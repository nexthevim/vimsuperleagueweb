<%- include('partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Syne:wght@700;800;900&display=swap" rel="stylesheet">

<style>
    :root {
        --brand-blue: #0088ff;
        --brand-cyan: #00c6ff;
        --mint: #d8f3e7;
        --mint-deep: #b8e8d4;
        --sky-soft: #e8f4ff;
        --text-dark: #0f172a;
        --text-muted: #64748b;
    }

    body {
        background: #f0f7fb;
        color: var(--text-dark);
        font-family: 'Plus Jakarta Sans', sans-serif;
        overflow-x: hidden;
        min-height: 100vh;
    }

    .font-display { font-family: 'Syne', sans-serif; }

    /* ===== COZY-STYLE HERO STAGE ===== */
    .vim-stage {
        position: relative;
        max-width: 1120px;
        margin: 0 auto;
        padding: 6.5rem 1.25rem 0;
    }

    .vim-stage-inner {
        position: relative;
        background: linear-gradient(165deg, #eaf6ff 0%, #f4fbff 45%, #eef9f3 100%);
        border-radius: 2rem;
        border: 1px solid rgba(148, 163, 184, 0.25);
        box-shadow: 0 30px 60px -30px rgba(15, 23, 42, 0.18);
        overflow: hidden;
        min-height: 520px;
    }

    .vim-stage-inner::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 15% 20%, rgba(0, 136, 255, 0.08), transparent 40%),
            radial-gradient(circle at 85% 15%, rgba(16, 185, 129, 0.1), transparent 35%);
        pointer-events: none;
    }

    /* Floating product-style cards */
    .float-card {
        position: absolute;
        background: #fff;
        border-radius: 1.15rem;
        border: 1px solid rgba(226, 232, 240, 0.95);
        box-shadow: 0 16px 40px -12px rgba(15, 23, 42, 0.18);
        z-index: 5;
    }

    .float-card-left {
        top: 18%;
        left: 4%;
        width: 150px;
        padding: 0.75rem;
        transform: rotate(-6deg);
    }

    .float-card-right {
        top: 14%;
        right: 5%;
        width: 168px;
        padding: 0.65rem;
        transform: rotate(5deg);
    }

    @media (max-width: 900px) {
        .float-card-left, .float-card-right { display: none; }
    }

    /* Bottom mint band — characters hold the edge */
    .hold-band {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 38%;
        background: linear-gradient(180deg, #c8efdc 0%, #a8e0c8 100%);
        z-index: 2;
    }

    .hold-band::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 28px;
        background: linear-gradient(180deg, rgba(255,255,255,0.35), transparent);
    }

    /* Roblox / soccer characters peeking over the band */
    .hold-chars {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 55%;
        z-index: 4;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        pointer-events: none;
        gap: 0;
    }

    .hold-char {
        position: relative;
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        filter: drop-shadow(0 12px 20px rgba(15, 23, 42, 0.2));
    }

    .hold-char img {
        object-fit: contain;
        object-position: bottom center;
        user-select: none;
    }

    .hold-char-side {
        width: clamp(110px, 18vw, 180px);
        height: clamp(140px, 22vw, 220px);
        margin-bottom: -4px;
    }

    .hold-char-center {
        width: clamp(150px, 26vw, 260px);
        height: clamp(180px, 30vw, 280px);
        margin-bottom: -6px;
        z-index: 2;
    }

    /* CSS fallback avatars if images fail */
    .char-fallback {
        width: 100%;
        height: 100%;
        border-radius: 1.5rem 1.5rem 0 0;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        font-size: 4rem;
        background: linear-gradient(180deg, transparent 20%, rgba(15,23,42,0.06));
        padding-bottom: 0.5rem;
    }

    .stage-copy {
        position: relative;
        z-index: 6;
        text-align: center;
        padding: 2.5rem 1.5rem 0;
        max-width: 640px;
        margin: 0 auto;
    }

    .btn-explore {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, #0088ff 0%, #00c6ff 100%);
        color: #fff;
        font-weight: 800;
        font-size: 0.75rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 0.95rem 1.75rem;
        border-radius: 999px;
        box-shadow: 0 10px 28px rgba(0, 136, 255, 0.35);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .btn-explore:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 32px rgba(0, 136, 255, 0.45);
    }

    .stat-strip {
        position: relative;
        z-index: 6;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 0.75rem;
        align-items: center;
        margin-top: auto;
        padding: 1rem 1.25rem 1.25rem;
    }

    .stat-box {
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 1rem;
        padding: 0.85rem 1rem;
        text-align: center;
    }

    .clean-card {
        background: #fff;
        border: 1px solid rgba(226, 232, 240, 0.9);
        box-shadow: 0 10px 30px -12px rgba(15, 23, 42, 0.1);
        border-radius: 1.25rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .clean-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 36px -14px rgba(0, 136, 255, 0.15);
    }

    .search-pill {
        background: #fff;
        border: 1px solid rgba(226, 232, 240, 0.95);
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
    }

    .btn-gradient {
        background: linear-gradient(135deg, #0088ff 0%, #00c6ff 100%);
        box-shadow: 0 8px 20px rgba(0, 136, 255, 0.28);
    }
    .btn-gradient:hover {
        opacity: 0.95;
        box-shadow: 0 12px 24px rgba(0, 136, 255, 0.4);
    }

    .section-soft {
        background: linear-gradient(135deg, #e8f0f8 0%, #e2eef5 100%);
        border-radius: 1.75rem;
        border: 1px solid #d4e2ee;
    }

    /* Tour (unchanged behaviour) */
    #vim-tour-overlay {
        position: fixed; inset: 0; z-index: 50000;
        pointer-events: none; opacity: 0; visibility: hidden;
        transition: opacity 0.25s ease, visibility 0.25s ease;
    }
    #vim-tour-overlay.active { opacity: 1; visibility: visible; }
    #vim-tour-backdrop {
        position: absolute; inset: 0;
        background: rgba(2, 6, 23, 0.76); pointer-events: auto;
    }
    #vim-tour-spotlight {
        position: absolute; width: 100px; height: 100px; border-radius: 9999px;
        border: 2px solid rgba(0, 198, 255, 0.95);
        box-shadow: 0 0 0 4px rgba(0, 136, 255, 0.10), 0 0 30px rgba(0, 136, 255, 0.45);
        pointer-events: none; transform: translate(-50%, -50%);
        transition: left 0.45s cubic-bezier(0.16, 1, 0.3, 1), top 0.45s cubic-bezier(0.16, 1, 0.3, 1), width 0.35s ease, height 0.35s ease;
    }
    #vim-tour-card {
        position: fixed; width: min(360px, calc(100vw - 32px));
        background: rgba(255, 255, 255, 0.97); color: #0f172a;
        border: 1px solid rgba(226, 232, 240, 0.9); border-radius: 20px; padding: 22px;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35); z-index: 50002; pointer-events: auto;
        transition: left 0.4s cubic-bezier(0.16, 1, 0.3, 1), top 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    #vim-tour-card::before {
        content: ""; position: absolute; width: 12px; height: 12px; background: white;
        border-left: 1px solid rgba(226, 232, 240, 0.9); border-top: 1px solid rgba(226, 232, 240, 0.9);
        transform: rotate(45deg); top: -7px; left: 34px;
    }
    #vim-tour-card.centered::before { display: none; }
    .vim-tour-eyebrow { font-size: 9px; font-weight: 900; letter-spacing: 0.2em; text-transform: uppercase; color: #0088ff; margin-bottom: 6px; }
    .vim-tour-title { font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 900; line-height: 1.15; margin-bottom: 8px; }
    .vim-tour-description { color: #64748b; font-size: 12px; line-height: 1.65; margin-bottom: 18px; }
    .vim-tour-progress { display: flex; align-items: center; gap: 5px; margin-bottom: 16px; }
    .vim-tour-progress span { height: 4px; width: 20px; border-radius: 999px; background: #e2e8f0; transition: all 0.25s ease; }
    .vim-tour-progress span.active { width: 32px; background: linear-gradient(90deg, #0088ff, #00c6ff); }
    .vim-tour-actions { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
    .vim-tour-skip { border: none; background: transparent; color: #94a3b8; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; padding: 8px 4px; cursor: pointer; }
    .vim-tour-next { border: none; background: linear-gradient(135deg, #0088ff, #00c6ff); color: white; font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.08em; padding: 11px 17px; border-radius: 11px; cursor: pointer; }
    #vim-tour-launcher {
        position: fixed; right: 20px; bottom: 20px; width: 42px; height: 42px; border-radius: 9999px;
        background: rgba(15, 23, 42, 0.92); color: white; border: 1px solid rgba(255, 255, 255, 0.12);
        z-index: 40000; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 900; cursor: pointer;
    }
    @media (max-width: 640px) {
        #vim-tour-card { bottom: 20px !important; top: auto !important; left: 16px !important; width: calc(100vw - 32px); }
        #vim-tour-card::before { display: none; }
        .vim-stage-inner { min-height: 460px; border-radius: 1.5rem; }
        .stat-strip { grid-template-columns: 1fr; }
        .stat-strip .stat-cta { order: -1; }
    }
</style>

<!-- TOUR -->
<div id="vim-tour-overlay" aria-hidden="true">
    <div id="vim-tour-backdrop"></div>
    <div id="vim-tour-spotlight"></div>
    <div id="vim-tour-card">
        <div class="vim-tour-eyebrow" id="vim-tour-eyebrow">VIM SUPER LEAGUE</div>
        <div class="vim-tour-title" id="vim-tour-title">Welcome to VIMSL</div>
        <div class="vim-tour-description" id="vim-tour-description">Let's take a quick look around the league.</div>
        <div class="vim-tour-progress" id="vim-tour-progress"></div>
        <div class="vim-tour-actions">
            <button type="button" id="vim-tour-skip" class="vim-tour-skip">Skip Tour</button>
            <button type="button" id="vim-tour-next" class="vim-tour-next">Next →</button>
        </div>
    </div>
</div>
<button id="vim-tour-launcher" type="button" aria-label="Replay VIMSL tutorial" title="Replay VIMSL tutorial">?</button>

<%
    const verifiedCount = (typeof players !== 'undefined' && players) ? players.filter(p => p.verified).length : 0;
    const heroPlayers = (typeof players !== 'undefined' && players)
        ? players.filter(p => p.verified && p.cardImage).slice(0, 3)
        : [];
%>

<!-- ========== CREATIVE HERO (CozyPaws-style stage) ========== -->
<section class="vim-stage">
    <div class="vim-stage-inner flex flex-col">

        <!-- Floating left: sample player / product card -->
        <% if (heroPlayers[0]) { %>
            <div class="float-card float-card-left">
                <div class="rounded-xl overflow-hidden bg-slate-100 aspect-[3/4] mb-2">
                    <img src="<%= heroPlayers[0].cardImage %>" alt="" class="w-full h-full object-cover" onerror="this.parentElement.innerHTML='⚽'">
                </div>
                <p class="text-[10px] font-black text-slate-800 truncate"><%= heroPlayers[0].name %></p>
                <p class="text-[9px] font-bold text-sky-600 uppercase"><%= heroPlayers[0].position || 'PRO' %></p>
            </div>
        <% } else { %>
            <div class="float-card float-card-left">
                <div class="rounded-xl bg-sky-50 aspect-[3/4] mb-2 flex items-center justify-center text-4xl">⚽</div>
                <p class="text-[10px] font-black text-slate-800">Player Card</p>
                <p class="text-[9px] font-bold text-sky-600">Market ready</p>
            </div>
        <% } %>

        <!-- Floating right: review / stream teaser -->
        <div class="float-card float-card-right">
            <div class="rounded-xl overflow-hidden bg-slate-900 aspect-video mb-2 relative flex items-center justify-center">
                <img src="/images/vimgfx.png" alt="" class="absolute inset-0 w-full h-full object-cover opacity-60" onerror="this.style.display='none'">
                <span class="relative z-10 w-9 h-9 rounded-full bg-white/90 flex items-center justify-center text-sky-600 text-sm font-black">▶</span>
            </div>
            <p class="text-[10px] font-black text-slate-800 leading-snug">Watch league highlights</p>
            <p class="text-[9px] font-bold text-slate-400 mt-0.5">Fixtures · streams · recaps</p>
        </div>

        <!-- Copy -->
        <div class="stage-copy">
            <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-sky-600 mb-3">VIM Super League</p>
            <h1 class="font-display text-4xl sm:text-5xl md:text-[3.25rem] font-black text-slate-900 leading-[1.05] tracking-tight">
                Everything<br>
                <span class="text-slate-700">Your Squad Needs</span>
            </h1>
            <p class="mt-4 text-sm text-slate-500 font-medium max-w-md mx-auto leading-relaxed">
                Market, fixtures, and the season — built for Roblox football competitors.
            </p>
            <div class="mt-6">
                <a href="/market" class="btn-explore">
                    Explore Market
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
            </div>
        </div>

        <!-- Mint band + characters holding the edge -->
        <div class="hold-band" aria-hidden="true"></div>
        <div class="hold-chars" aria-hidden="true">
            <!-- Left character -->
            <div class="hold-char">
                <% if (heroPlayers[1] && heroPlayers[1].cardImage) { %>
                    <img src="<%= heroPlayers[1].cardImage %>" alt="" class="hold-char-side" style="object-fit:cover;border-radius:1.25rem 1.25rem 0 0;mask-image:linear-gradient(to top, black 70%, transparent);" onerror="this.outerHTML='<div class=char-fallback>🏃</div>'">
                <% } else { %>
                    <div class="hold-char-side char-fallback">🏃</div>
                <% } %>
            </div>
            <!-- Center star (uses league GFX or player) -->
            <div class="hold-char">
                <% if (heroPlayers[0] && heroPlayers[0].cardImage) { %>
                    <img src="<%= heroPlayers[0].cardImage %>" alt="" class="hold-char-center" style="object-fit:cover;border-radius:1.5rem 1.5rem 0 0;mask-image:linear-gradient(to top, black 65%, transparent);" onerror="this.src='/images/vimgfx.png'">
                <% } else { %>
                    <img src="/images/vimgfx.png" alt="" class="hold-char-center" style="object-fit:cover;border-radius:1.5rem 1.5rem 0 0;" onerror="this.outerHTML='<div class=char-fallback>⚽</div>'">
                <% } %>
            </div>
            <!-- Right character -->
            <div class="hold-char">
                <% if (heroPlayers[2] && heroPlayers[2].cardImage) { %>
                    <img src="<%= heroPlayers[2].cardImage %>" alt="" class="hold-char-side" style="object-fit:cover;border-radius:1.25rem 1.25rem 0 0;mask-image:linear-gradient(to top, black 70%, transparent);" onerror="this.outerHTML='<div class=char-fallback>🛡️</div>'">
                <% } else { %>
                    <div class="hold-char-side char-fallback">🛡️</div>
                <% } %>
            </div>
        </div>

        <!-- Bottom stats like CozyPaws -->
        <div class="stat-strip relative z-10 mt-auto">
            <div class="stat-box">
                <p class="font-display text-xl sm:text-2xl font-black text-slate-900"><%= verifiedCount || '100' %>+</p>
                <p class="text-[9px] font-bold text-slate-500 uppercase tracking-wide mt-0.5">Players on the market</p>
            </div>
            <div class="stat-cta flex justify-center px-2">
                <a href="/market" class="btn-explore !py-3 !px-5 text-[11px] shadow-lg">
                    Best picks for your roster
                    <span class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center">→</span>
                </a>
            </div>
            <div class="stat-box">
                <p class="font-display text-xl sm:text-2xl font-black text-slate-900">S4</p>
                <p class="text-[9px] font-bold text-slate-500 uppercase tracking-wide mt-0.5">Season live · compete now</p>
            </div>
        </div>
    </div>

    <!-- Search under the stage -->
    <div class="relative max-w-xl mx-auto -mt-5 z-20 px-2">
        <form id="search-form" action="/matches" method="GET" class="search-pill rounded-2xl p-2.5 flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
            <div class="flex-1 flex items-center gap-3 px-3 py-2">
                <svg class="w-5 h-5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0a7 7 0 0114 0z"></path>
                </svg>
                <input id="live-search-input" name="q" type="text" placeholder="Search teams, players, matches…" autocomplete="off"
                    class="w-full bg-transparent text-slate-800 placeholder-slate-400 text-sm font-medium focus:outline-none">
            </div>
            <button type="submit" id="search-btn" class="btn-gradient text-white text-[11px] font-bold uppercase tracking-wider px-6 py-3.5 rounded-xl shrink-0">
                Search
            </button>
        </form>
        <div id="search-results-dropdown" class="hidden absolute left-0 right-0 mt-2 bg-white border border-slate-200 rounded-2xl shadow-2xl p-4 space-y-4 max-h-96 overflow-y-auto text-left z-50"></div>
    </div>
</section>

<main class="relative z-10 max-w-6xl mx-auto px-5 sm:px-6 pt-16 pb-28 space-y-20">

    <!-- Featured match + broadcast -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <div id="tour-featured-match" class="lg:col-span-7 clean-card p-6 sm:p-8">
            <div class="flex justify-between items-start gap-3 mb-5">
                <div>
                    <span class="text-[10px] font-bold text-sky-500 uppercase tracking-widest">Featured fixture</span>
                    <h3 class="font-display text-xl font-bold text-slate-900 mt-1">Upcoming match</h3>
                </div>
                <span class="bg-sky-50 text-sky-600 border border-sky-100 text-[9px] font-bold px-2.5 py-1 rounded-full uppercase">Schedule</span>
            </div>
            <% let nextMatch = (typeof matches !== 'undefined' && matches) ? matches.find(m => m.status === 'upcoming') : null; %>
            <% if (nextMatch) { %>
                <div class="flex items-center justify-between gap-3 bg-slate-50 rounded-2xl p-5 border border-slate-100">
                    <div class="flex-1 flex flex-col items-center gap-2 min-w-0">
                        <img src="<%= nextMatch.logoA %>" class="w-12 h-12 object-contain" onerror="this.style.opacity='0.3'">
                        <span class="font-bold text-xs text-slate-800 uppercase truncate max-w-full"><%= nextMatch.teamA %></span>
                    </div>
                    <div class="text-center px-2 shrink-0">
                        <span class="font-display font-black text-xl text-sky-500">VS</span>
                        <span class="block text-[10px] font-bold text-slate-400 uppercase mt-1"><%= nextMatch.time %></span>
                    </div>
                    <div class="flex-1 flex flex-col items-center gap-2 min-w-0">
                        <img src="<%= nextMatch.logoB %>" class="w-12 h-12 object-contain" onerror="this.style.opacity='0.3'">
                        <span class="font-bold text-xs text-slate-800 uppercase truncate max-w-full"><%= nextMatch.teamB %></span>
                    </div>
                </div>
            <% } else { %>
                <div class="py-12 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">No upcoming matches</p>
                </div>
            <% } %>
            <div class="flex justify-between items-center mt-4 pt-4 border-t border-slate-100 text-xs font-semibold text-slate-500">
                <span>League matches</span>
                <a href="/matches" class="text-sky-500 hover:text-sky-600 font-bold">Full fixtures →</a>
            </div>
        </div>

        <div class="lg:col-span-5 clean-card p-2 overflow-hidden bg-slate-950 text-white min-h-[240px] flex flex-col">
            <% if (typeof liveLink !== 'undefined' && liveLink && liveLink.trim() !== "") { %>
                <%
                    let embedLink = liveLink;
                    if (liveLink.includes('watch?v=')) embedLink = liveLink.replace('watch?v=', 'embed/').split('&')[0];
                    else if (liveLink.includes('youtu.be/')) embedLink = liveLink.replace('youtu.be/', 'youtube.com/embed/').split('?')[0];
                %>
                <iframe class="w-full flex-1 min-h-[240px] rounded-xl" src="<%= embedLink %>" frameborder="0" allowfullscreen></iframe>
            <% } else { %>
                <div class="flex-1 min-h-[240px] rounded-xl flex flex-col items-center justify-center p-6 text-center">
                    <span class="font-display text-base font-bold text-white/70 uppercase">Stream offline</span>
                    <span class="text-[10px] text-slate-500 uppercase tracking-wider mt-1">No live link set</span>
                </div>
            <% } %>
        </div>
    </div>

    <!-- 3 steps -->
    <div class="section-soft p-8 sm:p-12">
        <div class="text-center max-w-xl mx-auto mb-10">
            <span class="text-[10px] font-bold text-sky-500 uppercase tracking-[0.2em]">How it works</span>
            <h2 class="font-display text-2xl sm:text-3xl font-black text-slate-900 mt-2">Enter the league with ease</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
            <div>
                <div class="w-14 h-14 rounded-2xl bg-white border border-slate-200 text-sky-500 flex items-center justify-center mx-auto mb-4 shadow-sm text-lg font-black">1</div>
                <h3 class="font-display font-bold text-base text-slate-900 mb-1">Join community</h3>
                <p class="text-xs text-slate-500 leading-relaxed max-w-xs mx-auto">Discord in. Meet managers and scouts.</p>
            </div>
            <div>
                <div class="w-14 h-14 rounded-2xl bg-white border border-slate-200 text-sky-500 flex items-center justify-center mx-auto mb-4 shadow-sm text-lg font-black">2</div>
                <h3 class="font-display font-bold text-base text-slate-900 mb-1">Register your card</h3>
                <p class="text-xs text-slate-500 leading-relaxed max-w-xs mx-auto">Profile, position, and market presence.</p>
            </div>
            <div>
                <div class="w-14 h-14 rounded-2xl bg-white border border-slate-200 text-sky-500 flex items-center justify-center mx-auto mb-4 shadow-sm text-lg font-black">3</div>
                <h3 class="font-display font-bold text-base text-slate-900 mb-1">Get drafted & play</h3>
                <p class="text-xs text-slate-500 leading-relaxed max-w-xs mx-auto">Auction, roster, fixtures, climb.</p>
            </div>
        </div>
    </div>

    <!-- Results -->
    <div id="tour-results">
        <div class="flex justify-between items-end mb-6">
            <div>
                <span class="text-[10px] font-bold text-sky-500 uppercase tracking-widest">Scoreboard</span>
                <h2 class="font-display text-2xl font-bold text-slate-900 mt-1">Recent results</h2>
            </div>
            <a href="/matches" class="text-sky-500 text-xs font-bold hover:text-sky-600">All matches →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <%
                const finished = (typeof matches !== 'undefined' && matches)
                    ? matches.filter(m => m.status === 'completed' || m.status === 'finished' || (m.details && (m.details.goalsA != null || m.details.goalsB != null))).slice(0, 6)
                    : [];
            %>
            <% if (finished.length > 0) { %>
                <% finished.forEach(r => { %>
                    <a href="/match/<%= r.id || r._id %>" class="clean-card p-4 block">
                        <div class="flex justify-between items-center mb-2">
                            <div class="flex items-center gap-2 min-w-0">
                                <img src="<%= r.logoA %>" class="w-6 h-6 object-contain" onerror="this.style.opacity='0.25'">
                                <span class="font-bold text-xs text-slate-800 uppercase truncate"><%= r.teamA %></span>
                            </div>
                            <span class="font-display font-black text-base text-slate-900"><%= (r.details && r.details.goalsA != null) ? r.details.goalsA : 0 %></span>
                        </div>
                        <div class="flex justify-between items-center">
                            <div class="flex items-center gap-2 min-w-0">
                                <img src="<%= r.logoB %>" class="w-6 h-6 object-contain" onerror="this.style.opacity='0.25'">
                                <span class="font-bold text-xs text-slate-500 uppercase truncate"><%= r.teamB %></span>
                            </div>
                            <span class="font-display font-black text-base text-slate-400"><%= (r.details && r.details.goalsB != null) ? r.details.goalsB : 0 %></span>
                        </div>
                    </a>
                <% }) %>
            <% } else { %>
                <div class="col-span-full py-12 clean-card text-center text-slate-400 text-xs font-bold uppercase tracking-widest">No recent results</div>
            <% } %>
        </div>
    </div>

    <!-- Stories -->
    <div>
        <div class="mb-6">
            <span class="text-[10px] font-bold text-sky-500 uppercase tracking-widest">Journal</span>
            <h2 class="font-display text-2xl font-bold text-slate-900 mt-1">League stories</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <% if (typeof stories !== 'undefined' && stories.length > 0) { %>
                <% stories.slice().reverse().forEach(story => { %>
                    <div class="clean-card overflow-hidden group flex flex-col">
                        <div class="aspect-video overflow-hidden bg-slate-100">
                            <img src="<%= story.image %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" alt="">
                        </div>
                        <div class="p-5">
                            <span class="text-[10px] font-bold text-slate-400 uppercase"><%= story.date || 'Article' %></span>
                            <h4 class="font-display font-bold text-base text-slate-900 mt-1 group-hover:text-sky-500 transition leading-snug"><%= story.title %></h4>
                            <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed"><%= story.description %></p>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-span-full py-12 clean-card text-center text-slate-400 text-xs font-bold uppercase tracking-widest">No stories yet</div>
            <% } %>
        </div>
    </div>

    <!-- CTA -->
    <div class="section-soft p-10 sm:p-14 text-center">
        <h3 class="font-display text-2xl sm:text-3xl font-bold text-slate-900 mb-2">Ready to compete?</h3>
        <p class="text-xs text-slate-500 uppercase tracking-widest max-w-sm mx-auto mb-7">Set up your card and get on the market.</p>
        <a href="/market" class="btn-explore">
            Let's plan your career
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
    </div>
</main>

<script>
(function () {
    const overlay = document.getElementById('vim-tour-overlay');
    const backdrop = document.getElementById('vim-tour-backdrop');
    const spotlight = document.getElementById('vim-tour-spotlight');
    const card = document.getElementById('vim-tour-card');
    const eyebrow = document.getElementById('vim-tour-eyebrow');
    const title = document.getElementById('vim-tour-title');
    const description = document.getElementById('vim-tour-description');
    const progress = document.getElementById('vim-tour-progress');
    const nextButton = document.getElementById('vim-tour-next');
    const skipButton = document.getElementById('vim-tour-skip');
    const launcher = document.getElementById('vim-tour-launcher');
    if (!overlay || !spotlight || !card) return;

    const tourSteps = [
        { selector: '[data-tour="market"]', mobileSelector: '[data-tour="market-mobile"]', eyebrow: 'PLAYER MARKET', title: 'Build your player profile', description: 'Browse registered players, cards, stats and positions.' },
        { selector: '[data-tour="matches"]', mobileSelector: '[data-tour="matches-mobile"]', eyebrow: 'MATCH CENTER', title: 'Follow the fixtures', description: 'Upcoming fixtures, completed games and match details.' },
        { selector: '[data-tour="metrics"]', mobileSelector: '[data-tour="metrics-mobile"]', eyebrow: 'LEAGUE METRICS', title: 'Track the numbers', description: 'Goals, assists, saves, MVPs and league stats.' },
        { selector: '[data-tour="records"]', mobileSelector: '[data-tour="records-mobile"]', eyebrow: 'LEAGUE RECORDS', title: 'Explore the history', description: 'Achievements, records and milestones.' },
        { selector: '#live-search-input', eyebrow: 'SEARCH', title: 'Find anything quickly', description: 'Search teams, players or matches from the homepage.' },
        { selector: '#tour-featured-match', eyebrow: 'FEATURED FIXTURE', title: 'See what is coming up', description: 'Next scheduled match, front and center.' },
        { selector: '#tour-results', eyebrow: 'SCOREBOARD', title: 'Keep up with results', description: 'Recent completed matches with final scores.' }
    ];
    let currentStep = 0;
    function isMobileLayout() { return window.innerWidth < 1280; }
    function getTarget(step) {
        let target = null;
        if (isMobileLayout() && step.mobileSelector) target = document.querySelector(step.mobileSelector);
        if (!target && step.selector) target = document.querySelector(step.selector);
        return target;
    }
    function createProgress() {
        progress.innerHTML = '';
        tourSteps.forEach(function (_, index) {
            const dot = document.createElement('span');
            if (index === currentStep) dot.classList.add('active');
            progress.appendChild(dot);
        });
    }
    function positionTourCard(target) {
        const margin = 16;
        const cardWidth = Math.min(360, window.innerWidth - 32);
        card.style.width = cardWidth + 'px';
        if (window.innerWidth <= 640) {
            card.classList.add('centered');
            card.style.left = '16px'; card.style.top = 'auto'; card.style.bottom = '20px';
            return;
        }
        card.classList.remove('centered');
        const rect = target.getBoundingClientRect();
        let left = rect.left, top = rect.bottom + 22;
        if (left + cardWidth > window.innerWidth - margin) left = window.innerWidth - cardWidth - margin;
        if (left < margin) left = margin;
        if (top + 220 > window.innerHeight - margin) {
            top = rect.top - 242;
            if (top < margin) { top = margin; card.classList.add('centered'); }
        }
        card.style.left = left + 'px'; card.style.top = top + 'px'; card.style.bottom = 'auto';
    }
    function moveSpotlight(target) {
        const rect = target.getBoundingClientRect();
        let width = Math.max(rect.width, 55), height = Math.max(rect.height, 45);
        const padding = window.innerWidth <= 640 ? 10 : 9;
        spotlight.style.left = (rect.left + rect.width / 2) + 'px';
        spotlight.style.top = (rect.top + rect.height / 2) + 'px';
        spotlight.style.width = (width + padding * 2) + 'px';
        spotlight.style.height = (height + padding * 2) + 'px';
    }
    function showStep(index) {
        currentStep = index;
        const step = tourSteps[currentStep];
        const target = getTarget(step);
        if (!target) {
            if (currentStep < tourSteps.length - 1) showStep(currentStep + 1);
            else finishTour();
            return;
        }
        if (isMobileLayout() && step.mobileSelector) {
            const mobileMenu = document.getElementById('mobile-menu');
            if (mobileMenu && !mobileMenu.classList.contains('active')) mobileMenu.classList.add('active');
        }
        target.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
        setTimeout(function () { moveSpotlight(target); positionTourCard(target); }, 120);
        eyebrow.textContent = step.eyebrow;
        title.textContent = step.title;
        description.textContent = step.description;
        createProgress();
        nextButton.textContent = currentStep === tourSteps.length - 1 ? 'Finish ✓' : 'Next →';
    }
    function startTour() {
        currentStep = 0;
        overlay.classList.add('active');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        showStep(0);
    }
    function finishTour() {
        overlay.classList.remove('active');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        localStorage.setItem('vim_home_tour_seen', 'true');
        const mobileMenu = document.getElementById('mobile-menu');
        if (mobileMenu) mobileMenu.classList.remove('active');
    }
    nextButton.addEventListener('click', function () {
        if (currentStep >= tourSteps.length - 1) { finishTour(); return; }
        showStep(currentStep + 1);
    });
    skipButton.addEventListener('click', finishTour);
    backdrop.addEventListener('click', finishTour);
    launcher.addEventListener('click', startTour);
    document.addEventListener('keydown', function (event) {
        if (!overlay.classList.contains('active')) return;
        if (event.key === 'Escape') finishTour();
        if (event.key === 'ArrowRight' && currentStep < tourSteps.length - 1) showStep(currentStep + 1);
        if (event.key === 'ArrowLeft' && currentStep > 0) showStep(currentStep - 1);
    });
    window.addEventListener('resize', function () {
        if (!overlay.classList.contains('active')) return;
        const target = getTarget(tourSteps[currentStep]);
        if (target) { moveSpotlight(target); positionTourCard(target); }
    });
    if (!localStorage.getItem('vim_home_tour_seen')) setTimeout(startTour, 900);
})();
</script>

<script>
    const localMatches = <%- JSON.stringify(matches || []) %>;
    const localPlayers = <%- typeof players !== 'undefined' ? JSON.stringify(players) : '[]' %>;
    const searchInput = document.getElementById('live-search-input');
    const dropdown = document.getElementById('search-results-dropdown');
    const searchForm = document.getElementById('search-form');
    let debounceTimer, topTargetUrl = '';

    searchInput.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        const query = e.target.value.trim().toLowerCase();
        if (query.length < 1) { dropdown.classList.add('hidden'); dropdown.innerHTML = ''; topTargetUrl = ''; return; }
        debounceTimer = setTimeout(() => {
            fetch(`/api/search?q=${encodeURIComponent(query)}`)
                .then(res => res.ok ? res.json() : Promise.reject())
                .then(data => renderSearchResults(data, query))
                .catch(() => {
                    renderSearchResults({
                        matches: localMatches.filter(m => (m.teamA && m.teamA.toLowerCase().includes(query)) || (m.teamB && m.teamB.toLowerCase().includes(query))),
                        players: localPlayers.filter(p => (p.name && p.name.toLowerCase().includes(query)) || (p.role && p.role.toLowerCase().includes(query)))
                    }, query);
                });
        }, 150);
    });

    function renderSearchResults(data, query) {
        const { players, matches } = data;
        let html = ''; topTargetUrl = '';
        const hasMatches = matches && matches.length > 0;
        const hasPlayers = players && players.length > 0;
        if (!hasMatches && !hasPlayers) {
            dropdown.innerHTML = `<div class="text-center py-4 text-xs font-semibold text-gray-400 uppercase">No matches for "${query}"</div>`;
            dropdown.classList.remove('hidden'); return;
        }
        if (hasMatches) {
            if (!topTargetUrl) topTargetUrl = `/match/${matches[0].id || matches[0]._id || ''}`;
            html += `<div><span class="text-[10px] font-bold text-sky-500 uppercase tracking-widest block mb-2 px-2">Matches</span><div class="space-y-1">`;
            matches.forEach(m => {
                const matchUrl = (m.id || m._id) ? `/match/${m.id || m._id}` : `/matches?q=${encodeURIComponent(query)}`;
                html += `<a href="${matchUrl}" class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-100 transition"><span class="text-xs font-bold text-gray-800 uppercase">${m.teamA} <span class="text-sky-500">vs</span> ${m.teamB}</span><span class="text-[10px] text-gray-400 font-semibold uppercase">${m.status || m.time || 'Fixture'}</span></a>`;
            });
            html += `</div></div>`;
        }
        if (hasPlayers) {
            if (!topTargetUrl) topTargetUrl = players[0].id ? `/player/${players[0].id}` : `/market`;
            html += `<div class="${hasMatches ? 'pt-3 border-t border-slate-100' : ''}"><span class="text-[10px] font-bold text-sky-500 uppercase tracking-widest block mb-2 px-2">Players</span><div class="space-y-1">`;
            players.forEach(p => {
                const playerUrl = p.id ? `/player/${p.id}` : `/market?search=${encodeURIComponent(p.name)}`;
                html += `<a href="${playerUrl}" class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-100 transition"><div class="flex items-center gap-3"><div class="w-7 h-7 rounded-full bg-sky-100 text-sky-600 flex items-center justify-center font-bold text-xs">${p.name ? p.name.charAt(0) : 'P'}</div><div><span class="text-xs font-bold text-gray-800 block">${p.name}</span><span class="text-[10px] text-gray-400">${p.team || 'Free Agent'}</span></div></div><span class="text-[10px] text-sky-600 font-bold uppercase">${p.role || p.position || 'Player'}</span></a>`;
            });
            html += `</div></div>`;
        }
        dropdown.innerHTML = html;
        dropdown.classList.remove('hidden');
    }

    searchForm.addEventListener('submit', (e) => {
        if (topTargetUrl) { e.preventDefault(); window.location.href = topTargetUrl; }
    });
    document.addEventListener('click', (e) => {
        if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) dropdown.classList.add('hidden');
    });
</script>
