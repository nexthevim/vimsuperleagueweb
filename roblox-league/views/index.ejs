    .vim-tour-next { border: 0; background: var(--teal); color: #fff; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.7rem 1rem; border-radius: 999px; cursor: pointer; }
    #vim-tour-launcher { position: fixed; right: 1.1rem; bottom: 1.1rem; width: 2.5rem; height: 2.5rem; border-radius: 999px; background: var(--teal); color: #fff; border: 0; z-index: 40000; font-weight: 800; cursor: pointer; box-shadow: 0 10px 24px rgba(15,76,74,0.3); }
