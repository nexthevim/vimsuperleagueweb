<%- include('partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --sand: #f7f3ec;
        --paper: #fffcf8;
        --ink: #1c2b2a;
        --soft: #5c6b6a;
        --teal: #0f4c4a;
        --teal-mid: #1a6b68;
        --coral: #e8a87c;
        --coral-deep: #d4896a;
        --line: rgba(28, 43, 42, 0.08);
        --radius: 1.5rem;
    }

    body {
        margin: 0;
        background: var(--sand);
        color: var(--ink);
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
    }

    .pc { padding-top: 5rem; }

    .pc-wrap {
        width: min(1120px, calc(100% - 2.5rem));
        margin: 0 auto;
    }

    .pc-serif {
        font-family: 'Fraunces', Georgia, serif;
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.05;
    }

    .pc-label {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--teal-mid);
    }

    /* ----- reveal on scroll ----- */
    .reveal {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal.in {
        opacity: 1;
        transform: translateY(0);
    }
    .reveal-d1 { transition-delay: 0.08s; }
    .reveal-d2 { transition-delay: 0.16s; }
    .reveal-d3 { transition-delay: 0.24s; }
    .reveal-d4 { transition-delay: 0.32s; }

    /* ========== HERO ========== */
    .pc-hero {
        position: relative;
        padding: 1.5rem 0 0;
        overflow: hidden;
    }

    .pc-hero-shell {
        position: relative;
        border-radius: 2rem;
        overflow: hidden;
        min-height: min(72vh, 680px);
        background:
            linear-gradient(115deg, rgba(15, 76, 74, 0.55) 0%, rgba(15, 76, 74, 0.15) 42%, transparent 70%),
            url('/images/vimgfx.png') center center / cover no-repeat;
        color: #fff;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        align-items: center;
        box-shadow: 0 28px 60px rgba(28, 43, 42, 0.12);
    }

    .pc-hero-copy {
        position: relative;
        z-index: 2;
        padding: 3rem 2.5rem 3.5rem;
        max-width: 34rem;
    }

    .pc-hero-copy .pc-label {
        color: rgba(255,255,255,0.75);
        margin-bottom: 1rem;
    }

    .pc-hero h1 {
        margin: 0 0 1.1rem;
        font-size: clamp(2.6rem, 5.5vw, 4rem);
        color: #fff;
    }

    .pc-hero h1 em {
        font-style: italic;
        font-weight: 500;
        display: block;
        opacity: 0.95;
    }

    .pc-hero-lead {
        margin: 0 0 1.75rem;
        font-size: 1rem;
        line-height: 1.65;
        color: rgba(255,255,255,0.82);
        font-weight: 500;
        max-width: 28rem;
    }

    .pc-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
        margin-bottom: 1.5rem;
    }

    .pc-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.9rem 1.35rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }
    .pc-btn:hover { transform: translateY(-2px); }

    .pc-btn-coral {
        background: var(--coral);
        color: #1c2b2a;
        box-shadow: 0 10px 24px rgba(232, 168, 124, 0.35);
    }
    .pc-btn-coral:hover { background: var(--coral-deep); color: #1c2b2a; }

    .pc-btn-ghost {
        border: 1.5px solid rgba(255,255,255,0.45);
        color: #fff;
        background: rgba(255,255,255,0.08);
    }
    .pc-btn-ghost:hover { background: rgba(255,255,255,0.16); color: #fff; }

    .pc-search {
        position: relative;
        display: flex;
        gap: 0.35rem;
        max-width: 400px;
        padding: 0.4rem;
        border-radius: 999px;
        background: rgba(255,252,248,0.95);
        box-shadow: 0 14px 36px rgba(0,0,0,0.15);
    }
    .pc-search input {
        flex: 1; min-width: 0; border: 0; outline: none; background: transparent;
        padding: 0.75rem 1rem; font-family: inherit; font-size: 0.88rem; font-weight: 600; color: var(--ink);
    }
    .pc-search button {
        border: 0; border-radius: 999px; padding: 0.75rem 1.1rem;
        background: var(--teal); color: #fff; font-family: inherit;
        font-size: 0.68rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; cursor: pointer;
    }
    #search-results-dropdown {
        position: absolute; left: 0; right: 0; top: calc(100% + 0.5rem);
        background: var(--paper); border: 1px solid var(--line); border-radius: 1rem;
        box-shadow: 0 20px 50px rgba(28,43,42,0.14); padding: 0.85rem;
        max-height: 22rem; overflow-y: auto; z-index: 40; text-align: left; color: var(--ink);
    }

    /* decorative side panel placeholders in hero */
    .pc-hero-side {
        position: relative;
        z-index: 2;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        justify-content: center;
    }
    .pc-float-card {
        border-radius: 1.25rem;
        overflow: hidden;
        border: 3px solid rgba(255,255,255,0.55);
        box-shadow: 0 16px 40px rgba(0,0,0,0.18);
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(6px);
        min-height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,0.7);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }
    .pc-float-card img {
        width: 100%; height: 100%; object-fit: cover; display: block; min-height: 120px;
    }
    .pc-float-card.tall { min-height: 180px; }

    /* wave divider */
    .pc-wave {
        display: block;
        width: 100%;
        height: 72px;
        margin-top: -1px;
    }
    .pc-wave path { fill: var(--sand); }

    /* ========== 3D POP BUTTONS ========== */
    .pc-pops {
        padding: 1rem 0 3.5rem;
    }
    .pc-pops-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.15rem;
    }
    .pc-pop {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        text-decoration: none;
        color: inherit;
        padding: 1.5rem 1rem 1.35rem;
        border-radius: 1.35rem;
        background: var(--paper);
        border: 1px solid var(--line);
        box-shadow:
            0 1px 0 rgba(255,255,255,0.9) inset,
            0 10px 28px rgba(28, 43, 42, 0.07);
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
        overflow: visible;
    }
    .pc-pop:hover {
        transform: translateY(-8px);
        box-shadow: 0 22px 44px rgba(28, 43, 42, 0.14);
        color: inherit;
    }
    .pc-pop-icon {
        width: 4.5rem;
        height: 4.5rem;
        margin-bottom: 1rem;
        border-radius: 1.15rem;
        background: linear-gradient(145deg, #e8f5f4, #d4ebe9);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 8px 18px rgba(15, 76, 74, 0.12);
    }
    .pc-pop:hover .pc-pop-icon {
        transform: translateY(-14px) scale(1.12);
    }
    .pc-pop-icon svg {
        width: 2.35rem;
        height: 2.35rem;
        color: var(--teal);
    }
    .pc-pop strong {
        display: block;
        font-size: 0.95rem;
        font-weight: 800;
        margin-bottom: 0.25rem;
    }
    .pc-pop span {
        font-size: 0.78rem;
        color: var(--soft);
        line-height: 1.4;
    }

    /* ========== SERVICES-STYLE STRIP ========== */
    .pc-band {
        padding: 3.5rem 0;
    }
    .pc-band-head {
        text-align: center;
        margin-bottom: 2.25rem;
    }
    .pc-band-head h2 {
        margin: 0.5rem 0 0;
        font-size: clamp(1.9rem, 3.5vw, 2.6rem);
    }

    /* Match + stream */
    .pc-split {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 1.25rem;
    }
    .pc-card {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.5rem;
        box-shadow: 0 12px 32px rgba(28,43,42,0.05);
    }
    .pc-match {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 1rem;
        align-items: center;
        padding: 1.25rem;
        background: var(--sand);
        border-radius: 1.15rem;
        margin-top: 1rem;
    }
    .pc-team {
        display: flex; flex-direction: column; align-items: center; gap: 0.55rem; text-align: center;
    }
    .pc-team img { width: 3.5rem; height: 3.5rem; object-fit: contain; }
    .pc-team span { font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.03em; }
    .pc-vs { text-align: center; }
    .pc-vs strong { font-family: 'Fraunces', serif; font-size: 1.4rem; font-style: italic; color: var(--teal); }
    .pc-vs small { display: block; margin-top: 0.25rem; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--soft); }

    .pc-stream {
        border-radius: var(--radius);
        overflow: hidden;
        background: #0f1a19;
        min-height: 260px;
        border: 1px solid var(--line);
    }
    .pc-stream iframe { width: 100%; min-height: 280px; border: 0; display: block; }
    .pc-stream-empty {
        min-height: 260px; display: flex; flex-direction: column; align-items: center; justify-content: center;
        color: rgba(255,255,255,0.5); text-align: center; padding: 1.5rem; gap: 0.35rem;
    }
    .pc-stream-empty strong { color: rgba(255,255,255,0.85); font-family: 'Fraunces', serif; font-size: 1.25rem; }

    /* ========== IMAGE PLACEHOLDERS GALLERY ========== */
    .pc-gallery-band {
        background: var(--teal);
        color: #fff;
        padding: 3.5rem 0 4rem;
        border-radius: 2.5rem 2.5rem 0 0;
        margin-top: 1rem;
    }
    .pc-gallery-band .pc-label { color: rgba(255,255,255,0.65); }
    .pc-gallery-band h2 { color: #fff; margin: 0.45rem 0 0.35rem; font-size: clamp(1.8rem, 3vw, 2.4rem); }
    .pc-gallery-band .sub { color: rgba(255,255,255,0.65); font-size: 0.95rem; margin: 0 0 1.75rem; }

    .pc-gallery {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 0.85rem;
    }
    .pc-ph {
        aspect-ratio: 4 / 5;
        border-radius: 1.1rem;
        overflow: hidden;
        background: rgba(255,255,255,0.08);
        border: 1px dashed rgba(255,255,255,0.25);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        color: rgba(255,255,255,0.55);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-align: center;
        padding: 0.75rem;
        position: relative;
    }
    .pc-ph img {
        position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    }
    .pc-ph.has-img { border-style: solid; border-color: transparent; }
    .pc-ph.has-img span { display: none; }
    .pc-ph-label {
        position: absolute; left: 0; right: 0; bottom: 0;
        padding: 0.65rem 0.7rem;
        background: linear-gradient(transparent, rgba(0,0,0,0.55));
        color: #fff; font-size: 0.7rem; font-weight: 700;
        letter-spacing: 0.04em; text-transform: uppercase;
        z-index: 2;
    }

    /* ========== ABOUT ========== */
    .pc-about {
        background: var(--paper);
        padding: 4rem 0;
        border-radius: 0 0 2.5rem 2.5rem;
        margin-bottom: 2rem;
    }
    .pc-about-grid {
        display: grid;
        grid-template-columns: 0.95fr 1.05fr;
        gap: 2.5rem;
        align-items: center;
    }
    .pc-about-photo {
        border-radius: 1.5rem;
        overflow: hidden;
        min-height: 320px;
        background: var(--sand);
        border: 1px dashed rgba(28,43,42,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--soft);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        position: relative;
    }
    .pc-about-photo img {
        position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    }
    .pc-about h2 {
        margin: 0.5rem 0 1rem;
        font-size: clamp(1.9rem, 3.2vw, 2.6rem);
    }
    .pc-about p {
        margin: 0 0 1rem;
        font-size: 1rem;
        line-height: 1.7;
        color: var(--soft);
    }
    .pc-about-quote {
        margin-top: 1.25rem;
        padding-top: 1.15rem;
        border-top: 1px solid var(--line);
        font-family: 'Fraunces', serif;
        font-style: italic;
        font-size: 1.15rem;
        color: var(--ink);
        line-height: 1.45;
    }
    .pc-about-quote cite {
        display: block;
        margin-top: 0.5rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-style: normal;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--soft);
    }

    /* Results */
    .pc-results {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.85rem;
    }
    .pc-result {
        display: flex; flex-direction: column; gap: 0.55rem;
        padding: 1.1rem 1.2rem;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 1.15rem;
        text-decoration: none; color: inherit;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .pc-result:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(28,43,42,0.08); color: inherit; }
    .pc-result-row { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
    .pc-result-team { display: flex; align-items: center; gap: 0.55rem; min-width: 0; }
    .pc-result-team img { width: 1.5rem; height: 1.5rem; object-fit: contain; }
    .pc-result-team span { font-size: 0.78rem; font-weight: 800; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pc-result-score { font-family: 'Fraunces', serif; font-size: 1.25rem; font-weight: 600; }
    .pc-result-score.dim { color: var(--soft); }

    /* Stories */
    .pc-stories {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }
    .pc-story {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 1.25rem;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .pc-story-img {
        aspect-ratio: 16/10;
        background: var(--sand);
        position: relative;
        overflow: hidden;
    }
    .pc-story-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pc-story-body { padding: 1.15rem 1.2rem 1.35rem; }
    .pc-story-body small { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--soft); }
    .pc-story-body h3 { margin: 0.35rem 0 0.4rem; font-size: 1.1rem; font-family: 'Fraunces', serif; font-weight: 600; line-height: 1.2; }
    .pc-story-body p { margin: 0; font-size: 0.85rem; line-height: 1.55; color: var(--soft); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    /* CTA coral band */
    .pc-cta {
        margin: 2rem 0;
        border-radius: 1.75rem;
        padding: 2.5rem 2rem;
        background: linear-gradient(135deg, var(--coral), #f0b892);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        box-shadow: 0 18px 40px rgba(232, 168, 124, 0.3);
    }
    .pc-cta h3 {
        margin: 0 0 0.35rem;
        font-size: clamp(1.5rem, 2.5vw, 1.9rem);
        color: #1c2b2a;
    }
    .pc-cta p { margin: 0; color: rgba(28,43,42,0.75); font-size: 0.95rem; }
    .pc-cta .pc-btn {
        background: var(--teal);
        color: #fff;
        box-shadow: 0 10px 24px rgba(15,76,74,0.25);
    }
    .pc-cta .pc-btn:hover { background: #0a3836; color: #fff; }

    /* ========== FOOTER SOCIAL / ABOUT ========== */
    .pc-footer {
        background: var(--teal);
        color: #fff;
        padding: 3.5rem 0 2rem;
        border-radius: 2.5rem 2.5rem 0 0;
        margin-top: 1rem;
    }
    .pc-footer-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr;
        gap: 2rem;
        margin-bottom: 2.5rem;
    }
    .pc-footer h4 {
        margin: 0 0 0.85rem;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.55);
    }
    .pc-footer p {
        margin: 0;
        font-size: 0.92rem;
        line-height: 1.65;
        color: rgba(255,255,255,0.75);
        max-width: 28rem;
    }
    .pc-footer a {
        color: rgba(255,255,255,0.85);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
    }
    .pc-footer a:hover { color: #fff; }
    .pc-socials {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
    }
    .pc-social {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.7rem 1.1rem;
        border-radius: 999px;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.15);
        color: #fff !important;
        font-size: 0.78rem !important;
        font-weight: 700 !important;
        letter-spacing: 0.04em;
        transition: background 0.2s ease, transform 0.2s ease;
    }
    .pc-social:hover {
        background: rgba(255,255,255,0.18);
        transform: translateY(-2px);
        color: #fff !important;
    }
    .pc-social svg { width: 1.1rem; height: 1.1rem; }
    .pc-footer-bottom {
        border-top: 1px solid rgba(255,255,255,0.12);
        padding-top: 1.25rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.75rem;
        font-size: 0.75rem;
        color: rgba(255,255,255,0.45);
    }

    .pc-empty {
        padding: 2.25rem; text-align: center; border: 1px dashed rgba(28,43,42,0.15);
        border-radius: 1.15rem; color: var(--soft); font-size: 0.75rem; font-weight: 700;
        letter-spacing: 0.1em; text-transform: uppercase; background: rgba(255,255,255,0.4);
    }

    .pc-link {
        font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase;
        color: var(--teal); text-decoration: none;
    }
    .pc-link:hover { color: var(--teal-mid); }

    .pc-section-head {
        display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between;
        gap: 1rem; margin-bottom: 1.5rem;
    }
    .pc-section-head h2 {
        margin: 0.35rem 0 0; font-size: clamp(1.7rem, 3vw, 2.2rem);
    }

    @media (max-width: 960px) {
        .pc-hero-shell { grid-template-columns: 1fr; min-height: auto; }
        .pc-hero-side { display: none; }
        .pc-pops-grid { grid-template-columns: repeat(2, 1fr); }
        .pc-split, .pc-about-grid, .pc-footer-grid { grid-template-columns: 1fr; }
        .pc-gallery { grid-template-columns: repeat(2, 1fr); }
        .pc-stories, .pc-results { grid-template-columns: 1fr; }
    }
    @media (max-width: 560px) {
        .pc-pops-grid { grid-template-columns: 1fr 1fr; gap: 0.75rem; }
        .pc-search { flex-direction: column; border-radius: 1.1rem; }
        .pc-search button { width: 100%; }
        .pc-match { grid-template-columns: 1fr; }
    }

    /* Tour */
    #vim-tour-overlay { position: fixed; inset: 0; z-index: 50000; pointer-events: none; opacity: 0; visibility: hidden; transition: opacity 0.25s ease, visibility 0.25s ease; }
    #vim-tour-overlay.active { opacity: 1; visibility: visible; }
    #vim-tour-backdrop { position: absolute; inset: 0; background: rgba(15, 40, 38, 0.78); pointer-events: auto; }
    #vim-tour-spotlight { position: absolute; width: 100px; height: 100px; border-radius: 9999px; border: 2px solid rgba(232,168,124,0.9); box-shadow: 0 0 30px rgba(232,168,124,0.35); pointer-events: none; transform: translate(-50%, -50%); transition: left 0.45s ease, top 0.45s ease, width 0.35s ease, height 0.35s ease; }
    #vim-tour-card { position: fixed; width: min(360px, calc(100vw - 32px)); background: var(--paper); color: var(--ink); border: 1px solid var(--line); border-radius: 1.25rem; padding: 1.3rem; box-shadow: 0 24px 60px rgba(0,0,0,0.25); z-index: 50002; pointer-events: auto; }
    .vim-tour-eyebrow { font-size: 0.65rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--teal-mid); margin-bottom: 0.35rem; }
