<script>
/* =========================================================
   VIM AI — LOCAL KNOWLEDGE ASSISTANT
   ========================================================= */

(function() {

    const panel = document.getElementById('vim-ai-panel');
    const input = document.getElementById('vim-ai-input');
    const messages = document.getElementById('vim-ai-messages');

    // Always expose a toggle so the button never "does nothing"
    window.toggleVimAI = function(forceState) {
        if (!panel) return;
        const open = typeof forceState === 'boolean' ? forceState : !panel.classList.contains('active');
        panel.classList.toggle('active', open);
        if (open && input) setTimeout(() => { try { input.focus(); } catch(e) {} }, 180);
    };

    if (!panel || !input || !messages) {
        console.warn('VIM AI: panel elements missing');
        return;
    }


    /* ---------------------------------------------------------
       KNOWLEDGE BASE + LIVE MARKET BRAIN
       --------------------------------------------------------- */

    const SYNONYMS = {
        'budgt': 'budget', 'budjet': 'budget', 'mony': 'money', 'cash': 'budget',
        'rosters': 'roster', 'sqaud': 'squad', 'team': 'roster',
        'out bided': 'outbid', 'outbidded': 'outbid', 'outbiden': 'outbid',
        'widraw': 'withdraw', 'withraw': 'withdraw', 'widthdraw': 'withdraw',
        'bidd': 'bid', 'biding': 'bidding', 'auciton': 'auction', 'aution': 'auction',
        'recomend': 'recommend', 'reccomend': 'recommend', 'suggst': 'suggest',
        'forwards': 'fwd', 'strikers': 'fwd', 'strikers': 'fwd', 'attackers': 'fwd',
        'midfielders': 'mid', 'mids': 'mid', 'defenders': 'def', 'cbs': 'def',
        'goalkeepers': 'gk', 'keepers': 'gk', 'glk': 'gk',
        'superstar': 'ss', 's class': 's', 'a class': 'a',
        'eligable': 'eligible', 'ilegal': 'illegal', 'cant': "can't",
        'watlist': 'watchlist', 'wathclist': 'watchlist',
        'cheep': 'cheap', 'cheapest': 'cheap', 'bargain': 'cheap',
        'expensive': 'top', 'best': 'recommend', 'who should': 'recommend',
        'what should': 'recommend', 'who do i': 'recommend', 'pick': 'recommend',
        'target': 'recommend', 'go for': 'recommend', 'sign': 'recommend'
    };

    function normalizeQuestion(q) {
        let n = String(q || '')
            .toLowerCase()
            .replace(/[?!.,;:'"]+/g, ' ')
            .replace(/\s+/g, ' ')
            .trim();
        Object.keys(SYNONYMS).forEach(bad => {
            if (n.includes(bad)) n = n.replace(new RegExp(bad, 'g'), SYNONYMS[bad]);
        });
        return n;
    }

    function fuzzyIncludes(hay, needle) {
        if (!needle) return false;
        if (hay.includes(needle)) return true;
        // allow missing 1 char for short words / typo tolerance
        if (needle.length >= 4) {
            const parts = needle.split(' ');
            return parts.every(p => p.length < 3 || hay.includes(p) || hay.split(' ').some(h => {
                if (Math.abs(h.length - p.length) > 2) return false;
                let miss = 0;
                for (let i = 0, j = 0; i < h.length && j < p.length; ) {
                    if (h[i] === p[j]) { i++; j++; }
                    else { miss++; i++; if (miss > 1) return false; }
                }
                return miss <= 1;
            }));
        }
        return false;
    }

    const knowledgeBase = [
        {
            keywords: ['market', 'player market', 'scout', 'player card', 'cards', 'browse players'],
            response: `The <strong>Player Market</strong> is where every verified free agent lives. Open a card to see class (SS/S/A/B/C), position, stats, highest bid, and (if you're a manager) place bids.<br><br><a href="/market">Open Player Market →</a>`
        },
        {
            keywords: ['auction', 'bidding', 'how auction works', 'how does auction', 'franchise auction'],
            response: `<strong>Auction basics</strong><br>
            • Only assigned <strong>team managers</strong> can bid while the auction is <strong>LIVE</strong>.<br>
            • Bids lock budget. You only pay at the end if you still hold the highest bid.<br>
            • Class caps tighten if you take 2 SS (S/A limits drop).<br>
            • Your manager account already occupies 1 roster slot + their class.<br>
            • You must still be able to reach the <strong>minimum roster</strong> after any bid.<br>
            • Outbid money stays locked until you raise, they withdraw, or admin force-drops.<br><br>
            Ask me things like “who should I buy”, “cheap SS mid”, “my budget”, “why can't I bid”.`
        },
        {
            keywords: ['withdraw', 'withdrawal', 'take back bid', 'cancel bid', 'remove bid'],
            response: `<strong>Withdraw rules</strong><br>
            • You <em>can</em> withdraw only if <strong>nobody bid after you</strong> on that player.<br>
            • If someone outbid you, your amount stays <strong>locked</strong> (you can't withdraw it).<br>
            • Raise to a new highest amount to replace your old bid on that player.<br>
            • Locked money frees if the higher bidder withdraws or admin force-drops.`
        },
        {
            keywords: ['reserve', 'reserve price', 'minimum bid', 'starting price', 'increment', 'bid step'],
            response: `<strong>Reserves & increments</strong><br>
            Typical class reserves: SS higher, then S, A, B, C lowest.<br>
            Bids must clear the current high (or reserve) and land on valid increment steps (tiers like 100 / 250 / 500 depending on price). The bid box on a player card shows the next legal amount.`
        },
        {
            keywords: ['class', 'rank', 'ss', 's class', 'rating', 'tier'],
            response: `Player <strong>class/rank</strong> is SS, S, A, B, or C. Caps depend on how many SS you already hold (including if your manager is SS). Taking a 2nd SS tightens S and A limits. Caps are enforced live on every bid.`
        },
        {
