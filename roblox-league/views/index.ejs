<%- include('partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --bg: #f3f1ec;
        --paper: #fffcf7;
        --ink: #1a1a1a;
        --soft: #6b6560;
        --line: rgba(26, 26, 26, 0.08);
        --accent: #1d4ed8;
        --accent-soft: #dbeafe;
    }

    body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: 'Outfit', system-ui, sans-serif;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
    }

    .ed {
        padding-top: 5.5rem;
    }

    .ed-wrap {
        width: min(1120px, calc(100% - 2.5rem));
        margin: 0 auto;
    }

    .ed-label {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--soft);
    }

    .ed-serif {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 0.95;
    }

    /* ===== HERO SHELL ===== */
    .ed-hero {
        padding: 1.25rem 0 0;
    }

    .ed-hero-frame {
        position: relative;
        border-radius: 1.75rem;
        overflow: hidden;
        min-height: min(78vh, 760px);
        background:
            linear-gradient(180deg, rgba(20,18,16,0.15) 0%, rgba(20,18,16,0.25) 40%, rgba(20,18,16,0.72) 100%),
            url('/images/vimgfx.png') center center / cover no-repeat;
        color: #fff;
        display: flex;
        align-items: flex-end;
        box-shadow: 0 30px 80px rgba(26, 26, 26, 0.12);
    }

    .ed-hero-content {
        position: relative;
        z-index: 2;
        width: 100%;
        padding: 2.5rem 2.25rem 3rem;
        max-width: 820px;
    }

    .ed-hero-content .ed-label {
        color: rgba(255,255,255,0.7);
        margin-bottom: 1rem;
    }

    .ed-hero h1 {
        margin: 0 0 1.25rem;
        font-size: clamp(3.2rem, 9vw, 6.2rem);
        color: #fff;
    }

    .ed-hero h1 span {
        display: block;
        font-style: italic;
        font-weight: 500;
        opacity: 0.92;
    }

    .ed-hero-lead {
        max-width: 28rem;
        margin: 0 0 1.75rem;
        font-size: 1.02rem;
        font-weight: 400;
        line-height: 1.65;
        color: rgba(255,255,255,0.78);
    }

    .ed-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
        margin-bottom: 1.75rem;
    }

    .ed-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.9rem 1.35rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
    }

    .ed-btn:hover { transform: translateY(-1px); }

    .ed-btn-solid {
        background: #fff;
        color: var(--ink);
    }

    .ed-btn-solid:hover { background: #f5f5f5; color: var(--ink); }

    .ed-btn-line {
        border: 1px solid rgba(255,255,255,0.35);
        color: #fff;
        background: rgba(255,255,255,0.06);
        backdrop-filter: blur(6px);
    }

    .ed-btn-line:hover { background: rgba(255,255,255,0.14); color: #fff; }

    /* Search floating under hero text */
    .ed-search {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        max-width: 420px;
        padding: 0.4rem;
        border-radius: 999px;
        background: rgba(255,255,255,0.95);
        box-shadow: 0 16px 40px rgba(0,0,0,0.18);
        position: relative;
    }

    .ed-search input {
        flex: 1;
        min-width: 0;
        border: 0;
        outline: none;
        background: transparent;
        padding: 0.75rem 1rem;
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--ink);
    }

    .ed-search button {
        border: 0;
        border-radius: 999px;
        padding: 0.75rem 1.1rem;
        background: var(--ink);
        color: #fff;
        font-family: inherit;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        cursor: pointer;
    }

    #search-results-dropdown {
        position: absolute;
        left: 0; right: 0;
        top: calc(100% + 0.55rem);
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 1.1rem;
        box-shadow: 0 20px 50px rgba(26,26,26,0.14);
        padding: 0.85rem;
        max-height: 22rem;
        overflow-y: auto;
        z-index: 30;
        text-align: left;
        color: var(--ink);
    }

    /* ===== INTRO BAND ===== */
    .ed-intro {
        padding: 4.5rem 0 2rem;
        display: grid;
        grid-template-columns: 1fr 1.15fr;
        gap: 3rem;
        align-items: end;
    }

    .ed-intro h2 {
        margin: 0.6rem 0 0;
        font-size: clamp(2.2rem, 4.5vw, 3.4rem);
        max-width: 12ch;
    }

    .ed-intro p {
        margin: 0;
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--soft);
        font-weight: 400;
        max-width: 34rem;
    }

    @media (max-width: 800px) {
        .ed-intro { grid-template-columns: 1fr; gap: 1.25rem; }
    }

    /* ===== MATCH FEATURE ===== */
    .ed-block {
        padding: 2.5rem 0;
    }

    .ed-block-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .ed-block-head h3 {
        margin: 0.35rem 0 0;
        font-size: clamp(1.8rem, 3vw, 2.4rem);
    }

    .ed-link {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid rgba(26,26,26,0.25);
        padding-bottom: 0.15rem;
    }

    .ed-link:hover { border-color: var(--ink); color: var(--ink); }

    .ed-match-card {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 1.5rem;
        padding: 1.75rem 1.5rem;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 1.25rem;
        align-items: center;
        box-shadow: 0 12px 40px rgba(26,26,26,0.04);
    }

    .ed-team {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.7rem;
        text-align: center;
    }

    .ed-team img {
        width: 4rem;
        height: 4rem;
        object-fit: contain;
    }

    .ed-team span {
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .ed-vs {
        text-align: center;
        padding: 0 0.5rem;
    }

    .ed-vs strong {
        display: block;
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.75rem;
        font-weight: 600;
        font-style: italic;
    }

    .ed-vs small {
        display: block;
        margin-top: 0.35rem;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--soft);
    }

    /* Stream */
    .ed-stream {
        margin-top: 1.25rem;
        border-radius: 1.5rem;
        overflow: hidden;
        background: #141210;
        min-height: 300px;
        border: 1px solid var(--line);
    }

    .ed-stream iframe {
        width: 100%;
        min-height: 320px;
        border: 0;
        display: block;
    }

    .ed-stream-empty {
        min-height: 280px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,0.45);
        gap: 0.4rem;
        text-align: center;
        padding: 2rem;
    }

    .ed-stream-empty strong {
        color: rgba(255,255,255,0.85);
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.5rem;
        font-weight: 600;
    }

    /* ===== STEPS ===== */
    .ed-steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.15rem;
    }

    .ed-step {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 1.35rem;
        padding: 1.75rem 1.5rem;
        min-height: 180px;
    }

    .ed-step-num {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2rem;
        font-weight: 600;
        font-style: italic;
        color: rgba(26,26,26,0.28);
        margin-bottom: 1rem;
    }

    .ed-step h4 {
        margin: 0 0 0.55rem;
        font-size: 1.15rem;
        font-weight: 600;
    }

    .ed-step p {
        margin: 0;
        font-size: 0.92rem;
        line-height: 1.65;
        color: var(--soft);
        font-weight: 400;
    }

    @media (max-width: 800px) {
        .ed-steps { grid-template-columns: 1fr; }
        .ed-match-card { grid-template-columns: 1fr; gap: 1rem; }
    }

    /* ===== RESULTS ===== */
    .ed-results {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.9rem;
    }

    @media (max-width: 700px) {
        .ed-results { grid-template-columns: 1fr; }
    }

    .ed-result {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        padding: 1.15rem 1.25rem;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 1.15rem;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .ed-result:hover {
        border-color: rgba(26,26,26,0.2);
        transform: translateY(-2px);
        color: inherit;
    }

    .ed-result-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .ed-result-team {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        min-width: 0;
    }

    .ed-result-team img {
        width: 1.55rem;
        height: 1.55rem;
        object-fit: contain;
    }

    .ed-result-team span {
        font-size: 0.82rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ed-result-score {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.35rem;
        font-weight: 600;
    }

    .ed-result-score.dim { color: var(--soft); }

    /* ===== STORIES GALLERY ===== */
    .ed-stories {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr;
        gap: 0.9rem;
    }

    .ed-story {
        position: relative;
        border-radius: 1.25rem;
        overflow: hidden;
        min-height: 260px;
        background: #ddd;
        display: block;
        text-decoration: none;
        color: #fff;
    }

    .ed-story:first-child { min-height: 420px; grid-row: span 2; }

    .ed-story img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        position: absolute;
        inset: 0;
        transition: transform 0.5s ease;
    }

    .ed-story:hover img { transform: scale(1.04); }

    .ed-story-shade {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,0.72) 100%);
    }

    .ed-story-text {
        position: absolute;
        left: 0; right: 0; bottom: 0;
        padding: 1.25rem 1.3rem;
        z-index: 2;
    }

    .ed-story-text small {
        display: block;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.75;
        margin-bottom: 0.35rem;
    }

    .ed-story-text strong {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.45rem;
        font-weight: 600;
        line-height: 1.15;
        display: block;
    }

    @media (max-width: 900px) {
        .ed-stories { grid-template-columns: 1fr; }
        .ed-story:first-child { min-height: 300px; grid-row: auto; }
        .ed-story { min-height: 220px; }
    }

    /* ===== CTA ===== */
    .ed-cta {
        margin: 3rem 0 5rem;
        border-radius: 1.75rem;
        padding: 3.5rem 2rem;
        text-align: center;
        background: var(--paper);
        border: 1px solid var(--line);
    }

    .ed-cta h3 {
        margin: 0 0 0.85rem;
        font-size: clamp(2rem, 4vw, 3rem);
    }

    .ed-cta p {
        margin: 0 auto 1.75rem;
        max-width: 26rem;
        color: var(--soft);
        font-size: 1rem;
        line-height: 1.65;
    }

    .ed-cta .ed-btn-solid {
        background: var(--ink);
        color: #fff;
    }

    .ed-cta .ed-btn-solid:hover {
        background: #333;
        color: #fff;
    }

    .ed-empty {
        padding: 2.5rem;
        text-align: center;
        border: 1px dashed rgba(26,26,26,0.15);
        border-radius: 1.25rem;
        color: var(--soft);
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        background: rgba(255,255,255,0.4);
    }

    /* Tour — keep working */
    #vim-tour-overlay { position: fixed; inset: 0; z-index: 50000; pointer-events: none; opacity: 0; visibility: hidden; transition: opacity 0.25s ease, visibility 0.25s ease; }
    #vim-tour-overlay.active { opacity: 1; visibility: visible; }
    #vim-tour-backdrop { position: absolute; inset: 0; background: rgba(20,18,16,0.72); pointer-events: auto; }
    #vim-tour-spotlight { position: absolute; width: 100px; height: 100px; border-radius: 9999px; border: 2px solid rgba(255,255,255,0.85); box-shadow: 0 0 0 4px rgba(255,255,255,0.12), 0 0 40px rgba(0,0,0,0.25); pointer-events: none; transform: translate(-50%, -50%); transition: left 0.45s cubic-bezier(0.16,1,0.3,1), top 0.45s cubic-bezier(0.16,1,0.3,1), width 0.35s ease, height 0.35s ease; }
    #vim-tour-card { position: fixed; width: min(360px, calc(100vw - 32px)); background: var(--paper); color: var(--ink); border: 1px solid var(--line); border-radius: 1.25rem; padding: 1.35rem; box-shadow: 0 24px 60px rgba(0,0,0,0.2); z-index: 50002; pointer-events: auto; }
    #vim-tour-card.centered::before { display: none; }
    .vim-tour-eyebrow { font-size: 0.65rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--soft); margin-bottom: 0.4rem; }
    .vim-tour-title { font-family: 'Cormorant Garamond', serif; font-size: 1.55rem; font-weight: 600; line-height: 1.15; margin-bottom: 0.45rem; }
    .vim-tour-description { color: var(--soft); font-size: 0.88rem; line-height: 1.6; margin-bottom: 1rem; }
    .vim-tour-progress { display: flex; gap: 5px; margin-bottom: 1rem; }
    .vim-tour-progress span { height: 3px; width: 18px; border-radius: 999px; background: #e5e2dc; }
    .vim-tour-progress span.active { width: 28px; background: var(--ink); }
    .vim-tour-actions { display: flex; justify-content: space-between; align-items: center; }
    .vim-tour-skip { border: none; background: transparent; color: var(--soft); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.5rem; cursor: pointer; }
    .vim-tour-next { border: none; background: var(--ink); color: #fff; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.7rem 1rem; border-radius: 999px; cursor: pointer; }
    #vim-tour-launcher { position: fixed; right: 1.15rem; bottom: 1.15rem; width: 2.5rem; height: 2.5rem; border-radius: 999px; background: var(--ink); color: #fff; border: 0; z-index: 40000; font-weight: 600; cursor: pointer; box-shadow: 0 10px 24px rgba(0,0,0,0.18); }

    @media (max-width: 640px) {
        .ed-hero-content { padding: 1.75rem 1.35rem 2.25rem; }
        .ed-search { max-width: none; flex-direction: column; border-radius: 1.1rem; }
        .ed-search button { width: 100%; }
        #vim-tour-card { bottom: 1.15rem !important; top: auto !important; left: 1rem !important; width: calc(100vw - 2rem); }
    }
</style>

<div class="ed">

<div id="vim-tour-overlay" aria-hidden="true">
    <div id="vim-tour-backdrop"></div>
    <div id="vim-tour-spotlight"></div>
    <div id="vim-tour-card">
        <div class="vim-tour-eyebrow" id="vim-tour-eyebrow">VIM SUPER LEAGUE</div>
        <div class="vim-tour-title" id="vim-tour-title">Welcome</div>
        <div class="vim-tour-description" id="vim-tour-description">A quick look around the league.</div>
        <div class="vim-tour-progress" id="vim-tour-progress"></div>
        <div class="vim-tour-actions">
            <button type="button" id="vim-tour-skip" class="vim-tour-skip">Skip</button>
            <button type="button" id="vim-tour-next" class="vim-tour-next">Next</button>
        </div>
    </div>
</div>
<button id="vim-tour-launcher" type="button" aria-label="Replay tutorial" title="Replay tutorial">?</button>

<section class="ed-hero">
    <div class="ed-wrap">
        <div class="ed-hero-frame">
            <div class="ed-hero-content">
                <div class="ed-label">VIM Super League</div>
                <h1 class="ed-serif">
                    Above
                    <span>the rest</span>
                </h1>
                <p class="ed-hero-lead">
                    Competitive Roblox football — fixtures, market, and matchday energy in one calm place.
                </p>
                <div class="ed-actions">
                    <a href="/market" class="ed-btn ed-btn-solid">Enter market</a>
                    <a href="/matches" class="ed-btn ed-btn-line">Fixtures</a>
                </div>
                <form id="search-form" action="/matches" method="GET" class="ed-search">
                    <input id="live-search-input" name="q" type="text" placeholder="Search teams, players, matches…" autocomplete="off">
                    <button type="submit" id="search-btn">Search</button>
                    <div id="search-results-dropdown" class="hidden"></div>
                </form>
            </div>
        </div>
    </div>
</section>

<section class="ed-wrap ed-intro">
    <div>
        <div class="ed-label">The league</div>
        <h2 class="ed-serif">Built for managers who care about the details</h2>
    </div>
    <p>
        Track upcoming fixtures, browse the player market, and stay close to results — without the noise. Everything on this page is live from the league system.
    </p>
</section>

<section class="ed-wrap ed-block">
    <div class="ed-block-head">
        <div>
            <div class="ed-label">Schedule</div>
            <h3 class="ed-serif" id="tour-featured-match">Upcoming match</h3>
        </div>
        <a href="/matches" class="ed-link">All fixtures</a>
    </div>

    <% const matchList = (typeof matches !== 'undefined' && matches) ? matches : []; %>
    <% let nextMatch = matchList.find(m => m.status === 'upcoming'); %>

    <% if (nextMatch) { %>
        <div class="ed-match-card">
            <div class="ed-team">
                <img src="<%= nextMatch.logoA %>" alt="">
                <span><%= nextMatch.teamA %></span>
            </div>
            <div class="ed-vs">
                <strong>vs</strong>
                <small><%= nextMatch.time || 'Time TBC' %></small>
            </div>
            <div class="ed-team">
                <img src="<%= nextMatch.logoB %>" alt="">
                <span><%= nextMatch.teamB %></span>
            </div>
        </div>
    <% } else { %>
        <div class="ed-empty">No upcoming match scheduled</div>
    <% } %>

    <div class="ed-stream">
        <% if (typeof liveLink !== 'undefined' && liveLink && String(liveLink).trim() !== '') { %>
            <%
                let embedLink = liveLink;
                if (liveLink.includes('watch?v=')) embedLink = liveLink.replace('watch?v=', 'embed/').split('&')[0];
                else if (liveLink.includes('youtu.be/')) embedLink = liveLink.replace('youtu.be/', 'youtube.com/embed/').split('?')[0];
            %>
            <iframe src="<%= embedLink %>" allowfullscreen title="Live stream"></iframe>
        <% } else { %>
            <div class="ed-stream-empty">
                <strong>Stream offline</strong>
                <span>Broadcast appears here when a match is live</span>
            </div>
        <% } %>
    </div>
</section>

<section class="ed-wrap ed-block">
    <div class="ed-block-head">
        <div>
            <div class="ed-label">Path in</div>
            <h3 class="ed-serif">How players join</h3>
        </div>
    </div>
    <div class="ed-steps">
        <div class="ed-step">
            <div class="ed-step-num">01</div>
            <h4>Join the room</h4>
            <p>Start in Discord. Meet managers, learn the tone of the league, and get oriented.</p>
        </div>
        <div class="ed-step">
            <div class="ed-step-num">02</div>
            <h4>Register your card</h4>
            <p>Build a clean profile in the market — position, identity, the basics teams actually read.</p>
        </div>
        <div class="ed-step">
            <div class="ed-step-num">03</div>
            <h4>Get signed & play</h4>
            <p>Auction or signings put you on a roster. Fixtures and results follow from there.</p>
        </div>
    </div>
</section>

<section class="ed-wrap ed-block" id="tour-results">
    <div class="ed-block-head">
        <div>
            <div class="ed-label">Scoreboard</div>
            <h3 class="ed-serif">Recent results</h3>
        </div>
        <a href="/matches" class="ed-link">Full list</a>
    </div>
    <div class="ed-results">
        <%
            const recent = matchList
                .filter(m => m.status === 'completed' || m.status === 'complete' || (m.details && (m.details.goalsA != null || m.details.goalsB != null)))
                .slice(-8)
                .reverse();
        %>
        <% if (recent.length) { %>
            <% recent.forEach(r => { %>
                <a class="ed-result" href="/match/<%= r._id || r.id || '' %>">
                    <div class="ed-result-row">
                        <div class="ed-result-team">
                            <img src="<%= r.logoA %>" alt="">
                            <span><%= r.teamA %></span>
                        </div>
                        <span class="ed-result-score"><%= (r.details && r.details.goalsA != null) ? r.details.goalsA : 0 %></span>
                    </div>
                    <div class="ed-result-row">
                        <div class="ed-result-team">
                            <img src="<%= r.logoB %>" alt="">
                            <span style="color:var(--soft)"><%= r.teamB %></span>
                        </div>
                        <span class="ed-result-score dim"><%= (r.details && r.details.goalsB != null) ? r.details.goalsB : 0 %></span>
                    </div>
                </a>
            <% }) %>
        <% } else { %>
            <div class="ed-empty" style="grid-column:1/-1">No results posted yet</div>
        <% } %>
    </div>
</section>

<section class="ed-wrap ed-block">
    <div class="ed-block-head">
        <div>
            <div class="ed-label">Journal</div>
            <h3 class="ed-serif">Stories from the league</h3>
        </div>
    </div>
    <div class="ed-stories">
        <% if (typeof stories !== 'undefined' && stories && stories.length) { %>
            <% stories.slice().reverse().slice(0, 5).forEach((story, i) => { %>
                <div class="ed-story">
                    <% if (story.image) { %>
                        <img src="<%= story.image %>" alt="">
                    <% } %>
                    <div class="ed-story-shade"></div>
                    <div class="ed-story-text">
                        <small><%= story.date || 'Article' %></small>
                        <strong><%= story.title %></strong>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="ed-empty" style="grid-column:1/-1">Stories will appear here</div>
        <% } %>
    </div>
</section>

<section class="ed-wrap">
    <div class="ed-cta">
        <div class="ed-label" style="margin-bottom:0.75rem">Market</div>
        <h3 class="ed-serif">Ready when you are</h3>
        <p>Open the player market, set up your card, or browse who’s available for the next window.</p>
        <a href="/market" class="ed-btn ed-btn-solid">Go to market</a>
    </div>
</section>

</div>

<script>
(function () {
    const overlay = document.getElementById('vim-tour-overlay');
    const backdrop = document.getElementById('vim-tour-backdrop');
    const spotlight = document.getElementById('vim-tour-spotlight');
    const card = document.getElementById('vim-tour-card');
    const eyebrow = document.getElementById('vim-tour-eyebrow');
    const title = document.getElementById('vim-tour-title');
    const description = document.getElementById('vim-tour-description');
    const progress = document.getElementById('vim-tour-progress');
    const nextButton = document.getElementById('vim-tour-next');
    const skipButton = document.getElementById('vim-tour-skip');
    const launcher = document.getElementById('vim-tour-launcher');
    if (!overlay || !spotlight || !card) return;

    const tourSteps = [
        { selector: '[data-tour="market"]', mobileSelector: '[data-tour="market-mobile"]', eyebrow: 'MARKET', title: 'Player market', description: 'Browse cards, stats and registration.' },
        { selector: '[data-tour="matches"]', mobileSelector: '[data-tour="matches-mobile"]', eyebrow: 'MATCHES', title: 'Fixtures', description: 'Upcoming and completed games.' },
        { selector: '#live-search-input', eyebrow: 'SEARCH', title: 'Find anything', description: 'Teams, players or matches from here.' },
        { selector: '#tour-featured-match', eyebrow: 'SCHEDULE', title: 'Next match', description: 'The featured upcoming fixture.' },
        { selector: '#tour-results', eyebrow: 'RESULTS', title: 'Recent scores', description: 'Latest completed matches.' }
    ];
    let currentStep = 0;
    function isMobileLayout() { return window.innerWidth < 1280; }
    function getTarget(step) {
        let t = null;
        if (isMobileLayout() && step.mobileSelector) t = document.querySelector(step.mobileSelector);
        if (!t && step.selector) t = document.querySelector(step.selector);
        return t;
    }
    function createProgress() {
        progress.innerHTML = '';
        tourSteps.forEach((_, i) => {
            const d = document.createElement('span');
            if (i === currentStep) d.classList.add('active');
            progress.appendChild(d);
        });
    }
    function positionTourCard(target) {
        const margin = 16, cardWidth = Math.min(360, window.innerWidth - 32);
        card.style.width = cardWidth + 'px';
        if (window.innerWidth <= 640) {
            card.classList.add('centered');
            card.style.left = '16px'; card.style.top = 'auto'; card.style.bottom = '20px';
            return;
        }
        card.classList.remove('centered');
        const rect = target.getBoundingClientRect();
        let left = rect.left, top = rect.bottom + 22;
        if (left + cardWidth > window.innerWidth - margin) left = window.innerWidth - cardWidth - margin;
        if (left < margin) left = margin;
        if (top + 200 > window.innerHeight - margin) {
            top = Math.max(margin, rect.top - 200 - 22);
            card.classList.add('centered');
        }
        card.style.left = left + 'px'; card.style.top = top + 'px'; card.style.bottom = 'auto';
    }
    function moveSpotlight(target) {
        const rect = target.getBoundingClientRect();
        const pad = window.innerWidth <= 640 ? 10 : 9;
        spotlight.style.left = (rect.left + rect.width / 2) + 'px';
        spotlight.style.top = (rect.top + rect.height / 2) + 'px';
        spotlight.style.width = (Math.max(rect.width, 55) + pad * 2) + 'px';
        spotlight.style.height = (Math.max(rect.height, 45) + pad * 2) + 'px';
    }
    function showStep(index) {
        currentStep = index;
        const step = tourSteps[currentStep];
        const target = getTarget(step);
        if (!target) {
            if (currentStep < tourSteps.length - 1) showStep(currentStep + 1);
            else finishTour();
            return;
        }
        if (isMobileLayout() && step.mobileSelector) {
            const m = document.getElementById('mobile-menu');
            if (m && !m.classList.contains('active')) m.classList.add('active');
        }
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => { moveSpotlight(target); positionTourCard(target); }, 120);
        eyebrow.textContent = step.eyebrow;
        title.textContent = step.title;
        description.textContent = step.description;
        createProgress();
        nextButton.textContent = currentStep === tourSteps.length - 1 ? 'Done' : 'Next';
    }
    function startTour() {
        overlay.classList.add('active');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        showStep(0);
    }
    function finishTour() {
        overlay.classList.remove('active');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        localStorage.setItem('vim_home_tour_seen', 'true');
        const m = document.getElementById('mobile-menu');
        if (m) m.classList.remove('active');
    }
    nextButton.addEventListener('click', () => {
        if (currentStep >= tourSteps.length - 1) finishTour();
        else showStep(currentStep + 1);
    });
    skipButton.addEventListener('click', finishTour);
    backdrop.addEventListener('click', finishTour);
    launcher.addEventListener('click', startTour);
    document.addEventListener('keydown', (e) => {
        if (!overlay.classList.contains('active')) return;
        if (e.key === 'Escape') finishTour();
        if (e.key === 'ArrowRight' && currentStep < tourSteps.length - 1) showStep(currentStep + 1);
        if (e.key === 'ArrowLeft' && currentStep > 0) showStep(currentStep - 1);
    });
    if (!localStorage.getItem('vim_home_tour_seen')) setTimeout(startTour, 900);
})();
</script>

<script>
    const localMatches = <%- JSON.stringify(typeof matches !== 'undefined' ? matches : []) %>;
    const localPlayers = <%- typeof players !== 'undefined' ? JSON.stringify(players) : '[]' %>;
    const searchInput = document.getElementById('live-search-input');
    const dropdown = document.getElementById('search-results-dropdown');
    const searchForm = document.getElementById('search-form');
    let debounceTimer, topTargetUrl = '';

    searchInput.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        const query = e.target.value.trim().toLowerCase();
        if (query.length < 1) { dropdown.classList.add('hidden'); dropdown.innerHTML = ''; topTargetUrl = ''; return; }
        debounceTimer = setTimeout(() => {
            fetch(`/api/search?q=${encodeURIComponent(query)}`)
                .then(res => res.ok ? res.json() : Promise.reject())
                .then(data => renderSearchResults(data, query))
                .catch(() => {
                    renderSearchResults({
                        matches: localMatches.filter(m => (m.teamA && m.teamA.toLowerCase().includes(query)) || (m.teamB && m.teamB.toLowerCase().includes(query))),
                        players: localPlayers.filter(p => (p.name && p.name.toLowerCase().includes(query)) || (p.role && p.role.toLowerCase().includes(query)))
                    }, query);
                });
        }, 150);
    });

    function renderSearchResults(data, query) {
        const { players, matches } = data;
        let html = '';
        topTargetUrl = '';
        if ((!matches || !matches.length) && (!players || !players.length)) {
            dropdown.innerHTML = '<div style="padding:1rem;text-align:center;color:#6b6560;font-size:0.8rem;">No results</div>';
            dropdown.classList.remove('hidden');
            return;
        }
        if (matches && matches.length) {
            if (!topTargetUrl) topTargetUrl = `/match/${matches[0]._id || matches[0].id || ''}`;
            html += '<div style="font-size:0.65rem;letter-spacing:0.12em;text-transform:uppercase;color:#6b6560;margin-bottom:0.4rem;">Matches</div>';
            matches.forEach(m => {
                const url = (m._id || m.id) ? `/match/${m._id || m.id}` : `/matches?q=${encodeURIComponent(query)}`;
                html += `<a href="${url}" style="display:block;padding:0.5rem 0.25rem;text-decoration:none;color:#1a1a1a;font-size:0.85rem;font-weight:500;">${m.teamA} vs ${m.teamB}</a>`;
            });
        }
        if (players && players.length) {
            if (!topTargetUrl) topTargetUrl = (players[0]._id || players[0].id) ? `/player/${players[0]._id || players[0].id}` : '/market';
            html += '<div style="font-size:0.65rem;letter-spacing:0.12em;text-transform:uppercase;color:#6b6560;margin:0.6rem 0 0.4rem;">Players</div>';
            players.forEach(p => {
                const url = (p._id || p.id) ? `/player/${p._id || p.id}` : `/market?search=${encodeURIComponent(p.name)}`;
                html += `<a href="${url}" style="display:block;padding:0.5rem 0.25rem;text-decoration:none;color:#1a1a1a;font-size:0.85rem;font-weight:500;">${p.name}</a>`;
            });
        }
        dropdown.innerHTML = html;
        dropdown.classList.remove('hidden');
    }

    searchForm.addEventListener('submit', (e) => {
        if (topTargetUrl) { e.preventDefault(); window.location.href = topTargetUrl; }
    });
    document.addEventListener('click', (e) => {
        if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) dropdown.classList.add('hidden');
    });
</script>
