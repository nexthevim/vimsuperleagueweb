<%- include('partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Syne:wght@700;800;900&display=swap" rel="stylesheet">

<style>
    :root {
        --vim-blue: #3b82f6;
        --vim-blue-bright: #60a5fa;
        --vim-surface: #0b1220;
        --vim-elevated: #111827;
        --vim-border: rgba(148, 163, 184, 0.12);
        --vim-muted: #94a3b8;
        --vim-text: #f1f5f9;
    }

    body {
        background: #060a12;
        color: var(--vim-text);
        font-family: 'Inter', system-ui, sans-serif;
        overflow-x: hidden;
        min-height: 100vh;
    }

    .home-wrap {
        background:
            radial-gradient(ellipse 90% 50% at 50% -10%, rgba(37, 99, 235, 0.18), transparent 55%),
            radial-gradient(ellipse 50% 40% at 100% 20%, rgba(14, 165, 233, 0.06), transparent 50%),
            #060a12;
    }

    .font-display { font-family: 'Syne', sans-serif; }

    .home-btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.875rem 1.5rem;
        border-radius: 0.75rem;
        background: #2563eb;
        color: #fff;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        transition: background 0.15s ease, transform 0.15s ease;
    }
    .home-btn-primary:hover { background: #1d4ed8; }

    .home-btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.875rem 1.5rem;
        border-radius: 0.75rem;
        background: transparent;
        color: #e2e8f0;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border: 1px solid rgba(148, 163, 184, 0.25);
        transition: border-color 0.15s ease, background 0.15s ease;
    }
    .home-btn-secondary:hover {
        border-color: rgba(96, 165, 250, 0.5);
        background: rgba(37, 99, 235, 0.08);
    }

    .home-panel {
        background: rgba(17, 24, 39, 0.85);
        border: 1px solid var(--vim-border);
        border-radius: 1rem;
    }

    .home-stat {
        padding: 1rem 1.25rem;
        border-right: 1px solid var(--vim-border);
    }
    .home-stat:last-child { border-right: none; }
    @media (max-width: 767px) {
        .home-stat {
            border-right: none;
            border-bottom: 1px solid var(--vim-border);
        }
        .home-stat:last-child { border-bottom: none; }
    }

    .home-search {
        background: rgba(15, 23, 42, 0.9);
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 0.875rem;
        transition: border-color 0.15s ease;
    }
    .home-search:focus-within {
        border-color: rgba(59, 130, 246, 0.55);
    }

    .home-link {
        color: #60a5fa;
        font-weight: 700;
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        transition: color 0.15s ease;
    }
    .home-link:hover { color: #93c5fd; }

    /* Tour — keep functional, restyle slightly for dark page */
    #vim-tour-overlay {
        position: fixed;
        inset: 0;
        z-index: 50000;
        pointer-events: none;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.25s ease, visibility 0.25s ease;
    }
    #vim-tour-overlay.active {
        opacity: 1;
        visibility: visible;
    }
    #vim-tour-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(2, 6, 23, 0.82);
        pointer-events: auto;
    }
    #vim-tour-spotlight {
        position: absolute;
        width: 100px;
        height: 100px;
        border-radius: 9999px;
        border: 2px solid rgba(96, 165, 250, 0.9);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12), 0 0 40px rgba(37, 99, 235, 0.25);
        pointer-events: none;
        transform: translate(-50%, -50%);
        transition: left 0.45s cubic-bezier(0.16, 1, 0.3, 1), top 0.45s cubic-bezier(0.16, 1, 0.3, 1), width 0.35s ease, height 0.35s ease;
    }
    #vim-tour-card {
        position: fixed;
        width: min(360px, calc(100vw - 32px));
        background: #111827;
        color: #f1f5f9;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 16px;
        padding: 22px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
        z-index: 50002;
        pointer-events: auto;
        transition: left 0.4s cubic-bezier(0.16, 1, 0.3, 1), top 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    #vim-tour-card::before {
        content: "";
        position: absolute;
        width: 12px;
        height: 12px;
        background: #111827;
        border-left: 1px solid rgba(148, 163, 184, 0.18);
        border-top: 1px solid rgba(148, 163, 184, 0.18);
        transform: rotate(45deg);
        top: -7px;
        left: 34px;
    }
    #vim-tour-card.centered::before { display: none; }
    .vim-tour-eyebrow {
        font-size: 9px;
        font-weight: 900;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #60a5fa;
        margin-bottom: 6px;
    }
    .vim-tour-title {
        font-family: 'Syne', sans-serif;
        font-size: 18px;
        font-weight: 900;
        line-height: 1.2;
        margin-bottom: 8px;
    }
    .vim-tour-description {
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.65;
        margin-bottom: 18px;
    }
    .vim-tour-progress {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 16px;
    }
    .vim-tour-progress span {
        height: 3px;
        width: 18px;
        border-radius: 999px;
        background: #1e293b;
        transition: all 0.2s ease;
    }
    .vim-tour-progress span.active {
        width: 28px;
        background: #3b82f6;
    }
    .vim-tour-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }
    .vim-tour-skip {
        border: none;
        background: transparent;
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 8px 4px;
        cursor: pointer;
    }
    .vim-tour-next {
        border: none;
        background: #2563eb;
        color: white;
        font-size: 10px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 11px 16px;
        border-radius: 10px;
        cursor: pointer;
    }
    #vim-tour-launcher {
        position: fixed;
        right: 20px;
        bottom: 20px;
        width: 40px;
        height: 40px;
        border-radius: 9999px;
        background: #1e293b;
        color: #e2e8f0;
        border: 1px solid rgba(148, 163, 184, 0.2);
        z-index: 40000;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 900;
        cursor: pointer;
        transition: background 0.15s ease;
    }
    #vim-tour-launcher:hover { background: #334155; }

    @media (max-width: 640px) {
        #vim-tour-card {
            bottom: 20px !important;
            top: auto !important;
            left: 16px !important;
            width: calc(100vw - 32px);
        }
        #vim-tour-card::before { display: none; }
        #vim-tour-launcher { right: 14px; bottom: 14px; }
    }

    @media (prefers-reduced-motion: reduce) {
        #vim-tour-spotlight, #vim-tour-card { transition: none !important; }
    }
</style>

<div class="home-wrap">

<!-- TOUR OVERLAY (unchanged behaviour) -->
<div id="vim-tour-overlay" aria-hidden="true">
    <div id="vim-tour-backdrop"></div>
    <div id="vim-tour-spotlight"></div>
    <div id="vim-tour-card">
        <div class="vim-tour-eyebrow" id="vim-tour-eyebrow">VIM SUPER LEAGUE</div>
        <div class="vim-tour-title" id="vim-tour-title">Welcome to VIMSL</div>
        <div class="vim-tour-description" id="vim-tour-description">Let's take a quick look around the league.</div>
        <div class="vim-tour-progress" id="vim-tour-progress"></div>
        <div class="vim-tour-actions">
            <button type="button" id="vim-tour-skip" class="vim-tour-skip">Skip Tour</button>
            <button type="button" id="vim-tour-next" class="vim-tour-next">Next →</button>
        </div>
    </div>
</div>

<button id="vim-tour-launcher" type="button" aria-label="Replay VIMSL tutorial" title="Replay VIMSL tutorial">?</button>

<!-- ========== 1. HERO ========== -->
<header class="relative pt-28 sm:pt-32 pb-16 sm:pb-20 px-5 sm:px-8">
    <div class="max-w-5xl mx-auto">
        <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-blue-400/90 mb-5">
            VIM Super League
        </p>
        <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-black text-white tracking-tight leading-[1.08] max-w-3xl">
            Competitive football.<br class="hidden sm:block">
            <span class="text-slate-400">Built for the next season.</span>
        </h1>
        <p class="mt-5 text-sm sm:text-[15px] text-slate-400 max-w-xl leading-relaxed font-medium">
            Fixtures, player market, and high-stakes league competition — one place to follow the season and step onto the pitch.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="/market" class="home-btn-primary">Enter player market</a>
            <a href="/matches" class="home-btn-secondary">View fixtures</a>
        </div>

        <!-- Search -->
        <div class="relative max-w-xl mt-10">
            <form id="search-form" action="/matches" method="GET" class="home-search flex items-center gap-2 p-2 pl-4">
                <svg class="w-4 h-4 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0a7 7 0 0114 0z"></path>
                </svg>
                <input
                    id="live-search-input"
                    name="q"
                    type="text"
                    placeholder="Search teams, players, matches…"
                    autocomplete="off"
                    class="flex-1 min-w-0 bg-transparent text-sm text-slate-200 placeholder-slate-500 font-medium focus:outline-none py-2"
                >
                <button type="submit" id="search-btn" class="home-btn-primary !py-2.5 !px-4 shrink-0">
                    Search
                </button>
            </form>
            <div id="search-results-dropdown"
                 class="hidden absolute left-0 right-0 mt-2 bg-slate-900 border border-slate-700/80 rounded-xl shadow-2xl p-3 space-y-3 max-h-96 overflow-y-auto text-left z-50">
            </div>
        </div>
    </div>
</header>

<main class="max-w-6xl mx-auto px-5 sm:px-8 pb-24 space-y-20">

    <!-- ========== 2. LEAGUE STATUS ========== -->
    <%
        const verifiedCount = (typeof players !== 'undefined' && players)
            ? players.filter(p => p.verified).length
            : 0;
        const teamCount = (typeof groups !== 'undefined' && groups)
            ? groups.reduce((n, g) => n + ((g.teams && g.teams.length) || 0), 0)
            : 0;
        const upcomingCount = (typeof matches !== 'undefined' && matches)
            ? matches.filter(m => m.status === 'upcoming').length
            : 0;
        const auctionStatus = (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.status)
            ? String(auctionSettings.status)
            : ((typeof auctionSession !== 'undefined' && auctionSession && auctionSession.status)
                ? String(auctionSession.status)
                : 'ready');
        const auctionLabel = auctionStatus === 'live' ? 'Auction live'
            : (auctionStatus === 'paused' ? 'Auction paused'
            : (auctionStatus === 'ended' ? 'Auction ended' : 'Registration / ready'));
    %>
    <section>
        <div class="flex items-end justify-between gap-4 mb-5">
            <div>
                <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500 mb-1">League pulse</p>
                <h2 class="font-display text-xl sm:text-2xl font-bold text-white">Season at a glance</h2>
            </div>
        </div>
        <div class="home-panel overflow-hidden">
            <div class="grid grid-cols-2 md:grid-cols-4">
                <div class="home-stat">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Season</p>
                    <p class="mt-1.5 text-lg font-bold text-white">VSL S4</p>
                </div>
                <div class="home-stat">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Verified players</p>
                    <p class="mt-1.5 text-lg font-bold text-white tabular-nums"><%= verifiedCount %></p>
                </div>
                <div class="home-stat">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Teams</p>
                    <p class="mt-1.5 text-lg font-bold text-white tabular-nums"><%= teamCount || '—' %></p>
                </div>
                <div class="home-stat">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Market</p>
                    <p class="mt-1.5 text-lg font-bold <%= auctionStatus === 'live' ? 'text-emerald-400' : 'text-white' %>"><%= auctionLabel %></p>
                </div>
            </div>
        </div>
        <% if (upcomingCount > 0) { %>
            <p class="mt-3 text-xs text-slate-500 font-medium"><%= upcomingCount %> upcoming fixture<%= upcomingCount === 1 ? '' : 's' %> on the schedule.</p>
        <% } %>
    </section>

    <!-- ========== 3. FEATURED ========== -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">
        <!-- Next match -->
        <div id="tour-featured-match" class="lg:col-span-7 home-panel p-6 sm:p-7">
            <div class="flex items-center justify-between gap-3 mb-6">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-500 mb-1">Next up</p>
                    <h3 class="font-display text-lg font-bold text-white">Featured fixture</h3>
                </div>
                <span class="text-[9px] font-bold uppercase tracking-wider text-blue-400 bg-blue-500/10 border border-blue-500/20 px-2.5 py-1 rounded-md">Schedule</span>
            </div>

            <% let nextMatch = (typeof matches !== 'undefined' && matches) ? matches.find(m => m.status === 'upcoming') : null; %>
            <% if (nextMatch) { %>
                <div class="flex items-center justify-between gap-4 py-6 border-y border-slate-800/80">
                    <div class="flex-1 flex flex-col items-center gap-2 min-w-0">
                        <img src="<%= nextMatch.logoA %>" alt="" class="w-12 h-12 object-contain opacity-95" onerror="this.style.opacity='0.3'">
                        <span class="text-xs font-bold text-slate-200 uppercase truncate max-w-full text-center"><%= nextMatch.teamA %></span>
                    </div>
                    <div class="text-center px-2 shrink-0">
                        <p class="font-display text-xl font-black text-slate-500">VS</p>
                        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mt-1"><%= nextMatch.time %></p>
                    </div>
                    <div class="flex-1 flex flex-col items-center gap-2 min-w-0">
                        <img src="<%= nextMatch.logoB %>" alt="" class="w-12 h-12 object-contain opacity-95" onerror="this.style.opacity='0.3'">
                        <span class="text-xs font-bold text-slate-200 uppercase truncate max-w-full text-center"><%= nextMatch.teamB %></span>
                    </div>
                </div>
            <% } else { %>
                <div class="py-12 text-center border-y border-slate-800/80 border-dashed">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">No upcoming match scheduled</p>
                </div>
            <% } %>

            <div class="flex justify-between items-center mt-5">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-600">League matches</span>
                <a href="/matches" class="home-link">Full fixtures →</a>
            </div>
        </div>

        <!-- Live / broadcast -->
        <div class="lg:col-span-5 home-panel overflow-hidden flex flex-col min-h-[240px]">
            <div class="px-5 pt-5 pb-3 flex items-center justify-between">
                <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-500">Broadcast</p>
                <% if (typeof liveLink !== 'undefined' && liveLink && liveLink.trim() !== '') { %>
                    <span class="flex items-center gap-1.5 text-[9px] font-bold uppercase tracking-wider text-rose-400">
                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span> Live
                    </span>
                <% } else { %>
                    <span class="text-[9px] font-bold uppercase tracking-wider text-slate-600">Offline</span>
                <% } %>
            </div>
            <% if (typeof liveLink !== 'undefined' && liveLink && liveLink.trim() !== '') { %>
                <%
                    let embedLink = liveLink;
                    if (liveLink.includes('watch?v=')) {
                        embedLink = liveLink.replace('watch?v=', 'embed/').split('&')[0];
                    } else if (liveLink.includes('youtu.be/')) {
                        embedLink = liveLink.replace('youtu.be/', 'youtube.com/embed/').split('?')[0];
                    }
                %>
                <iframe class="w-full flex-1 min-h-[200px] border-0" src="<%= embedLink %>" allowfullscreen></iframe>
            <% } else { %>
                <div class="flex-1 flex flex-col items-center justify-center px-6 pb-8 text-center">
                    <p class="text-sm font-semibold text-slate-400">Stream offline</p>
                    <p class="text-xs text-slate-600 mt-1">No broadcast link is set right now.</p>
                </div>
            <% } %>
        </div>
    </section>

    <!-- ========== 4. HOW IT WORKS ========== -->
    <section>
        <div class="mb-8 max-w-2xl">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500 mb-2">The path in</p>
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-white">From free agent to matchday</h2>
            <p class="mt-3 text-sm text-slate-400 leading-relaxed">Three steps. No filler — register, get seen, compete.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-slate-800/60 rounded-xl overflow-hidden border border-slate-800/60">
            <div class="bg-[#0b1220] p-6 sm:p-8">
                <span class="text-[10px] font-black text-blue-500 tracking-widest">01</span>
                <h3 class="mt-3 font-display text-base font-bold text-white">Join the community</h3>
                <p class="mt-2 text-xs text-slate-400 leading-relaxed">Connect on Discord. Meet managers and scouts running VSL sides.</p>
            </div>
            <div class="bg-[#0b1220] p-6 sm:p-8">
                <span class="text-[10px] font-black text-blue-500 tracking-widest">02</span>
                <h3 class="mt-3 font-display text-base font-bold text-white">Register your card</h3>
                <p class="mt-2 text-xs text-slate-400 leading-relaxed">Build your profile in the Market — position, bio, and stats that managers actually use.</p>
            </div>
            <div class="bg-[#0b1220] p-6 sm:p-8">
                <span class="text-[10px] font-black text-blue-500 tracking-widest">03</span>
                <h3 class="mt-3 font-display text-base font-bold text-white">Get drafted & play</h3>
                <p class="mt-2 text-xs text-slate-400 leading-relaxed">Auction, roster, fixtures. Track results and climb the board.</p>
            </div>
        </div>
    </section>

    <!-- ========== RESULTS ========== -->
    <section id="tour-results">
        <div class="flex items-end justify-between gap-4 mb-6">
            <div>
                <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500 mb-1">Scoreboard</p>
                <h2 class="font-display text-xl sm:text-2xl font-bold text-white">Recent results</h2>
            </div>
            <a href="/matches" class="home-link shrink-0">All matches →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <%
                const finished = (typeof matches !== 'undefined' && matches)
                    ? matches.filter(m => m.status === 'completed' || m.status === 'finished' || (m.details && (m.details.goalsA != null || m.details.goalsB != null))).slice(0, 6)
                    : [];
            %>
            <% if (finished.length > 0) { %>
                <% finished.forEach(r => { %>
                    <a href="/match/<%= r.id || r._id %>" class="home-panel p-4 hover:border-slate-600/50 transition block">
                        <div class="flex justify-between items-center mb-3">
                            <div class="flex items-center gap-2 min-w-0">
                                <img src="<%= r.logoA %>" class="w-6 h-6 object-contain" onerror="this.style.opacity='0.25'">
                                <span class="text-xs font-bold text-slate-200 uppercase truncate"><%= r.teamA %></span>
                            </div>
                            <span class="font-display text-base font-black text-white tabular-nums ml-2">
                                <%= (r.details && r.details.goalsA != null) ? r.details.goalsA : 0 %>
                            </span>
                        </div>
                        <div class="flex justify-between items-center">
                            <div class="flex items-center gap-2 min-w-0">
                                <img src="<%= r.logoB %>" class="w-6 h-6 object-contain" onerror="this.style.opacity='0.25'">
                                <span class="text-xs font-bold text-slate-500 uppercase truncate"><%= r.teamB %></span>
                            </div>
                            <span class="font-display text-base font-black text-slate-500 tabular-nums ml-2">
                                <%= (r.details && r.details.goalsB != null) ? r.details.goalsB : 0 %>
                            </span>
                        </div>
                    </a>
                <% }) %>
            <% } else { %>
                <div class="col-span-full home-panel py-12 text-center">
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">No recent results yet</p>
                </div>
            <% } %>
        </div>
    </section>

    <!-- ========== STORIES ========== -->
    <section>
        <div class="mb-6">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500 mb-1">Journal</p>
            <h2 class="font-display text-xl sm:text-2xl font-bold text-white">League stories</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <% if (typeof stories !== 'undefined' && stories.length > 0) { %>
                <% stories.slice().reverse().forEach(story => { %>
                    <article class="home-panel overflow-hidden flex flex-col group">
                        <div class="aspect-[16/10] bg-slate-900 overflow-hidden">
                            <img src="<%= story.image %>" alt="" class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity duration-300">
                        </div>
                        <div class="p-5 flex-1 flex flex-col">
                            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider"><%= story.date || 'Article' %></span>
                            <h4 class="mt-2 font-display text-base font-bold text-white leading-snug group-hover:text-blue-400 transition-colors">
                                <%= story.title %>
                            </h4>
                            <p class="mt-2 text-xs text-slate-400 leading-relaxed line-clamp-2 flex-1"><%= story.description %></p>
                        </div>
                    </article>
                <% }) %>
            <% } else { %>
                <div class="col-span-full home-panel py-12 text-center">
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">No stories published yet</p>
                </div>
            <% } %>
        </div>
    </section>

    <!-- ========== FINAL CTA ========== -->
    <section class="relative rounded-2xl border border-slate-800 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-blue-600/15 via-transparent to-transparent pointer-events-none"></div>
        <div class="relative px-6 sm:px-12 py-12 sm:py-16 text-center">
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-white tracking-tight">
                Ready for the next kickoff?
            </h2>
            <p class="mt-3 text-sm text-slate-400 max-w-md mx-auto">
                Register your card, get on the market, and make sure managers know your name.
            </p>
            <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
                <a href="/market" class="home-btn-primary">Go to player market</a>
                <a href="/matches" class="home-btn-secondary">Browse fixtures</a>
            </div>
        </div>
    </section>

</main>
</div>

<!-- TOUR SCRIPT (same behaviour) -->
<script>
(function () {
    const overlay = document.getElementById('vim-tour-overlay');
    const backdrop = document.getElementById('vim-tour-backdrop');
    const spotlight = document.getElementById('vim-tour-spotlight');
    const card = document.getElementById('vim-tour-card');
    const eyebrow = document.getElementById('vim-tour-eyebrow');
    const title = document.getElementById('vim-tour-title');
    const description = document.getElementById('vim-tour-description');
    const progress = document.getElementById('vim-tour-progress');
    const nextButton = document.getElementById('vim-tour-next');
    const skipButton = document.getElementById('vim-tour-skip');
    const launcher = document.getElementById('vim-tour-launcher');

    if (!overlay || !spotlight || !card) return;

    const tourSteps = [
        {
            selector: '[data-tour="market"]',
            mobileSelector: '[data-tour="market-mobile"]',
            eyebrow: 'PLAYER MARKET',
            title: 'Build your player profile',
            description: 'The Market is where you can browse registered players, inspect their cards, stats, positions and player information.'
        },
        {
            selector: '[data-tour="matches"]',
            mobileSelector: '[data-tour="matches-mobile"]',
            eyebrow: 'MATCH CENTER',
            title: 'Follow the fixtures',
            description: 'Matches contains upcoming fixtures, completed games and individual match details.'
        },
        {
            selector: '[data-tour="metrics"]',
            mobileSelector: '[data-tour="metrics-mobile"]',
            eyebrow: 'LEAGUE METRICS',
            title: 'Track the numbers',
            description: 'Metrics is where the league statistics come together — goals, assists, saves, MVPs and other player records.'
        },
        {
            selector: '[data-tour="records"]',
            mobileSelector: '[data-tour="records-mobile"]',
            eyebrow: 'LEAGUE RECORDS',
            title: 'Explore the history',
            description: 'Records gives you the bigger picture: notable league achievements, historical records and milestones.'
        },
        {
            selector: '#live-search-input',
            eyebrow: 'SEARCH',
            title: 'Find anything quickly',
            description: 'Search for teams, players or matches directly from the homepage.'
        },
        {
            selector: '#tour-featured-match',
            eyebrow: 'FEATURED FIXTURE',
            title: 'See what is coming up',
            description: 'The homepage highlights the next scheduled match so you can jump into the action.'
        },
        {
            selector: '#tour-results',
            eyebrow: 'SCOREBOARD',
            title: 'Keep up with results',
            description: 'Recent completed matches appear here with their final scores.'
        }
    ];

    let currentStep = 0;

    function isMobileLayout() {
        return window.innerWidth < 1280;
    }

    function getTarget(step) {
        let target = null;
        if (isMobileLayout() && step.mobileSelector) {
            target = document.querySelector(step.mobileSelector);
        }
        if (!target && step.selector) {
            target = document.querySelector(step.selector);
        }
        return target;
    }

    function createProgress() {
        progress.innerHTML = '';
        tourSteps.forEach(function (_, index) {
            const dot = document.createElement('span');
            if (index === currentStep) dot.classList.add('active');
            progress.appendChild(dot);
        });
    }

    function positionTourCard(target) {
        const margin = 16;
        const cardWidth = Math.min(360, window.innerWidth - 32);
        card.style.width = cardWidth + 'px';
        if (window.innerWidth <= 640) {
            card.classList.add('centered');
            card.style.left = '16px';
            card.style.top = 'auto';
            card.style.bottom = '20px';
            return;
        }
        card.classList.remove('centered');
        const rect = target.getBoundingClientRect();
        let left = rect.left;
        let top = rect.bottom + 22;
        if (left + cardWidth > window.innerWidth - margin) left = window.innerWidth - cardWidth - margin;
        if (left < margin) left = margin;
        const estimatedCardHeight = 220;
        if (top + estimatedCardHeight > window.innerHeight - margin) {
            top = rect.top - estimatedCardHeight - 22;
            if (top < margin) {
                top = margin;
                card.classList.add('centered');
            }
        }
        card.style.left = left + 'px';
        card.style.top = top + 'px';
        card.style.bottom = 'auto';
    }

    function moveSpotlight(target) {
        const rect = target.getBoundingClientRect();
        const isSmall = window.innerWidth <= 640;
        let width = rect.width;
        let height = rect.height;
        if (width < 55) width = 55;
        if (height < 45) height = 45;
        const padding = isSmall ? 10 : 9;
        spotlight.style.left = (rect.left + rect.width / 2) + 'px';
        spotlight.style.top = (rect.top + rect.height / 2) + 'px';
        spotlight.style.width = (width + padding * 2) + 'px';
        spotlight.style.height = (height + padding * 2) + 'px';
    }

    function showStep(index) {
        currentStep = index;
        const step = tourSteps[currentStep];
        const target = getTarget(step);
        if (!target) {
            if (currentStep < tourSteps.length - 1) showStep(currentStep + 1);
            else finishTour();
            return;
        }
        if (isMobileLayout() && step.mobileSelector) {
            const mobileMenu = document.getElementById('mobile-menu');
            if (mobileMenu && !mobileMenu.classList.contains('active')) mobileMenu.classList.add('active');
        }
        target.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
        setTimeout(function () {
            moveSpotlight(target);
            positionTourCard(target);
        }, 120);
        eyebrow.textContent = step.eyebrow;
        title.textContent = step.title;
        description.textContent = step.description;
        createProgress();
        nextButton.textContent = currentStep === tourSteps.length - 1 ? 'Finish ✓' : 'Next →';
    }

    function startTour() {
        currentStep = 0;
        overlay.classList.add('active');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        showStep(0);
    }

    function finishTour() {
        overlay.classList.remove('active');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        localStorage.setItem('vim_home_tour_seen', 'true');
        const mobileMenu = document.getElementById('mobile-menu');
        if (mobileMenu) mobileMenu.classList.remove('active');
    }

    nextButton.addEventListener('click', function () {
        if (currentStep >= tourSteps.length - 1) { finishTour(); return; }
        showStep(currentStep + 1);
    });
    skipButton.addEventListener('click', finishTour);
    backdrop.addEventListener('click', finishTour);
    launcher.addEventListener('click', startTour);
    document.addEventListener('keydown', function (event) {
        if (!overlay.classList.contains('active')) return;
        if (event.key === 'Escape') finishTour();
        if (event.key === 'ArrowRight' && currentStep < tourSteps.length - 1) showStep(currentStep + 1);
        if (event.key === 'ArrowLeft' && currentStep > 0) showStep(currentStep - 1);
    });
    window.addEventListener('resize', function () {
        if (!overlay.classList.contains('active')) return;
        const step = tourSteps[currentStep];
        const target = getTarget(step);
        if (target) { moveSpotlight(target); positionTourCard(target); }
    });

    if (!localStorage.getItem('vim_home_tour_seen')) {
        setTimeout(startTour, 900);
    }
})();
</script>

<!-- SEARCH SCRIPT (same behaviour, dark-friendly markup) -->
<script>
    const localMatches = <%- JSON.stringify(matches || []) %>;
    const localPlayers = <%- typeof players !== 'undefined' ? JSON.stringify(players) : '[]' %>;

    const searchInput = document.getElementById('live-search-input');
    const dropdown = document.getElementById('search-results-dropdown');
    const searchForm = document.getElementById('search-form');
    let debounceTimer;
    let topTargetUrl = '';

    searchInput.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        const query = e.target.value.trim().toLowerCase();
        if (query.length < 1) {
            dropdown.classList.add('hidden');
            dropdown.innerHTML = '';
            topTargetUrl = '';
            return;
        }
        debounceTimer = setTimeout(() => {
            fetch(`/api/search?q=${encodeURIComponent(query)}`)
                .then(res => res.ok ? res.json() : Promise.reject('No server API'))
                .then(data => renderSearchResults(data, query))
                .catch(() => {
                    const matchedMatches = localMatches.filter(m =>
                        (m.teamA && m.teamA.toLowerCase().includes(query)) ||
                        (m.teamB && m.teamB.toLowerCase().includes(query))
                    );
                    const matchedPlayers = localPlayers.filter(p =>
                        (p.name && p.name.toLowerCase().includes(query)) ||
                        (p.role && p.role.toLowerCase().includes(query))
                    );
                    renderSearchResults({ matches: matchedMatches, players: matchedPlayers }, query);
                });
        }, 150);
    });

    function renderSearchResults(data, query) {
        const { players, matches } = data;
        let html = '';
        topTargetUrl = '';
        const hasMatches = matches && matches.length > 0;
        const hasPlayers = players && players.length > 0;

        if (!hasMatches && !hasPlayers) {
            dropdown.innerHTML = `<div class="text-center py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">No matches for "${query}"</div>`;
            dropdown.classList.remove('hidden');
            return;
        }

        if (hasMatches) {
            if (!topTargetUrl) topTargetUrl = `/match/${matches[0].id || matches[0]._id || ''}`;
            html += `<div><span class="text-[10px] font-bold text-blue-400 uppercase tracking-widest block mb-2 px-2">Matches & teams</span><div class="space-y-1">`;
            matches.forEach(m => {
                const matchUrl = (m.id || m._id) ? `/match/${m.id || m._id}` : `/matches?q=${encodeURIComponent(query)}`;
                html += `<a href="${matchUrl}" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-800 transition">
                    <span class="text-xs font-bold text-slate-200 uppercase">${m.teamA} <span class="text-blue-400">vs</span> ${m.teamB}</span>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase">${m.status || m.time || 'Fixture'}</span>
                </a>`;
            });
            html += `</div></div>`;
        }

        if (hasPlayers) {
            if (!topTargetUrl) topTargetUrl = players[0].id ? `/player/${players[0].id}` : `/market`;
            html += `<div class="${hasMatches ? 'pt-3 border-t border-slate-800' : ''}"><span class="text-[10px] font-bold text-blue-400 uppercase tracking-widest block mb-2 px-2">Players</span><div class="space-y-1">`;
            players.forEach(p => {
                const playerUrl = p.id ? `/player/${p.id}` : `/market?search=${encodeURIComponent(p.name)}`;
                html += `<a href="${playerUrl}" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-800 transition">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-7 h-7 rounded-full bg-blue-500/15 text-blue-400 flex items-center justify-center font-bold text-xs uppercase shrink-0">${p.name ? p.name.charAt(0) : 'P'}</div>
                        <div class="min-w-0">
                            <span class="text-xs font-bold text-slate-200 block truncate">${p.name}</span>
                            <span class="text-[10px] text-slate-500">${p.team || 'Free Agent'}</span>
                        </div>
                    </div>
                    <span class="text-[10px] text-blue-400 font-bold uppercase">${p.role || p.position || 'Player'}</span>
                </a>`;
            });
            html += `</div></div>`;
        }

        dropdown.innerHTML = html;
        dropdown.classList.remove('hidden');
    }

    searchForm.addEventListener('submit', (e) => {
        if (topTargetUrl) {
            e.preventDefault();
            window.location.href = topTargetUrl;
        }
    });

    document.addEventListener('click', (e) => {
        if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.classList.add('hidden');
        }
    });
</script>
