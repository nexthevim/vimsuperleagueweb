<%- include('partials/navbar') %>

<div id="profile-page" class="min-h-screen py-16 px-4 sm:px-8 transition-colors duration-200">
    <main class="max-w-7xl mx-auto">
        
        <!-- HEADER SECTION -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4 border-b border-slate-200 dark:border-slate-800 pb-6">
            <div>
                <h1 class="text-3xl font-black italic uppercase tracking-tight text-slate-900 dark:text-white">
                    Player <span class="text-blue-600">Hub</span>
                </h1>
                <p class="text-xs font-bold tracking-widest uppercase text-slate-500 dark:text-slate-400 mt-1">
                    Dashboard & Account Settings
                </p>
            </div>
            
            <form action="/profile/delete" method="POST" onsubmit="return confirm('Are you sure? This will permanently remove your market card and player stats.')">
                <button type="submit" class="text-rose-600 hover:text-rose-700 text-[10px] font-black border border-rose-200 dark:border-rose-900/50 bg-rose-50/50 dark:bg-rose-950/20 px-4 py-2 rounded-xl hover:bg-rose-100 dark:hover:bg-rose-900/30 transition-all uppercase tracking-wider">
                    Delete Account
                </button>
            </form>
        </div>

        <!-- ============================================================
             VSL SEASON 4 — MANAGER AUCTION DASHBOARD
             Only rendered for accounts assigned as a team manager in
             admin.ejs. Normal users never see any of this.
             ============================================================ -->
        <% if (typeof isManager !== 'undefined' && isManager && typeof myAuctionState !== 'undefined' && myAuctionState) { %>
            <div class="mb-10 space-y-6">

                <div class="flex items-center gap-3">
                    <span class="text-xl">👔</span>
                    <div>
                        <h2 class="text-xl font-black italic uppercase tracking-tight text-slate-900 dark:text-white">
                            Manager Dashboard — <%= myAuctionState.team.name %>
                        </h2>
                        <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Private to you. No other manager can see this.</p>
                    </div>
                </div>

                <!-- BUDGET / ROSTER OVERVIEW -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800">
                        <p class="text-[9px] font-black uppercase text-slate-400">Total Guru Money</p>
                        <p class="text-xl font-black italic text-slate-900 dark:text-white mt-1"><%= Number(myAuctionState.budget).toLocaleString() %></p>
                    </div>
                    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800">
                        <p class="text-[9px] font-black uppercase text-slate-400">Available Right Now</p>
                        <p class="text-xl font-black italic text-emerald-600 mt-1"><%= Number(myAuctionState.availableBudget).toLocaleString() %></p>
                    </div>
                    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800">
                        <p class="text-[9px] font-black uppercase text-slate-400">Roster</p>
                        <p class="text-xl font-black italic text-slate-900 dark:text-white mt-1"><%= myAuctionState.totalPlayers %> <span class="text-xs text-slate-400">/ <%= myAuctionState.rosterMax %></span></p>
                    </div>
                    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800">
                        <p class="text-[9px] font-black uppercase text-slate-400">Slots Remaining</p>
                        <p class="text-xl font-black italic text-slate-900 dark:text-white mt-1"><%= myAuctionState.remainingSlots.total %></p>
                    </div>
                </div>

                <!-- CLASS SLOTS -->
                <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800">
                    <p class="text-[10px] font-black uppercase tracking-wider text-slate-400 mb-3">Class Slots Remaining</p>
                    <div class="grid grid-cols-5 gap-2">
                        <% ['SS','S','A','B','C'].forEach(k => {
                            const has = myAuctionState.caps[k] !== undefined;
                            const count = myAuctionState.counts[k] || 0;
                            const cap = has ? myAuctionState.caps[k] : null;
                        %>
                            <div class="text-center bg-slate-50 dark:bg-slate-950 rounded-xl py-2.5 border border-slate-100 dark:border-slate-800">
                                <p class="text-[8px] font-black text-slate-400 uppercase"><%= k %></p>
                                <p class="text-sm font-black text-slate-900 dark:text-white mt-0.5">
                                    <%= count %><% if (has) { %><span class="text-slate-400">/<%= cap %></span><% } %>
                                </p>
                            </div>
                        <% }) %>
                    </div>
                    <% if (myAuctionState.team.allowTwoSS) { %>
                        <p class="text-[9px] font-bold text-fuchsia-600 uppercase tracking-wider mt-2">✨ 2-SS Exception active for your team</p>
                    <% } %>
                </div>

                <!-- WARNINGS -->
                <% const needMore = Math.max(0, myAuctionState.rosterMin - myAuctionState.totalPlayers); %>
                <% if (needMore > 0) { %>
                    <div class="bg-amber-50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-900/50 rounded-2xl p-4 flex items-start gap-3">
                        <span class="text-lg">⚠️</span>
                        <p class="text-xs font-bold text-amber-700 dark:text-amber-400">
                            Roster warning: you still need at least <%= needMore %> more player(s) to hit the <%= myAuctionState.rosterMin %>-player minimum.
                            You have <%= Number(myAuctionState.availableBudget).toLocaleString() %> Vollars available.
                        </p>
                    </div>
                <% } %>
                <% if (myAuctionState.availableBudget < 2500 && myAuctionState.totalPlayers < myAuctionState.rosterMin) { %>
                    <div class="bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/50 rounded-2xl p-4 flex items-start gap-3">
                        <span class="text-lg">🚨</span>
                        <p class="text-xs font-bold text-rose-700 dark:text-rose-400">
                            Budget critical: you may not have enough left to reach the <%= myAuctionState.rosterMin %>-player minimum. Consider withdrawing a bid if still possible.
                        </p>
                    </div>
                <% } %>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

                    <!-- PLAYERS I'M WINNING -->
                    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-5">
                        <p class="text-[10px] font-black uppercase tracking-wider text-emerald-600 mb-3">🟢 Currently Winning (<%= myAuctionState.provisional.length %>)</p>
                        <% if (myAuctionState.provisional.length > 0) { %>
                            <div class="space-y-2 max-h-56 overflow-y-auto pr-1">
                                <% myAuctionState.provisional.forEach(({player, amount}) => { %>
                                    <div class="flex items-center justify-between gap-2 bg-emerald-50/50 dark:bg-emerald-950/10 rounded-xl px-3 py-2">
                                        <span class="text-xs font-black text-slate-900 dark:text-white truncate"><%= player.name %></span>
                                        <span class="text-xs font-black text-emerald-600 flex-shrink-0"><%= Number(amount).toLocaleString() %></span>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="text-xs text-slate-400 italic font-bold">No active winning bids yet.</p>
                        <% } %>
                    </div>

                    <!-- OUTBID -->
                    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-5">
                        <p class="text-[10px] font-black uppercase tracking-wider text-rose-600 mb-3">🔴 You've Been Outbid (<%= typeof myOutbidPlayers !== 'undefined' ? myOutbidPlayers.length : 0 %>)</p>
                        <% if (typeof myOutbidPlayers !== 'undefined' && myOutbidPlayers.length > 0) { %>
                            <div class="space-y-2 max-h-56 overflow-y-auto pr-1">
                                <% myOutbidPlayers.forEach(p => { %>
                                    <div class="flex items-center justify-between gap-2 bg-rose-50/50 dark:bg-rose-950/10 rounded-xl px-3 py-2">
                                        <div class="min-w-0">
                                            <p class="text-xs font-black text-slate-900 dark:text-white truncate"><%= p.name %></p>
                                            <p class="text-[9px] text-slate-400 font-bold uppercase truncate">by <%= p.highestBidder %></p>
                                        </div>
                                        <span class="text-xs font-black text-rose-600 flex-shrink-0"><%= Number(p.highestBid).toLocaleString() %></span>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="text-xs text-slate-400 italic font-bold">You haven't been outbid on anything.</p>
                        <% } %>
                    </div>

                    <!-- WATCHLIST -->
                    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-5">
                        <p class="text-[10px] font-black uppercase tracking-wider text-amber-600 mb-3">⭐ Watchlist (<%= typeof myWatchlistPlayers !== 'undefined' ? myWatchlistPlayers.length : 0 %>)</p>
                        <% if (typeof myWatchlistPlayers !== 'undefined' && myWatchlistPlayers.length > 0) { %>
                            <div class="space-y-2 max-h-56 overflow-y-auto pr-1">
                                <% myWatchlistPlayers.forEach(p => {
                                    const amWinningWatched = (p.highestBidder || '').toLowerCase() === myAuctionState.team.name.toLowerCase() && Number(p.highestBid) > 0;
                                %>
                                    <div class="flex items-center justify-between gap-2 bg-amber-50/50 dark:bg-amber-950/10 rounded-xl px-3 py-2">
                                        <div class="min-w-0">
                                            <p class="text-xs font-black text-slate-900 dark:text-white truncate"><%= p.name %></p>
                                            <p class="text-[9px] font-bold uppercase truncate <%= amWinningWatched ? 'text-emerald-600' : 'text-slate-400' %>"><%= amWinningWatched ? 'You\'re winning' : (p.highestBidder || 'No bids yet') %></p>
                                        </div>
                                        <span class="text-xs font-black text-slate-700 dark:text-slate-300 flex-shrink-0"><%= Number(p.highestBid || p.reservePrice || 0).toLocaleString() %></span>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="text-xs text-slate-400 italic font-bold">Star players in the Market to track them here.</p>
                        <% } %>
                    </div>

                </div>

                <div class="text-center">
                    <a href="/market" class="inline-block px-6 py-3 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-xl font-black uppercase text-xs tracking-wider hover:bg-slate-800 dark:hover:bg-slate-100 transition">
                        Go To Auction Hub →
                    </a>
                </div>

            </div>
        <% } %>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <!-- LEFT COLUMN: PLAYER CARD & STATS -->
            <div class="lg:col-span-4 space-y-6">
                <!-- CARD PREVIEW -->
                <div class="bg-white dark:bg-slate-900 p-5 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm">
                    <div class="flex items-center justify-between mb-3">
                        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Official Player Card</p>
                        <% if (user && user.cardImage) { %>
                            <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 text-[9px] font-black uppercase tracking-wider border border-emerald-500/20">
                                Verified
                            </span>
                        <% } %>
                    </div>
                    
                    <div class="relative aspect-[3/4] rounded-2xl overflow-hidden border border-slate-800 bg-slate-950 shadow-xl group">
                        <% if (user && user.cardImage) { %>
                            <img src="<%= user.cardImage %>" alt="<%= user.name %> Card" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                        <% } else { %>
                            <div class="w-full h-full flex flex-col items-center justify-center p-6 text-center space-y-3 bg-slate-950">
                                <div class="w-12 h-12 border-2 border-blue-500/20 border-t-blue-500 rounded-full animate-spin flex items-center justify-center">
                                </div>
                                <div>
                                    <p class="text-xs font-black uppercase text-white tracking-wider">Card Verification Pending</p>
                                    <p class="text-[10px] font-medium text-slate-400 mt-1">An admin will generate your official market card soon.</p>
                                </div>
                            </div>
                        <% } %>
                        
                        <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent">
                            <div class="flex justify-between items-end">
                                <div>
                                    <p class="text-xl font-black italic text-white uppercase leading-none"><%= user ? user.name : 'Unknown' %></p>
                                    <p class="text-blue-400 font-bold text-[10px] uppercase tracking-widest mt-1">@<%= user ? user.discord : 'none' %></p>
                                </div>
                                <span class="bg-blue-600 text-white text-[9px] font-black px-2 py-0.5 rounded italic uppercase">
                                    <%= user ? user.position : '???' %>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STATS GRID -->
                <div class="grid grid-cols-2 gap-3">
                    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 text-center">
                        <p class="text-[9px] font-black uppercase text-slate-400">Goals</p>
                        <p class="text-2xl font-black italic text-slate-900 dark:text-white mt-1"><%= user ? user.goals : 0 %></p>
                    </div>
                    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 text-center">
                        <p class="text-[9px] font-black uppercase text-slate-400">Assists</p>
                        <p class="text-2xl font-black italic text-slate-900 dark:text-white mt-1"><%= user ? user.assists : 0 %></p>
                    </div>
                    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 text-center">
                        <p class="text-[9px] font-black uppercase text-slate-400">Saves</p>
                        <p class="text-2xl font-black italic text-slate-900 dark:text-white mt-1"><%= user ? (user.saves || 0) : 0 %></p>
                    </div>
                    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 text-center">
                        <p class="text-[9px] font-black uppercase text-slate-400">MVPs</p>
                        <p class="text-2xl font-black italic text-slate-900 dark:text-white mt-1"><%= user ? user.mvps : 0 %></p>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: THEMES & EDIT FORM -->
            <div class="lg:col-span-8 space-y-6">
                
                <!-- CLEAN THEME SELECTOR -->
                <div class="bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm">
                    <h2 class="text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3">Global Website Theme</h2>

                    <div class="grid grid-cols-3 gap-3">
                        <button type="button" onclick="setTheme('light')" id="btn-theme-light" class="theme-btn py-3 px-4 rounded-xl border border-slate-200 dark:border-slate-800 text-xs font-black uppercase transition-all flex items-center justify-center gap-2 text-slate-700 dark:text-slate-300">
                            ☀️ Light
                        </button>
                        <button type="button" onclick="setTheme('dark')" id="btn-theme-dark" class="theme-btn py-3 px-4 rounded-xl border border-slate-200 dark:border-slate-800 text-xs font-black uppercase transition-all flex items-center justify-center gap-2 text-slate-700 dark:text-slate-300">
                            🌙 Dark
                        </button>
                        <button type="button" onclick="setTheme('system')" id="btn-theme-system" class="theme-btn py-3 px-4 rounded-xl border border-slate-200 dark:border-slate-800 text-xs font-black uppercase transition-all flex items-center justify-center gap-2 text-slate-700 dark:text-slate-300">
                            💻 System
                        </button>
                    </div>
                </div>

                <!-- PROFILE FORM -->
                <div class="bg-white dark:bg-slate-900 p-6 sm:p-8 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm">
                    <div class="mb-6 pb-4 border-b border-slate-100 dark:border-slate-800">
                        <h2 class="text-base font-black uppercase tracking-tight text-slate-900 dark:text-white">Edit Player Profile</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Updates reflect directly in the Market section.</p>
                    </div>

                    <form action="/profile/update" method="POST" class="space-y-5">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div class="space-y-1.5">
                                <label class="text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Display Name</label>
                                <input name="name" value="<%= user ? user.name : '' %>" required
                                    class="w-full p-3 rounded-xl text-xs font-bold bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white outline-none focus:border-blue-600">
                            </div>

                            <div class="space-y-1.5">
                                <label class="text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Discord Handle</label>
                                <input name="discord" value="<%= user ? user.discord : '' %>" required
                                    class="w-full p-3 rounded-xl text-xs font-bold bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white outline-none focus:border-blue-600" placeholder="username">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                            <div class="space-y-1.5">
                                <label class="text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Position</label>
                                <select name="position" class="w-full p-3 rounded-xl text-xs font-bold bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white outline-none focus:border-blue-600">
                                    <option value="FWD" <%= user && user.position === 'FWD' ? 'selected' : '' %>>FORWARD (FWD)</option>
                                    <option value="MID" <%= user && user.position === 'MID' ? 'selected' : '' %>>MIDFIELD (MID)</option>
                                    <option value="DEF" <%= user && user.position === 'DEF' ? 'selected' : '' %>>DEFENSE (DEF)</option>
                                    <option value="GK" <%= user && user.position === 'GK' ? 'selected' : '' %>>GOALKEEPER (GK)</option>
                                </select>
                            </div>

                            <div class="space-y-1.5">
                                <label class="text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Country</label>
                                <input name="country" value="<%= user ? user.country : '' %>" required
                                    class="w-full p-3 rounded-xl text-xs font-bold bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white outline-none focus:border-blue-600" placeholder="e.g. India, USA">
                            </div>

                            <div class="space-y-1.5">
                                <label class="text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Timezone</label>
                                <input name="timezone" value="<%= user ? user.timezone : '' %>" 
                                    class="w-full p-3 rounded-xl text-xs font-bold bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white outline-none focus:border-blue-600" placeholder="e.g. GMT+5:30">
                            </div>
                        </div>

                        <div class="space-y-1.5">
                            <label class="text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Market Biography</label>
                            <textarea name="bio" rows="4" 
                                placeholder="Describe your experience, past teams, and playstyle..."
                                class="w-full p-3.5 rounded-xl text-xs leading-relaxed bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white outline-none focus:border-blue-600"><%= user ? (user.bio || user.experience) : '' %></textarea>
                        </div>

                        <div class="pt-2">
                            <button type="submit" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-black uppercase text-xs tracking-wider transition-all">
                                Save Profile Settings
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </main>
</div>

<!-- CLIENT-SIDE THEME ENGINE -->
<script>
    tailwind.config = {
        darkMode: 'class',
    };

    function setTheme(mode) {
        localStorage.setItem('vim_theme', mode);

        const isDark = mode === 'dark' || (mode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);

        if (isDark) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }

        // Send backend update silently
        fetch('/profile/update-theme', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ theme: mode })
        }).catch(() => {});

        // Update button styles
        document.querySelectorAll('.theme-btn').forEach(btn => {
            btn.classList.remove('bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-900', 'border-transparent');
            btn.classList.add('border-slate-200', 'dark:border-slate-800');
        });

        const activeBtn = document.getElementById('btn-theme-' + mode);
        if (activeBtn) {
            activeBtn.classList.remove('border-slate-200', 'dark:border-slate-800');
            activeBtn.classList.add('bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-900', 'border-transparent');
        }
    }

    // Initialize Theme on Load
    (function() {
        const savedTheme = localStorage.getItem('vim_theme') || "<%= user ? (user.theme || 'system') : 'system' %>";
        setTheme(savedTheme);
    })();
</script>
