                        <path d="M16 6l3.2 2.4-1.2 3.9h-4L12.8 8.4 16 6z" fill="#14532d"/>
                        <path d="M8.5 12.5l3.9-.9 1.2 3.9-3.2 2.5-3.1-2.7.2-2.8z" fill="#14532d"/>
                        <path d="M23.5 12.5l-3.9-.9-1.2 3.9 3.2 2.5 3.1-2.7-.2-2.8z" fill="#14532d"/>
                        <path d="M11 22.5l.9-3.9 3.9 1.2v4l-3.4 1.4-1.4-2.7z" fill="#14532d"/>
                        <path d="M21 22.5l-.9-3.9-3.9 1.2v4l3.4 1.4 1.4-2.7z" fill="#14532d"/>
                    </svg>
                </div>
                <h3>Fixtures</h3>
                <p>Upcoming games, completed matches and the schedule your manager needs to know.</p>
                <span class="vsl-mini-link">View fixtures</span>
