<!-- =========================================================
     VIM AI + CURSOR + LEAGUE GUIDE BRIDGE
     ========================================================= -->

<script>
/* =========================================================
   VIM AI — LOCAL KNOWLEDGE ASSISTANT
   ========================================================= */

(function() {

    const panel = document.getElementById('vim-ai-panel');
    const input = document.getElementById('vim-ai-input');
    const messages = document.getElementById('vim-ai-messages');

    if (!panel || !input || !messages) return;


    /* ---------------------------------------------------------
       KNOWLEDGE BASE
       --------------------------------------------------------- */

    const knowledgeBase = [

        {
            keywords: ['market', 'player market', 'player card', 'players', 'buy player', 'scout'],
            response: `The <strong>Player Market</strong> is where registered VIM players can be viewed, scouted and evaluated. Player cards contain information such as position, stats, experience and market-related details.<br><br><a href="/market">Open Player Market →</a>`
        },

        {
            keywords: ['match', 'matches', 'fixture', 'fixtures', 'game', 'games', 'schedule'],
            response: `The <strong>Matches</strong> section is your fixture hub. You can check upcoming fixtures, completed matches and open individual match reports.<br><br><a href="/matches">Open Matches →</a>`
        },

        {
            keywords: ['metric', 'metrics', 'stats', 'statistics', 'stat'],
            response: `<strong>Metrics</strong> is the league performance area. It's designed for tracking player performance and league-wide statistics.<br><br><a href="/metrics">Open Metrics →</a>`
        },

        {
            keywords: ['record', 'records', 'history', 'historic', 'achievement'],
            response: `<strong>League Records</strong> is where VIM's historical achievements and notable records can be explored.<br><br><a href="/league-records">Open Records →</a>`
        },

        {
            keywords: ['info', 'information', 'rules', 'league', 'how does vim work', 'what is vim'],
            response: `<strong>VIM Super League</strong> is the main league hub. This website brings together the player market, fixtures, statistics, records, league information and community links in one place.<br><br><a href="/info">Open League Info →</a>`
        },

        {
            keywords: ['join', 'register', 'registration', 'free agent', 'become player', 'play'],
            response: `Want to get involved? Start by checking the league information and joining the VIM community. Player registration and recruitment happen around the league's player ecosystem.<br><br><a href="/info">League Information →</a>`
        },

        {
            keywords: ['discord', 'community', 'server'],
            response: `The VIM Discord is the community hub where players, teams and league members can connect.<br><br><a href="https://discord.gg/9Jz2d5PkwB" target="_blank">Join the Discord →</a>`
        },

        {
            keywords: ['handbook', 'rulebook', 'rules book'],
            response: `The official VIM Handbook contains the league's rules and regulations.<br><br><a href="https://vimsuperleague-rulebook.base44.app/" target="_blank">Open Official Handbook →</a>`
        },

        {
            keywords: ['home', 'homepage', 'main page'],
            response: `You're already on the VIM home base 😭. The homepage gives you quick access to fixtures, broadcasts, recent results, league stories and the main navigation.`
        },

        {
            keywords: ['admin', 'administrator', 'dashboard'],
            response: `The <strong>Admin</strong> area is for authorised league management and administrative tools. If you're not a league administrator, you probably won't need to use it.`
        },

        {
            keywords: ['goal', 'goals', 'scoring'],
            response: `Goals are one of the core player performance statistics tracked across VIM. For the current player numbers, check the <strong>Metrics</strong> section or individual player information.<br><br><a href="/metrics">Open Metrics →</a>`
        },

        {
            keywords: ['assist', 'assists'],
            response: `Assists are tracked as part of player performance statistics. The Metrics section is the place to inspect league-wide performance data.<br><br><a href="/metrics">Open Metrics →</a>`
        },

        {
            keywords: ['save', 'saves', 'goalkeeper', 'keeper', 'gk'],
            response: `Saves are tracked as a player statistic, particularly useful for evaluating goalkeepers. Check the Metrics section for league performance data.<br><br><a href="/metrics">Open Metrics →</a>`
        },

        {
            keywords: ['mvp', 'most valuable', 'valuable player'],
            response: `MVPs are tracked as a player achievement/performance statistic. You can use Metrics to explore player performance data.`
        },

        {
            keywords: ['position', 'positions', 'fwd', 'mid', 'def', 'forward', 'defender', 'midfielder'],
            response: `Player positions describe their role on the pitch. VIM player cards can contain position information alongside their other player details. Check the <strong>Player Market</strong> to scout the available cards.<br><br><a href="/market">Open Player Market →</a>`
        },

        {
            keywords: ['profile', 'account', 'login', 'sign in'],
            response: `Your player/account area is available through the profile button in the navbar. If you're signed in, you'll see your account badge there.`
        },

        {
            keywords: ['hello', 'hi', 'hey', 'yo', 'sup', 'wassup', 'wsp'],
            response: `Yooo 😭 What's good? I'm the VIM Assistant. Ask me about the Market, Matches, Metrics, Records, rules or how the league works.`
        },

        {
            keywords: ['who are you', 'what are you', 'ai', 'assistant'],
            response: `I'm the <strong>VIM Assistant</strong> ✦. Right now I'm a local knowledge assistant built directly into the VIM website. I'm not connected to a real AI model yet — that's the next evolution 👀.`
        },

        {
            keywords: ['help', 'what can you do', 'commands'],
            response: `I can currently explain the main VIM sections, including:<br><br>• Player Market<br>• Matches & fixtures<br>• Metrics & stats<br>• League Records<br>• League information<br>• Community & Handbook<br>• Player registration basics<br><br>Try asking me something naturally!`
        }

    ];


    /* ---------------------------------------------------------
       RESPONSE ENGINE
       --------------------------------------------------------- */

    function generateResponse(question) {

        const normalized = question
            .toLowerCase()
            .replace(/[?!.,]/g, ' ')
            .replace(/\s+/g, ' ')
            .trim();

        if (!normalized) {
            return `Ask me something about VIM 👀`;
        }


        let bestMatch = null;
        let bestScore = 0;

        knowledgeBase.forEach(item => {

            let score = 0;

            item.keywords.forEach(keyword => {

                if (normalized.includes(keyword)) {

                    score += keyword.length >= 8 ? 3 : 2;

                }

            });

            if (score > bestScore) {
                bestScore = score;
                bestMatch = item;
            }

        });


        if (bestMatch && bestScore > 0) {
            return bestMatch.response;
        }


        /* Basic navigation detection */

        if (normalized.includes('where') && normalized.includes('market')) {
            return `The Player Market is in the main navigation at the top of the site.<br><br><a href="/market">Go to Market →</a>`;
        }

        if (normalized.includes('where') && normalized.includes('match')) {
            return `Matches are available from the main navigation.<br><br><a href="/matches">Go to Matches →</a>`;
        }


        /* Unknown question fallback */

        return `Hmm, I don't have that one in my VIM knowledge base yet 😭.<br><br>
        Try asking about the <strong>Player Market</strong>, <strong>Matches</strong>, <strong>Metrics</strong>, <strong>League Records</strong>, the <strong>Handbook</strong>, or how to <strong>join VIM</strong>.`;
    }


    /* ---------------------------------------------------------
       ADD MESSAGE
       --------------------------------------------------------- */

    function addMessage(content, type) {

        const message = document.createElement('div');

        message.className = `vim-ai-message ${type}`;
        message.innerHTML = content;

        messages.appendChild(message);

        messages.scrollTop = messages.scrollHeight;

        return message;
    }


    /* ---------------------------------------------------------
       TYPING EFFECT
       --------------------------------------------------------- */

    function showTyping() {

        const typing = document.createElement('div');

        typing.className = 'vim-ai-typing';
        typing.id = 'vim-ai-typing';

        typing.innerHTML = `
            <span></span>
            <span></span>
            <span></span>
        `;

        messages.appendChild(typing);

        messages.scrollTop = messages.scrollHeight;

    }


    function removeTyping() {

        const typing = document.getElementById('vim-ai-typing');

        if (typing) {
            typing.remove();
        }

    }


    /* ---------------------------------------------------------
       ASK AI
       --------------------------------------------------------- */

    window.askVimAI = function(question) {

        if (!question || !question.trim()) return;

        const cleanQuestion = question.trim();

        addMessage(
            escapeHtml(cleanQuestion),
            'user'
        );

        showTyping();

        const delay = 500 + Math.random() * 650;

        setTimeout(() => {

            removeTyping();

            const response = generateResponse(cleanQuestion);

            addMessage(response, 'bot');

        }, delay);

    };


    /* ---------------------------------------------------------
       FORM SUBMISSION
       --------------------------------------------------------- */

    window.handleVimAISubmit = function(event) {

        event.preventDefault();

        const question = input.value.trim();

        if (!question) return;

        input.value = '';

        askVimAI(question);

    };


    /* ---------------------------------------------------------
       OPEN / CLOSE
       --------------------------------------------------------- */

    window.toggleVimAI = function(forceState) {

        let shouldOpen;

        if (typeof forceState === 'boolean') {
            shouldOpen = forceState;
        } else {
            shouldOpen = !panel.classList.contains('active');
        }

        if (shouldOpen) {

            panel.classList.add('active');

            setTimeout(() => {
                input.focus();
            }, 180);

        } else {

            panel.classList.remove('active');

        }

    };


    /* ---------------------------------------------------------
       ESCAPE HTML
       --------------------------------------------------------- */

    function escapeHtml(text) {

        const div = document.createElement('div');

        div.textContent = text;

        return div.innerHTML;

    }


    /* ---------------------------------------------------------
       CLOSE WHEN CLICKING OUTSIDE
       --------------------------------------------------------- */

    document.addEventListener('click', function(event) {

        if (!panel.classList.contains('active')) return;

        const aiButton = document.getElementById('vim-ai-button');

        if (
            !panel.contains(event.target) &&
            aiButton &&
            !aiButton.contains(event.target)
        ) {
            panel.classList.remove('active');
        }

    });


    /* ---------------------------------------------------------
       ESC TO CLOSE
       --------------------------------------------------------- */

    document.addEventListener('keydown', function(event) {

        if (event.key === 'Escape' && panel.classList.contains('active')) {
            panel.classList.remove('active');
        }

    });


    /* ---------------------------------------------------------
       AI KEYBOARD SHORTCUT
       Ctrl + /
       --------------------------------------------------------- */

    document.addEventListener('keydown', function(event) {

        if (
            event.ctrlKey &&
            event.key === '/'
        ) {

            event.preventDefault();

            toggleVimAI(true);

        }

    });

})();


/* =========================================================
   VIM LEAGUE GUIDE BRIDGE
   =========================================================

   The actual tour lives in index.ejs.

   The navbar ? dispatches this event.
   This listener finds the original homepage
   tour launcher and triggers it.

   This means the original tour code remains
   completely untouched.
   ========================================================= */

window.addEventListener('vim:open-tour', function() {

    const tourLauncher = document.getElementById('vim-tour-launcher');

    if (tourLauncher) {
        tourLauncher.click();
    }

});


/* =========================================================
   VIM CUSTOM CURSOR
   ========================================================= */

(function() {

    if (!window.matchMedia('(pointer: fine)').matches) {
        return;
    }

    const dot = document.createElement('div');
    const ring = document.createElement('div');

    dot.id = 'vim-cursor-dot';
    ring.id = 'vim-cursor-ring';

    document.body.appendChild(ring);
    document.body.appendChild(dot);


    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;

    let ringX = mouseX;
    let ringY = mouseY;

    let mouseInside = false;


    function updateCursor() {

        dot.style.left = mouseX + 'px';
        dot.style.top = mouseY + 'px';

        ringX += (mouseX - ringX) * 0.16;
        ringY += (mouseY - ringY) * 0.16;

        ring.style.left = ringX + 'px';
        ring.style.top = ringY + 'px';

        requestAnimationFrame(updateCursor);

    }


    document.addEventListener('mousemove', function(event) {

        mouseX = event.clientX;
        mouseY = event.clientY;

        if (!mouseInside) {
            mouseInside = true;

            dot.classList.remove('hidden');
            ring.classList.remove('hidden');
        }

    });


    document.addEventListener('mouseleave', function() {

        mouseInside = false;

        dot.classList.add('hidden');
        ring.classList.add('hidden');

    });


    document.addEventListener('mouseenter', function() {

        mouseInside = true;

        dot.classList.remove('hidden');
        ring.classList.remove('hidden');

    });


    document.addEventListener('mouseover', function(event) {

        const target = event.target;

        if (
            target.closest('a') ||
            target.closest('button') ||
            target.closest('input') ||
            target.closest('textarea') ||
            target.closest('select') ||
            target.closest('[role="button"]')
        ) {

            dot.classList.add('hover');
            ring.classList.add('hover');

        }

    });


    document.addEventListener('mouseout', function(event) {

        const target = event.target;

        if (
            target.closest('a') ||
            target.closest('button') ||
            target.closest('input') ||
            target.closest('textarea') ||
            target.closest('select') ||
            target.closest('[role="button"]')
        ) {

            dot.classList.remove('hover');
            ring.classList.remove('hover');

        }

    });


    document.addEventListener('mousedown', function() {

        ring.classList.add('click');

    });


    document.addEventListener('mouseup', function() {

        ring.classList.remove('click');

    });


    document.addEventListener('click', function(event) {

        const ripple = document.createElement('div');

        ripple.className = 'vim-cursor-ripple';

        ripple.style.left = event.clientX + 'px';
        ripple.style.top = event.clientY + 'px';

        document.body.appendChild(ripple);

        setTimeout(function() {
            ripple.remove();
        }, 600);

    });


    updateCursor();

})();
</script>