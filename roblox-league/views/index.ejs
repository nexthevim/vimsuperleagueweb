<!-- RESULTS -->
<section class="pc-wrap pc-band" id="tour-results">
    <div class="pc-section-head reveal">
        <div>
            <div class="pc-label">Scoreboard</div>
            <h2 class="pc-serif">Recent results</h2>
        </div>
        <a href="/matches" class="pc-link">Full list →</a>
    </div>
    <div class="pc-results">
        <%
            const recent = matchList
                .filter(m => m.status === 'completed' || m.status === 'complete' || (m.details && (m.details.goalsA != null || m.details.goalsB != null)))
                .slice(-8)
                .reverse();
        %>
        <% if (recent.length) { %>
            <% recent.forEach((r, i) => { %>
                <a class="pc-result reveal reveal-d<%= (i % 4) + 1 %>" href="/match/<%= r._id || r.id || '' %>">
                    <div class="pc-result-row">
                        <div class="pc-result-team">
                            <img src="<%= r.logoA %>" alt="">
                            <span><%= r.teamA %></span>
                        </div>
                        <span class="pc-result-score"><%= (r.details && r.details.goalsA != null) ? r.details.goalsA : 0 %></span>
                    </div>
                    <div class="pc-result-row">
                        <div class="pc-result-team">
                            <img src="<%= r.logoB %>" alt="">
                            <span style="color:var(--soft)"><%= r.teamB %></span>
                        </div>
                        <span class="pc-result-score dim"><%= (r.details && r.details.goalsB != null) ? r.details.goalsB : 0 %></span>
                    </div>
                </a>
            <% }) %>
        <% } else { %>
            <div class="pc-empty" style="grid-column:1/-1">No results yet</div>
        <% } %>
    </div>
</section>

<!-- STORIES -->
<section class="pc-wrap pc-band">
    <div class="pc-section-head reveal">
        <div>
            <div class="pc-label">Journal</div>
            <h2 class="pc-serif">League stories</h2>
        </div>
    </div>
    <div class="pc-stories">
        <% if (typeof stories !== 'undefined' && stories && stories.length) { %>
            <% stories.slice().reverse().slice(0, 6).forEach((story, i) => { %>
                <article class="pc-story reveal reveal-d<%= (i % 3) + 1 %>">
                    <div class="pc-story-img">
                        <% if (story.image) { %><img src="<%= story.image %>" alt=""><% } %>
                    </div>
                    <div class="pc-story-body">
                        <small><%= story.date || 'Article' %></small>
                        <h3><%= story.title %></h3>
                        <p><%= story.description %></p>
                    </div>
                </article>
            <% }) %>
        <% } else { %>
            <div class="pc-empty" style="grid-column:1/-1">Stories will appear here</div>
