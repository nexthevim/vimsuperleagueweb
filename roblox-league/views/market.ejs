<%- include('partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
/* =========================================================
   VIM MARKET — editorial skin (matches profile hub)
========================================================= */
:root {
    --mk-paper: #f4f1e9;
    --mk-paper-2: #fffdf8;
    --mk-ink: #123b3c;
    --mk-ink-deep: #073536;
    --mk-teal: #07595a;
    --mk-teal-2: #0a7778;
    --mk-coral: #f18470;
    --mk-coral-dark: #d96756;
    --mk-mint: #d9ece6;
    --mk-muted: #728081;
    --mk-line: rgba(18,59,60,.105);
    --mk-line-strong: rgba(18,59,60,.16);
    --mk-display: "DM Serif Display", Georgia, serif;
    --mk-body: "Manrope", system-ui, sans-serif;
    --mk-radius: 1.5rem;
    --mk-shadow: 0 12px 40px rgba(18,59,60,.055), 0 2px 8px rgba(18,59,60,.035);
}

html { scroll-behavior: smooth; }
body { margin: 0; font-family: var(--mk-body); }

main.py-16, main {
    background:
        radial-gradient(circle at 8% 8%, rgba(241,132,112,.10), transparent 22rem),
        radial-gradient(circle at 92% 18%, rgba(7,89,90,.08), transparent 26rem),
        radial-gradient(circle at 50% 100%, rgba(217,236,230,.55), transparent 30rem),
        var(--mk-paper) !important;
    color: var(--mk-ink) !important;
    font-family: var(--mk-body);
    padding-top: 5.5rem !important;
    padding-bottom: 3.5rem !important;
}

.mk-display { font-family: var(--mk-display); font-weight: 400; letter-spacing: -.025em; }
.mk-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    color: var(--mk-coral-dark); font-size: .61rem; font-weight: 800;
    letter-spacing: .17em; text-transform: uppercase;
}
.mk-eyebrow::before { content: ""; width: 16px; height: 1px; background: currentColor; }

/* shell */
.mk-shell { width: min(1200px, calc(100% - 2rem)); margin: 0 auto; }

/* panel cards */
.mk-panel {
    background: rgba(255,253,248,.88);
    border: 1px solid var(--mk-line);
    border-radius: var(--mk-radius);
    box-shadow: var(--mk-shadow);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
}

/* buttons */
.mk-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 42px; padding: 0 16px; border-radius: 999px; border: 0;
    font-family: inherit; font-size: .62rem; font-weight: 800;
    letter-spacing: .08em; text-transform: uppercase; text-decoration: none;
    cursor: pointer;
    transition: transform .22s cubic-bezier(.22,1,.36,1), box-shadow .22s ease, background .22s ease;
}
.mk-btn:hover { transform: translateY(-2px); }
.mk-btn:active { transform: translateY(0) scale(.98); }
.mk-btn-teal { background: var(--mk-teal); color: #fff; box-shadow: 0 8px 22px rgba(7,89,90,.18); }
.mk-btn-teal:hover { background: var(--mk-teal-2); color: #fff; }
.mk-btn-coral { background: var(--mk-coral); color: #fff; box-shadow: 0 8px 22px rgba(241,132,112,.2); }
.mk-btn-coral:hover { background: #ed7966; color: #fff; }
.mk-btn-ghost {
    background: rgba(255,255,255,.5); color: var(--mk-ink);
    border: 1px solid var(--mk-line-strong); box-shadow: none;
}
.mk-btn-ghost:hover { background: #fff; color: var(--mk-ink); }

/* underline link */
.mk-link {
    position: relative; color: var(--mk-teal); font-weight: 800; font-size: .68rem;
    letter-spacing: .06em; text-transform: uppercase; text-decoration: none;
}
.mk-link::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -3px; height: 1.5px;
    background: currentColor; transform: scaleX(0); transform-origin: right;
    transition: transform .28s cubic-bezier(.22,1,.36,1);
}
.mk-link:hover::after { transform: scaleX(1); transform-origin: left; }

/* header */
.mk-header {
    display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between;
    gap: 1.25rem; margin-bottom: 1.25rem; padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--mk-line);
}
.mk-header h1 {
    margin: .3rem 0 0; font-size: clamp(2.4rem, 5vw, 3.4rem); line-height: .92;
    color: var(--mk-ink-deep);
}
.mk-header h1 em { font-style: italic; color: var(--mk-teal); }
.mk-header p { margin: .35rem 0 0; color: var(--mk-muted); font-size: .82rem; }

/* controls bar */
.mk-controls {
    display: flex; flex-wrap: wrap; align-items: center; gap: .55rem;
    padding: .85rem 1rem; margin-bottom: 1.25rem;
}
.mk-mode {
    display: flex; background: rgba(18,59,60,.06); padding: 4px; border-radius: 999px;
}
.mk-mode button {
    border: 0; border-radius: 999px; padding: .55rem 1.1rem;
    font-family: inherit; font-size: .62rem; font-weight: 800;
    letter-spacing: .08em; text-transform: uppercase; cursor: pointer;
    background: transparent; color: var(--mk-muted);
    transition: background .2s ease, color .2s ease, box-shadow .2s ease;
}
.mk-mode button.is-on {
    background: #fff; color: var(--mk-ink-deep);
    box-shadow: 0 4px 14px rgba(18,59,60,.1);
}

.mk-search {
    position: relative; flex: 1; min-width: 180px; max-width: 280px;
}
.mk-search input {
    width: 100%; padding: .7rem 1rem .7rem 2.35rem; border-radius: 999px;
    border: 1.5px solid var(--mk-line); background: #fff; color: var(--mk-ink);
    font-family: inherit; font-size: .8rem; font-weight: 600; outline: none;
    transition: border-color .2s, box-shadow .2s;
}
.mk-search input:focus {
    border-color: var(--mk-teal); box-shadow: 0 0 0 4px rgba(7,89,90,.1);
}
.mk-search svg {
    position: absolute; left: .85rem; top: 50%; transform: translateY(-50%);
    width: 15px; height: 15px; color: var(--mk-muted); pointer-events: none;
}

.mk-filters {
    display: flex; flex-wrap: wrap; gap: .3rem;
    padding: 4px; border-radius: 999px; background: rgba(18,59,60,.05);
}
.mk-filters .filter-btn {
    border: 0; border-radius: 999px; padding: .45rem .75rem;
    font-family: inherit; font-size: .58rem; font-weight: 800;
    letter-spacing: .06em; text-transform: uppercase; cursor: pointer;
    background: transparent; color: var(--mk-muted);
    transition: background .18s, color .18s, transform .18s;
}
.mk-filters .filter-btn:hover { color: var(--mk-ink); transform: translateY(-1px); }
.mk-filters .filter-btn.active {
    background: var(--mk-ink-deep); color: #fff;
}

.mk-count {
    padding: .55rem .9rem; border-radius: 999px;
    background: var(--mk-mint); color: var(--mk-teal);
    font-size: .58rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
}

/* section title */
.mk-section-head {
    display: flex; align-items: center; justify-content: space-between; gap: .75rem;
    margin-bottom: 1rem;
}
.mk-section-head h3 {
    margin: .15rem 0 0; font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    color: var(--mk-ink-deep); line-height: 1;
}

/* MULTI-DIRECTIONAL CONVEYOR */
@keyframes scrollLeft { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
@keyframes scrollRight { 0% { transform: translateX(-50%); } 100% { transform: translateX(0); } }
.animate-conveyor-1 { display: flex; animation: scrollLeft 32s linear infinite; width: max-content; }
.animate-conveyor-2 { display: flex; animation: scrollRight 38s linear infinite; width: max-content; }
.animate-conveyor-1:hover, .animate-conveyor-2:hover { animation-play-state: paused; }

/* GLASS + CARD */
.glass-light {
    background: rgba(255, 253, 248, 0.95);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(18, 59, 60, 0.1);
    box-shadow: 0 16px 36px -12px rgba(18, 59, 60, 0.08);
}

.player-card {
    transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.3s ease, border-color 0.3s ease;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transform-style: preserve-3d;
    perspective: 1000px;
    background: rgba(255, 253, 248, 0.97);
    border-radius: 1.5rem !important;
}
.player-card:hover {
    z-index: 20;
    border-color: rgba(7, 89, 90, 0.45) !important;
    box-shadow: 0 0 32px rgba(7, 89, 90, 0.18), 0 20px 40px -10px rgba(18, 59, 60, 0.14);
}

.card-sheen {
    position: absolute; inset: 0;
    background: linear-gradient(115deg, transparent 20%, rgba(255,255,255,0.65) 45%, rgba(255,255,255,0.9) 50%, rgba(255,255,255,0.65) 55%, transparent 80%);
    pointer-events: none; z-index: 12; opacity: 0; transform: translateX(-100%);
    transition: opacity 0.3s ease;
}
.player-card:hover .card-sheen {
    opacity: 1; transform: translateX(100%);
    transition: transform 0.8s ease-in-out, opacity 0.3s ease;
}

.pos-fwd { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; }
.pos-mid { background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: #fff; }
.pos-def { background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; }
.pos-gk  { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; }
.pos-pro { background: linear-gradient(135deg, #64748b, #475569); color: #fff; }

.rank-ss { background: linear-gradient(135deg, #ec4899, #a855f7, #f59e0b); background-size: 200% 200%; animation: rankShimmer 3s ease infinite; color: #fff; border: 1px solid rgba(255,255,255,0.6); }
.rank-s { background: linear-gradient(135deg, #f59e0b, #ef4444); color: #fff; border: 1px solid #fef08a; }
.rank-a { background: linear-gradient(135deg, #8b5cf6, #3b82f6); color: #fff; }
.rank-b { background: linear-gradient(135deg, #10b981, #059669); color: #fff; }
.rank-c { background: linear-gradient(135deg, #64748b, #475569); color: #fff; }

@keyframes rankShimmer {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

.card-img {
    filter: grayscale(100%) contrast(1.05);
    transition: filter 0.5s cubic-bezier(0.4, 0, 0.2, 1), transform 0.5s ease;
}
.player-card:hover .card-img {
    filter: grayscale(0%) contrast(1);
    transform: scale(1.06);
}

.card-active-anim {
    animation: sleekClick 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    pointer-events: none;
}
@keyframes sleekClick {
    0% { transform: scale(1); box-shadow: 0 0 0 rgba(7,89,90,0); }
    50% { transform: scale(1.05); box-shadow: 0 0 30px rgba(7,89,90,0.4); }
    100% { transform: scale(1.02); opacity: 0.9; }
}

/* MODAL */
.modal {
    display: none; position: fixed; inset: 0;
    background: rgba(7, 20, 20, 0); z-index: 100;
    align-items: center; justify-content: center; padding: 20px;
    backdrop-filter: blur(0px); transition: all 0.4s ease;
}
.modal.active { background: rgba(7, 20, 20, 0.55); backdrop-filter: blur(16px); }
#modalContainer {
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    transform: translateY(30px) scale(0.96); opacity: 0;
}
#modalContainer.show { transform: translateY(0) scale(1); opacity: 1; }

.stat-badge {
    background: rgba(241, 245, 249, 0.85);
    border: 1px solid rgba(226, 232, 240, 1);
    backdrop-filter: blur(8px);
}

.form-label {
    display: block; font-size: 0.62rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--mk-muted); margin-bottom: 0.35rem;
}
.form-input {
    width: 100%; background: #fffdf8; border: 1.5px solid var(--mk-line);
    padding: 0.75rem 1rem; border-radius: 0.9rem; outline: none;
    transition: all 0.25s ease; color: var(--mk-ink); font-weight: 700; font-size: 0.85rem;
    font-family: inherit;
}
.form-input:focus {
    border-color: var(--mk-teal); background: #ffffff;
    box-shadow: 0 0 0 4px rgba(7, 89, 90, 0.1);
}
select.form-input option { background: #ffffff; color: #0f172a; }
.position-radio:checked + label {
    border-color: var(--mk-teal); background: var(--mk-mint); color: var(--mk-teal);
    box-shadow: 0 0 0 2px var(--mk-teal);
}
.hidden-form { display: none !important; }

.custom-scroll::-webkit-scrollbar { width: 4px; }
.custom-scroll::-webkit-scrollbar-track { background: rgba(241, 245, 249, 0.5); }
.custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

.team-tile {
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    border-radius: 1.25rem !important;
}
.team-tile.active {
    border-color: transparent;
    box-shadow: 0 0 0 3px hsl(var(--team-hue) 75% 52%), 0 20px 35px -15px rgba(15, 23, 42, 0.2);
    transform: translateY(-3px);
}

#spotlightTopFull .text-slate-400,
#spotlightPosFull .text-slate-400,
#spotlightRisingFull .text-slate-400 { color: #94a3b8 !important; }

/* spotlight panel */
.mk-spotlight {
    position: relative; overflow: hidden;
    border-radius: 1.75rem; margin-bottom: 2rem;
    border: 1px solid var(--mk-line);
    background:
        radial-gradient(circle at 15% 10%, rgba(241,132,112,.1), transparent 40%),
        radial-gradient(circle at 85% 70%, rgba(7,89,90,.07), transparent 45%),
        rgba(255,253,248,.92);
    box-shadow: var(--mk-shadow);
}
.mk-spotlight-inner { position: relative; padding: 1.5rem 1.35rem 1.75rem; }

/* auction hub */
#auctionSection .mk-panel { margin-bottom: 1rem; }

/* fade-up */
@keyframes mkFadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
}
.mk-fade { animation: mkFadeUp .55s cubic-bezier(.22,1,.36,1) both; }

/* auth boxes */
#registerBox, #loginBox {
    border-radius: 1.5rem !important;
    border-color: var(--mk-line) !important;
    background: rgba(255,253,248,.95) !important;
}

@media (max-width: 640px) {
    .mk-header h1 { font-size: 2.3rem; }
    .mk-controls { padding: .75rem; }
}

/* ===== LEADERBOARD PRO ===== */
.mk-spot-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 1rem; margin-bottom: 1.5rem;
}
.mk-spot-head h3 {
    margin: .2rem 0 0; font-family: var(--mk-display);
    font-size: 1.55rem; line-height: 1; color: var(--mk-ink-deep);
}
.mk-spot-head p { margin: .3rem 0 0; font-size: .72rem; color: var(--mk-muted); }
.mk-spot-btn {
    border: 0; border-radius: 999px; padding: .6rem 1.15rem;
    font-family: inherit; font-size: .6rem; font-weight: 800;
    letter-spacing: .08em; text-transform: uppercase; cursor: pointer;
    background: var(--mk-ink-deep); color: #fff;
    box-shadow: 0 8px 20px rgba(7,53,54,.15);
    transition: transform .2s ease, background .2s ease;
}
.mk-spot-btn:hover { transform: translateY(-2px); background: var(--mk-teal); }

.mk-lb-block { margin-bottom: 1.75rem; }
.mk-lb-block:last-child { margin-bottom: 0; }
.mk-lb-label {
    display: flex; align-items: center; gap: .5rem;
    margin: 0 0 1rem; font-size: .6rem; font-weight: 800;
    letter-spacing: .14em; text-transform: uppercase; color: var(--mk-muted);
}
.mk-lb-label .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--mk-coral);
}

.mk-podium {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem; align-items: end; justify-items: center;
    perspective: 1400px; padding: .5rem 0 1rem;
}
@media (max-width: 820px) {
    .mk-podium { grid-template-columns: 1fr; }
}
.mk-pod-slot {
    position: relative; display: flex; flex-direction: column; align-items: center;
    animation: mkPodIn .55s cubic-bezier(.22,1,.36,1) both;
}
.mk-pod-slot:nth-child(1) { animation-delay: .05s; }
.mk-pod-slot:nth-child(2) { animation-delay: .12s; }
.mk-pod-slot:nth-child(3) { animation-delay: .18s; }
@keyframes mkPodIn {
    from { opacity: 0; transform: translateY(22px) scale(.96); }
    to { opacity: 1; transform: none; }
}
.mk-pod-slot.is-first { transform: translateY(-10px); }
.mk-pod-slot.is-first .player-card { width: 236px !important; height: 318px !important; }
.mk-pod-slot:not(.is-first) .player-card { width: 200px !important; height: 278px !important; }
@media (max-width: 820px) {
    .mk-pod-slot.is-first { transform: none; }
    .mk-pod-slot.is-first .player-card,
    .mk-pod-slot:not(.is-first) .player-card { width: 220px !important; height: 300px !important; }
}
.mk-pod-medal {
    position: absolute; top: -14px; z-index: 25;
    font-size: 1.55rem; filter: drop-shadow(0 6px 10px rgba(0,0,0,.2));
    animation: mkMedal .8s cubic-bezier(.22,1,.36,1) both;
}
@keyframes mkMedal {
    from { opacity: 0; transform: translateY(-8px) scale(.6); }
    to { opacity: 1; transform: none; }
}
.mk-pod-base {
    margin-top: .65rem; width: 70%; height: 6px; border-radius: 999px;
    background: linear-gradient(90deg, transparent, rgba(18,59,60,.12), transparent);
}

/* full list */
.mk-top10 {
    margin-top: .85rem; border-radius: 1.15rem; overflow: hidden;
    border: 1px solid var(--mk-line); background: rgba(255,255,255,.75);
    max-height: 0; opacity: 0; transform: translateY(6px);
    transition: max-height .4s cubic-bezier(.22,1,.36,1), opacity .3s ease, transform .3s ease;
}
.mk-top10.is-open {
    max-height: 420px; opacity: 1; transform: none;
    overflow-y: auto;
}
.mk-top10-row {
    display: flex; align-items: center; justify-content: space-between; gap: .75rem;
    padding: .7rem 1rem; border-bottom: 1px solid var(--mk-line);
    transition: background .15s;
}
.mk-top10-row:last-child { border-bottom: 0; }
.mk-top10-row:hover { background: rgba(7,89,90,.04); }
.mk-top10-n {
    width: 1.55rem; height: 1.55rem; border-radius: 50%;
    display: grid; place-items: center; flex-shrink: 0;
    font-size: .65rem; font-weight: 800;
    background: rgba(18,59,60,.08); color: var(--mk-ink);
}
.mk-top10-n.gold { background: linear-gradient(135deg,#f5d78e,#c9a227); color: #fff; }
.mk-top10-n.silver { background: linear-gradient(135deg,#e2e8f0,#94a3b8); color: #fff; }
.mk-top10-n.bronze { background: linear-gradient(135deg,#fdba74,#c2410c); color: #fff; }

/* ===== CARD PREVIEW UPGRADE ===== */
.player-card {
    border-radius: 1.4rem !important;
    box-shadow:
        0 1px 0 rgba(255,255,255,.5) inset,
        0 18px 40px -16px rgba(18,59,60,.2) !important;
}
.player-card::before {
    content: "";
    position: absolute; inset: 0; z-index: 5; pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.12);
}
.player-card .mk-card-foot {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 20;
    padding: 2.5rem 1rem .95rem;
    background: linear-gradient(to top, rgba(8,16,16,.95) 12%, rgba(8,16,16,.55) 55%, transparent);
}
.player-card .mk-card-foot h3 {
    margin: 0; color: #fff; font-size: 1.15rem; font-weight: 900;
    font-style: italic; text-transform: uppercase; letter-spacing: -.03em;
    line-height: 1.05; text-shadow: 0 2px 8px rgba(0,0,0,.35);
}
.player-card .mk-card-meta {
    display: flex; align-items: center; justify-content: space-between; gap: .5rem;
    margin-top: .35rem;
}
.player-card .mk-card-bid {
    font-size: .72rem; font-weight: 800; color: #6ee7b7;
}
.player-card .mk-card-team {
    font-size: .62rem; font-weight: 700; color: rgba(255,255,255,.55);
    text-transform: uppercase; max-width: 48%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.player-card .mk-card-ribbon {
    position: absolute; top: 0; right: 0; z-index: 21;
    padding: .35rem .65rem .35rem .85rem;
    border-radius: 0 1.4rem 0 1rem;
    font-size: .55rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase;
    background: rgba(0,0,0,.45); color: #fff; backdrop-filter: blur(8px);
}

/* ===== MODAL PROFILE UPGRADE ===== */
#modalContainer {
    background: transparent !important;
}
.mk-modal-card {
    border-radius: 1.75rem !important;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0,0,0,.35) !important;
}
.mk-modal-side {
    background: rgba(255,253,248,.97) !important;
    border-radius: 1.75rem !important;
    border: 1px solid var(--mk-line) !important;
    box-shadow: 0 24px 50px rgba(18,59,60,.12) !important;
}
#modalBiddingBox {
    border-radius: 1.25rem !important;
    border-color: var(--mk-line) !important;
    background: #fff !important;
}
#modalQuickBidRow button {
    border-radius: .9rem !important;
    font-family: var(--mk-body) !important;
    transition: transform .15s ease, background .15s ease !important;
}
#modalQuickBidRow button:hover {
    transform: translateY(-2px);
    background: var(--mk-teal) !important;
    color: #fff !important;
    border-color: var(--mk-teal) !important;
}
#modalBidButton {
    border-radius: 999px !important;
    letter-spacing: .08em !important;
    box-shadow: 0 8px 20px rgba(18,59,60,.15);
}

/* ===== AUDIT FEED ===== */
.mk-feed {
    background: rgba(255,253,248,.95);
    border: 1px solid var(--mk-line);
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: var(--mk-shadow);
    max-height: 28rem;
}
.mk-feed-item {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: .75rem;
    align-items: start;
    padding: .9rem 1.1rem;
    border-bottom: 1px solid var(--mk-line);
    transition: background .15s;
}
.mk-feed-item:last-child { border-bottom: 0; }
.mk-feed-item:hover { background: rgba(7,89,90,.03); }
.mk-feed-icon {
    width: 2.35rem; height: 2.35rem; border-radius: .85rem;
    display: grid; place-items: center; font-size: .95rem;
    background: rgba(18,59,60,.06);
}
.mk-feed-icon.bid { background: rgba(5,150,105,.12); }
.mk-feed-icon.withdraw { background: rgba(217,119,6,.12); }
.mk-feed-icon.won { background: rgba(5,150,105,.15); }
.mk-feed-icon.start { background: rgba(18,59,60,.1); }
.mk-feed-icon.end { background: rgba(225,29,72,.1); }
.mk-feed-icon.rank { background: rgba(124,58,237,.12); }
.mk-feed-title {
    margin: 0; font-size: .72rem; font-weight: 800;
    letter-spacing: .04em; text-transform: uppercase;
}
.mk-feed-detail {
    margin: .2rem 0 0; font-size: .78rem; color: var(--mk-ink);
    font-weight: 600; line-height: 1.35;
}
.mk-feed-sub {
    margin: .15rem 0 0; font-size: .65rem; color: var(--mk-muted); font-weight: 600;
}
.mk-feed-amt {
    text-align: right; font-weight: 800; font-size: .9rem; color: var(--mk-teal);
    white-space: nowrap;
}
.mk-feed-time {
    display: block; margin-top: .15rem; font-size: .6rem; color: var(--mk-muted); font-weight: 600;
}

/* lane polish */
.mk-lane-bar {
    border-radius: 1.5rem !important;
    border: 1px solid var(--mk-line) !important;
    background: rgba(255,253,248,.55) !important;
    overflow: hidden;
}

</style>


<% if (typeof error !== 'undefined' && error) { %>
    <div class="fixed top-24 left-1/2 -translate-x-1/2 z-[100] bg-red-600 text-white px-8 py-4 rounded-full font-black uppercase italic shadow-[0_15px_30px_rgba(220,38,38,0.3)] border border-white/20 text-xs tracking-wider">
        ⚠️ <%= error %>
    </div>
<% } %>

<main class="py-16 min-h-screen overflow-hidden mk-fade">
    <div class="mk-shell">
    <!-- MARKET HEADER -->
    <div class="mk-header">
        <div>
            <div class="mk-eyebrow">VIM Super League</div>
            <h1 class="mk-display">Player <em>Market</em></h1>
            <p>Scout cards, filter by class, and jump into the auction hub.</p>
        </div>
        <div class="mk-mode" role="tablist">
            <button type="button" id="viewMarketBtn" onclick="switchMode('market')" class="is-on">Market</button>
            <button type="button" id="viewAuctionBtn" onclick="switchMode('auction')">Auction Hub</button>
        </div>
    </div>

    <!-- CONTROLS -->
    <div class="mk-controls mk-panel">
        <div class="mk-search" id="searchWrapper">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input type="text" id="searchInput" onkeyup="filterCards()" placeholder="Search name, Discord, country…">
        </div>
        <div class="mk-filters" id="filterWrapper">
            <button data-pos-filter="ALL" onclick="setFilter('ALL')" class="filter-btn active">ALL</button>
            <button data-pos-filter="FWD" onclick="setFilter('FWD')" class="filter-btn">FWD</button>
            <button data-pos-filter="MID" onclick="setFilter('MID')" class="filter-btn">MID</button>
            <button data-pos-filter="DEF" onclick="setFilter('DEF')" class="filter-btn">DEF</button>
            <button data-pos-filter="GK" onclick="setFilter('GK')" class="filter-btn">GK</button>
        </div>
        <div class="mk-filters" id="classFilterWrapper">
            <button data-class-filter="ALL" onclick="setClassFilter('ALL')" class="filter-btn active">ALL CLASS</button>
            <button data-class-filter="SS" onclick="setClassFilter('SS')" class="filter-btn">SS</button>
            <button data-class-filter="S" onclick="setClassFilter('S')" class="filter-btn">S</button>
            <button data-class-filter="A" onclick="setClassFilter('A')" class="filter-btn">A</button>
            <button data-class-filter="B" onclick="setClassFilter('B')" class="filter-btn">B</button>
            <button data-class-filter="C" onclick="setClassFilter('C')" class="filter-btn">C</button>
        </div>
        <% if (typeof isManager !== 'undefined' && isManager) { %>
            <button id="eligibleFilterBtn" onclick="toggleEligibleFilter()" title="Only show players you can currently legally bid on"
                class="mk-btn mk-btn-ghost" style="min-height:36px;font-size:.58rem">I can bid</button>
        <% } %>
        <div class="mk-count" id="countWrapper">● Players: <%= players.length %></div>
    </div>


    <!-- AUCTION OVERRIDE NOTIFICATION BANNER (FOR MANAGERS) -->
    <% if (typeof isManager !== 'undefined' && isManager && typeof myOutbidPlayers !== 'undefined' && myOutbidPlayers && myOutbidPlayers.length > 0) { %>
        <div class="max-w-7xl mx-auto px-6 mb-6">
            <div class="bg-amber-500 text-white p-4 rounded-2xl shadow-lg border border-amber-400 flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <span class="text-xl">⚠️</span>
                    <div>
                        <p class="text-xs font-black uppercase tracking-wider">You've Been Outbid!</p>
                        <p class="text-[11px] text-amber-100 font-bold">
                            Other managers are now winning <%= myOutbidPlayers.length %> player(s) you bid on:
                            <% myOutbidPlayers.slice(0, 3).forEach((p, i) => { %><%= i > 0 ? ', ' : '' %><%= p.name %> (<%= p.highestBid %> Vollars)<% }) %><%= myOutbidPlayers.length > 3 ? ', …' : '' %>
                        </p>
                    </div>
                </div>
                <button onclick="switchMode('auction')" class="bg-white text-amber-600 px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-amber-50 transition shadow-sm">
                    Review Bids
                </button>
            </div>
        </div>
    <% } %>

    <!-- MODE 1: STANDARD MARKET VIEW -->
    <div id="marketSection">

        <!-- ============================================================
             MARKET SPOTLIGHT — real player cards (same hover tilt/sheen)
             ============================================================ -->
        <% if (typeof marketSpotlight !== 'undefined' && marketSpotlight) { %>
            <%
                // Shared helper bits for spotlight cards
                function spotPosClass(pos) {
                    const u = (pos || 'PRO').toUpperCase();
                    if (u === 'FWD' || u === 'FORWARD') return 'pos-fwd';
                    if (u === 'MID' || u === 'MIDFIELD') return 'pos-mid';
                    if (u === 'DEF' || u === 'DEFENSE') return 'pos-def';
                    if (u === 'GK' || u === 'GOALKEEPER') return 'pos-gk';
                    return 'pos-pro';
                }
                function spotRankClass(rank) {
                    const u = (rank || 'C').toUpperCase();
                    if (u === 'SS') return 'rank-ss';
                    if (u === 'S') return 'rank-s';
                    if (u === 'A') return 'rank-a';
                    if (u === 'B') return 'rank-b';
                    return 'rank-c';
                }
            %>
            <div class="mb-10">
                <div class="mk-spotlight">
                    <div class="mk-spotlight-inner">
                <div class="mk-spot-head">
                    <div>
                        <div class="mk-eyebrow">Live boards</div>
                        <h3>Market leaderboards</h3>
                        <p>Top money · position heat · rising — cards tilt on hover</p>
                    </div>
                    <button type="button" id="spotlightExpandBtn" class="mk-spot-btn" onclick="toggleSpotlightExpand()">Show top 10</button>
                </div>

                <!-- ════ TOP BIDS — real hovering player cards ════ -->
                <div class="mb-10">
                    <div class="mk-lb-block">
                    <p class="mk-lb-label"><span class="dot"></span> Top bids</p>
                    <% if (marketSpotlight.topBids && marketSpotlight.topBids.length > 0) { %>
                        <div id="spotlightTopPodium" class="mk-podium">
                            <% marketSpotlight.topBids.slice(0, 3).forEach((p, i) => {
                                const medals = ['🥇','🥈','🥉'];
                                const pos = (p.position || 'PRO').toUpperCase();
                                const rank = (p.rank || 'C').toUpperCase();
                                const pId = p._id || p.id || '';
                                const isMgrAccount = (typeof managerPlayerNames !== 'undefined' && managerPlayerNames.includes((p.name || '').toLowerCase()));
                                const isWatched = (typeof user !== 'undefined' && user && Array.isArray(user.watchlist) && user.watchlist.map(String).includes(String(pId)));
                            %>
                                <div class="mk-pod-slot <%= i === 0 ? 'is-first' : '' %>">
                                    <span class="mk-pod-medal"><%= medals[i] %></span>
                                    <div class="player-card glass-light border border-slate-200 relative group"
                                         
                                         onmouseleave="resetTilt(this)"
                                         onmousemove="tiltCard(event, this)" onclick="openBio(this, '<%= p.name %>', '<%= p.cardImage %>', `<%= (p.experience || p.bio || '').toString().replace(/`/g, '') %>`, '<%= p.discord %>', '<%= p.goals || 0 %>', '<%= p.assists || 0 %>', '<%= p.saves || 0 %>', '<%= p.mvps || 0 %>', '<%= p.views ? p.views.length : 0 %>', '<%= p.position %>', '<%= p.country %>', '<%= p.timezone %>', '<%= p.highestBid || 0 %>', '<%= p.highestBidder || 'None' %>', '<%= pId %>', '<%= p.reservePrice || 0 %>', <%- !!isMgrAccount %>, <%- !!isWatched %>)">
                                        <div class="card-sheen"></div>
                                        <% if (p.cardImage && String(p.cardImage).trim()) { %>
                                            <img src="<%= p.cardImage %>" class="card-img w-full h-full object-cover rounded-[28px]">
                                        <% } else { %>
                                            <div class="card-img w-full h-full bg-gradient-to-b from-slate-100 to-slate-200 flex items-center justify-center rounded-[28px]">
                                                <span class="text-[48px] font-black italic text-slate-300/50 uppercase"><%= pos %></span>
                                            </div>
                                        <% } %>
                                        <div class="absolute top-3 left-3 z-20 flex gap-1.5">
                                            <span class="<%= spotPosClass(pos) %> text-white text-[8px] font-black px-2 py-0.5 rounded-md uppercase"><%= pos %></span>
                                            <span class="<%= spotRankClass(rank) %> text-[8px] font-black px-2 py-0.5 rounded-md uppercase"><%= rank %></span>
                                        </div>
                                        <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent rounded-b-[28px] z-20">
                                            <h3 class="font-black text-xl italic uppercase tracking-tighter text-white drop-shadow-md truncate"><%= p.name %></h3>
                                            <div class="mt-1 flex items-center justify-between text-[9px] font-black text-emerald-400">
                                                <span><%= Number(p.highestBid || 0).toLocaleString() %> V</span>
                                                <span class="text-slate-300 text-[8px] uppercase truncate max-w-[90px]"><%= p.highestBidder || '—' %></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                        <div id="spotlightTopFull" class="mk-top10">
                            <% marketSpotlight.topBids.forEach((p, i) => { %>
                                <div class="flex items-center justify-between gap-3 px-4 py-3 hover:bg-slate-50 transition cursor-pointer"
                                     onclick="document.querySelectorAll('.player-card').forEach(c=>{if((c.getAttribute('data-name')||'')==='<%= (p.name||'').toLowerCase() %>'){c.click();}})">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <span class="mk-top10-n <%= i===0?'gold':(i===1?'silver':(i===2?'bronze':'')) %>"><%= i + 1 %></span>
                                        <% if (p.cardImage && String(p.cardImage).trim()) { %>
                                            <img src="<%= p.cardImage %>" class="w-10 h-10 rounded-lg object-cover" alt="">
                                        <% } %>
                                        <div class="min-w-0">
                                            <p class="text-xs font-black text-slate-900 uppercase truncate"><%= p.name %></p>
                                            <p class="text-[9px] text-slate-400 font-bold uppercase truncate"><%= p.position || 'PRO' %> · <%= p.highestBidder || '—' %></p>
                                        </div>
                                    </div>
                                    <span class="text-sm font-black text-emerald-600 flex-shrink-0"><%= Number(p.highestBid).toLocaleString() %></span>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-xs text-slate-400 italic font-bold py-10 text-center bg-white/70 rounded-2xl border border-dashed border-slate-200">No bids placed yet.</p>
                    <% } %>
                </div>

                <!-- ════ POSITION LEADERS — real cards ════ -->
                <div class="mb-10">
                    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 mb-4 flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>⚡ Position Leaders</p>
                    <div id="spotlightPosPodium" class="flex flex-wrap justify-center gap-5 py-4" style="perspective: 1200px;">
                        <% ['FWD','MID','DEF','GK'].forEach(posKey => {
                            const p = marketSpotlight.byPosition && marketSpotlight.byPosition[posKey];
                            if (!p) { %>
                                <div class="w-[200px] h-[280px] rounded-[28px] border border-dashed border-slate-200 bg-white/80 flex flex-col items-center justify-center text-slate-400">
                                    <span class="text-[10px] font-black uppercase"><%= posKey %></span>
                                    <span class="text-xs font-bold mt-1">No bids</span>
                                </div>
                            <% return; }
                            const pos = (p.position || posKey).toUpperCase();
                            const rank = (p.rank || 'C').toUpperCase();
                            const pId = p._id || p.id || '';
                            const isMgrAccount = (typeof managerPlayerNames !== 'undefined' && managerPlayerNames.includes((p.name || '').toLowerCase()));
                            const isWatched = (typeof user !== 'undefined' && user && Array.isArray(user.watchlist) && user.watchlist.map(String).includes(String(pId)));
                        %>
                            <div class="relative flex flex-col items-center">
                                <span class="<%= spotPosClass(posKey) %> text-white text-[9px] font-black px-2.5 py-1 rounded-lg uppercase absolute -top-2 z-30 shadow"><%= posKey %></span>
                                <div class="player-card w-[200px] h-[280px] glass-light rounded-[28px] border border-slate-200 shadow-lg relative group"
                                     
                                     onmouseleave="resetTilt(this)"
                                     onmousemove="tiltCard(event, this)" onclick="openBio(this, '<%= p.name %>', '<%= p.cardImage %>', `<%= (p.experience || p.bio || '').toString().replace(/`/g, '') %>`, '<%= p.discord %>', '<%= p.goals || 0 %>', '<%= p.assists || 0 %>', '<%= p.saves || 0 %>', '<%= p.mvps || 0 %>', '<%= p.views ? p.views.length : 0 %>', '<%= p.position %>', '<%= p.country %>', '<%= p.timezone %>', '<%= p.highestBid || 0 %>', '<%= p.highestBidder || 'None' %>', '<%= pId %>', '<%= p.reservePrice || 0 %>', <%- !!isMgrAccount %>, <%- !!isWatched %>)">
                                    <div class="card-sheen"></div>
                                    <% if (p.cardImage && String(p.cardImage).trim()) { %>
                                        <img src="<%= p.cardImage %>" class="card-img w-full h-full object-cover rounded-[28px]">
                                    <% } else { %>
                                        <div class="card-img w-full h-full bg-gradient-to-b from-slate-100 to-slate-200 flex items-center justify-center rounded-[28px]">
                                            <span class="text-[40px] font-black italic text-slate-300/50 uppercase"><%= posKey %></span>
                                        </div>
                                    <% } %>
                                    <div class="absolute bottom-0 left-0 right-0 p-3.5 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent rounded-b-[28px] z-20">
                                        <h3 class="font-black text-lg italic uppercase tracking-tighter text-white truncate"><%= p.name %></h3>
                                        <p class="text-[9px] font-black text-emerald-400 mt-0.5"><%= Number(p.highestBid || 0).toLocaleString() %> Vollars</p>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                    <div id="spotlightPosFull" class="hidden mt-3 bg-white/90 rounded-2xl border border-slate-200 overflow-hidden max-w-2xl mx-auto">
                        <% ['FWD','MID','DEF','GK'].forEach(posKey => {
                            const list = (marketSpotlight.byPositionTop && marketSpotlight.byPositionTop[posKey]) || [];
                        %>
                            <div class="border-b border-slate-100 last:border-0">
                                <p class="text-[9px] font-black uppercase tracking-wider text-slate-400 px-4 pt-3 pb-1"><%= posKey %></p>
                                <% if (!list.length) { %>
                                    <p class="text-[10px] text-slate-300 px-4 pb-3 italic">No bids</p>
                                <% } else { list.forEach((p, i) => { %>
                                    <div class="flex items-center justify-between gap-3 px-4 py-2 hover:bg-slate-50">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <span class="text-[9px] font-black text-slate-400 w-5">#<%= i + 1 %></span>
                                            <span class="text-[11px] font-black text-slate-900 uppercase truncate"><%= p.name %></span>
                                        </div>
                                        <span class="text-[11px] font-black text-emerald-600"><%= Number(p.highestBid).toLocaleString() %></span>
                                    </div>
                                <% }) } %>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <!-- ════ RISING BIDS — real cards ════ -->
                <div>
                    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-rose-500 mb-4 flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>📈 Rising Bids <span class="text-rose-400 normal-case tracking-normal font-bold">(last 2h)</span></p>
                    <% if (marketSpotlight.rising && marketSpotlight.rising.length > 0) { %>
                        <div id="spotlightRisingPodium" class="mk-podium" style="perspective: 1200px;">
                            <% marketSpotlight.rising.slice(0, 3).forEach((r, i) => {
                                const p = r.player;
                                const pos = (p.position || 'PRO').toUpperCase();
                                const rank = (p.rank || 'C').toUpperCase();
                                const pId = p._id || p.id || '';
                                const isMgrAccount = (typeof managerPlayerNames !== 'undefined' && managerPlayerNames.includes((p.name || '').toLowerCase()));
                                const isWatched = (typeof user !== 'undefined' && user && Array.isArray(user.watchlist) && user.watchlist.map(String).includes(String(pId)));
                            %>
                                <div class="mk-pod-slot <%= i === 0 ? 'is-first' : '' %>">
                                    <span class="mk-pod-medal" style="font-size:.65rem;background:#e11d48;color:#fff;padding:.3rem .55rem;border-radius:999px;font-weight:900;letter-spacing:.06em"><%= r.bidCount %>× bids</span>
                                    <div class="player-card glass-light border border-rose-200 relative group"
                                         
                                         onmouseleave="resetTilt(this)"
                                         onmousemove="tiltCard(event, this)" onclick="openBio(this, '<%= p.name %>', '<%= p.cardImage %>', `<%= (p.experience || p.bio || '').toString().replace(/`/g, '') %>`, '<%= p.discord %>', '<%= p.goals || 0 %>', '<%= p.assists || 0 %>', '<%= p.saves || 0 %>', '<%= p.mvps || 0 %>', '<%= p.views ? p.views.length : 0 %>', '<%= p.position %>', '<%= p.country %>', '<%= p.timezone %>', '<%= p.highestBid || 0 %>', '<%= p.highestBidder || 'None' %>', '<%= pId %>', '<%= p.reservePrice || 0 %>', <%- !!isMgrAccount %>, <%- !!isWatched %>)">
                                        <div class="card-sheen"></div>
                                        <% if (p.cardImage && String(p.cardImage).trim()) { %>
                                            <img src="<%= p.cardImage %>" class="card-img w-full h-full object-cover rounded-[28px]">
                                        <% } else { %>
                                            <div class="card-img w-full h-full bg-gradient-to-b from-rose-50 to-slate-200 flex items-center justify-center rounded-[28px]">
                                                <span class="text-[48px] font-black italic text-rose-200 uppercase"><%= pos %></span>
                                            </div>
                                        <% } %>
                                        <div class="absolute top-3 left-3 z-20 flex gap-1.5">
                                            <span class="<%= spotPosClass(pos) %> text-white text-[8px] font-black px-2 py-0.5 rounded-md uppercase"><%= pos %></span>
                                            <span class="<%= spotRankClass(rank) %> text-[8px] font-black px-2 py-0.5 rounded-md uppercase"><%= rank %></span>
                                        </div>
                                        <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent rounded-b-[28px] z-20">
                                            <h3 class="font-black text-xl italic uppercase tracking-tighter text-white drop-shadow-md truncate"><%= p.name %></h3>
                                            <p class="text-[9px] font-black text-emerald-400 mt-1"><%= Number(p.highestBid || 0).toLocaleString() %> V · #<%= i + 1 %> rising</p>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                        <div id="spotlightRisingFull" class="hidden mt-3 bg-white/90 rounded-2xl border border-rose-100 divide-y divide-rose-50 overflow-hidden max-w-2xl mx-auto">
                            <% marketSpotlight.rising.forEach((r, i) => { %>
                                <div class="flex items-center justify-between gap-3 px-4 py-3 hover:bg-rose-50/50 transition">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <span class="text-xs font-black text-rose-300 w-6">#<%= i + 1 %></span>
                                        <% if (r.player.cardImage && String(r.player.cardImage).trim()) { %>
                                            <img src="<%= r.player.cardImage %>" class="w-10 h-10 rounded-lg object-cover" alt="">
                                        <% } %>
                                        <div class="min-w-0">
                                            <p class="text-xs font-black text-slate-900 uppercase truncate"><%= r.player.name %></p>
                                            <p class="text-[9px] text-slate-400 font-bold uppercase"><%= r.player.position || 'PRO' %></p>
                                        </div>
                                    </div>
                                    <span class="bg-rose-600 text-white text-[9px] font-black px-2 py-0.5 rounded-lg uppercase flex-shrink-0"><%= r.bidCount %>×</span>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-xs text-rose-400 italic font-bold py-10 text-center bg-rose-50/80 rounded-2xl border border-dashed border-rose-100">No bidding flurries recently.</p>
                    <% } %>
                </div>
                    </div><!-- /relative pad -->
                </div><!-- /stage -->
            </div>
        <% } %>

        <!-- MULTI-TIER DUAL CONVEYOR CARDS DISPLAY -->
        <% if(players.length > 0) { %>
            <% 
                let fullList = players.length < 6 ? [...players, ...players, ...players, ...players] : [...players, ...players]; 
                let tier1 = fullList.slice(0, Math.ceil(fullList.length / 2));
                let tier2 = fullList.slice(Math.ceil(fullList.length / 2));
                let tiers = [
                    { list: tier1, anim: 'animate-conveyor-1', label: 'Top Tier Prospects' },
                    { list: tier2, anim: 'animate-conveyor-2', label: 'Midfield, Defensive Anchors & Free Agents' }
                ];
            %>

            <div class="space-y-6 mb-24">
                <% tiers.forEach((t, idx) => { %>
                    <div class="relative flex items-center mk-lane-bar py-7">
                        <div class="<%= t.anim %> gap-6 px-4" id="cardContainer<%= idx %>">
                            <% t.list.forEach(p => { %>
                                <% 
                                    let posClass = 'pos-pro';
                                    let pos = (p.position || 'PRO').toUpperCase();
                                    if(pos === 'FWD' || pos === 'FORWARD') posClass = 'pos-fwd';
                                    else if(pos === 'MID' || pos === 'MIDFIELD') posClass = 'pos-mid';
                                    else if(pos === 'DEF' || pos === 'DEFENSE') posClass = 'pos-def';
                                    else if(pos === 'GK' || pos === 'GOALKEEPER') posClass = 'pos-gk';

                                    let rankClass = 'rank-c';
                                    let rank = (p.rank || 'C').toUpperCase();
                                    if(rank === 'SS') rankClass = 'rank-ss';
                                    else if(rank === 'S') rankClass = 'rank-s';
                                    else if(rank === 'A') rankClass = 'rank-a';
                                    else if(rank === 'B') rankClass = 'rank-b';

                                    let pId = p._id || p.id || '';

                                    // VSL Season 4: manager accounts are never auctionable, and
                                    // every other player gets a manager-specific status badge.
                                    let isMgrAccount = (typeof managerPlayerNames !== 'undefined' && managerPlayerNames.includes((p.name || '').toLowerCase()));

                                    let myBadge = null;
                                    if (!isMgrAccount && typeof isManager !== 'undefined' && isManager && typeof myAuctionState !== 'undefined' && myAuctionState) {
                                        const amWinning = Number(p.highestBid || 0) > 0 && (p.highestBidder || '').toLowerCase() === myAuctionState.team.name.toLowerCase();
                                        const amOutbid = myAuctionState.outbidPlayerIds.includes(String(pId));
                                        if (amWinning) myBadge = 'winning';
                                        else if (amOutbid) myBadge = 'outbid';
                                        else if (typeof myEligibility !== 'undefined' && myEligibility && myEligibility[String(pId)] === false) myBadge = 'ineligible';
                                    }

                                    let isWatched = (typeof user !== 'undefined' && user && Array.isArray(user.watchlist) && user.watchlist.map(String).includes(String(pId)));
                                    let eligibleAttr = (typeof myEligibility !== 'undefined' && myEligibility) ? (myEligibility[String(pId)] === true) : true;
                                %>
                                <div class="player-card card-item w-[260px] h-[350px] glass-light rounded-[28px] border border-slate-200 shadow-md flex-shrink-0 relative group"
                                     data-name="<%= p.name.toLowerCase() %>"
                                     data-search="<%= ((p.name || '') + ' ' + (p.discord || '') + ' ' + (p.country || '')).toLowerCase() %>"
                                     data-pos="<%= pos %>"
                                     data-class="<%= rank %>"
                                     data-eligible="<%= eligibleAttr %>"
                                      
                                     onmouseleave="resetTilt(this)"
                                     onmousemove="tiltCard(event, this)" onclick="openBio(this, '<%= p.name %>', '<%= p.cardImage %>', `<%= (p.experience || p.bio || '').toString().replace(/`/g, '').replace(/\\/g, '') %>`, '<%= p.discord %>', '<%= p.goals || 0 %>', '<%= p.assists || 0 %>', '<%= p.saves || 0 %>', '<%= p.mvps || 0 %>', '<%= p.views ? p.views.length : 0 %>', '<%= p.position %>', '<%= p.country %>', '<%= p.timezone %>', '<%= p.highestBid || 0 %>', '<%= p.highestBidder || 'None' %>', '<%= pId %>', '<%= p.reservePrice || 0 %>', <%- isMgrAccount %>, <%- isWatched %>)">
                                    
                                    <!-- Shiny Dynamic Sweeping Glare -->
                                    <div class="card-sheen"></div>

                                    <% if (p.cardImage && p.cardImage.trim() !== "") { %>
                                        <img src="<%= p.cardImage %>" class="card-img w-full h-full object-cover">
                                    <% } else { %>
                                        <div class="card-img w-full h-full bg-gradient-to-b from-slate-100 to-slate-200 flex items-center justify-center relative">
                                            <span class="absolute top-10 text-[64px] font-black italic text-slate-300/40 select-none uppercase tracking-tighter"><%= p.position || 'PRO' %></span>
                                            <svg class="w-24 h-24 text-slate-300" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                                        </div>
                                    <% } %>

                                    <!-- MANAGER BADGE (not auctionable) -->
                                    <% if (isMgrAccount) { %>
                                        <div class="absolute top-4 right-4 z-30">
                                            <span class="bg-slate-900 text-white text-[9px] font-black px-2.5 py-1 rounded-xl uppercase shadow-lg tracking-wider border border-white/20">👔 MANAGER</span>
                                        </div>
                                    <% } else { %>
                                        <!-- WATCHLIST STAR (managers only) -->
                                        <% if (typeof isManager !== 'undefined' && isManager) { %>
                                            <button type="button"
                                                onclick="event.stopPropagation(); toggleWatchlistStar(this, '<%= pId %>')"
                                                data-watching="<%= isWatched %>"
                                                class="watchlist-star-btn absolute top-4 right-4 z-30 w-8 h-8 rounded-full flex items-center justify-center text-base transition-all shadow-lg border border-white/30 <%= isWatched ? 'bg-amber-400 text-white' : 'bg-black/30 text-white/80 hover:bg-black/50' %>">
                                                <%= isWatched ? '★' : '☆' %>
                                            </button>
                                        <% } %>

                                        <!-- MY STATUS BADGE (winning / outbid / ineligible) -->
                                        <% if (myBadge === 'winning') { %>
                                            <div class="absolute top-4 left-4 z-30">
                                                <span class="bg-emerald-500 text-white text-[9px] font-black px-2.5 py-1 rounded-xl uppercase shadow-lg tracking-wider">🟢 Winning</span>
                                            </div>
                                        <% } else if (myBadge === 'outbid') { %>
                                            <div class="absolute top-4 left-4 z-30">
                                                <span class="bg-rose-500 text-white text-[9px] font-black px-2.5 py-1 rounded-xl uppercase shadow-lg tracking-wider">🔴 Outbid</span>
                                            </div>
                                        <% } else if (myBadge === 'ineligible') { %>
                                            <div class="absolute top-4 left-4 z-30">
                                                <span class="bg-slate-600 text-white text-[9px] font-black px-2.5 py-1 rounded-xl uppercase shadow-lg tracking-wider">⚠️ Ineligible</span>
                                            </div>
                                        <% } %>
                                    <% } %>

                                    <!-- RANK BADGE AT BOTTOM RIGHT ON HOVER / ALWAYS VISIBLE -->
                                    <div class="absolute bottom-4 right-4 z-20 transition-all duration-300 transform group-hover:scale-110">
                                        <span class="<%= rankClass %> text-[10px] font-black px-2.5 py-1 rounded-xl uppercase shadow-lg tracking-wider border border-white/20"><%= rank %> RANK</span>
                                    </div>

                                    <!-- Card Overlays -->
                                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent p-5 flex flex-col justify-end z-10">
                                        <div class="flex justify-between items-center mb-1">
                                            <span class="<%= posClass %> text-[9px] font-black px-2.5 py-1 rounded-lg italic uppercase shadow-sm tracking-wide"><%= p.position || 'PRO' %></span>
                                            <div class="flex items-center gap-1 bg-white/20 backdrop-filter blur-md px-2 py-0.5 rounded-md border border-white/20">
                                                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                                <span class="text-[9px] text-white font-black"><%= p.views ? p.views.length : 0 %></span>
                                            </div>
                                        </div>
                                        
                                        <h3 class="font-black text-2xl italic uppercase tracking-tighter text-white drop-shadow-md"><%= p.name %></h3>
                                        
                                        <!-- Highest Bid Info in Market -->
                                        <div class="mt-1 flex items-center justify-between text-[9px] font-black text-emerald-400">
                                            <span>TOP BID: <%= p.highestBid ? p.highestBid + ' Vollars' : 'No Bids' %></span>
                                            <% if (p.highestBidder) { %>
                                                <span class="text-slate-300 text-[8px] uppercase truncate max-w-[90px]">(<%= p.highestBidder %>)</span>
                                            <% } %>
                                        </div>

                                        <!-- Stat Strip Preview -->
                                        <div class="grid grid-cols-4 gap-1 mt-2 pt-2 border-t border-white/15 text-center">
                                            <div><p class="text-[7px] font-black text-white/50 uppercase">G</p><p class="text-xs font-black text-white"><%= p.goals || 0 %></p></div>
                                            <div><p class="text-[7px] font-black text-white/50 uppercase">A</p><p class="text-xs font-black text-white"><%= p.assists || 0 %></p></div>
                                            <div><p class="text-[7px] font-black text-white/50 uppercase">S</p><p class="text-xs font-black text-white"><%= p.saves || 0 %></p></div>
                                            <div><p class="text-[7px] font-black text-blue-400 uppercase">MVP</p><p class="text-xs font-black text-blue-400"><%= p.mvps || 0 %></p></div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>


    <% if (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.status === 'soft_lock') { %>
        <div class="max-w-7xl mx-auto px-6 mb-4">
            <div class="bg-violet-50 border border-violet-200 text-violet-900 rounded-2xl px-5 py-3 flex items-center gap-3 shadow-sm">
                <span class="text-xl">🔒</span>
                <div>
                    <p class="text-xs font-black uppercase tracking-wider">Soft lock active</p>
                    <p class="text-[10px] font-bold leading-relaxed">
                        Each team has <strong>5 total</strong> bid/raise attempts (not per player).
                        Unlocked outbid withdraws still allowed — no extra budget.
                        <% if (typeof softLockInfo !== 'undefined' && softLockInfo && softLockInfo.active && !softLockInfo.spectator) { %>
                            <span class="text-violet-700">Your team: <%= softLockInfo.remaining %> / <%= softLockInfo.max %> attempts left (used <%= softLockInfo.used %>).</span>
                        <% } %>
                    </p>
                </div>
            </div>
        </div>
    <% } %>
    <% if (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.status === 'paused') { %>
        <div class="max-w-7xl mx-auto px-6 mb-4">
            <div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-2xl px-5 py-3 flex items-center gap-3 shadow-sm">
                <span class="text-xl">⏸</span>
                <div>
                    <p class="text-xs font-black uppercase tracking-wider">Auction Paused</p>
                    <p class="text-[10px] font-bold">Bidding is frozen. Admin is reviewing — wait for End or Resume.</p>
                </div>
            </div>
        </div>
    <% } %>

    <!-- MODE 2: AUCTION HUB VIEW -->
    <div id="auctionSection" class="hidden max-w-7xl mx-auto px-6 mb-24 mk-in">
        <%
            function hueFromName(str) {
                let h = 0;
                str = str || 'Team';
                for (let i = 0; i < str.length; i++) {
                    h = str.charCodeAt(i) + ((h << 5) - h);
                }
                return Math.abs(h) % 360;
            }
            function findPlayerRecord(idOrName) {
                if (!idOrName || typeof players === 'undefined') return null;
                return players.find(p => {
                    let pid = (p._id || p.id || '').toString();
                    return pid === idOrName.toString() ||
                        (p.name && p.name.toLowerCase() === idOrName.toString().toLowerCase());
                }) || null;
            }

            let sessionStatus = (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.status) || 'ready';
            let statusLabel = 'READY';
            let statusDot = 'bg-slate-400';
            let statusRing = 'border-slate-200 bg-slate-50 text-slate-600';
            if (sessionStatus === 'live') {
                statusLabel = 'LIVE';
                statusDot = 'bg-emerald-400 animate-pulse';
                statusRing = 'border-emerald-200 bg-emerald-50 text-emerald-700';
            } else if (sessionStatus === 'ended') {
                statusLabel = 'ENDED';
                statusDot = 'bg-rose-400';
                statusRing = 'border-rose-200 bg-rose-50 text-rose-700';
            }
            let squadCap = (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.maxRosterSize) || 16;
            let squadMin = (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.minRosterSize) || 10;
            let sessionName = (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.name) || 'VIM Auction';
        %>

        <!-- HERO STATUS -->
        <div class="relative overflow-hidden rounded-[32px] mb-8 border border-slate-200 shadow-xl shadow-slate-200/50">
            <div class="absolute inset-0 bg-gradient-to-br from-white via-slate-50 to-emerald-50/50"></div>
            <div class="absolute inset-0 opacity-80" style="background-image: radial-gradient(circle at 12% 40%, rgba(16,185,129,0.1), transparent 42%), radial-gradient(circle at 88% 15%, rgba(251,191,36,0.1), transparent 38%);"></div>
            <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-slate-900 via-emerald-500 to-slate-900"></div>

            <div class="relative p-6 md:p-8 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                <div class="flex items-start gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-white border border-slate-200 flex items-center justify-center text-3xl shadow-sm">🏆</div>
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-[0.25em] text-slate-400"><%= sessionName %></p>
                        <h3 class="text-3xl font-black italic uppercase tracking-tighter text-slate-900 mt-1">Auction Hub</h3>
                        <p class="text-[11px] text-slate-500 font-bold mt-1">Franchise bids · live roster pressure · full audit trail</p>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    <div class="<%= statusRing %> border px-4 py-2.5 rounded-2xl flex items-center gap-2 shadow-sm">
                        <span class="w-2 h-2 rounded-full <%= statusDot %>"></span>
                        <div>
                            <p class="text-[8px] font-black uppercase tracking-widest opacity-70">Status</p>
                            <p class="text-sm font-black uppercase tracking-wider leading-none"><%= statusLabel %></p>
                        </div>
                    </div>
                    <div class="bg-white border border-slate-200 text-slate-900 px-4 py-2.5 rounded-2xl shadow-sm">
                        <p class="text-[8px] font-black uppercase tracking-widest text-slate-400">Roster</p>
                        <p class="text-sm font-black"><%= squadMin %>–<%= squadCap %> <span class="text-slate-400 font-bold text-[10px]">players</span></p>
                    </div>
                    <div class="bg-white border border-slate-200 text-slate-900 px-4 py-2.5 rounded-2xl shadow-sm">
                        <p class="text-[8px] font-black uppercase tracking-widest text-slate-400">Franchises</p>
                        <p class="text-sm font-black"><%= typeof auctionTeams !== 'undefined' ? auctionTeams.length : 0 %></p>
                    </div>
                </div>
            </div>
        </div>

        <% if (typeof isManager !== 'undefined' && isManager && typeof myAuctionState !== 'undefined' && myAuctionState) { %>
            <div class="mb-8 grid grid-cols-2 md:grid-cols-4 gap-3">
                <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
                    <p class="text-[9px] font-black uppercase text-slate-400">Your budget left</p>
                    <p class="text-xl font-black text-emerald-600 mt-1"><%= Number(myAuctionState.availableBudget).toLocaleString() %></p>
                </div>
                <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
                    <p class="text-[9px] font-black uppercase text-slate-400">Roster slots</p>
                    <p class="text-xl font-black text-slate-900 mt-1"><%= myAuctionState.totalPlayers %><span class="text-sm text-slate-400">/<%= myAuctionState.rosterMax %></span></p>
                </div>
                <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
                    <p class="text-[9px] font-black uppercase text-slate-400">Winning</p>
                    <p class="text-xl font-black text-emerald-600 mt-1"><%= (myAuctionState.provisional || []).filter(x => !x.isManager).length %></p>
                </div>
                <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
                    <p class="text-[9px] font-black uppercase text-slate-400">Outbid</p>
                    <p class="text-xl font-black text-rose-600 mt-1"><%= typeof myOutbidPlayers !== 'undefined' ? myOutbidPlayers.length : 0 %></p>
                </div>
            </div>
        <% } %>

        <% if (typeof auctionTeams !== 'undefined' && auctionTeams && auctionTeams.length > 0) { %>

            <div class="flex items-center justify-between gap-3 mb-4">
                <h3 class="text-[11px] font-black uppercase tracking-[0.25em] text-slate-400">Registered Franchises</h3>
                <p class="text-[10px] font-bold text-slate-400 uppercase">Tap a team to inspect bids</p>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 mb-8">
                <% auctionTeams.forEach((t, i) => {
                    let tId = t._id || t.id || '';
                    let reserved = (t.bids || []).reduce((sum, b) => sum + (Number(b.amount) || 0), 0);
                    let remaining = (t.budget || 0) - (t.spent || 0) - reserved;
                    let committedPct = (t.budget && t.budget > 0) ? Math.min(100, Math.round(((t.spent || 0) + reserved) / t.budget * 100)) : 0;
                    let hue = hueFromName(t.name);
                    let bidCount = (t.bids || []).length;
                    let rosterCount = (t.roster || []).length;
                %>
                    <div onclick="selectAuctionTeam('<%= tId %>')"
                         id="teamTile-<%= tId %>"
                         class="team-tile cursor-pointer bg-white border-2 rounded-[24px] p-4 text-center relative overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl <%= i === 0 ? 'active' : 'border-slate-200' %>"
                         style="--team-hue: <%= hue %>;">
                        <div class="absolute inset-x-0 top-0 h-1.5" style="background: hsl(<%= hue %> 75% 48%);"></div>
                        <div class="absolute -right-6 -top-6 w-20 h-20 rounded-full opacity-10" style="background: hsl(<%= hue %> 75% 48%);"></div>

                        <div class="w-20 h-20 mx-auto rounded-2xl bg-slate-50 border border-slate-100 p-2 flex items-center justify-center shadow-sm mb-3 mt-1">
                            <% if (t.logo) { %>
                                <img src="<%= t.logo %>" class="w-full h-full object-contain">
                            <% } else { %>
                                <span class="text-2xl font-black" style="color: hsl(<%= hue %> 65% 42%);"><%= (t.name || '?').charAt(0) %></span>
                            <% } %>
                        </div>

                        <h4 class="font-black italic uppercase text-sm text-slate-900 truncate"><%= t.name %></h4>
                        <p class="text-[9px] text-slate-400 font-bold uppercase truncate mb-3">Mgr · <%= t.manager || 'Unassigned' %></p>

                        <div class="grid grid-cols-2 gap-1.5 text-left mb-2">
                            <div class="bg-slate-50 rounded-xl px-2 py-1.5 border border-slate-100">
                                <span class="block text-[7px] text-slate-400 font-black uppercase">Left</span>
                                <span class="text-[11px] font-black text-emerald-600"><%= Number(remaining).toLocaleString() %></span>
                            </div>
                            <div class="bg-slate-50 rounded-xl px-2 py-1.5 border border-slate-100">
                                <span class="block text-[7px] text-slate-400 font-black uppercase">Bids</span>
                                <span class="text-[11px] font-black text-slate-900"><%= bidCount %></span>
                            </div>
                        </div>

                        <div class="h-1.5 rounded-full bg-slate-100 overflow-hidden">
                            <div class="h-full rounded-full transition-all" style="width: <%= committedPct %>%; background: hsl(<%= hue %> 75% 48%);"></div>
                        </div>
                        <p class="text-[8px] font-bold text-slate-400 mt-1.5 uppercase"><%= committedPct %>% committed · <%= rosterCount %> signed</p>
                    </div>
                <% }) %>
            </div>

            <!-- TEAM DETAIL PANELS -->
            <% auctionTeams.forEach((t, i) => {
                let tId = t._id || t.id || '';
                let reserved = (t.bids || []).reduce((sum, b) => sum + (Number(b.amount) || 0), 0);
                let remaining = (t.budget || 0) - (t.spent || 0) - reserved;
                let hue = hueFromName(t.name);
            %>
                <div id="teamDetails-<%= tId %>" class="team-details-panel <%= i === 0 ? '' : 'hidden' %> mb-8">
                    <div class="bg-white rounded-[28px] border border-slate-200 shadow-lg overflow-hidden">
                        <div class="px-6 py-5 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100" style="background: linear-gradient(135deg, hsl(<%= hue %> 40% 97%), white);">
                            <div class="flex items-center gap-4">
                                <div class="w-14 h-14 rounded-2xl bg-white border border-slate-200 p-1.5 flex items-center justify-center shadow-sm">
                                    <% if (t.logo) { %>
                                        <img src="<%= t.logo %>" class="w-full h-full object-contain">
                                    <% } else { %>
                                        <span class="text-xl font-black" style="color: hsl(<%= hue %> 65% 42%);"><%= (t.name || '?').charAt(0) %></span>
                                    <% } %>
                                </div>
                                <div>
                                    <h4 class="text-xl font-black italic uppercase text-slate-900 tracking-tight"><%= t.name %></h4>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">Manager · <%= t.manager || 'Unassigned' %></p>
                                </div>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                <div class="bg-slate-900 text-white px-3 py-2 rounded-xl">
                                    <p class="text-[7px] font-black uppercase text-slate-400">Budget</p>
                                    <p class="text-sm font-black"><%= Number(t.budget || 0).toLocaleString() %></p>
                                </div>
                                <div class="bg-emerald-50 border border-emerald-100 text-emerald-700 px-3 py-2 rounded-xl">
                                    <p class="text-[7px] font-black uppercase text-emerald-500">Remaining</p>
                                    <p class="text-sm font-black"><%= Number(remaining).toLocaleString() %></p>
                                </div>
                                <div class="bg-slate-50 border border-slate-100 px-3 py-2 rounded-xl">
                                    <p class="text-[7px] font-black uppercase text-slate-400">Spent</p>
                                    <p class="text-sm font-black text-slate-900"><%= Number(t.spent || 0).toLocaleString() %></p>
                                </div>
                            </div>
                        </div>

                        <div class="px-6 pt-4 flex gap-2">
                            <button type="button" id="tabBtn-bidding-<%= tId %>" onclick="switchTeamSubTab('<%= tId %>', 'bidding')"
                                class="px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-slate-900 text-white transition">
                                Live Bids
                            </button>
                            <button type="button" id="tabBtn-roster-<%= tId %>" onclick="switchTeamSubTab('<%= tId %>', 'roster')"
                                class="px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider text-slate-400 hover:text-slate-900 transition">
                                Final Roster
                            </button>
                        </div>

                        <div id="subTab-bidding-<%= tId %>" class="p-6">
                            <% if (t.bids && t.bids.length > 0) { %>
                                <div class="space-y-2">
                                    <% t.bids.forEach(b => {
                                        const full = findPlayerRecord(b.playerId || b.playerName);
                                        const isWinning = full && (full.highestBidder || '').toLowerCase() === (t.name || '').toLowerCase()
                                            && Number(full.highestBid || 0) === Number(b.amount || 0);
                                    %>
                                        <div class="flex items-center justify-between gap-3 bg-slate-50 hover:bg-slate-100 border border-slate-100 rounded-2xl px-4 py-3 transition cursor-pointer"
                                             <% if (full) { %>
                                             onmousemove="tiltCard(event, this)" onclick="openBio(this, '<%= full.name %>', '<%= full.cardImage %>', `<%= (full.experience || full.bio || '').toString().replace(/`/g,'') %>`, '<%= full.discord %>', '<%= full.goals || 0 %>', '<%= full.assists || 0 %>', '<%= full.saves || 0 %>', '<%= full.mvps || 0 %>', '<%= full.views ? full.views.length : 0 %>', '<%= full.position %>', '<%= full.country %>', '<%= full.timezone %>', '<%= full.highestBid || 0 %>', '<%= full.highestBidder || "None" %>', '<%= full._id || full.id %>', '<%= full.reservePrice || 0 %>', <%- (typeof managerPlayerNames !== 'undefined' && managerPlayerNames.includes((full.name||'').toLowerCase())) %>, <%- !!(typeof user !== 'undefined' && user && Array.isArray(user.watchlist) && user.watchlist.map(String).includes(String(full._id||full.id))) %>)"
                                             <% } %>>
                                            <div class="flex items-center gap-3 min-w-0">
                                                <% if (full && full.cardImage) { %>
                                                    <img src="<%= full.cardImage %>" class="w-11 h-11 rounded-xl object-cover border border-slate-200" alt="">
                                                <% } else { %>
                                                    <div class="w-11 h-11 rounded-xl bg-slate-200 flex items-center justify-center text-[10px] font-black text-slate-400"><%= (b.playerName || '?').charAt(0) %></div>
                                                <% } %>
                                                <div class="min-w-0">
                                                    <h5 class="font-black italic uppercase text-slate-900 text-sm truncate"><%= b.playerName || (full && full.name) || 'Player' %></h5>
                                                    <p class="text-[9px] text-slate-400 font-bold uppercase"><%= full ? (full.position || 'PRO') : '—' %> · <%= full ? (full.rank || 'C') : '' %></p>
                                                </div>
                                            </div>
                                            <div class="text-right flex-shrink-0">
                                                <p class="text-sm font-black text-slate-900"><%= Number(b.amount || 0).toLocaleString() %> V</p>
                                                <% if (isWinning) { %>
                                                    <span class="text-[8px] font-black uppercase text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md">Winning</span>
                                                <% } else { %>
                                                    <span class="text-[8px] font-black uppercase text-rose-500 bg-rose-50 px-2 py-0.5 rounded-md">Outbid</span>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div class="text-center py-14 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                                    <p class="text-xs font-black uppercase text-slate-400 tracking-wider">No active bids from this franchise yet</p>
                                </div>
                            <% } %>
                        </div>

                        <div id="subTab-roster-<%= tId %>" class="p-6 hidden">
                            <% if (t.roster && t.roster.length > 0) { %>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                    <% t.roster.forEach(r => {
                                        const full = findPlayerRecord(r.name);
                                    %>
                                        <div class="flex items-center justify-between gap-3 bg-slate-50 border border-slate-100 rounded-2xl px-4 py-3"
                                             <% if (full) { %>
                                             onmousemove="tiltCard(event, this)" onclick="openBio(this, '<%= full.name %>', '<%= full.cardImage %>', `<%= (full.experience || full.bio || '').toString().replace(/`/g,'') %>`, '<%= full.discord %>', '<%= full.goals || 0 %>', '<%= full.assists || 0 %>', '<%= full.saves || 0 %>', '<%= full.mvps || 0 %>', '<%= full.views ? full.views.length : 0 %>', '<%= full.position %>', '<%= full.country %>', '<%= full.timezone %>', '<%= full.highestBid || 0 %>', '<%= full.highestBidder || "None" %>', '<%= full._id || full.id %>', '<%= full.reservePrice || 0 %>', false, false)"
                                             class="cursor-pointer hover:bg-slate-100"
                                             <% } %>>
                                            <div class="min-w-0">
                                                <h5 class="font-black italic uppercase text-slate-900 text-sm truncate"><%= r.name %></h5>
                                                <p class="text-[10px] text-slate-400 font-bold uppercase"><%= r.position || 'PRO' %> · <%= r.rank || '' %> · <%= Number(r.boughtFor || 0).toLocaleString() %> V</p>
                                            </div>
                                            <span class="text-[9px] font-black text-emerald-600 bg-emerald-50 border border-emerald-100 px-2.5 py-1 rounded-lg uppercase flex-shrink-0">Signed</span>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div class="text-center py-14 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                                    <p class="text-xs font-black uppercase text-slate-400 tracking-wider">Roster fills when the admin ends the auction</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>

        <% } else { %>
            <div class="bg-white p-12 rounded-[32px] border border-dashed border-slate-200 text-center">
                <p class="text-sm font-black text-slate-400 uppercase tracking-widest">No auction teams configured yet</p>
                <p class="text-[11px] text-slate-400 font-bold mt-2">Admin can enroll franchises from the Auction Control tab</p>
            </div>
        <% } %>

        <!-- AUDIT LOG -->
        <% if (typeof auctionActivityFeed !== 'undefined' && auctionActivityFeed && auctionActivityFeed.length > 0) { %>
            <div class="mt-10">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-9 h-9 rounded-xl bg-slate-900 text-white flex items-center justify-center text-sm">📜</div>
                    <div>
                        <h3 class="text-[11px] font-black uppercase tracking-[0.25em] text-slate-400">Auction feed</h3>
                        <p class="text-[9px] font-bold text-slate-400 uppercase">Bids · withdrawals · wins · session events</p>
                    </div>
                </div>

                <div class="mk-feed custom-scroll overflow-y-auto">
                    <% auctionActivityFeed.forEach((ev) => {
                        let icon = '•';
                        let label = (ev.type || 'event').replace(/_/g, ' ');
                        let iconClass = '';
                        if (ev.type === 'bid') { icon = '💰'; label = 'Bid placed'; iconClass = 'bid'; }
                        else if (ev.type === 'withdraw') { icon = '↩️'; label = 'Withdrawal'; iconClass = 'withdraw'; }
                        else if (ev.type === 'won') { icon = '🏆'; label = 'Player won'; iconClass = 'won'; }
                        else if (ev.type === 'auction_start') { icon = '🚀'; label = 'Auction started'; iconClass = 'start'; }
                        else if (ev.type === 'auction_end') { icon = '🔒'; label = 'Auction ended'; iconClass = 'end'; }
                        else if (ev.type === 'rank_change') { icon = '🎖️'; label = 'Rank change'; iconClass = 'rank'; }
                        else if (ev.type === 'outbid') { icon = '⚡'; label = 'Outbid'; iconClass = 'withdraw'; }
                        const when = ev.createdAt ? new Date(ev.createdAt).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : (ev.time || '');
                        const detailParts = [];
                        if (ev.playerName) detailParts.push(ev.playerName);
                        if (ev.teamName) detailParts.push(ev.teamName);
                        if (ev.managerName) detailParts.push('mgr ' + ev.managerName);
                        if (ev.fromRank && ev.toRank) detailParts.push(ev.fromRank + ' → ' + ev.toRank);
                        if (ev.message) detailParts.push(ev.message);
                        const detail = detailParts.join(' · ') || (ev.note || '—');
                    %>
                        <div class="mk-feed-item">
                            <div class="mk-feed-icon <%= iconClass %>"><%= icon %></div>
                            <div style="min-width:0">
                                <p class="mk-feed-title"><%= label %></p>
                                <p class="mk-feed-detail"><%= detail %></p>
                                <p class="mk-feed-sub">
                                    <% if (ev.playerName && ev.teamName) { %>Player target · team action<% } else if (ev.type === 'auction_start' || ev.type === 'auction_end') { %>Session event<% } else { %>Market event<% } %>
                                </p>
                            </div>
                            <div class="mk-feed-amt">
                                <% if (ev.amount != null && ev.amount !== '') { %>
                                    <%= Number(ev.amount).toLocaleString() %> V
                                <% } else { %>
                                    <span style="color:var(--mk-muted)">—</span>
                                <% } %>
                                <span class="mk-feed-time"><%= when %></span>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </div>

    </div><!-- /mk-shell -->

<!-- LIGHT THEME FIFA MODAL WITH BIDDING CAPABILITY FOR MANAGERS -->
    <div id="bioModal" class="modal" onclick="closeBio()">
        <div class="max-w-5xl w-full flex flex-col md:flex-row gap-6 items-center relative" id="modalContainer" class="mk-modal-wrap" onclick="event.stopPropagation()">
            <!-- Player Card Spotlight -->
            <div class="relative group w-[300px] h-[420px] flex-shrink-0 mk-modal-card">
                <div class="absolute -inset-2 bg-slate-300/40 blur-2xl rounded-full opacity-70"></div>
                <div class="relative w-full h-full bg-white rounded-[36px] overflow-hidden border border-slate-200 shadow-2xl">
                    <img id="modalImg" src="" class="w-full h-full object-cover">
                    <div id="modalImgPlaceholder" class="w-full h-full bg-gradient-to-b from-slate-100 to-slate-200 flex items-center justify-center">
                        <svg class="w-40 h-40 text-slate-300" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                    </div>

                    <!-- WATCHLIST STAR — visible corner of the player profile -->
                    <% if (typeof isManager !== 'undefined' && isManager) { %>
                        <button type="button"
                            id="modalWatchlistStar"
                            onclick="toggleWatchlistStar(this, window.currentModalPlayerId)"
                            data-watching="false"
                            class="hidden absolute top-4 right-4 z-30 w-10 h-10 rounded-full flex items-center justify-center text-lg transition-all shadow-lg border border-white/30 bg-black/30 text-white/80 hover:bg-black/50">
                            ☆
                        </button>
                    <% } %>

                    <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent">
                        <div class="flex items-center gap-2">
                            <span id="modalPosBadge" class="text-white text-[10px] font-black px-3 py-1 rounded-lg italic uppercase tracking-wider"></span>
                            <span id="modalCountryBadge" class="text-slate-300 text-[10px] font-black uppercase tracking-widest"></span>
                        </div>
                        <h2 id="modalName" class="text-3xl font-black italic uppercase text-white tracking-tighter mt-1"></h2>
                    </div>
                </div>
            </div>

            <!-- Details & Bidding Panel -->
            <div class="flex-1 bg-white p-8 md:p-10 rounded-[36px] border border-slate-200 shadow-2xl relative overflow-hidden">
                <div class="absolute -top-10 -right-10 text-[120px] font-black italic text-slate-100 pointer-events-none uppercase select-none">STATS</div>
                
                <div class="flex justify-between items-start mb-6 relative z-10">
                    <div>
                        <p id="modalDiscord" class="text-slate-900 font-black text-xs uppercase tracking-wider mb-0.5"></p>
                        <p id="modalTZ" class="text-[10px] text-slate-400 font-bold uppercase mb-1"></p>
                        <p class="text-[10px] text-slate-400 font-black uppercase tracking-widest">Official VIM Player Contract</p>
                    </div>
                    <div class="text-right">
                        <p id="modalViews" class="text-4xl font-black italic text-slate-900 leading-none">0</p>
                        <p class="text-[8px] uppercase font-black text-slate-400 tracking-widest mt-1">PROFILE VIEWS</p>
                    </div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6 relative z-10">
                    <div class="stat-badge p-3.5 rounded-2xl text-center"><p class="text-[8px] uppercase font-black text-slate-400 mb-0.5">Goals</p><p id="mGoals" class="text-2xl font-black italic text-slate-900">0</p></div>
                    <div class="stat-badge p-3.5 rounded-2xl text-center"><p class="text-[8px] uppercase font-black text-slate-400 mb-0.5">Assists</p><p id="mAssists" class="text-2xl font-black italic text-slate-900">0</p></div>
                    <div class="stat-badge p-3.5 rounded-2xl text-center"><p class="text-[8px] uppercase font-black text-slate-400 mb-0.5">Saves</p><p id="mSaves" class="text-2xl font-black italic text-slate-900">0</p></div>
                    <div class="stat-badge p-3.5 rounded-2xl text-center border-amber-200 bg-amber-50/50"><p class="text-[8px] uppercase font-black text-amber-600 mb-0.5">MVP</p><p id="mMvps" class="text-2xl font-black italic text-amber-600">0</p></div>
                </div>

                <div class="relative z-10 mb-4">
                    <p class="text-[10px] uppercase tracking-widest text-slate-400 mb-2 font-black">Experience & Biography</p>
                    <div id="modalBio" class="text-slate-600 leading-relaxed text-xs h-20 overflow-y-auto pr-3 italic bg-slate-50 p-3 rounded-2xl border border-slate-100 custom-scroll"></div>
                </div>

                <!-- MANAGER ACCOUNT NOTICE -->
                <div id="modalManagerNotice" class="hidden relative z-10 bg-slate-900 text-white p-4 rounded-2xl mb-4 flex items-center gap-3">
                    <span class="text-2xl">👔</span>
                    <div>
                        <p class="text-xs font-black uppercase tracking-wider">Manager Account</p>
                        <p class="text-[10px] text-slate-300 font-bold">This is an assigned team manager, not an auctionable player.</p>
                    </div>
                </div>

                <!-- RECENT BIDS TOGGLE (always visible arrow / button on the right of modal) -->
                <button type="button" id="modalExpandBidsBtn" onclick="toggleModalBidHistory()"
                    class="relative z-10 w-full mb-3 flex items-center justify-between gap-3 bg-slate-900 hover:bg-blue-600 text-white px-4 py-3 rounded-2xl transition shadow-sm group">
                    <div class="text-left">
                        <p class="text-[9px] font-black uppercase tracking-widest text-slate-400 group-hover:text-blue-200">Auction Activity</p>
                        <p class="text-xs font-black uppercase tracking-wider">Recent Bids by Teams</p>
                    </div>
                    <span id="modalExpandBidsArrow" class="text-xl font-black transition-transform duration-200">›</span>
                </button>
                <div id="modalBidHistoryPanel" class="hidden relative z-10 mb-4 bg-white rounded-2xl border border-slate-200 p-3 max-h-44 overflow-y-auto custom-scroll">
                    <div id="modalBidHistoryList" class="space-y-2">
                        <p class="text-[10px] text-slate-400 italic font-bold">Loading…</p>
                    </div>
                </div>

                <!-- CLEAN BIDDING BOX -->
                <div id="modalBiddingBox" class="relative z-10 bg-white text-slate-900 p-4 rounded-2xl border border-slate-200 mb-4 shadow-sm">
                    <div class="grid grid-cols-2 gap-3 mb-4">
                        <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-3">
                            <span id="modalHighestBidLabel" class="text-[8px] font-black text-emerald-600/70 uppercase tracking-widest block">Highest Bid</span>
                            <span id="modalHighestBid" class="text-lg font-black italic text-emerald-600 leading-tight">No bids yet</span>
                        </div>
                        <div class="bg-slate-50 border border-slate-100 rounded-xl p-3">
                            <span class="text-[8px] font-black text-slate-400 uppercase tracking-widest block">Reserve</span>
                            <span id="modalReservePrice" class="text-lg font-black italic text-slate-700 leading-tight">0 Vollars</span>
                        </div>
                    </div>

                    <% if ((typeof isManager !== 'undefined' && isManager) || (typeof currentManagerTeam !== 'undefined' && currentManagerTeam)) { %>
                        <form action="/auction/bid" method="POST" class="space-y-3" id="modalBidForm" onsubmit="return confirmBidSubmit(event)">
                            <input type="hidden" id="modalPlayerId" name="playerId" value="">
                            <% if (typeof currentManagerTeam !== 'undefined' && currentManagerTeam) { %>
                                <input type="hidden" name="teamId" value="<%= currentManagerTeam %>">
                            <% } %>

                            <div>
                                <p class="text-[9px] font-black uppercase tracking-wider text-slate-400 mb-1.5">Quick amounts</p>
                                <div id="modalQuickBidRow" class="grid grid-cols-3 gap-2"></div>
                            </div>

                            <div>
                                <p class="text-[9px] font-black uppercase tracking-wider text-slate-400 mb-1.5">Or type your bid</p>
                                <input
                                    type="number"
                                    id="modalBidInput"
                                    name="bidAmount"
                                    placeholder="Amount in Vollars"
                                    required
                                    min="1"
                                    class="w-full bg-slate-50 border border-slate-200 text-slate-900 text-sm font-bold px-4 py-3 rounded-xl outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition"
                                >
                            </div>

                            <button
                                type="submit"
                                id="modalBidButton"
                                class="w-full bg-slate-900 hover:bg-blue-600 text-white text-xs font-black py-3.5 rounded-xl uppercase tracking-widest transition shadow-md"
                            >
                                Place Bid
                            </button>
                        </form>

                        <div class="grid grid-cols-2 gap-2 mt-3">
                            <button
                                type="button"
                                onclick="editCurrentBid()"
                                class="bg-amber-50 hover:bg-amber-500 text-amber-700 hover:text-white border border-amber-200 px-3 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-wider transition"
                            >
                                Edit My Bid
                            </button>
                            <form
                                action="/auction/withdraw"
                                method="POST"
                                onsubmit="return confirm('Withdraw your bid for this player?')"
                            >
                                <input type="hidden" id="modalWithdrawPlayerId" name="playerId" value="">
                                <% if (typeof currentManagerTeam !== 'undefined' && currentManagerTeam) { %>
                                    <input type="hidden" name="teamId" value="<%= currentManagerTeam %>">
                                <% } %>
                                <button
                                    type="submit"
                                    class="w-full bg-red-50 hover:bg-red-600 text-red-600 hover:text-white border border-red-200 px-3 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-wider transition"
                                >
                                    Withdraw
                                </button>
                            </form>
                        </div>
                    <% } else { %>
                        <p class="text-[10px] text-slate-400 italic text-center py-2">
                            Only authorized team managers can place bids.
                        </p>
                    <% } %>
                </div>

                <button onclick="closeBio()" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-900 py-3 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] transition-all duration-300">Return to Market</button>
            </div>
        </div>
    </div>

    <!-- USER AUTHENTICATION & MANAGEMENT PANELS -->
    <div class="max-w-4xl mx-auto px-6">
        <% if (user) { %>
            <div class="max-w-xl mx-auto bg-white p-10 rounded-[36px] shadow-xl border border-slate-200 text-center space-y-5">
                <h3 class="text-2xl font-black italic uppercase text-slate-900">Welcome Back, <span class="text-blue-600"><%= user.name %></span></h3>
                <div class="pt-2 space-y-3">
                    <a href="/profile" class="block w-full bg-blue-600 text-white py-4 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-blue-700 transition shadow-md">Manage Profile & Stats</a>
                    <form action="/profile/delete" method="POST" onsubmit="return confirm('Withdraw your application from the market?')">
                        <button type="submit" class="w-full bg-red-50 text-red-600 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest border border-red-200 hover:bg-red-600 hover:text-white transition">Withdraw Application</button>
                    </form>
                </div>
            </div>
        <% } else { %>
            <div class="max-w-2xl mx-auto">
                <!-- Registration Form -->
                <div id="registerBox" class="bg-white p-8 md:p-10 rounded-[36px] shadow-2xl border border-slate-200/80 relative overflow-hidden">
                    <div class="mb-6 flex justify-between items-end border-b border-slate-100 pb-4">
                        <div>
                            <span class="text-[10px] font-black text-blue-600 tracking-widest uppercase">Market Application</span>
                            <h3 class="text-3xl font-black italic uppercase text-slate-900">Register Player</h3>
                        </div>
                        <span class="text-xs font-black text-slate-300 italic">VIM LEAGUE</span>
                    </div>

                    <form action="/register" method="POST" class="space-y-5">
                        <!-- Primary User Handles -->
                        <div>
                            <span class="form-label">Username and Information</span>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                <div>
                                    <input name="name" placeholder="Roblox Username" required class="form-input">
                                </div>
                                <div>
                                    <input name="discord" placeholder="Discord Username (e.g. @user)" required class="form-input">
                                </div>
                            </div>
                        </div>

                        <!-- Visual Position Selection Cards -->
                        <div>
                            <span class="form-label">Select Primary Position</span>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                                <div>
                                    <input type="radio" id="posFWD" name="position" value="FWD" class="hidden position-radio" required>
                                    <label for="posFWD" class="flex flex-col items-center justify-center p-3 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 transition text-center">
                                        <span class="text-xs font-black text-red-500">FWD</span>
                                        <span class="text-[9px] font-bold text-slate-400 uppercase">Forward</span>
                                    </label>
                                </div>
                                <div>
                                    <input type="radio" id="posMID" name="position" value="MID" class="hidden position-radio">
                                    <label for="posMID" class="flex flex-col items-center justify-center p-3 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 transition text-center">
                                        <span class="text-xs font-black text-purple-500">MID</span>
                                        <span class="text-[9px] font-bold text-slate-400 uppercase">Midfield</span>
                                    </label>
                                </div>
                                <div>
                                    <input type="radio" id="posDEF" name="position" value="DEF" class="hidden position-radio">
                                    <label for="posDEF" class="flex flex-col items-center justify-center p-3 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 transition text-center">
                                        <span class="text-xs font-black text-blue-500">DEF</span>
                                        <span class="text-[9px] font-bold text-slate-400 uppercase">Defense</span>
                                    </label>
                                </div>
                                <div>
                                    <input type="radio" id="posGK" name="position" value="GK" class="hidden position-radio">
                                    <label for="posGK" class="flex flex-col items-center justify-center p-3 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 transition text-center">
                                        <span class="text-xs font-black text-amber-500">GK</span>
                                        <span class="text-[9px] font-bold text-slate-400 uppercase">Goalkeeper</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Location & Timezone Selectors (Complete Country List Preserved) -->
                        <div>
                            <span class="form-label">Regional Information</span>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                <select name="country" required class="form-input">
                                    <option value="" disabled selected>Select Country</option>
                                    <option value="Afghanistan">🇦🇫 Afghanistan</option>
                                    <option value="Albania">🇦🇱 Albania</option>
                                    <option value="Algeria">🇩🇿 Algeria</option>
                                    <option value="Andorra">🇦🇩 Andorra</option>
                                    <option value="Angola">🇦🇴 Angola</option>
                                    <option value="Antigua and Barbuda">🇦🇬 Antigua and Barbuda</option>
                                    <option value="Argentina">🇦🇷 Argentina</option>
                                    <option value="Armenia">🇦🇲 Armenia</option>
