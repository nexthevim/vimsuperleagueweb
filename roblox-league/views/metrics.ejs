<%- include('partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --mt-paper: #f4f1e9;
  --mt-ink: #0f2f2f;
  --mt-ink-deep: #073536;
  --mt-teal: #07595a;
  --mt-coral: #e87a64;
  --mt-muted: #6d7f7a;
  --mt-line: rgba(15,47,47,.1);
  --mt-display: "DM Serif Display", Georgia, serif;
  --mt-body: "Manrope", system-ui, sans-serif;
}
* { box-sizing: border-box; }
body { margin: 0; font-family: var(--mt-body); }

.mt-page {
  min-height: 100vh;
  color: var(--mt-ink);
  background:
    radial-gradient(ellipse 55% 40% at 8% 0%, rgba(232,122,100,.12), transparent 50%),
    radial-gradient(ellipse 45% 35% at 95% 8%, rgba(7,89,90,.1), transparent 48%),
    var(--mt-paper);
  padding: 5.5rem 0 4rem;
}
.mt-wrap { width: min(1120px, calc(100% - 1.75rem)); margin: 0 auto; }

.mt-hero {
  text-align: center;
  margin-bottom: 2rem;
  animation: mtIn .55s cubic-bezier(.22,1,.36,1) both;
}
.mt-hero .eyebrow {
  display: inline-flex; align-items: center; gap: .5rem;
  font-size: .62rem; font-weight: 800; letter-spacing: .18em;
  text-transform: uppercase; color: var(--mt-coral);
}
.mt-hero .eyebrow::before {
  content: ""; width: 16px; height: 2px; background: currentColor;
}
.mt-hero h1 {
  margin: .4rem 0 .3rem;
  font-family: var(--mt-display);
  font-size: clamp(2.6rem, 5.5vw, 3.8rem);
  line-height: .92; color: var(--mt-ink-deep);
}
.mt-hero h1 em { font-style: italic; color: var(--mt-teal); }
.mt-hero p { margin: 0; color: var(--mt-muted); font-size: .85rem; }

.mt-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: .85rem;
  margin-bottom: 2rem;
  animation: mtIn .55s .06s cubic-bezier(.22,1,.36,1) both;
}
@media (max-width: 900px) {
  .mt-stats { grid-template-columns: repeat(2, 1fr); }
}
.mt-stat {
  background: #fffdf8;
  border: 1px solid var(--mt-line);
  border-radius: 1.35rem;
  padding: 1.1rem 1.15rem;
  box-shadow: 0 12px 30px rgba(15,47,47,.05);
  transition: transform .25s cubic-bezier(.22,1,.36,1);
}
.mt-stat:hover { transform: translateY(-3px); }
.mt-stat span {
  display: block; font-size: .55rem; font-weight: 800;
  letter-spacing: .12em; text-transform: uppercase; color: var(--mt-muted);
}
.mt-stat strong {
  display: block; margin-top: .35rem;
  font-family: var(--mt-display); font-size: 1.75rem;
  color: var(--mt-ink-deep); line-height: 1;
}
.mt-stat em {
  display: block; margin-top: .35rem; font-style: normal;
  font-size: .72rem; font-weight: 800; color: var(--mt-teal);
  text-transform: uppercase; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.mt-card {
  background: #fffdf8;
  border: 1px solid var(--mt-line);
  border-radius: 1.55rem;
  overflow: hidden;
  box-shadow: 0 14px 36px rgba(15,47,47,.05);
  margin-bottom: 1.35rem;
  animation: mtIn .55s cubic-bezier(.22,1,.36,1) both;
}

.mt-card-head {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
  gap: .75rem; padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--mt-line);
  background: linear-gradient(135deg, rgba(7,89,90,.05), rgba(232,122,100,.04));
}
.mt-card-head h2 {
  margin: 0; font-family: var(--mt-display);
  font-size: 1.35rem; color: var(--mt-ink-deep);
}
.mt-pill {
  font-size: .55rem; font-weight: 800; letter-spacing: .1em;
  text-transform: uppercase; padding: .35rem .7rem; border-radius: 999px;
  background: rgba(15,47,47,.06); color: var(--mt-muted);
}

table.mt-table {
  width: 100%; border-collapse: collapse; text-align: left;
}
.mt-table thead th {
  padding: .85rem 1rem;
  font-size: .55rem; font-weight: 800; letter-spacing: .12em;
  text-transform: uppercase; color: var(--mt-muted);
  border-bottom: 1px solid var(--mt-line);
  background: rgba(15,47,47,.02);
}
.mt-table tbody tr {
  border-bottom: 1px solid var(--mt-line);
  transition: background .15s;
}
.mt-table tbody tr:last-child { border-bottom: 0; }
.mt-table tbody tr:hover { background: rgba(7,89,90,.03); }
.mt-table td { padding: .9rem 1rem; vertical-align: middle; }

.pos {
  display: inline-flex; align-items: center; justify-content: center;
  width: 1.7rem; height: 1.7rem; border-radius: 50%;
  font-size: .7rem; font-weight: 900;
  background: rgba(15,47,47,.06); color: var(--mt-ink);
}
.pos.g { background: linear-gradient(135deg, #f5d78e, #c9a227); color: #fff; }
.pos.s { background: linear-gradient(135deg, #e2e8f0, #94a3b8); color: #fff; }
.pos.b { background: linear-gradient(135deg, #fdba74, #c2410c); color: #fff; }

.club {
  display: flex; align-items: center; gap: .65rem;
  text-decoration: none; color: inherit;
}
.club img {
  width: 36px; height: 36px; object-fit: contain;
  border-radius: .65rem; background: rgba(15,47,47,.04);
  border: 1px solid var(--mt-line); padding: 4px;
  transition: transform .2s;
}
.club:hover img { transform: scale(1.08); }
.club span {
  font-size: .82rem; font-weight: 800; text-transform: uppercase;
  letter-spacing: -.01em; color: var(--mt-ink-deep);
}
.club:hover span { color: var(--mt-teal); }

.num { font-size: .8rem; font-weight: 800; color: var(--mt-muted); text-align: center; }
.num.w { color: #059669; }
.num.l { color: #e11d48; }
.pts {
  font-family: var(--mt-display); font-size: 1.35rem;
  color: var(--mt-ink-deep); text-align: right; font-weight: 400;
}

.mt-boards {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;
  margin-top: 1.5rem;
}
@media (max-width: 800px) {
  .mt-boards { grid-template-columns: 1fr; }
}
.mt-board-list { padding: .75rem; }
.mt-row {
  display: flex; align-items: center; justify-content: space-between; gap: .75rem;
  padding: .65rem .7rem; border-radius: .9rem;
  border: 1px solid transparent;
  transition: background .15s, border-color .15s;
}
.mt-row:hover {
  background: rgba(7,89,90,.04);
  border-color: var(--mt-line);
}
.mt-row-left { display: flex; align-items: center; gap: .55rem; min-width: 0; }
.mt-row-n {
  width: 1.45rem; height: 1.45rem; border-radius: .45rem;
  display: grid; place-items: center;
  font-size: .6rem; font-weight: 900;
  background: rgba(15,47,47,.07); color: var(--mt-ink); flex-shrink: 0;
}
.mt-row-name {
  font-size: .75rem; font-weight: 800; text-transform: uppercase;
  color: var(--mt-ink-deep); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.mt-row-val {
  display: flex; align-items: center; gap: .45rem; flex-shrink: 0;
}
.mt-row-val strong { font-size: .8rem; font-weight: 900; color: var(--mt-ink-deep); }
.mt-bar {
  width: 48px; height: 5px; border-radius: 999px;
  background: rgba(15,47,47,.08); overflow: hidden;
}
.mt-bar i {
  display: block; height: 100%; border-radius: 999px;
  background: linear-gradient(90deg, var(--mt-teal), var(--mt-coral));
}

.mt-empty {
  padding: 2.5rem; text-align: center;
  font-size: .75rem; font-weight: 800; letter-spacing: .1em;
  text-transform: uppercase; color: var(--mt-muted);
}

@keyframes mtIn {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: none; }
}
</style>

<div class="mt-page">
  <div class="mt-wrap">

    <header class="mt-hero">
      <div class="eyebrow">Live analytics</div>
      <h1>League <em>Metrics</em></h1>
      <p>Standings, squads & individual leaders</p>
    </header>

    <%
      let totalTeamsCount = 0;
      if (groups && groups.length > 0) {
        groups.forEach(g => { totalTeamsCount += (g.teams ? g.teams.length : 0); });
      }
      const topScorer = (leaderboards && leaderboards.scorers && leaderboards.scorers[0]) ? leaderboards.scorers[0] : null;
      const topSaves = (leaderboards && leaderboards.saves && leaderboards.saves[0]) ? leaderboards.saves[0] : null;
    %>

    <div class="mt-stats">
      <div class="mt-stat">
        <span>Active groups</span>
        <strong><%= groups ? groups.length : 0 %></strong>
      </div>
      <div class="mt-stat">
        <span>Registered squads</span>
        <strong><%= totalTeamsCount %></strong>
      </div>
      <div class="mt-stat">
        <span>Top goalscorer</span>
        <strong style="font-size:1.15rem"><%= topScorer ? topScorer.value : 0 %></strong>
        <em><%= topScorer ? topScorer.name : '—' %></em>
      </div>
      <div class="mt-stat">
        <span>Golden glove</span>
        <strong style="font-size:1.15rem"><%= topSaves ? topSaves.value : 0 %></strong>
        <em><%= topSaves ? topSaves.name : '—' %></em>
      </div>
    </div>

    <% if (groups && groups.length > 0) { %>
      <% groups.forEach((group, gIdx) => { %>
        <div class="mt-card" style="animation-delay:<%= (gIdx * 0.05).toFixed(2) %>s">
          <div class="mt-card-head">
            <h2><%= group.name %></h2>
            <span class="mt-pill">Official standings</span>
          </div>
          <div style="overflow-x:auto">
            <table class="mt-table">
              <thead>
                <tr>
                  <th style="text-align:center;width:3.5rem">Pos</th>
                  <th>Club</th>
                  <th style="text-align:center;width:3rem">MP</th>
                  <th style="text-align:center;width:3rem">W</th>
                  <th style="text-align:center;width:3rem">L</th>
                  <th style="text-align:right;width:4rem">Pts</th>
                </tr>
              </thead>
              <tbody>
                <% (group.teams || []).forEach((team, index) => {
                  const posCls = index === 0 ? 'g' : (index === 1 ? 's' : (index === 2 ? 'b' : ''));
                  const gid = group._id || group.id;
                %>
                  <tr>
                    <td style="text-align:center"><span class="pos <%= posCls %>"><%= index + 1 %></span></td>
                    <td>
                      <a class="club" href="/team/<%= gid %>/<%= index %>">
                        <img src="<%= team.logo %>" onerror="this.onerror=null;this.src='https://via.placeholder.com/80/f4f1e9/07595a?text=FC'" alt="">
                        <span><%= team.name %></span>
                      </a>
                    </td>
                    <td class="num"><%= team.mp || 0 %></td>
                    <td class="num w"><%= team.wins || 0 %></td>
                    <td class="num l"><%= team.loses || 0 %></td>
                    <td class="pts"><%= team.pts || 0 %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="mt-card"><div class="mt-empty">No active group standings</div></div>
    <% } %>

    <div class="mt-boards">
      <% ['scorers', 'saves', 'assists'].forEach((type, tIdx) => { %>
        <div class="mt-card" style="animation-delay:<%= (0.15 + tIdx * 0.05).toFixed(2) %>s;margin-bottom:0">
          <div class="mt-card-head">
            <h2 style="font-size:1.1rem">Top <%= type %></h2>
            <span class="mt-pill">Individual</span>
          </div>
          <div class="mt-board-list">
            <% if (leaderboards && leaderboards[type] && leaderboards[type].length > 0) {
              const maxVal = leaderboards[type][0].value || 1;
              leaderboards[type].slice(0, 8).forEach((player, index) => {
            %>
              <div class="mt-row">
                <div class="mt-row-left">
                  <span class="mt-row-n"><%= index + 1 %></span>
                  <span class="mt-row-name"><%= player.name %></span>
                </div>
                <div class="mt-row-val">
                  <strong><%= player.value %></strong>
                  <div class="mt-bar"><i style="width:<%= Math.min(100, (player.value / maxVal) * 100) %>%"></i></div>
                </div>
              </div>
            <% }); } else { %>
              <div class="mt-empty" style="padding:1.5rem">No stats yet</div>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>

  </div>
</div>
