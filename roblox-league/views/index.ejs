<%- include('partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
/* =========================================================
   VIM SUPER LEAGUE — EDITORIAL / ORGANIC HOMEPAGE
   Inspired by premium studio / magazine layouts:
   image-led, curved sections, tactile buttons, asymmetry.
   Navbar is intentionally kept outside this skin.
   ========================================================= */

:root {
    --vsl-paper: #f7f4ed;
    --vsl-paper-2: #fffdf8;
    --vsl-ink: #123b3c;
    --vsl-ink-deep: #083536;
    --vsl-teal: #07595a;
    --vsl-teal-2: #0b6867;
    --vsl-coral: #f18470;
    --vsl-coral-dark: #dc6957;
    --vsl-mint: #d9ece6;
    --vsl-sand: #ece6da;
    --vsl-text: #274647;
    --vsl-muted: #728081;
    --vsl-line: rgba(18,59,60,.13);
    --vsl-white: #fff;
    --vsl-display: "DM Serif Display", Georgia, serif;
    --vsl-body: "Manrope", "Plus Jakarta Sans", system-ui, sans-serif;
}

html { scroll-behavior: smooth; }

body {
    margin: 0;
    background: var(--vsl-paper);
    color: var(--vsl-text);
    font-family: var(--vsl-body);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
}

/* The existing navbar remains rendered by partials/navbar.
   This offset keeps the first section below fixed navbars without styling
   or replacing the navigation itself. */
.vsl-home {
    padding-top: 5.35rem;
    overflow: hidden;
}

.vsl-shell {
    width: min(1190px, calc(100% - 44px));
    margin-inline: auto;
}

.vsl-display {
    font-family: var(--vsl-display);
    font-weight: 400;
    letter-spacing: -.035em;
}

.vsl-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--vsl-coral-dark);
    font-size: .64rem;
    font-weight: 800;
    letter-spacing: .17em;
    text-transform: uppercase;
}

.vsl-eyebrow::before {
    content: "";
    width: 19px;
    height: 1px;
    background: currentColor;
}

.vsl-quiet {
    color: var(--vsl-muted);
    line-height: 1.75;
}

/* ---------------------------------------------------------
   HERO
   --------------------------------------------------------- */

.vsl-hero {
    position: relative;
    min-height: 640px;
    display: flex;
    align-items: center;
    overflow: visible;
    border-radius: 0 0 0 110px;
    background: var(--vsl-ink-deep);
}

.vsl-hero::after {
    content: "";
    position: absolute;
    left: -3%;
    right: -3%;
    bottom: -55px;
    height: 115px;
    background: var(--vsl-paper);
    border-radius: 50% 50% 0 0 / 60% 60% 0 0;
    z-index: 2;
}

.vsl-hero-copy {
    position: relative;
    z-index: 3;
    width: min(540px, 54%);
    padding: 72px 0 110px;
}

.vsl-brand-line {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    color: var(--vsl-teal);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
}

.vsl-brand-mark {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--vsl-mint);
    color: var(--vsl-teal);
    font-family: var(--vsl-display);
    font-size: 1rem;
}

.vsl-hero h1 {
    margin: 0;
    color: var(--vsl-ink-deep);
    font-size: clamp(4.5rem, 8.2vw, 7.5rem);
    line-height: .82;
}

.vsl-hero h1 span {
    display: block;
    margin-left: 27px;
    color: var(--vsl-teal);
    font-style: italic;
    font-size: .68em;
}

.vsl-hero-lead {
    max-width: 385px;
    margin: 24px 0 26px;
    color: #506465;
    font-size: .9rem;
    line-height: 1.72;
}

.vsl-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 11px;
}

.vsl-btn {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    padding: 0 19px;
    border-radius: 999px;
    border: 0;
    text-decoration: none;
    font-family: var(--vsl-body);
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .11em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
}

.vsl-btn::after {
    content: "→";
    font-size: .95rem;
    transition: transform .18s ease;
}

.vsl-btn:hover {
    transform: translateY(-3px);
}

.vsl-btn:hover::after {
    transform: translateX(4px);
}

.vsl-btn:active {
    transform: translateY(1px);
}

.vsl-btn-coral {
    background: var(--vsl-coral);
    color: #fff;
    box-shadow: 0 5px 0 #c95e4e, 0 12px 25px rgba(241,132,112,.23);
}

.vsl-btn-coral:hover {
    background: #f48d7a;
    color: #fff;
    box-shadow: 0 3px 0 #c95e4e, 0 14px 30px rgba(241,132,112,.28);
}

.vsl-btn-teal {
    background: var(--vsl-teal);
    color: #fff;
    box-shadow: 0 5px 0 #043d3e, 0 12px 25px rgba(7,89,90,.18);
}

.vsl-btn-teal:hover {
    color: #fff;
    background: #096565;
    box-shadow: 0 3px 0 #043d3e, 0 14px 30px rgba(7,89,90,.25);
}

.vsl-btn-outline {
    border: 1px solid rgba(255,255,255,.45);
    color: #fff;
    background: rgba(255,255,255,.07);
    backdrop-filter: blur(8px);
}

.vsl-btn-outline:hover {
    color: #fff;
    background: rgba(255,255,255,.15);
}

/* hero floating match card */
.vsl-hero-card {
    position: absolute;
    z-index: 7;
    right: 7%;
    bottom: 75px;
    width: 285px;
    padding: 19px;
    border-radius: 23px 23px 8px 23px;
    background: rgba(255,253,248,.95);
    color: var(--vsl-ink);
    box-shadow: 0 25px 60px rgba(19,59,60,.22);
    transform: rotate(-2deg);
    backdrop-filter: blur(12px);
    animation: vslHover 5s ease-in-out infinite;
}

.vsl-hero-card::before {
    content: "";
    position: absolute;
    width: 16px;
    height: 16px;
    top: -7px;
    right: 30px;
    border-radius: 50%;
    background: var(--vsl-coral);
    box-shadow: 0 3px 10px rgba(241,132,112,.3);
}

.vsl-card-label {
    color: var(--vsl-coral-dark);
    font-size: .57rem;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
    margin-bottom: 14px;
}

.vsl-match-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 9px;
}

.vsl-side {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
}

.vsl-side:last-child {
    flex-direction: row-reverse;
    text-align: right;
}

.vsl-side img {
    width: 38px;
    height: 38px;
    object-fit: contain;
}

.vsl-side span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: .62rem;
    font-weight: 800;
    text-transform: uppercase;
}

.vsl-vs {
    color: #92a0a0;
    font-family: var(--vsl-display);
    font-style: italic;
    font-size: 1.15rem;
}

/* ---------------------------------------------------------
   SEARCH
   --------------------------------------------------------- */

.vsl-search-dock {
    position: absolute;
    z-index: 8;
    left: 50%;
    bottom: 8px;
    width: min(550px, calc(100% - 44px));
    transform: translate(-50%, 50%);
}

.vsl-search {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 6px;
    border: 1px solid rgba(18,59,60,.09);
    border-radius: 999px;
    background: var(--vsl-paper-2);
    box-shadow: 0 18px 42px rgba(18,59,60,.15);
}

.vsl-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    padding: 12px 16px;
    background: transparent;
    color: var(--vsl-ink);
    font-family: inherit;
    font-size: .78rem;
    font-weight: 600;
}

.vsl-search input::placeholder { color: #97a1a1; }

.vsl-search button {
    min-height: 42px;
    border: 0;
    border-radius: 999px;
    padding: 0 17px;
    background: var(--vsl-teal);
    color: #fff;
    font-family: inherit;
    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .09em;
    text-transform: uppercase;
    cursor: pointer;
}

#search-results-dropdown {
    position: absolute;
    left: 0; right: 0;
    top: calc(100% + 9px);
    max-height: 300px;
    overflow-y: auto;
    padding: 12px;
    border-radius: 20px;
    background: var(--vsl-paper-2);
    box-shadow: 0 25px 55px rgba(18,59,60,.18);
    color: var(--vsl-ink);
    text-align: left;
    z-index: 30;
}

.hidden { display: none !important; }

/* ---------------------------------------------------------
   SERVICE / ENTRY CARDS
   --------------------------------------------------------- */

.vsl-services {
    padding: 72px 0 48px;
}

.vsl-section-title {
    text-align: center;
    max-width: 690px;
    margin: 0 auto 31px;
}

.vsl-section-title h2 {
    margin: 11px 0 10px;
    color: var(--vsl-ink-deep);
    font-size: clamp(2.7rem, 5vw, 4.6rem);
    line-height: .9;
}

.vsl-section-title p {
    max-width: 520px;
    margin: 0 auto;
    color: var(--vsl-muted);
    font-size: .78rem;
    line-height: 1.7;
}

.vsl-service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 13px;
}

.vsl-service {
    position: relative;
    min-height: 240px;
    padding: 28px 22px 22px;
    border: 1px solid rgba(18,59,60,.10);
    border-radius: 18px;
    background: #fffdf8;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    /* 3D block */
    box-shadow:
        0 1px 0 rgba(255,255,255,.9) inset,
        0 0 0 1px rgba(18,59,60,.04),
        0 10px 0 #d9d2c4,
        0 16px 28px rgba(18,59,60,.10);
    transform: translateY(0);
    transition: transform .2s cubic-bezier(.2,.8,.2,1), box-shadow .2s ease;
    overflow: visible;
}

.vsl-service:nth-child(2) { margin-top: 12px; }
.vsl-service:nth-child(4) { margin-top: -6px; }

.vsl-service:hover {
    transform: translateY(-10px);
    box-shadow:
        0 1px 0 rgba(255,255,255,.95) inset,
        0 0 0 1px rgba(18,59,60,.05),
        0 18px 0 #d9d2c4,
        0 28px 40px rgba(18,59,60,.16);
    color: inherit;
}

.vsl-service:active {
    transform: translateY(4px);
    box-shadow:
        0 1px 0 rgba(255,255,255,.7) inset,
        0 0 0 1px rgba(18,59,60,.04),
        0 4px 0 #d9d2c4,
        0 8px 16px rgba(18,59,60,.12);
}

.vsl-service-icon {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    border-radius: 16px;
    margin-bottom: 4px;
    transition: transform .28s cubic-bezier(.2,.8,.2,1);
    box-shadow: 0 8px 16px rgba(18,59,60,.12);
}

.vsl-service:hover .vsl-service-icon {
    transform: translateY(-14px) scale(1.12);
}

.vsl-service:nth-child(1) .vsl-service-icon {
    background: linear-gradient(145deg, #7dd3fc, #2563eb);
}
.vsl-service:nth-child(2) .vsl-service-icon {
    background: linear-gradient(145deg, #86efac, #15803d);
}
.vsl-service:nth-child(3) .vsl-service-icon {
    background: linear-gradient(145deg, #c4b5fd, #6d28d9);
}
.vsl-service:nth-child(4) .vsl-service-icon {
    background: linear-gradient(145deg, #fcd34d, #c2410c);
}

.vsl-service-icon svg {
    width: 30px;
    height: 30px;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,.2));
}

.vsl-service h3 {
    margin: 18px 0 8px;
    color: var(--vsl-ink);
    font-size: .76rem;
    line-height: 1.35;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.vsl-service p {
    margin: 0 0 16px;
    color: var(--vsl-muted);
    font-size: .69rem;
    line-height: 1.65;
    flex: 1;
}

.vsl-mini-link {
    color: var(--vsl-ink);
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    text-decoration: none;
}

.vsl-mini-link::after {
    content: " →";
    color: var(--vsl-coral-dark);
}

/* ---------------------------------------------------------
   TEAL FEATURED MATCHDAY BAND
   --------------------------------------------------------- */

.vsl-featured {
    position: relative;
    margin-top: 16px;
    padding: 56px 0 72px;
    background: var(--vsl-teal);
    color: #fff;
    overflow: hidden;
}

.vsl-featured::before {
    content: "";
    position: absolute;
    top: -70px;
    left: -4%;
    width: 108%;
    height: 120px;
    background: var(--vsl-paper);
    border-radius: 50%;
}

.vsl-featured::after {
    content: "";
    position: absolute;
    bottom: -95px;
    left: -5%;
    width: 110%;
    height: 150px;
    background: var(--vsl-paper);
    border-radius: 50%;
}

.vsl-featured .vsl-eyebrow {
    color: #f3b7a9;
}

.vsl-featured .vsl-section-title h2 {
    color: #fff;
}

.vsl-featured .vsl-section-title p {
    color: rgba(255,255,255,.63);
}

.vsl-featured-inner {
    position: relative;
    z-index: 2;
}

.vsl-results-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 11px;
    align-items: end;
}

.vsl-result {
    position: relative;
    min-height: 165px;
    padding: 16px;
    overflow: hidden;
    border-radius: 12px 12px 12px 4px;
    background: #fff;
    color: var(--vsl-ink);
    text-decoration: none;
    box-shadow: 0 12px 26px rgba(0,0,0,.12);
    transition: transform .2s ease;
}

.vsl-result:nth-child(2) { transform: translateY(-13px); }
.vsl-result:nth-child(4) { transform: translateY(-8px); }

.vsl-result:hover {
    transform: translateY(-16px) rotate(-.5deg) !important;
    color: var(--vsl-ink);
}

.vsl-result::after {
    content: "FT";
    position: absolute;
    right: -5px;
    bottom: -14px;
    color: rgba(7,89,90,.055);
    font-family: var(--vsl-display);
    font-size: 5rem;
}

.vsl-result-meta {
    color: var(--vsl-coral-dark);
    font-size: .5rem;
    font-weight: 800;
    letter-spacing: .11em;
    text-transform: uppercase;
}

.vsl-result-team {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 17px;
}

.vsl-result-team img {
    width: 31px;
    height: 31px;
    object-fit: contain;
}

.vsl-result-team span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: .62rem;
    font-weight: 800;
    text-transform: uppercase;
}

.vsl-result-team strong {
    margin-left: auto;
    font-family: var(--vsl-display);
    font-size: 1.55rem;
}

.vsl-result-divider {
    height: 1px;
    margin: 10px 0 2px;
    background: rgba(18,59,60,.09);
}

.vsl-featured-action {
    display: flex;
    justify-content: center;
    margin-top: 26px;
}

/* ---------------------------------------------------------
   STORY / SPLIT IMAGE SECTION
   --------------------------------------------------------- */

.vsl-story-section {
    padding: 64px 0 52px;
}

.vsl-story-layout {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: 70px;
    align-items: center;
}

.vsl-story-image {
    position: relative;
    min-height: 440px;
}

.vsl-story-image-main {
    position: absolute;
    left: 0;
    top: 0;
    width: 78%;
    height: 390px;
    object-fit: cover;
    border-radius: 180px 180px 15px 15px;
    box-shadow: 0 22px 45px rgba(18,59,60,.13);
}

.vsl-story-image-small {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 47%;
    height: 190px;
    object-fit: cover;
    border-radius: 90px 12px 90px 12px;
    border: 9px solid var(--vsl-paper);
    box-shadow: 0 20px 35px rgba(18,59,60,.15);
}

.vsl-story-copy h2 {
    margin: 13px 0 15px;
    color: var(--vsl-ink-deep);
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: .88;
}

.vsl-story-copy p {
    max-width: 480px;
    margin: 0 0 23px;
    color: var(--vsl-muted);
    font-size: .79rem;
    line-height: 1.8;
}

.vsl-signature {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--vsl-ink);
    font-family: var(--vsl-display);
    font-size: 1.05rem;
    font-style: italic;
}

.vsl-signature span {
    width: 34px;
    height: 1px;
    background: var(--vsl-coral);
}

/* ---------------------------------------------------------
   PROCESS / HOW IT WORKS
   --------------------------------------------------------- */

.vsl-process {
    padding: 52px 0;
    background: var(--vsl-paper-2);
    border-top: 1px solid rgba(18,59,60,.06);
    border-bottom: 1px solid rgba(18,59,60,.06);
}

.vsl-process-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 65px;
    align-items: start;
}

.vsl-process-copy h2 {
    margin: 10px 0 13px;
    color: var(--vsl-ink-deep);
    font-size: clamp(3rem, 5vw, 4.6rem);
    line-height: .87;
}

.vsl-process-copy p {
    max-width: 370px;
    margin: 0;
    color: var(--vsl-muted);
    font-size: .76rem;
    line-height: 1.8;
}

.vsl-process-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 40px;
}

.vsl-process-item {
    position: relative;
    display: grid;
    grid-template-columns: 43px 1fr;
    gap: 13px;
    align-items: start;
}

.vsl-process-item:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 20px;
    top: 43px;
    width: 1px;
    height: 60px;
    background: var(--vsl-line);
}

.vsl-process-num {
    width: 43px;
    height: 43px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--vsl-mint);
    color: var(--vsl-teal);
    font-family: var(--vsl-display);
    font-size: 1.15rem;
}

.vsl-process-item h3 {
    margin: 4px 0 6px;
    color: var(--vsl-ink);
    font-size: .7rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.vsl-process-item p {
    margin: 0;
    color: var(--vsl-muted);
    font-size: .66rem;
    line-height: 1.6;
}

/* ---------------------------------------------------------
   TESTIMONIAL + GALLERY
   --------------------------------------------------------- */

.vsl-testimonial {
    position: relative;
    padding: 56px 0 64px;
    overflow: hidden;
    background:
        radial-gradient(circle at 18% 50%, rgba(255,255,255,.24), transparent 16rem),
        linear-gradient(180deg, #d9ece6, #c9e4de);
}

.vsl-testimonial::before,
.vsl-testimonial::after {
    content: "";
    position: absolute;
    width: 230px;
    height: 230px;
    border: 2px solid rgba(7,89,90,.09);
    border-radius: 50%;
}

.vsl-testimonial::before { left: -120px; top: -80px; }
.vsl-testimonial::after { right: -110px; bottom: -110px; }

.vsl-quote {
    position: relative;
    z-index: 2;
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
}

.vsl-quote-mark {
    color: var(--vsl-teal);
    font-family: Georgia, serif;
    font-size: 4.3rem;
    line-height: .5;
}

.vsl-quote blockquote {
    margin: 18px 0 11px;
    color: var(--vsl-ink-deep);
    font-family: var(--vsl-display);
    font-size: clamp(2rem, 4vw, 3.3rem);
    line-height: .98;
}

.vsl-quote cite {
    color: var(--vsl-muted);
    font-size: .58rem;
    font-style: normal;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
}

.vsl-gallery {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 35px;
}

.vsl-gallery img {
    width: 112px;
    height: 112px;
    object-fit: cover;
    border: 6px solid rgba(255,255,255,.62);
    border-radius: 50%;
    box-shadow: 0 13px 25px rgba(18,59,60,.12);
}

.vsl-gallery img:nth-child(2) { transform: translateY(13px); }
.vsl-gallery img:nth-child(4) { transform: translateY(-7px); }

/* ---------------------------------------------------------
   CTA + FOOTER
   --------------------------------------------------------- */

.vsl-cta {
    position: relative;
    z-index: 3;
    width: min(950px, calc(100% - 44px));
    margin: -10px auto 0;
    padding: 35px 48px;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 30px;
    border-radius: 26px 26px 7px 26px;
    background: var(--vsl-coral);
    color: #fff;
    box-shadow: 0 22px 50px rgba(241,132,112,.28);
}

.vsl-cta h2 {
    margin: 4px 0 3px;
    font-size: clamp(2.1rem, 4vw, 3.5rem);
    line-height: .9;
}

.vsl-cta p {
    margin: 0;
    color: rgba(255,255,255,.78);
    font-size: .7rem;
}

.vsl-cta .vsl-btn {
    background: #fff;
    color: var(--vsl-ink);
    box-shadow: 0 5px 0 #d8d0c5, 0 12px 25px rgba(0,0,0,.10);
}

.vsl-footer {
    margin-top: 0;
    padding: 48px 0 20px;
    background: var(--vsl-teal);
    color: #fff;
}

.vsl-footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.25fr;
    gap: 42px;
}

.vsl-footer-brand {
    max-width: 270px;
}

.vsl-footer-brand strong {
    display: block;
    font-family: var(--vsl-display);
    font-size: 1.8rem;
    line-height: .85;
}

.vsl-footer-brand span {
    display: block;
    margin-top: 8px;
    color: rgba(255,255,255,.48);
    font-size: .55rem;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
}

.vsl-footer-brand p {
    margin: 17px 0 0;
    color: rgba(255,255,255,.58);
    font-size: .66rem;
    line-height: 1.7;
}

.vsl-footer h4 {
    margin: 0 0 13px;
    color: #f3b7a9;
    font-size: .55rem;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
}

.vsl-footer a {
    display: block;
    width: max-content;
    margin: 0 0 8px;
    color: rgba(255,255,255,.72);
    font-size: .64rem;
    text-decoration: none;
}

.vsl-footer a:hover { color: #fff; }

.vsl-footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid rgba(255,255,255,.11);
    color: rgba(255,255,255,.38);
    font-size: .55rem;
}

/* ---------------------------------------------------------
   TOUR — same functionality, restyled to match
   --------------------------------------------------------- */

#vim-tour-overlay {
    position: fixed;
    inset: 0;
    z-index: 50000;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity .25s ease, visibility .25s ease;
}

#vim-tour-overlay.active { opacity: 1; visibility: visible; }

#vim-tour-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8,53,54,.72);
    pointer-events: auto;
}

#vim-tour-spotlight {
    position: absolute;
    width: 100px;
    height: 100px;
    border-radius: 18px;
    border: 2px solid var(--vsl-coral);
    box-shadow: 0 0 0 5px rgba(241,132,112,.14), 0 0 45px rgba(0,0,0,.2);
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: left .45s cubic-bezier(.16,1,.3,1), top .45s cubic-bezier(.16,1,.3,1), width .35s ease, height .35s ease;
}

#vim-tour-card {
    position: fixed;
    width: min(360px, calc(100vw - 32px));
    padding: 1.35rem;
    border-radius: 21px;
    background: var(--vsl-paper-2);
    color: var(--vsl-ink);
    box-shadow: 0 24px 60px rgba(0,0,0,.25);
    z-index: 50002;
    pointer-events: auto;
}

#vim-tour-card.centered::before { display: none; }

.vim-tour-eyebrow {
    margin-bottom: .4rem;
    color: var(--vsl-coral-dark);
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
}

.vim-tour-title {
    margin-bottom: .45rem;
    font-family: var(--vsl-display);
    font-size: 1.8rem;
    line-height: 1;
}

.vim-tour-description {
    margin-bottom: 1rem;
    color: var(--vsl-muted);
    font-size: .82rem;
    line-height: 1.6;
}

.vim-tour-progress { display: flex; gap: 5px; margin-bottom: 1rem; }
.vim-tour-progress span { height: 3px; width: 18px; border-radius: 99px; background: #e4e1d8; }
.vim-tour-progress span.active { width: 28px; background: var(--vsl-coral); }

.vim-tour-actions { display: flex; justify-content: space-between; align-items: center; }

.vim-tour-skip {
    border: 0;
    background: transparent;
    color: var(--vsl-muted);
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
}

.vim-tour-next {
    border: 0;
    border-radius: 999px;
    padding: .72rem 1rem;
    background: var(--vsl-teal);
    color: #fff;
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
}

#vim-tour-launcher {
    position: fixed;
    right: 1.15rem;
    bottom: 1.15rem;
    width: 2.65rem;
    height: 2.65rem;
    border: 0;
    border-radius: 50%;
    background: var(--vsl-coral);
    color: #fff;
    z-index: 40000;
    font-family: var(--vsl-display);
    font-size: 1.1rem;
    cursor: pointer;
    box-shadow: 0 10px 24px rgba(0,0,0,.18);
}

@keyframes vslHover {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -8px; }
}

/* ---------------------------------------------------------
   RESPONSIVE
   --------------------------------------------------------- */

@media (max-width: 980px) {
    .vsl-hero-copy { width: 62%; }
    .vsl-hero-card { right: 4%; }
    .vsl-service-grid { grid-template-columns: repeat(2, 1fr); }
    .vsl-results-grid { grid-template-columns: repeat(3, 1fr); }
    .vsl-result:nth-child(4), .vsl-result:nth-child(2) { transform: none; }
    .vsl-result:nth-child(4):hover, .vsl-result:nth-child(2):hover { transform: translateY(-7px) !important; }
    .vsl-story-layout { gap: 45px; }
    .vsl-footer-grid { grid-template-columns: 1.3fr 1fr 1fr; }
}

@media (max-width: 760px) {
    .vsl-home { padding-top: 4.5rem; }
    .vsl-shell { width: min(100% - 28px, 1190px); }

    .vsl-hero {
        min-height: 680px;
        align-items: flex-end;
        border-radius: 0 0 0 55px;
        background:
            linear-gradient(180deg, rgba(247,244,237,.02) 15%, rgba(247,244,237,.82) 54%, rgba(247,244,237,.98) 76%),
            url('/images/vimgfx.png') 62% 20% / cover no-repeat;
    }

    .vsl-hero-copy {
        width: 100%;
        padding: 260px 0 115px;
    }

    .vsl-hero h1 { font-size: clamp(4rem, 17vw, 6rem); }
    .vsl-hero-lead { max-width: 440px; }

    .vsl-hero-card {
        right: 15px;
        top: 30px;
        bottom: auto;
        transform: rotate(2deg) scale(.9);
        transform-origin: top right;
    }

    .vsl-services { padding-top: 90px; }
    .vsl-service:nth-child(2), .vsl-service:nth-child(4) { transform: none; }
    .vsl-service:hover { transform: translateY(-6px) !important; }

    .vsl-results-grid { grid-template-columns: 1fr 1fr; }
    .vsl-story-layout { grid-template-columns: 1fr; gap: 35px; }
    .vsl-story-image { min-height: 390px; }
    .vsl-process-grid { grid-template-columns: 1fr; gap: 35px; }
    .vsl-cta { grid-template-columns: 1fr; padding: 30px; }
    .vsl-footer-grid { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 520px) {
    .vsl-shell { width: min(100% - 20px, 1190px); }
    .vsl-home { padding-top: 4rem; }

    .vsl-hero { min-height: 700px; }
    .vsl-hero-copy { padding-top: 285px; }
    .vsl-hero h1 { font-size: 4.2rem; }
    .vsl-hero h1 span { margin-left: 12px; }
    .vsl-hero-lead { font-size: .78rem; }
    .vsl-actions .vsl-btn { min-height: 43px; padding: 0 14px; }

    .vsl-hero-card {
        width: 255px;
        right: 10px;
        transform: rotate(2deg) scale(.84);
        transform-origin: top right;
    }

    .vsl-search-dock { width: calc(100% - 20px); }
    .vsl-search { flex-direction: column; border-radius: 19px; }
    .vsl-search input { width: 100%; }
    .vsl-search button { width: 100%; }

    .vsl-services { padding-top: 105px; }
    .vsl-service-grid { grid-template-columns: 1fr; }
    .vsl-service { min-height: 190px; }

    .vsl-results-grid { grid-template-columns: 1fr; }
    .vsl-result { min-height: 135px; }

    .vsl-story-image { min-height: 340px; }
    .vsl-story-image-main { width: 82%; height: 300px; }
    .vsl-story-image-small { height: 150px; }

    .vsl-process-list { grid-template-columns: 1fr; }
    .vsl-gallery { gap: 6px; }
    .vsl-gallery img { width: 78px; height: 78px; border-width: 4px; }

    .vsl-cta { width: calc(100% - 20px); }
    .vsl-footer-grid { grid-template-columns: 1fr; gap: 28px; }
    .vsl-footer-bottom { flex-direction: column; gap: 6px; }

    #vim-tour-card { bottom: 1.15rem !important; top: auto !important; left: 1rem !important; width: calc(100vw - 2rem); }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
    }
}

.vsl-hero-rotator {
    position:absolute;
    inset:0;
    z-index:1;
    overflow:hidden;
}
.vsl-hero-slide {
    position:absolute;
    inset:0;
    opacity:0;
    transition:opacity 1s ease;
    background-position:center center;
    background-size:cover;
    background-repeat:no-repeat;
}
.vsl-hero-slide.active { opacity:1; }
.vsl-hero-rotator::after {
    content:"";
    position:absolute;
    inset:0;
    background:
      linear-gradient(90deg, rgba(247,244,237,.92) 0%, rgba(247,244,237,.72) 28%, rgba(247,244,237,.22) 55%, rgba(247,244,237,0) 78%),
      linear-gradient(180deg, rgba(0,0,0,.08), rgba(0,0,0,.18));
    pointer-events:none;
}
.vsl-hero-dots {
    position:absolute;
    z-index:6;
    right:34px;
    bottom:34px;
    display:flex;
    gap:7px;
}
.vsl-hero-dot {
    width:7px;
    height:7px;
    border:0;
    border-radius:50%;
    background:rgba(255,255,255,.42);
    padding:0;
    cursor:pointer;
    transition:width .2s ease, background .2s ease;
}
.vsl-hero-dot.active {
    width:25px;
    border-radius:99px;
    background:#dceca0;
}
.vsl-hero h1 {
    max-width: 760px;
}
.vsl-hero-football {
    position:absolute;
    z-index:5;
    right:5%;
    bottom:8%;
    width:clamp(180px, 24vw, 340px);
    height:auto;
    aspect-ratio:1;
    border-radius:50%;
    object-fit:cover;
    pointer-events:none;
    filter:drop-shadow(0 28px 40px rgba(0,0,0,.35));
    transform:rotate(-8deg);
    animation:vslBallFloat 5.5s ease-in-out infinite;
}
@keyframes vslBallFloat {
    0%,100% { transform:translateY(0) rotate(-8deg); }
    50% { transform:translateY(-18px) rotate(4deg); }
}
@media (max-width:820px) {
    .vsl-hero-football { right:3%; bottom:14%; width:min(160px, 38vw); }
    .vsl-hero-dots { right:16px; bottom:18px; }
}


/* Navbar sits above homepage layers (works with existing partial) */
nav, header, .navbar, #navbar, [class*="nav"] {
    /* only raise fixed/sticky bars */
}
.vsl-home { position: relative; z-index: 1; }
.vsl-hero { position: relative; z-index: 2; }
/* Common fixed-nav patterns from the shared navbar partial */
body > nav,
body > header,
.fixed, .sticky {
    z-index: 200 !important;
}

</style>

<%
    const vslMatches = (typeof matches !== 'undefined' && matches) ? matches : [];
    const vslStories = (typeof stories !== 'undefined' && stories) ? stories.slice().reverse() : [];
    const vslNext = vslMatches.find(m => m.status === 'upcoming');
    const vslRecent = vslMatches
        .filter(m => m.status === 'completed' || m.status === 'complete' || (m.details && (m.details.goalsA != null || m.details.goalsB != null)))
        .slice(-5)
        .reverse();
    const vslImg1 = vslStories[0] && vslStories[0].image ? vslStories[0].image : '/images/vimgfx.png';
    const vslImg2 = vslStories[1] && vslStories[1].image ? vslStories[1].image : '/images/vimgfx.png';
    const vslImg3 = vslStories[2] && vslStories[2].image ? vslStories[2].image : '/images/vimgfx.png';
    const vslImg4 = vslStories[3] && vslStories[3].image ? vslStories[3].image : '/images/vimgfx.png';
%>

<div class="vsl-home">

    <!-- =====================================================
         HERO — large image, soft editorial copy, floating UI
         ===================================================== -->
    <section class="vsl-hero">
        <!-- Hero image carousel (placeholders — drop files in /public/images/) -->
        <div class="vsl-hero-rotator" aria-hidden="true">
            <div class="vsl-hero-slide active" style="background-image:url('/images/vsl-hero-01.jpg'), url('/images/vimgfx.png');"></div>
            <div class="vsl-hero-slide" style="background-image:url('/images/vsl-hero-02.jpg'), url('/images/vimgfx.png');"></div>
            <div class="vsl-hero-slide" style="background-image:url('/images/vsl-hero-03.jpg'), url('/images/vimgfx.png');"></div>
            <div class="vsl-hero-slide" style="background-image:url('/images/vsl-hero-04.jpg'), url('/images/vimgfx.png');"></div>
        </div>

        <div class="vsl-hero-dots" role="tablist" aria-label="Hero slides">
            <button type="button" class="vsl-hero-dot active" data-slide="0" aria-label="Slide 1"></button>
            <button type="button" class="vsl-hero-dot" data-slide="1" aria-label="Slide 2"></button>
            <button type="button" class="vsl-hero-dot" data-slide="2" aria-label="Slide 3"></button>
            <button type="button" class="vsl-hero-dot" data-slide="3" aria-label="Slide 4"></button>
        </div>

        <!-- Large floating football (vector) -->
        <svg class="vsl-hero-football" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
                <radialGradient id="vslBallG" cx="35%" cy="30%" r="70%">
                    <stop offset="0%" stop-color="#ffffff"/>
                    <stop offset="70%" stop-color="#e8e8e8"/>
                    <stop offset="100%" stop-color="#c4c4c4"/>
                </radialGradient>
            </defs>
            <circle cx="100" cy="100" r="92" fill="url(#vslBallG)" stroke="#1a1a1a" stroke-width="3"/>
            <polygon points="100,55 118,68 111,90 89,90 82,68" fill="#1a1a1a"/>
            <path d="M100 55 L82 68 L60 55 L70 35 L100 40 Z" fill="#1a1a1a" opacity=".9"/>
            <path d="M118 68 L140 55 L130 35 L100 40 L111 55 Z" fill="#1a1a1a" opacity=".9"/>
            <path d="M89 90 L70 110 L55 100 L60 78 L82 68 Z" fill="#1a1a1a" opacity=".85"/>
            <path d="M111 90 L130 110 L145 100 L140 78 L118 68 Z" fill="#1a1a1a" opacity=".85"/>
            <path d="M70 110 L100 125 L130 110 L111 90 L89 90 Z" fill="#1a1a1a" opacity=".8"/>
            <path d="M55 100 L40 130 L70 155 L85 130 L70 110 Z" fill="none" stroke="#1a1a1a" stroke-width="3"/>
            <path d="M145 100 L160 130 L130 155 L115 130 L130 110 Z" fill="none" stroke="#1a1a1a" stroke-width="3"/>
            <path d="M70 155 L100 170 L130 155 L100 125 Z" fill="none" stroke="#1a1a1a" stroke-width="3"/>
        </svg>

        <div class="vsl-shell">
            <div class="vsl-hero-copy">
                <div class="vsl-brand-line">
                    VIM SUPER LEAGUE · SEASON LIVE
                </div>

                <h1 class="vsl-display">
                    Where every<br>
                    <span>match matters.</span>
                </h1>

                <p class="vsl-hero-lead">
                    A manager-driven Roblox football league where matchdays,
                    player markets and team building actually matter.
                </p>

                <div class="vsl-actions">
                    <a href="/market" class="vsl-btn vsl-btn-coral">Explore the market</a>
                    <a href="/matches" class="vsl-btn vsl-btn-teal">View fixtures</a>
                </div>
            </div>
        </div>

        <% if (vslNext) { %>
            <div class="vsl-hero-card" id="tour-featured-match">
