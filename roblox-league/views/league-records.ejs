<%- include('partials/navbar') %>

<style>
    /* Clean Light Glass Canvas */
    .bg-vim-canvas {
        background-color: #f8fafc;
        background-image: 
            radial-gradient(at 0% 0%, rgba(241, 245, 249, 0.9) 0px, transparent 50%),
            radial-gradient(at 100% 100%, rgba(226, 232, 240, 0.6) 0px, transparent 50%);
        background-attachment: fixed;
    }

    /* Glass Cards */
    .vim-glass-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(226, 232, 240, 0.8);
        box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.02);
    }

    /* Navigation Pills */
    .nav-pill {
        color: #64748b;
        transition: all 0.2s ease;
    }
    .nav-pill:hover {
        color: #0f172a;
        background: rgba(255, 255, 255, 0.9);
    }
    .nav-pill.active {
        background: #0f172a;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
    }

    /* Record Row Hover Effect */
    .record-row {
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .record-row:hover {
        background: rgba(255, 255, 255, 0.95);
        transform: translateX(4px);
        border-color: rgba(203, 213, 225, 1);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.04);
    }
</style>

<div class="min-h-screen bg-vim-canvas text-slate-900 font-sans pb-24">
    <main class="py-12 px-4 sm:px-6 max-w-6xl mx-auto space-y-10">

        <!-- HEADER SECTION -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-slate-200/80 pb-8">
            <div class="space-y-2">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-200/60 border border-slate-300/50">
                    <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                    <span class="text-[10px] font-extrabold uppercase tracking-widest text-slate-700">VIM Eternal Archives</span>
                </div>
                <h1 class="text-4xl md:text-5xl font-black uppercase tracking-tight text-slate-900">
                    HALL OF <span class="text-slate-400 font-light">RECORDS</span>
                </h1>
            </div>

            <!-- CATEGORY TABS -->
            <div class="flex items-center gap-1 p-1.5 rounded-2xl bg-white/70 border border-slate-200 backdrop-blur-md overflow-x-auto">
                <button onclick="filterRecords('all')" id="tab-all" class="nav-pill active px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider whitespace-nowrap">All</button>
                <button onclick="filterRecords('champions')" id="tab-champions" class="nav-pill px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider whitespace-nowrap">Champions</button>
                <button onclick="filterRecords('milestones')" id="tab-milestones" class="nav-pill px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider whitespace-nowrap">Milestones</button>
                <button onclick="filterRecords('awards')" id="tab-awards" class="nav-pill px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider whitespace-nowrap">Awards</button>
            </div>
        </div>

        <!-- RECORDS FEED / LIST VIEW -->
        <div class="space-y-4" id="recordsContainer">
            <% if (records && records.length > 0) { %>
                <% records.forEach((record, idx) => { %>
                    <% 
                        let category = record.category || 'milestones';
                    %>
                    <div class="record-item record-row vim-glass-card p-6 rounded-2xl flex flex-col md:flex-row items-start md:items-center justify-between gap-6 border border-slate-200/70" data-category="<%= category %>" data-record-id="<%= record.id || idx %>">
                        
                        <!-- Left: Icon & Core Details -->
                        <div class="flex items-center gap-5">
                            <div class="w-14 h-14 bg-white border border-slate-200/80 rounded-2xl flex items-center justify-center text-2xl shadow-sm shrink-0">
                                <%= record.icon || '🏆' %>
                            </div>
                            <div class="space-y-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 border border-slate-200">
                                        <%= record.date || 'SEASON 1' %>
                                    </span>
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                        #<%= (idx + 1).toString().padStart(2, '0') %>
                                    </span>
                                </div>
                                <h3 class="text-lg font-black text-slate-900 uppercase tracking-tight">
                                    <%= record.title %>
                                </h3>
                                <p class="text-slate-500 text-xs font-medium max-w-xl">
                                    <%= record.description %>
                                </p>
                            </div>
                        </div>

                        <!-- Right: Holder & Admin Hook / Action -->
                        <div class="flex items-center justify-between md:justify-end w-full md:w-auto gap-6 pt-4 md:pt-0 border-t md:border-t-0 border-slate-100">
                            <div class="text-left md:text-right">
                                <span class="text-[10px] font-black uppercase tracking-widest text-slate-400 block">Record Holder</span>
                                <span class="text-sm font-black text-slate-900 uppercase"><%= record.holder %></span>
                            </div>

                            <div class="flex items-center gap-2">
                                <% if(record.matchId) { %>
                                    <a href="/match/<%= record.matchId %>" class="w-10 h-10 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-700 hover:bg-slate-900 hover:text-white transition" title="View Match">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
                                    </a>
                                <% } %>

                                <!-- Placeholder Admin Edit Trigger (Hook this up to your admin panel modal/route) -->
                                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                                    <button onclick="openEditRecordModal('<%= record.id || idx %>')" class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-700 hover:bg-amber-500 hover:text-white transition" title="Edit Record">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                    </button>
                                <% } %>
                            </div>
                        </div>

                    </div>
                <% }) %>
            <% } else { %>
                <div class="py-24 text-center vim-glass-card rounded-3xl border border-slate-200">
                    <p class="text-4xl mb-3">📜</p>
                    <p class="text-xs font-black uppercase tracking-widest text-slate-400">No records etched into league history yet</p>
                </div>
            <% } %>
        </div>

    </main>
</div>

<script>
    function filterRecords(cat) {
        const buttons = document.querySelectorAll('.nav-pill');
        const items = document.querySelectorAll('.record-item');

        buttons.forEach(btn => btn.classList.remove('active'));
        document.getElementById(`tab-${cat}`).classList.add('active');

        items.forEach(item => {
            const itemCat = item.getAttribute('data-category');
            if (cat === 'all' || itemCat === cat) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
    }

    // Ready hook for your admin panel integration
    function openEditRecordModal(recordId) {
        // Plug your admin edit drawer/modal opening logic here!
        console.log("Editing record ID:", recordId);
    }
</script>