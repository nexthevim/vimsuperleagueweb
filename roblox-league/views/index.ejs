<%- include('partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --ink: #0b1220;
        --muted: #64748b;
        --line: rgba(15, 23, 42, 0.08);
        --surface: #ffffff;
        --canvas: #f6f7f9;
        --accent: #0088ff;
        --accent-2: #00b4ff;
    }

    body {
        margin: 0;
        background: var(--canvas);
        color: var(--ink);
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        overflow-x: hidden;
    }

    .vim-home {
        --radius: 1.25rem;
    }

    .vim-home h1, .vim-home h2, .vim-home h3 {
        font-family: 'Syne', sans-serif;
        letter-spacing: -0.03em;
    }

    /* ---------- HERO ---------- */
    .home-hero {
        position: relative;
        min-height: min(92vh, 920px);
        display: flex;
        align-items: flex-end;
        padding: 7.5rem 1.5rem 5rem;
        background:
            linear-gradient(180deg, rgba(8,12,20,0.35) 0%, rgba(8,12,20,0.55) 45%, rgba(8,12,20,0.82) 100%),
            url('/images/vimgfx.png') center center / cover no-repeat;
        color: #fff;
        overflow: hidden;
    }

    .home-hero::after {
        content: "";
        position: absolute;
        inset: auto 0 0 0;
        height: 120px;
        background: linear-gradient(to bottom, transparent, var(--canvas));
        pointer-events: none;
    }

    .home-hero-inner {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1120px;
        margin: 0 auto;
    }

    .home-kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.78);
        margin-bottom: 1.25rem;
    }

    .home-kicker span {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: var(--accent-2);
        box-shadow: 0 0 12px rgba(0,180,255,0.8);
    }

    .home-hero h1 {
        font-size: clamp(2.6rem, 7vw, 4.75rem);
        line-height: 0.95;
        font-weight: 800;
        max-width: 14ch;
        margin: 0 0 1.25rem;
        text-transform: uppercase;
    }

    .home-hero h1 em {
        font-style: normal;
        background: linear-gradient(135deg, #5ec8ff, #0088ff);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .home-hero-lead {
        max-width: 36rem;
        font-size: 1rem;
        line-height: 1.6;
        color: rgba(255,255,255,0.78);
        font-weight: 500;
        margin: 0 0 2rem;
    }

    .home-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 2.5rem;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.95rem 1.4rem;
        border-radius: 999px;
        background: linear-gradient(135deg, #0088ff, #00b4ff);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        box-shadow: 0 12px 28px rgba(0,136,255,0.28);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 32px rgba(0,136,255,0.38);
        color: #fff;
    }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.95rem 1.35rem;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.28);
        background: rgba(255,255,255,0.08);
        backdrop-filter: blur(8px);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        transition: background 0.2s ease, border-color 0.2s ease;
    }

    .btn-ghost:hover {
        background: rgba(255,255,255,0.14);
        border-color: rgba(255,255,255,0.45);
        color: #fff;
    }

    .home-search {
        max-width: 520px;
        background: rgba(255,255,255,0.96);
        border-radius: 1rem;
        padding: 0.45rem;
        display: flex;
        gap: 0.35rem;
        box-shadow: 0 20px 50px rgba(0,0,0,0.25);
        position: relative;
    }

    .home-search input {
        flex: 1;
        min-width: 0;
        border: 0;
        outline: none;
        background: transparent;
        padding: 0.85rem 1rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--ink);
    }

    .home-search button {
        border: 0;
        border-radius: 0.75rem;
        padding: 0.85rem 1.15rem;
        background: var(--ink);
        color: #fff;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
        white-space: nowrap;
    }

    #search-results-dropdown {
        position: absolute;
        left: 0;
        right: 0;
        top: calc(100% + 0.5rem);
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 1rem;
        box-shadow: 0 24px 60px rgba(15,23,42,0.18);
        padding: 0.85rem;
        max-height: 22rem;
        overflow-y: auto;
        z-index: 40;
        text-align: left;
        color: var(--ink);
    }

    /* ---------- LAYOUT ---------- */
    .home-wrap {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .home-section {
        padding: 4.5rem 0;
    }

    .section-label {
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 0.6rem;
    }

    .section-title {
        font-size: clamp(1.75rem, 3.5vw, 2.4rem);
        font-weight: 800;
        line-height: 1.1;
        margin: 0 0 0.75rem;
        color: var(--ink);
    }

    .section-copy {
        max-width: 36rem;
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.65;
        margin: 0;
    }

    .section-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 2rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--line);
    }

    .text-link {
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--accent);
        text-decoration: none;
    }

    .text-link:hover { color: #0066cc; }

    /* ---------- FEATURE GRID ---------- */
    .feature-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 1.25rem;
        margin-top: -3.5rem;
        position: relative;
        z-index: 5;
    }

    @media (max-width: 900px) {
        .feature-grid { grid-template-columns: 1fr; margin-top: -2rem; }
    }

    .panel {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: 0 18px 40px rgba(15,23,42,0.06);
        overflow: hidden;
    }

    .panel-pad { padding: 1.5rem 1.6rem; }

    .match-strip {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 1rem;
        align-items: center;
        padding: 1.35rem;
        background: #f8fafc;
        border-radius: 1rem;
        border: 1px solid var(--line);
    }

    .match-side {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.55rem;
        text-align: center;
    }

    .match-side img {
        width: 3.25rem;
        height: 3.25rem;
        object-fit: contain;
    }

    .match-side span {
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    .match-vs {
        text-align: center;
    }

    .match-vs strong {
        display: block;
        font-family: 'Syne', sans-serif;
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--accent);
    }

    .match-vs small {
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .stream-frame {
        min-height: 280px;
        background: #0b1220;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stream-frame iframe {
        width: 100%;
        min-height: 280px;
        border: 0;
        display: block;
    }

    .stream-offline {
        text-align: center;
        color: rgba(255,255,255,0.55);
        padding: 2rem;
    }

    .stream-offline strong {
        display: block;
        color: rgba(255,255,255,0.85);
        font-family: 'Syne', sans-serif;
        font-size: 1.05rem;
        margin-bottom: 0.35rem;
        text-transform: uppercase;
    }

    /* ---------- STEPS ---------- */
    .steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
    }

    @media (max-width: 800px) {
        .steps { grid-template-columns: 1fr; }
    }

    .step {
        padding: 1.5rem;
        border-radius: var(--radius);
        background: #fff;
        border: 1px solid var(--line);
    }

    .step-num {
        font-family: 'Syne', sans-serif;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: var(--accent);
        margin-bottom: 0.85rem;
    }

    .step h3 {
        font-size: 1.15rem;
        margin: 0 0 0.5rem;
        font-weight: 800;
    }

    .step p {
        margin: 0;
        font-size: 0.88rem;
        line-height: 1.6;
        color: var(--muted);
    }

    /* ---------- RESULTS ---------- */
    .results-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }

    @media (max-width: 900px) {
        .results-grid { grid-template-columns: 1fr; }
    }

    .result-card {
        display: block;
        text-decoration: none;
        color: inherit;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.15rem 1.25rem;
        transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    .result-card:hover {
        border-color: rgba(0,136,255,0.35);
        transform: translateY(-2px);
        box-shadow: 0 14px 30px rgba(15,23,42,0.08);
        color: inherit;
    }

    .result-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.55rem;
    }

    .result-row:last-child { margin-bottom: 0; }

    .result-team {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        min-width: 0;
    }

    .result-team img {
        width: 1.5rem;
        height: 1.5rem;
        object-fit: contain;
    }

    .result-team span {
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .result-score {
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: 1.05rem;
    }

    .result-score.muted { color: var(--muted); }

    /* ---------- STORIES ---------- */
    .stories-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.15rem;
    }

    @media (max-width: 900px) {
        .stories-grid { grid-template-columns: 1fr; }
    }

    .story-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .story-card img {
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        display: block;
    }

    .story-body {
        padding: 1.15rem 1.25rem 1.35rem;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        flex: 1;
    }

    .story-date {
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .story-body h4 {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 800;
        line-height: 1.25;
        font-family: 'Syne', sans-serif;
    }

    .story-body p {
        margin: 0;
        font-size: 0.85rem;
        line-height: 1.55;
        color: var(--muted);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* ---------- CTA ---------- */
    .home-cta {
        margin: 1rem 0 5rem;
        border-radius: 1.75rem;
        padding: 3.25rem 2rem;
        text-align: center;
        background:
            radial-gradient(circle at 20% 20%, rgba(0,136,255,0.12), transparent 45%),
            radial-gradient(circle at 80% 80%, rgba(0,180,255,0.1), transparent 40%),
            #0b1220;
        color: #fff;
    }

    .home-cta h3 {
        margin: 0 0 0.75rem;
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        font-weight: 800;
    }

    .home-cta p {
        margin: 0 auto 1.75rem;
        max-width: 28rem;
        color: rgba(255,255,255,0.65);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .empty-state {
        grid-column: 1 / -1;
        padding: 3rem 1.5rem;
        text-align: center;
        border: 1px dashed rgba(15,23,42,0.15);
        border-radius: var(--radius);
        color: var(--muted);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        background: rgba(255,255,255,0.6);
    }

    /* ---------- TOUR (kept functional) ---------- */
    #vim-tour-overlay {
        position: fixed; inset: 0; z-index: 50000;
        pointer-events: none; opacity: 0; visibility: hidden;
        transition: opacity 0.25s ease, visibility 0.25s ease;
    }
    #vim-tour-overlay.active { opacity: 1; visibility: visible; }
    #vim-tour-backdrop {
        position: absolute; inset: 0;
        background: rgba(2, 6, 23, 0.76); pointer-events: auto;
    }
    #vim-tour-spotlight {
        position: absolute; width: 100px; height: 100px; border-radius: 9999px;
        border: 2px solid rgba(0, 198, 255, 0.95);
        box-shadow: 0 0 0 4px rgba(0,136,255,0.1), 0 0 30px rgba(0,136,255,0.45);
        pointer-events: none; transform: translate(-50%, -50%);
        transition: left 0.45s cubic-bezier(0.16,1,0.3,1), top 0.45s cubic-bezier(0.16,1,0.3,1), width 0.35s ease, height 0.35s ease;
    }
    #vim-tour-card {
        position: fixed; width: min(360px, calc(100vw - 32px));
        background: rgba(255,255,255,0.97); color: #0f172a;
        border: 1px solid rgba(226,232,240,0.9); border-radius: 20px; padding: 22px;
        box-shadow: 0 30px 80px rgba(0,0,0,0.35); z-index: 50002; pointer-events: auto;
        transition: left 0.4s cubic-bezier(0.16,1,0.3,1), top 0.4s cubic-bezier(0.16,1,0.3,1);
    }
    #vim-tour-card::before {
        content: ""; position: absolute; width: 12px; height: 12px; background: white;
        border-left: 1px solid rgba(226,232,240,0.9); border-top: 1px solid rgba(226,232,240,0.9);
        transform: rotate(45deg); top: -7px; left: 34px;
    }
    #vim-tour-card.centered::before { display: none; }
    .vim-tour-eyebrow { font-size: 9px; font-weight: 900; letter-spacing: 0.2em; text-transform: uppercase; color: #0088ff; margin-bottom: 6px; }
    .vim-tour-title { font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 900; line-height: 1.15; margin-bottom: 8px; }
    .vim-tour-description { color: #64748b; font-size: 12px; line-height: 1.65; margin-bottom: 18px; }
    .vim-tour-progress { display: flex; align-items: center; gap: 5px; margin-bottom: 16px; }
    .vim-tour-progress span { height: 4px; width: 20px; border-radius: 999px; background: #e2e8f0; transition: all 0.25s ease; }
    .vim-tour-progress span.active { width: 32px; background: linear-gradient(90deg, #0088ff, #00c6ff); }
    .vim-tour-actions { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
    .vim-tour-skip { border: none; background: transparent; color: #94a3b8; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; padding: 8px 4px; }
    .vim-tour-next { border: none; background: linear-gradient(135deg, #0088ff, #00c6ff); color: white; font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.08em; padding: 11px 17px; border-radius: 11px; }
    #vim-tour-launcher {
        position: fixed; right: 20px; bottom: 20px; width: 42px; height: 42px; border-radius: 9999px;
        background: rgba(15,23,42,0.92); color: white; border: 1px solid rgba(255,255,255,0.12);
        box-shadow: 0 12px 30px rgba(15,23,42,0.25); z-index: 40000;
        display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 900;
    }
    @media (max-width: 640px) {
        #vim-tour-card { bottom: 20px !important; top: auto !important; left: 16px !important; width: calc(100vw - 32px); }
        #vim-tour-card::before { display: none; }
        .home-hero { min-height: 78vh; padding-bottom: 4rem; }
        .home-search { flex-direction: column; }
        .home-search button { width: 100%; }
    }
</style>

<div class="vim-home">

<!-- TOUR -->
<div id="vim-tour-overlay" aria-hidden="true">
    <div id="vim-tour-backdrop"></div>
    <div id="vim-tour-spotlight"></div>
    <div id="vim-tour-card">
        <div class="vim-tour-eyebrow" id="vim-tour-eyebrow">VIM SUPER LEAGUE</div>
        <div class="vim-tour-title" id="vim-tour-title">Welcome to VIMSL</div>
        <div class="vim-tour-description" id="vim-tour-description">Let's take a quick look around the league.</div>
        <div class="vim-tour-progress" id="vim-tour-progress"></div>
        <div class="vim-tour-actions">
            <button type="button" id="vim-tour-skip" class="vim-tour-skip">Skip Tour</button>
            <button type="button" id="vim-tour-next" class="vim-tour-next">Next →</button>
        </div>
    </div>
</div>
<button id="vim-tour-launcher" type="button" aria-label="Replay VIMSL tutorial" title="Replay VIMSL tutorial">?</button>

<!-- HERO -->
<header class="home-hero">
    <div class="home-hero-inner">
        <div class="home-kicker"><span></span> VIM Super League</div>
        <h1>Find the perfect <em>league</em> to compete</h1>
        <p class="home-hero-lead">
            Official fixtures, live player market, and high-stakes Roblox football — built for managers and players who take the competition seriously.
        </p>
        <div class="home-hero-actions">
            <a href="/market" class="btn-primary">Enter player market</a>
            <a href="/matches" class="btn-ghost">View fixtures</a>
        </div>

        <form id="search-form" action="/matches" method="GET" class="home-search">
            <input
                id="live-search-input"
                name="q"
                type="text"
                placeholder="Search teams, players, or matches…"
                autocomplete="off"
            >
            <button type="submit" id="search-btn">Search</button>
            <div id="search-results-dropdown" class="hidden"></div>
        </form>
    </div>
</header>

<main class="home-wrap">

    <!-- FEATURED + STREAM -->
    <section class="feature-grid" style="margin-bottom: 1rem;">
        <div id="tour-featured-match" class="panel">
            <div class="panel-pad">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1.25rem;">
                    <div>
                        <div class="section-label" style="margin-bottom:0.35rem;">Featured fixture</div>
                        <h2 class="section-title" style="font-size:1.45rem;margin:0;">Upcoming match</h2>
                    </div>
                    <span style="font-size:0.65rem;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;color:var(--accent);background:#eff6ff;border:1px solid #dbeafe;padding:0.35rem 0.65rem;border-radius:999px;">Live schedule</span>
                </div>

                <% const matchList = (typeof matches !== 'undefined' && matches) ? matches : []; %>
                <% let nextMatch = matchList.find(m => m.status === 'upcoming'); %>

                <% if (nextMatch) { %>
                    <div class="match-strip">
                        <div class="match-side">
                            <img src="<%= nextMatch.logoA %>" alt="">
                            <span><%= nextMatch.teamA %></span>
                        </div>
                        <div class="match-vs">
                            <strong>VS</strong>
                            <small><%= nextMatch.time || 'TBC' %></small>
                        </div>
                        <div class="match-side">
                            <img src="<%= nextMatch.logoB %>" alt="">
                            <span><%= nextMatch.teamB %></span>
                        </div>
                    </div>
                <% } else { %>
                    <div class="empty-state" style="border-style:dashed;">No upcoming matches scheduled</div>
                <% } %>

                <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1.15rem;padding-top:1rem;border-top:1px solid var(--line);">
                    <span style="font-size:0.75rem;font-weight:700;color:var(--muted);">League matches</span>
                    <a href="/matches" class="text-link">Full fixtures →</a>
                </div>
            </div>
        </div>

        <div class="panel">
            <div class="stream-frame">
                <% if (typeof liveLink !== 'undefined' && liveLink && liveLink.trim() !== "") { %>
                    <%
                        let embedLink = liveLink;
                        if (liveLink.includes('watch?v=')) {
                            embedLink = liveLink.replace('watch?v=', 'embed/').split('&')[0];
                        } else if (liveLink.includes('youtu.be/')) {
                            embedLink = liveLink.replace('youtu.be/', 'youtube.com/embed/').split('?')[0];
                        }
                    %>
                    <iframe src="<%= embedLink %>" allowfullscreen title="Live broadcast"></iframe>
                <% } else { %>
                    <div class="stream-offline">
                        <strong>Stream offline</strong>
                        <span style="font-size:0.8rem;">No live broadcast is active right now</span>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="home-section">
        <div class="section-head">
            <div>
                <div class="section-label">How it works</div>
                <h2 class="section-title">From free agent to matchday</h2>
                <p class="section-copy">Three clear steps. No clutter — just the path into the league.</p>
            </div>
        </div>
        <div class="steps">
            <div class="step">
                <div class="step-num">01</div>
                <h3>Join the community</h3>
                <p>Connect on Discord, meet managers and scouts, and get oriented before you register.</p>
            </div>
            <div class="step">
                <div class="step-num">02</div>
                <h3>Build your card</h3>
                <p>Register in the Market Hub with your role, profile, and the details teams actually look for.</p>
            </div>
            <div class="step">
                <div class="step-num">03</div>
                <h3>Compete</h3>
                <p>Get signed, track fixtures, and play for results that show up on the league tables.</p>
            </div>
        </div>
    </section>

    <!-- RESULTS -->
    <section class="home-section" id="tour-results" style="padding-top:0;">
        <div class="section-head">
            <div>
                <div class="section-label">Scoreboard</div>
                <h2 class="section-title">Recent results</h2>
            </div>
            <a href="/matches" class="text-link">All matches →</a>
        </div>

        <div class="results-grid">
            <%
                const recent = matchList
                    .filter(m => m.status === 'completed' || m.status === 'complete' || (m.details && (m.details.goalsA != null || m.details.goalsB != null)))
                    .slice(-6)
                    .reverse();
            %>
            <% if (recent.length) { %>
                <% recent.forEach(r => { %>
                    <a class="result-card" href="/match/<%= r._id || r.id || '' %>">
                        <div class="result-row">
                            <div class="result-team">
                                <img src="<%= r.logoA %>" alt="">
                                <span><%= r.teamA %></span>
                            </div>
                            <span class="result-score"><%= (r.details && r.details.goalsA != null) ? r.details.goalsA : 0 %></span>
                        </div>
                        <div class="result-row">
                            <div class="result-team">
                                <img src="<%= r.logoB %>" alt="">
                                <span style="color:var(--muted);"><%= r.teamB %></span>
                            </div>
                            <span class="result-score muted"><%= (r.details && r.details.goalsB != null) ? r.details.goalsB : 0 %></span>
                        </div>
                    </a>
                <% }) %>
            <% } else { %>
                <div class="empty-state">No recent results yet</div>
            <% } %>
        </div>
    </section>

    <!-- STORIES -->
    <section class="home-section" style="padding-top:0;">
        <div class="section-head">
            <div>
                <div class="section-label">Journal</div>
                <h2 class="section-title">League stories</h2>
            </div>
        </div>
        <div class="stories-grid">
            <% if (typeof stories !== 'undefined' && stories && stories.length > 0) { %>
                <% stories.slice().reverse().slice(0, 6).forEach(story => { %>
                    <article class="story-card">
                        <% if (story.image) { %>
                            <img src="<%= story.image %>" alt="">
                        <% } else { %>
                            <div style="aspect-ratio:16/10;background:#e2e8f0;"></div>
                        <% } %>
                        <div class="story-body">
                            <div class="story-date"><%= story.date || 'Article' %></div>
                            <h4><%= story.title %></h4>
                            <p><%= story.description %></p>
                        </div>
                    </article>
                <% }) %>
            <% } else { %>
                <div class="empty-state">No stories published yet</div>
            <% } %>
        </div>
    </section>

    <!-- CTA -->
    <section class="home-cta">
        <h3>Ready for the next matchday?</h3>
        <p>Set up your player card, browse the market, and get in front of managers building their squads.</p>
        <a href="/market" class="btn-primary">Open the market</a>
    </section>

</main>
</div>

<script>
(function () {
    const overlay = document.getElementById('vim-tour-overlay');
    const backdrop = document.getElementById('vim-tour-backdrop');
    const spotlight = document.getElementById('vim-tour-spotlight');
    const card = document.getElementById('vim-tour-card');
    const eyebrow = document.getElementById('vim-tour-eyebrow');
    const title = document.getElementById('vim-tour-title');
    const description = document.getElementById('vim-tour-description');
    const progress = document.getElementById('vim-tour-progress');
    const nextButton = document.getElementById('vim-tour-next');
    const skipButton = document.getElementById('vim-tour-skip');
    const launcher = document.getElementById('vim-tour-launcher');
    if (!overlay || !spotlight || !card) return;

    const tourSteps = [
        { selector: '[data-tour="market"]', mobileSelector: '[data-tour="market-mobile"]', eyebrow: 'PLAYER MARKET', title: 'Build your player profile', description: 'Browse registered players, inspect cards, stats, positions and information.' },
        { selector: '[data-tour="matches"]', mobileSelector: '[data-tour="matches-mobile"]', eyebrow: 'MATCH CENTER', title: 'Follow the fixtures', description: 'Upcoming fixtures, completed games and individual match details.' },
        { selector: '[data-tour="metrics"]', mobileSelector: '[data-tour="metrics-mobile"]', eyebrow: 'LEAGUE METRICS', title: 'Track the numbers', description: 'Goals, assists, saves, MVPs and other league records.' },
        { selector: '[data-tour="records"]', mobileSelector: '[data-tour="records-mobile"]', eyebrow: 'LEAGUE RECORDS', title: 'Explore the history', description: 'Notable achievements, historical records and milestones.' },
        { selector: '#live-search-input', eyebrow: 'SEARCH', title: 'Find anything quickly', description: 'Search teams, players or matches from the homepage.' },
        { selector: '#tour-featured-match', eyebrow: 'FEATURED FIXTURE', title: 'See what is coming up', description: 'The next scheduled match is highlighted here.' },
        { selector: '#tour-results', eyebrow: 'SCOREBOARD', title: 'Keep up with results', description: 'Recent completed matches with final scores.' }
    ];

    let currentStep = 0;
    function isMobileLayout() { return window.innerWidth < 1280; }
    function getTarget(step) {
        let target = null;
        if (isMobileLayout() && step.mobileSelector) target = document.querySelector(step.mobileSelector);
        if (!target && step.selector) target = document.querySelector(step.selector);
        return target;
    }
    function createProgress() {
        progress.innerHTML = '';
        tourSteps.forEach(function (_, index) {
            const dot = document.createElement('span');
            if (index === currentStep) dot.classList.add('active');
            progress.appendChild(dot);
        });
    }
    function positionTourCard(target) {
        const margin = 16;
        const cardWidth = Math.min(360, window.innerWidth - 32);
        card.style.width = cardWidth + 'px';
        if (window.innerWidth <= 640) {
            card.classList.add('centered');
            card.style.left = '16px'; card.style.top = 'auto'; card.style.bottom = '20px';
            return;
        }
        card.classList.remove('centered');
        const rect = target.getBoundingClientRect();
        let left = rect.left;
        let top = rect.bottom + 22;
        if (left + cardWidth > window.innerWidth - margin) left = window.innerWidth - cardWidth - margin;
        if (left < margin) left = margin;
        if (top + 220 > window.innerHeight - margin) {
            top = rect.top - 220 - 22;
            if (top < margin) { top = margin; card.classList.add('centered'); }
        }
        card.style.left = left + 'px';
        card.style.top = top + 'px';
        card.style.bottom = 'auto';
    }
    function moveSpotlight(target) {
        const rect = target.getBoundingClientRect();
        let width = Math.max(rect.width, 55);
        let height = Math.max(rect.height, 45);
        const padding = window.innerWidth <= 640 ? 10 : 9;
        spotlight.style.left = (rect.left + rect.width / 2) + 'px';
        spotlight.style.top = (rect.top + rect.height / 2) + 'px';
        spotlight.style.width = (width + padding * 2) + 'px';
        spotlight.style.height = (height + padding * 2) + 'px';
    }
    function showStep(index) {
        currentStep = index;
        const step = tourSteps[currentStep];
        const target = getTarget(step);
        if (!target) {
            if (currentStep < tourSteps.length - 1) showStep(currentStep + 1);
            else finishTour();
            return;
        }
        if (isMobileLayout() && step.mobileSelector) {
            const mobileMenu = document.getElementById('mobile-menu');
            if (mobileMenu && !mobileMenu.classList.contains('active')) mobileMenu.classList.add('active');
        }
        target.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
        setTimeout(function () { moveSpotlight(target); positionTourCard(target); }, 120);
        eyebrow.textContent = step.eyebrow;
        title.textContent = step.title;
        description.textContent = step.description;
        createProgress();
        nextButton.textContent = currentStep === tourSteps.length - 1 ? 'Finish ✓' : 'Next →';
    }
    function startTour() {
        currentStep = 0;
        overlay.classList.add('active');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        showStep(0);
    }
    function finishTour() {
        overlay.classList.remove('active');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        localStorage.setItem('vim_home_tour_seen', 'true');
        const mobileMenu = document.getElementById('mobile-menu');
        if (mobileMenu) mobileMenu.classList.remove('active');
    }
    nextButton.addEventListener('click', function () {
        if (currentStep >= tourSteps.length - 1) { finishTour(); return; }
        showStep(currentStep + 1);
    });
    skipButton.addEventListener('click', finishTour);
    backdrop.addEventListener('click', finishTour);
    launcher.addEventListener('click', startTour);
    document.addEventListener('keydown', function (event) {
        if (!overlay.classList.contains('active')) return;
        if (event.key === 'Escape') finishTour();
        if (event.key === 'ArrowRight' && currentStep < tourSteps.length - 1) showStep(currentStep + 1);
        if (event.key === 'ArrowLeft' && currentStep > 0) showStep(currentStep - 1);
    });
    window.addEventListener('resize', function () {
        if (!overlay.classList.contains('active')) return;
        const target = getTarget(tourSteps[currentStep]);
        if (target) { moveSpotlight(target); positionTourCard(target); }
    });
    if (!localStorage.getItem('vim_home_tour_seen')) {
        setTimeout(startTour, 900);
    }
})();
</script>

<script>
    const localMatches = <%- JSON.stringify(typeof matches !== 'undefined' ? matches : []) %>;
    const localPlayers = <%- typeof players !== 'undefined' ? JSON.stringify(players) : '[]' %>;
    const searchInput = document.getElementById('live-search-input');
    const dropdown = document.getElementById('search-results-dropdown');
    const searchForm = document.getElementById('search-form');
    let debounceTimer;
    let topTargetUrl = '';

    searchInput.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        const query = e.target.value.trim().toLowerCase();
        if (query.length < 1) {
            dropdown.classList.add('hidden');
            dropdown.innerHTML = '';
            topTargetUrl = '';
            return;
        }
        debounceTimer = setTimeout(() => {
            fetch(`/api/search?q=${encodeURIComponent(query)}`)
                .then(res => res.ok ? res.json() : Promise.reject('No server API'))
                .then(data => renderSearchResults(data, query))
                .catch(() => {
                    const matchedMatches = localMatches.filter(m =>
                        (m.teamA && m.teamA.toLowerCase().includes(query)) ||
                        (m.teamB && m.teamB.toLowerCase().includes(query))
                    );
                    const matchedPlayers = localPlayers.filter(p =>
                        (p.name && p.name.toLowerCase().includes(query)) ||
                        (p.role && p.role.toLowerCase().includes(query))
                    );
                    renderSearchResults({ matches: matchedMatches, players: matchedPlayers }, query);
                });
        }, 150);
    });

    function renderSearchResults(data, query) {
        const { players, matches } = data;
        let html = '';
        topTargetUrl = '';
        const hasMatches = matches && matches.length > 0;
        const hasPlayers = players && players.length > 0;
        if (!hasMatches && !hasPlayers) {
            dropdown.innerHTML = `<div style="text-align:center;padding:1rem;font-size:0.75rem;font-weight:700;color:#94a3b8;text-transform:uppercase;">No results for "${query}"</div>`;
            dropdown.classList.remove('hidden');
            return;
        }
        if (hasMatches) {
            if (!topTargetUrl) topTargetUrl = `/match/${matches[0].id || matches[0]._id || ''}`;
            html += `<div style="margin-bottom:0.75rem;"><div style="font-size:0.65rem;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;color:#0088ff;margin-bottom:0.4rem;padding:0 0.35rem;">Matches</div>`;
            matches.forEach(m => {
                const matchUrl = (m.id || m._id) ? `/match/${m.id || m._id}` : `/matches?q=${encodeURIComponent(query)}`;
                html += `<a href="${matchUrl}" style="display:flex;justify-content:space-between;align-items:center;padding:0.55rem 0.45rem;border-radius:0.65rem;text-decoration:none;color:#0f172a;font-size:0.8rem;font-weight:700;">
                    <span>${m.teamA} <span style="color:#0088ff;">vs</span> ${m.teamB}</span>
                    <span style="font-size:0.65rem;color:#94a3b8;text-transform:uppercase;">${m.status || m.time || 'Fixture'}</span>
                </a>`;
            });
            html += `</div>`;
        }
        if (hasPlayers) {
            if (!topTargetUrl) topTargetUrl = players[0].id || players[0]._id ? `/player/${players[0].id || players[0]._id}` : `/market`;
            html += `<div><div style="font-size:0.65rem;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;color:#0088ff;margin-bottom:0.4rem;padding:0 0.35rem;">Players</div>`;
            players.forEach(p => {
                const playerUrl = (p.id || p._id) ? `/player/${p.id || p._id}` : `/market?search=${encodeURIComponent(p.name)}`;
                html += `<a href="${playerUrl}" style="display:flex;justify-content:space-between;align-items:center;padding:0.55rem 0.45rem;border-radius:0.65rem;text-decoration:none;color:#0f172a;font-size:0.8rem;font-weight:700;">
                    <span>${p.name}</span>
                    <span style="font-size:0.65rem;color:#0284c7;text-transform:uppercase;">${p.role || p.position || 'Player'}</span>
                </a>`;
            });
            html += `</div>`;
        }
        dropdown.innerHTML = html;
        dropdown.classList.remove('hidden');
    }

    searchForm.addEventListener('submit', (e) => {
        if (topTargetUrl) { e.preventDefault(); window.location.href = topTargetUrl; }
    });
    document.addEventListener('click', (e) => {
        if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) dropdown.classList.add('hidden');
    });
</script>
