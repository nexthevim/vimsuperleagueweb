<%- include('partials/navbar') %>

<style>
    /* MULTI-DIRECTIONAL CONVEYOR ANIMATIONS */
    @keyframes scrollLeft { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
    @keyframes scrollRight { 0% { transform: translateX(-50%); } 100% { transform: translateX(0); } }

    .animate-conveyor-1 { display: flex; animation: scrollLeft 32s linear infinite; width: max-content; }
    .animate-conveyor-2 { display: flex; animation: scrollRight 38s linear infinite; width: max-content; }

    .animate-conveyor-1:hover, 
    .animate-conveyor-2:hover { 
        animation-play-state: paused; 
    }
    
    /* LIGHT GLASSMORPHY BASE */
    .glass-light {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(226, 232, 240, 0.9);
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.05);
    }

    /* 3D TILT & HOLOGRAM GLOW/SHEEN EFFECT */
    .player-card { 
        transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.3s ease, border-color 0.3s ease;
        cursor: pointer; 
        position: relative;
        overflow: hidden;
        transform-style: preserve-3d;
        perspective: 1000px;
        background: rgba(255, 255, 255, 0.95);
    }
    
    /* SHINY HOVER GLOW & HIGH LIGHT INSPECT EFFECT */
    .player-card:hover { 
        z-index: 20; 
        border-color: rgba(59, 130, 246, 0.9); 
        box-shadow: 0 0 35px rgba(59, 130, 246, 0.35), 0 20px 40px -10px rgba(15, 23, 42, 0.15);
    }

    /* SHINY SWEEPING LIGHT GLARE */
    .card-sheen {
        position: absolute;
        inset: 0;
        background: linear-gradient(115deg, transparent 20%, rgba(255, 255, 255, 0.7) 45%, rgba(255, 255, 255, 0.9) 50%, rgba(255, 255, 255, 0.7) 55%, transparent 80%);
        pointer-events: none;
        z-index: 12;
        opacity: 0;
        transform: translateX(-100%);
        transition: opacity 0.3s ease;
    }

    .player-card:hover .card-sheen {
        opacity: 1;
        transform: translateX(100%);
        transition: transform 0.8s ease-in-out, opacity 0.3s ease;
    }

    /* COLOR-CODED POSITION BADGES */
    .pos-fwd { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; }
    .pos-mid { background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: #fff; }
    .pos-def { background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; }
    .pos-gk  { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; }
    .pos-pro { background: linear-gradient(135deg, #64748b, #475569); color: #fff; }

    /* RANK BADGES */
    .rank-ss { background: linear-gradient(135deg, #ec4899, #a855f7, #f59e0b); background-size: 200% 200%; animation: rankShimmer 3s ease infinite; color: #fff; border: 1px solid rgba(255,255,255,0.6); }
    .rank-s { background: linear-gradient(135deg, #f59e0b, #ef4444); color: #fff; border: 1px solid #fef08a; }
    .rank-a { background: linear-gradient(135deg, #8b5cf6, #3b82f6); color: #fff; }
    .rank-b { background: linear-gradient(135deg, #10b981, #059669); color: #fff; }
    .rank-c { background: linear-gradient(135deg, #64748b, #475569); color: #fff; }

    @keyframes rankShimmer {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    /* GRAYSCALE TO FULL COLOR TRANSITION */
    .card-img {
        filter: grayscale(100%) contrast(1.05);
        transition: filter 0.5s cubic-bezier(0.4, 0, 0.2, 1), transform 0.5s ease;
    }
    .player-card:hover .card-img {
        filter: grayscale(0%) contrast(1);
        transform: scale(1.06);
    }

    /* SLEEK CLICK ANIMATION */
    .card-active-anim {
        animation: sleekClick 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        pointer-events: none;
    }

    @keyframes sleekClick {
        0% { transform: scale(1); box-shadow: 0 0 0 rgba(59, 130, 246, 0); }
        50% { transform: scale(1.05); box-shadow: 0 0 30px rgba(59, 130, 246, 0.5); }
        100% { transform: scale(1.02); opacity: 0.9; }
    }

    /* MODAL */
    .modal { 
        display: none; 
        position: fixed; 
        inset: 0; 
        background: rgba(15, 23, 42, 0); 
        z-index: 100; 
        align-items: center; 
        justify-content: center; 
        padding: 20px; 
        backdrop-filter: blur(0px);
        transition: all 0.4s ease;
    }
    
    .modal.active { background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(16px); }

    #modalContainer {
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
        transform: translateY(30px) scale(0.96);
        opacity: 0;
    }

    #modalContainer.show {
        transform: translateY(0) scale(1);
        opacity: 1;
    }

    .stat-badge {
        background: rgba(241, 245, 249, 0.8);
        border: 1px solid rgba(226, 232, 240, 1);
        backdrop-filter: blur(8px);
    }

    /* IMPROVED REGISTRATION & LOGIN FORM STYLING */
    .form-label {
        display: block;
        font-size: 0.65rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #64748b;
        margin-bottom: 0.35rem;
    }

    .form-input { 
        width: 100%; 
        background: #f8fafc; 
        border: 1px solid #cbd5e1; 
        padding: 0.75rem 1rem; 
        border-radius: 0.85rem; 
        outline: none; 
        transition: all 0.25s ease; 
        color: #0f172a; 
        font-weight: 700;
        font-size: 0.85rem;
    }
    .form-input:focus { 
        border-color: #3b82f6; 
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
    }
    select.form-input option { background: #ffffff; color: #0f172a; }

    .position-radio:checked + label {
        border-color: #3b82f6;
        background: #eff6ff;
        color: #1d4ed8;
        box-shadow: 0 0 0 2px #3b82f6;
    }

    .hidden-form { display: none !important; }

    /* CUSTOM SCROLLBAR */
    .custom-scroll::-webkit-scrollbar { width: 4px; }
    .custom-scroll::-webkit-scrollbar-track { background: rgba(241, 245, 249, 0.5); }
    .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

    /* TAB ACTIVE STATES */
    .team-tile {
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }
    .team-tile.active {
        border-color: transparent;
        box-shadow: 0 0 0 3px hsl(var(--team-hue) 75% 52%), 0 20px 35px -15px rgba(15, 23, 42, 0.2);
        transform: translateY(-3px);
    }
</style>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="fixed top-24 left-1/2 -translate-x-1/2 z-[100] bg-red-600 text-white px-8 py-4 rounded-full font-black uppercase italic shadow-[0_15px_30px_rgba(220,38,38,0.3)] border border-white/20 animate-bounce text-xs tracking-wider">
        ⚠️ <%= error %>
    </div>
<% } %>

<main class="py-16 bg-slate-50 min-h-screen text-slate-900 overflow-hidden">
    <!-- MARKET HEADER & CONTROLS -->
    <div class="max-w-7xl mx-auto px-6 mb-8 flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
        <div>
            <div class="flex items-center gap-3 mb-1">
                <span class="h-2.5 w-2.5 rounded-full bg-blue-600 animate-pulse"></span>
                <p class="text-[11px] text-slate-400 font-black uppercase tracking-[0.25em]">VIM Super League Official Market</p>
            </div>
            <h2 class="text-5xl font-black italic uppercase tracking-tighter text-slate-900">PLAYER MARKET</h2>
        </div>
        
        <!-- MODE SWITCH SLIDER & SEARCH BAR -->
        <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
            <!-- MODE SWITCH SLIDER -->
            <div class="bg-slate-200 p-1 rounded-2xl flex items-center border border-slate-300 shadow-inner">
                <button id="viewMarketBtn" onclick="switchMode('market')" class="px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-white text-slate-900 shadow-sm">
                    Market
                </button>
                <button id="viewAuctionBtn" onclick="switchMode('auction')" class="px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 text-slate-500 hover:text-slate-900">
                    Auction Hub
                </button>
            </div>

            <div class="relative flex-1 md:w-64" id="searchWrapper">
                <input type="text" id="searchInput" onkeyup="filterCards()" placeholder="Search name, Discord, country..." class="w-full bg-white border border-slate-200 px-4 py-2.5 pl-9 rounded-2xl text-xs font-bold text-slate-800 outline-none focus:border-blue-500 transition shadow-sm">
                <svg class="w-4 h-4 text-slate-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
            <div class="flex items-center bg-white border border-slate-200 p-1 rounded-2xl shadow-sm overflow-x-auto" id="filterWrapper">
                <button data-pos-filter="ALL" onclick="setFilter('ALL')" class="filter-btn active text-[10px] font-black px-3.5 py-1.5 rounded-xl transition bg-slate-900 text-white">ALL</button>
                <button data-pos-filter="FWD" onclick="setFilter('FWD')" class="filter-btn text-[10px] font-black px-3.5 py-1.5 rounded-xl text-slate-500 hover:text-slate-900 transition">FWD</button>
                <button data-pos-filter="MID" onclick="setFilter('MID')" class="filter-btn text-[10px] font-black px-3.5 py-1.5 rounded-xl text-slate-500 hover:text-slate-900 transition">MID</button>
                <button data-pos-filter="DEF" onclick="setFilter('DEF')" class="filter-btn text-[10px] font-black px-3.5 py-1.5 rounded-xl text-slate-500 hover:text-slate-900 transition">DEF</button>
                <button data-pos-filter="GK" onclick="setFilter('GK')" class="filter-btn text-[10px] font-black px-3.5 py-1.5 rounded-xl text-slate-500 hover:text-slate-900 transition">GK</button>
            </div>
            <div class="flex items-center bg-white border border-slate-200 p-1 rounded-2xl shadow-sm overflow-x-auto" id="classFilterWrapper">
                <button data-class-filter="ALL" onclick="setClassFilter('ALL')" class="filter-btn active text-[10px] font-black px-3.5 py-1.5 rounded-xl transition bg-slate-900 text-white">ALL CLASS</button>
                <button data-class-filter="SS" onclick="setClassFilter('SS')" class="filter-btn text-[10px] font-black px-3.5 py-1.5 rounded-xl text-slate-500 hover:text-slate-900 transition">SS</button>
                <button data-class-filter="S" onclick="setClassFilter('S')" class="filter-btn text-[10px] font-black px-3.5 py-1.5 rounded-xl text-slate-500 hover:text-slate-900 transition">S</button>
                <button data-class-filter="A" onclick="setClassFilter('A')" class="filter-btn text-[10px] font-black px-3.5 py-1.5 rounded-xl text-slate-500 hover:text-slate-900 transition">A</button>
                <button data-class-filter="B" onclick="setClassFilter('B')" class="filter-btn text-[10px] font-black px-3.5 py-1.5 rounded-xl text-slate-500 hover:text-slate-900 transition">B</button>
                <button data-class-filter="C" onclick="setClassFilter('C')" class="filter-btn text-[10px] font-black px-3.5 py-1.5 rounded-xl text-slate-500 hover:text-slate-900 transition">C</button>
            </div>
            <% if (typeof isManager !== 'undefined' && isManager) { %>
                <button
                    id="eligibleFilterBtn"
                    onclick="toggleEligibleFilter()"
                    title="Only show players you can currently legally bid on"
                    class="text-[10px] font-black px-3.5 py-1.5 rounded-xl transition text-emerald-600 hover:bg-emerald-50 bg-white border border-emerald-200 whitespace-nowrap">
                    ✅ I Can Bid
                </button>
            <% } %>
            <div class="bg-blue-50 border border-blue-200 px-4 py-2.5 rounded-2xl" id="countWrapper">
                <span class="text-[10px] text-blue-600 font-black uppercase tracking-wider">● Players: <%= players.length %></span>
            </div>
        </div>
    </div>

    <!-- AUCTION OVERRIDE NOTIFICATION BANNER (FOR MANAGERS) -->
    <% if (typeof isManager !== 'undefined' && isManager && typeof myOutbidPlayers !== 'undefined' && myOutbidPlayers && myOutbidPlayers.length > 0) { %>
        <div class="max-w-7xl mx-auto px-6 mb-6">
            <div class="bg-amber-500 text-white p-4 rounded-2xl shadow-lg border border-amber-400 flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <span class="text-xl">⚠️</span>
                    <div>
                        <p class="text-xs font-black uppercase tracking-wider">You've Been Outbid!</p>
                        <p class="text-[11px] text-amber-100 font-bold">
                            Other managers are now winning <%= myOutbidPlayers.length %> player(s) you bid on:
                            <% myOutbidPlayers.slice(0, 3).forEach((p, i) => { %><%= i > 0 ? ', ' : '' %><%= p.name %> (<%= p.highestBid %> Vollars)<% }) %><%= myOutbidPlayers.length > 3 ? ', …' : '' %>
                        </p>
                    </div>
                </div>
                <button onclick="switchMode('auction')" class="bg-white text-amber-600 px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-amber-50 transition shadow-sm">
                    Review Bids
                </button>
            </div>
        </div>
    <% } %>

    <!-- MODE 1: STANDARD MARKET VIEW -->
    <div id="marketSection">

        <!-- ============================================================
             MARKET SPOTLIGHT — floating widget, top 3 per category
             ============================================================ -->
        <% if (typeof marketSpotlight !== 'undefined' && marketSpotlight) { %>
            <div class="max-w-7xl mx-auto px-6 mb-10">
                <div class="bg-white rounded-[28px] border border-slate-200 shadow-xl shadow-slate-200/60 p-5 md:p-6 -mt-2 relative">

                    <div class="flex items-center gap-2 mb-4">
                        <span class="text-lg">🔥</span>
                        <h3 class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-400">Market Spotlight</h3>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

                        <!-- TOP 3 BIDS -->
                        <div class="rounded-2xl bg-gradient-to-br from-slate-900 to-slate-800 text-white p-4">
                            <p class="text-[9px] font-black uppercase tracking-[0.15em] text-amber-400 mb-2.5 flex items-center gap-1.5">👑 Top Bids</p>
                            <% if (marketSpotlight.topBids && marketSpotlight.topBids.length > 0) { %>
                                <div class="space-y-2">
                                    <% marketSpotlight.topBids.forEach((p, i) => { %>
                                        <div class="flex items-center justify-between gap-2">
                                            <div class="flex items-center gap-2 min-w-0">
                                                <span class="text-[9px] font-black text-slate-500 w-3 flex-shrink-0"><%= i + 1 %></span>
                                                <span class="text-[11px] font-black uppercase truncate"><%= p.name %></span>
                                            </div>
                                            <span class="text-[11px] font-black text-emerald-400 flex-shrink-0"><%= Number(p.highestBid).toLocaleString() %></span>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <p class="text-[10px] text-slate-400 italic font-bold">No bids placed yet.</p>
                            <% } %>
                        </div>

                        <!-- POSITION LEADERS -->
                        <div class="rounded-2xl bg-slate-50 border border-slate-100 p-4">
                            <p class="text-[9px] font-black uppercase tracking-[0.15em] text-slate-400 mb-2.5">Position Leaders</p>
                            <div class="space-y-2">
                                <% ['FWD','MID','DEF','GK'].forEach(posKey => {
                                    const entry = marketSpotlight.byPosition && marketSpotlight.byPosition[posKey];
                                    let posDotClass = posKey === 'FWD' ? 'bg-rose-500' : posKey === 'MID' ? 'bg-amber-500' : posKey === 'DEF' ? 'bg-blue-500' : 'bg-violet-500';
                                %>
                                    <div class="flex items-center justify-between gap-2">
                                        <div class="flex items-center gap-1.5 min-w-0">
                                            <span class="w-1.5 h-1.5 rounded-full <%= posDotClass %> flex-shrink-0"></span>
                                            <span class="text-[8px] font-black text-slate-400 uppercase w-7 flex-shrink-0"><%= posKey %></span>
                                            <span class="text-[11px] font-black text-slate-900 uppercase truncate"><%= entry ? entry.name : '—' %></span>
                                        </div>
                                        <span class="text-[11px] font-black text-slate-600 flex-shrink-0"><%= entry ? Number(entry.highestBid).toLocaleString() : '—' %></span>
                                    </div>
                                <% }) %>
                            </div>
                        </div>

                        <!-- RISING BIDS -->
                        <div class="rounded-2xl bg-rose-50 border border-rose-100 p-4">
                            <p class="text-[9px] font-black uppercase tracking-[0.15em] text-rose-500 mb-2.5 flex items-center gap-1.5">📈 Rising Bids</p>
                            <% if (marketSpotlight.rising && marketSpotlight.rising.length > 0) { %>
                                <div class="space-y-2">
                                    <% marketSpotlight.rising.forEach(r => { %>
                                        <div class="flex items-center justify-between gap-2">
                                            <span class="text-[11px] font-black text-slate-900 uppercase truncate"><%= r.player.name %></span>
                                            <span class="bg-rose-600 text-white text-[8px] font-black px-1.5 py-0.5 rounded-md uppercase flex-shrink-0"><%= r.bidCount %>×/2h</span>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <p class="text-[10px] text-rose-400 italic font-bold">No bidding flurries recently.</p>
                            <% } %>
                        </div>

                    </div>
                </div>
            </div>
        <% } %>

        <!-- MULTI-TIER DUAL CONVEYOR CARDS DISPLAY -->
        <% if(players.length > 0) { %>
            <% 
                let fullList = players.length < 6 ? [...players, ...players, ...players, ...players] : [...players, ...players]; 
                let tier1 = fullList.slice(0, Math.ceil(fullList.length / 2));
                let tier2 = fullList.slice(Math.ceil(fullList.length / 2));
                let tiers = [
                    { list: tier1, anim: 'animate-conveyor-1', label: 'Top Tier Prospects' },
                    { list: tier2, anim: 'animate-conveyor-2', label: 'Midfield, Defensive Anchors & Free Agents' }
                ];
            %>

            <div class="space-y-6 mb-24">
                <% tiers.forEach((t, idx) => { %>
                    <div class="relative flex items-center border-y border-slate-200/80 bg-white/40 py-6">
                        <div class="<%= t.anim %> gap-6 px-4" id="cardContainer<%= idx %>">
                            <% t.list.forEach(p => { %>
                                <% 
                                    let posClass = 'pos-pro';
                                    let pos = (p.position || 'PRO').toUpperCase();
                                    if(pos === 'FWD' || pos === 'FORWARD') posClass = 'pos-fwd';
                                    else if(pos === 'MID' || pos === 'MIDFIELD') posClass = 'pos-mid';
                                    else if(pos === 'DEF' || pos === 'DEFENSE') posClass = 'pos-def';
                                    else if(pos === 'GK' || pos === 'GOALKEEPER') posClass = 'pos-gk';

                                    let rankClass = 'rank-c';
                                    let rank = (p.rank || 'C').toUpperCase();
                                    if(rank === 'SS') rankClass = 'rank-ss';
                                    else if(rank === 'S') rankClass = 'rank-s';
                                    else if(rank === 'A') rankClass = 'rank-a';
                                    else if(rank === 'B') rankClass = 'rank-b';

                                    let pId = p._id || p.id || '';

                                    // VSL Season 4: manager accounts are never auctionable, and
                                    // every other player gets a manager-specific status badge.
                                    let isMgrAccount = (typeof managerPlayerNames !== 'undefined' && managerPlayerNames.includes((p.name || '').toLowerCase()));

                                    let myBadge = null;
                                    if (!isMgrAccount && typeof isManager !== 'undefined' && isManager && typeof myAuctionState !== 'undefined' && myAuctionState) {
                                        const amWinning = Number(p.highestBid || 0) > 0 && (p.highestBidder || '').toLowerCase() === myAuctionState.team.name.toLowerCase();
                                        const amOutbid = myAuctionState.outbidPlayerIds.includes(String(pId));
                                        if (amWinning) myBadge = 'winning';
                                        else if (amOutbid) myBadge = 'outbid';
                                        else if (typeof myEligibility !== 'undefined' && myEligibility && myEligibility[String(pId)] === false) myBadge = 'ineligible';
                                    }

                                    let isWatched = (typeof user !== 'undefined' && user && Array.isArray(user.watchlist) && user.watchlist.map(String).includes(String(pId)));
                                    let eligibleAttr = (typeof myEligibility !== 'undefined' && myEligibility) ? (myEligibility[String(pId)] === true) : true;
                                %>
                                <div class="player-card card-item w-[260px] h-[350px] glass-light rounded-[28px] border border-slate-200 shadow-md flex-shrink-0 relative group"
                                     data-name="<%= p.name.toLowerCase() %>"
                                     data-search="<%= ((p.name || '') + ' ' + (p.discord || '') + ' ' + (p.country || '')).toLowerCase() %>"
                                     data-pos="<%= pos %>"
                                     data-class="<%= rank %>"
                                     data-eligible="<%= eligibleAttr %>"
                                     onmousemove="tiltCard(event, this)" 
                                     onmouseleave="resetTilt(this)"
                                     onclick="openBio(this, '<%= p.name %>', '<%= p.cardImage %>', `<%= p.experience || p.bio %>`, '<%= p.discord %>', '<%= p.goals || 0 %>', '<%= p.assists || 0 %>', '<%= p.saves || 0 %>', '<%= p.mvps || 0 %>', '<%= p.views ? p.views.length : 0 %>', '<%= p.position %>', '<%= p.country %>', '<%= p.timezone %>', '<%= p.highestBid || 0 %>', '<%= p.highestBidder || 'None' %>', '<%= pId %>', '<%= p.reservePrice || 0 %>', <%- isMgrAccount %>, <%- isWatched %>)">
                                    
                                    <!-- Shiny Dynamic Sweeping Glare -->
                                    <div class="card-sheen"></div>

                                    <% if (p.cardImage && p.cardImage.trim() !== "") { %>
                                        <img src="<%= p.cardImage %>" class="card-img w-full h-full object-cover">
                                    <% } else { %>
                                        <div class="card-img w-full h-full bg-gradient-to-b from-slate-100 to-slate-200 flex items-center justify-center relative">
                                            <span class="absolute top-10 text-[64px] font-black italic text-slate-300/40 select-none uppercase tracking-tighter"><%= p.position || 'PRO' %></span>
                                            <svg class="w-24 h-24 text-slate-300" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                                        </div>
                                    <% } %>

                                    <!-- MANAGER BADGE (not auctionable) -->
                                    <% if (isMgrAccount) { %>
                                        <div class="absolute top-4 right-4 z-30">
                                            <span class="bg-slate-900 text-white text-[9px] font-black px-2.5 py-1 rounded-xl uppercase shadow-lg tracking-wider border border-white/20">👔 MANAGER</span>
                                        </div>
                                    <% } else { %>
                                        <!-- WATCHLIST STAR (managers only) -->
                                        <% if (typeof isManager !== 'undefined' && isManager) { %>
                                            <button type="button"
                                                onclick="event.stopPropagation(); toggleWatchlistStar(this, '<%= pId %>')"
                                                data-watching="<%= isWatched %>"
                                                class="watchlist-star-btn absolute top-4 right-4 z-30 w-8 h-8 rounded-full flex items-center justify-center text-base transition-all shadow-lg border border-white/30 <%= isWatched ? 'bg-amber-400 text-white' : 'bg-black/30 text-white/80 hover:bg-black/50' %>">
                                                <%= isWatched ? '★' : '☆' %>
                                            </button>
                                        <% } %>

                                        <!-- MY STATUS BADGE (winning / outbid / ineligible) -->
                                        <% if (myBadge === 'winning') { %>
                                            <div class="absolute top-4 left-4 z-30">
                                                <span class="bg-emerald-500 text-white text-[9px] font-black px-2.5 py-1 rounded-xl uppercase shadow-lg tracking-wider">🟢 Winning</span>
                                            </div>
                                        <% } else if (myBadge === 'outbid') { %>
                                            <div class="absolute top-4 left-4 z-30">
                                                <span class="bg-rose-500 text-white text-[9px] font-black px-2.5 py-1 rounded-xl uppercase shadow-lg tracking-wider">🔴 Outbid</span>
                                            </div>
                                        <% } else if (myBadge === 'ineligible') { %>
                                            <div class="absolute top-4 left-4 z-30">
                                                <span class="bg-slate-600 text-white text-[9px] font-black px-2.5 py-1 rounded-xl uppercase shadow-lg tracking-wider">⚠️ Ineligible</span>
                                            </div>
                                        <% } %>
                                    <% } %>

                                    <!-- RANK BADGE AT BOTTOM RIGHT ON HOVER / ALWAYS VISIBLE -->
                                    <div class="absolute bottom-4 right-4 z-20 transition-all duration-300 transform group-hover:scale-110">
                                        <span class="<%= rankClass %> text-[10px] font-black px-2.5 py-1 rounded-xl uppercase shadow-lg tracking-wider border border-white/20"><%= rank %> RANK</span>
                                    </div>

                                    <!-- Card Overlays -->
                                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent p-5 flex flex-col justify-end z-10">
                                        <div class="flex justify-between items-center mb-1">
                                            <span class="<%= posClass %> text-[9px] font-black px-2.5 py-1 rounded-lg italic uppercase shadow-sm tracking-wide"><%= p.position || 'PRO' %></span>
                                            <div class="flex items-center gap-1 bg-white/20 backdrop-filter blur-md px-2 py-0.5 rounded-md border border-white/20">
                                                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                                <span class="text-[9px] text-white font-black"><%= p.views ? p.views.length : 0 %></span>
                                            </div>
                                        </div>
                                        
                                        <h3 class="font-black text-2xl italic uppercase tracking-tighter text-white drop-shadow-md"><%= p.name %></h3>
                                        
                                        <!-- Highest Bid Info in Market -->
                                        <div class="mt-1 flex items-center justify-between text-[9px] font-black text-emerald-400">
                                            <span>TOP BID: <%= p.highestBid ? p.highestBid + ' Vollars' : 'No Bids' %></span>
                                            <% if (p.highestBidder) { %>
                                                <span class="text-slate-300 text-[8px] uppercase truncate max-w-[90px]">(<%= p.highestBidder %>)</span>
                                            <% } %>
                                        </div>

                                        <!-- Stat Strip Preview -->
                                        <div class="grid grid-cols-4 gap-1 mt-2 pt-2 border-t border-white/15 text-center">
                                            <div><p class="text-[7px] font-black text-white/50 uppercase">G</p><p class="text-xs font-black text-white"><%= p.goals || 0 %></p></div>
                                            <div><p class="text-[7px] font-black text-white/50 uppercase">A</p><p class="text-xs font-black text-white"><%= p.assists || 0 %></p></div>
                                            <div><p class="text-[7px] font-black text-white/50 uppercase">S</p><p class="text-xs font-black text-white"><%= p.saves || 0 %></p></div>
                                            <div><p class="text-[7px] font-black text-blue-400 uppercase">MVP</p><p class="text-xs font-black text-blue-400"><%= p.mvps || 0 %></p></div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

    <!-- MODE 2: AUCTION HUB VIEW -->
    <div id="auctionSection" class="hidden max-w-7xl mx-auto px-6 mb-24">
        <%
            // Deterministic accent color per franchise (IPL-style team color chips)
            function hueFromName(str) {
                let h = 0;
                str = str || 'Team';
                for (let i = 0; i < str.length; i++) {
                    h = str.charCodeAt(i) + ((h << 5) - h);
                }
                return Math.abs(h) % 360;
            }

            // Looks up the full player record behind a bid (by id) or a
            // roster slot (by name) so clicking it can open the same
            // profile modal used on the main market cards.
            function findPlayerRecord(idOrName) {
                if (!idOrName || typeof players === 'undefined') return null;
                return players.find(p => {
                    let pid = (p._id || p.id || '').toString();
                    return pid === idOrName.toString() ||
                        (p.name && p.name.toLowerCase() === idOrName.toString().toLowerCase());
                }) || null;
            }

            let sessionStatus = (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.status) || 'ready';
            let statusLabel = 'Auction Ready';
            let statusColor = 'slate';
            if (sessionStatus === 'live') { statusLabel = 'Live Now'; statusColor = 'emerald'; }
            else if (sessionStatus === 'ended') { statusLabel = 'Auction Ended'; statusColor = 'rose'; }
            let squadCap = (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.maxRosterSize) || 7;
            let sessionName = (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.name) || 'VIM Auction';
        %>

        <!-- SESSION STATUS BANNER (LIGHT / IPL-STYLE) -->
        <div class="relative overflow-hidden bg-white border border-slate-200 p-6 rounded-[32px] shadow-md mb-8 flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="absolute inset-x-0 top-0 h-1.5 bg-slate-900"></div>
            <div class="flex items-center gap-4">
                <div class="h-12 w-12 rounded-2xl bg-slate-900 shadow-sm flex items-center justify-center text-white text-2xl font-black">
                    🏆
                </div>
                <div>
                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest"><%= sessionName %></span>
                    <h3 class="text-2xl font-black italic uppercase tracking-tight text-slate-900">Franchise Auction Hub</h3>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="bg-slate-50 border border-slate-100 px-5 py-3 rounded-2xl text-center">
                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block">Status</span>
                    <span class="text-base font-black italic text-<%= statusColor %>-600 uppercase tracking-wider flex items-center justify-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-<%= statusColor %>-500 <%= sessionStatus === 'live' ? 'animate-pulse' : '' %>"></span>
                        <%= statusLabel %>
                    </span>
                </div>
                <div class="bg-slate-50 border border-slate-100 px-5 py-3 rounded-2xl text-center">
                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block">Squad Cap</span>
                    <span class="text-base font-black italic text-slate-900 uppercase tracking-wider"><%= squadCap %> Players</span>
                </div>
            </div>
        </div>

        <% if (typeof auctionTeams !== 'undefined' && auctionTeams && auctionTeams.length > 0) { %>

            <!-- FRANCHISE TILE GRID (IPL-STYLE ENLARGED LOGOS) -->
            <h3 class="text-xs font-black uppercase tracking-[0.25em] text-slate-400 mb-4">Registered Franchises &middot; Tap a team</h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5 mb-10">
                <% auctionTeams.forEach((t, i) => {
                    let tId = t._id || t.id || '';
                    let reserved = (t.bids || []).reduce((sum, b) => sum + (Number(b.amount) || 0), 0);
                    let remaining = (t.budget || 0) - (t.spent || 0) - reserved;
                    let committedPct = (t.budget && t.budget > 0) ? Math.min(100, Math.round(((t.spent || 0) + reserved) / t.budget * 100)) : 0;
                    let hue = hueFromName(t.name);
                %>
                    <div onclick="selectAuctionTeam('<%= tId %>')"
                         id="teamTile-<%= tId %>"
                         class="team-tile cursor-pointer bg-white border-2 rounded-[28px] p-5 text-center relative overflow-hidden <%= i === 0 ? 'active' : 'border-slate-200' %>"
                         style="--team-hue: <%= hue %>;">

                        <div class="absolute inset-x-0 top-0 h-1.5" style="background: hsl(<%= hue %> 75% 52%);"></div>

                        <div class="w-24 h-24 mx-auto rounded-3xl bg-slate-50 border border-slate-100 p-2 flex items-center justify-center shadow-sm mb-3 mt-1">
                            <% if (t.logo) { %>
                                <img src="<%= t.logo %>" class="w-full h-full object-contain">
                            <% } else { %>
                                <span class="text-3xl font-black" style="color: hsl(<%= hue %> 65% 45%);"><%= (t.name || '?').charAt(0) %></span>
                            <% } %>
                        </div>

                        <h4 class="font-black italic uppercase text-sm text-slate-900 truncate"><%= t.name %></h4>
                        <p class="text-[9px] text-slate-400 font-bold uppercase truncate mb-3">Mgr: <%= t.manager || 'Unassigned' %></p>

                        <div class="grid grid-cols-2 gap-1.5 text-left mb-2">
                            <div class="bg-slate-50 rounded-lg px-2 py-1.5 border border-slate-100">
                                <span class="block text-[7px] text-slate-400 font-black uppercase tracking-wider">Budget</span>
                                <span class="text-[11px] font-black text-slate-900"><%= t.budget || 0 %> V</span>
                            </div>
                            <div class="bg-emerald-50 rounded-lg px-2 py-1.5 border border-emerald-100">
                                <span class="block text-[7px] text-emerald-500 font-black uppercase tracking-wider">Remaining</span>
                                <span class="text-[11px] font-black text-emerald-600"><%= remaining %> V</span>
                            </div>
                        </div>

                        <div class="h-1.5 rounded-full bg-slate-100 overflow-hidden">
                            <div class="h-full rounded-full" style="width: <%= committedPct %>%; background: hsl(<%= hue %> 75% 52%);"></div>
                        </div>
                        <p class="text-[8px] text-slate-400 font-black uppercase tracking-widest mt-1"><%= committedPct %>% Committed</p>
                    </div>
                <% }) %>
            </div>

            <!-- SELECTED FRANCHISE DETAIL PANEL -->
            <% auctionTeams.forEach((t, i) => {
                let tId = t._id || t.id || '';
                let reserved = (t.bids || []).reduce((sum, b) => sum + (Number(b.amount) || 0), 0);
                let remaining = (t.budget || 0) - (t.spent || 0) - reserved;
                let hue = hueFromName(t.name);
            %>
                <div id="teamDetails-<%= tId %>" class="team-details-panel <%= i === 0 ? '' : 'hidden' %> bg-white border border-slate-200 rounded-[36px] p-8 shadow-xl">

                    <!-- TEAM HEADER WITH ENLARGED LOGO & VOLLARS STATS -->
                    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 border-b border-slate-100 pb-8 mb-8">
                        <div class="w-28 h-28 rounded-3xl bg-slate-50 border border-slate-200 shadow-md flex-shrink-0 p-2 flex items-center justify-center"
                             style="box-shadow: 0 0 0 3px hsla(<%= hue %>, 75%, 52%, 0.25);">
                            <% if (t.logo) { %>
                                <img src="<%= t.logo %>" class="w-full h-full object-contain">
                            <% } else { %>
                                <span class="text-5xl font-black" style="color: hsl(<%= hue %> 65% 45%);"><%= (t.name || '?').charAt(0) %></span>
                            <% } %>
                        </div>
                        <div class="flex-1 text-center sm:text-left">
                            <span class="text-[10px] font-black uppercase tracking-widest" style="color: hsl(<%= hue %> 60% 42%);">Official VIM Franchise</span>
                            <h2 class="text-4xl font-black italic uppercase text-slate-900 tracking-tight"><%= t.name %></h2>
                            <p class="text-xs text-slate-400 font-bold uppercase mt-1">Manager: <span class="text-slate-800"><%= t.manager || 'Unassigned' %></span></p>

                            <!-- BUDGET SUMMARY TILES (VOLLARS) -->
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4">
                                <div class="bg-slate-50 p-3 rounded-2xl border border-slate-100 text-center">
                                    <span class="text-[8px] font-black text-slate-400 uppercase tracking-widest block">Budget</span>
                                    <span class="text-base font-black text-slate-900"><%= t.budget || 0 %> V</span>
                                </div>
                                <div class="bg-slate-100 p-3 rounded-2xl border border-slate-200 text-center">
                                    <span class="text-[8px] font-black text-slate-500 uppercase tracking-widest block">Locked (Signed)</span>
                                    <span class="text-base font-black text-slate-900"><%= t.spent || 0 %> V</span>
                                </div>
                                <div class="bg-amber-50/60 p-3 rounded-2xl border border-amber-100 text-center">
                                    <span class="text-[8px] font-black text-amber-600 uppercase tracking-widest block">In Active Bids</span>
                                    <span class="text-base font-black text-amber-600"><%= reserved %> V</span>
                                </div>
                                <div class="bg-emerald-50/60 p-3 rounded-2xl border border-emerald-100 text-center">
                                    <span class="text-[8px] font-black text-emerald-600 uppercase tracking-widest block">Remaining</span>
                                    <span class="text-base font-black text-emerald-600"><%= remaining %> V</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- BIDDING VS ROSTER TABS -->
                    <div class="flex items-center justify-between mb-6 border-b border-slate-100 pb-4">
                        <div class="flex items-center gap-3">
                            <button onclick="switchTeamSubTab('<%= tId %>', 'bidding')" id="tabBtn-bidding-<%= tId %>" class="px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-slate-900 text-white transition">
                                Bids In Progress
                            </button>
                            <button onclick="switchTeamSubTab('<%= tId %>', 'roster')" id="tabBtn-roster-<%= tId %>" class="px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider text-slate-400 hover:text-slate-900 transition">
                                Official Roster
                            </button>
                        </div>
                    </div>

                    <!-- SUB-TAB 1: BIDDING SIDE -->
                    <div id="subTab-bidding-<%= tId %>" class="space-y-4">
                        <% if (t.bids && t.bids.length > 0) { %>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <% t.bids.forEach(b => {
                                    let full = findPlayerRecord(b.playerId);
                                %>
                                    <div class="p-4 rounded-2xl border border-slate-200 bg-slate-50 flex items-center justify-between gap-3 <%= full ? 'hover:border-amber-300 hover:bg-amber-50/40 transition-colors cursor-pointer' : '' %>"
                                         <% if (full) { %>
                                         onclick="openBio(this, '<%= full.name %>', '<%= full.cardImage %>', `<%= full.experience || full.bio %>`, '<%= full.discord %>', '<%= full.goals || 0 %>', '<%= full.assists || 0 %>', '<%= full.saves || 0 %>', '<%= full.mvps || 0 %>', '<%= full.views ? full.views.length : 0 %>', '<%= full.position %>', '<%= full.country %>', '<%= full.timezone %>', '<%= full.highestBid || 0 %>', '<%= full.highestBidder || "None" %>', '<%= full._id || full.id %>', '<%= full.reservePrice || 0 %>', <%- (typeof managerPlayerNames !== 'undefined' && managerPlayerNames.includes((full.name||'').toLowerCase())) %>, <%- !!(typeof user !== 'undefined' && user && Array.isArray(user.watchlist) && user.watchlist.map(String).includes(String(full._id||full.id))) %>)"
                                         <% } %>>
                                        <div class="min-w-0">
                                            <h5 class="font-black italic uppercase text-slate-900 text-sm truncate"><%= b.playerName %></h5>
                                            <p class="text-[10px] text-amber-600 font-black uppercase">Current Bid: <%= b.amount %> Vollars</p>
                                            <% if (full) { %><p class="text-[8px] text-slate-400 font-bold uppercase tracking-widest mt-0.5">Tap to view profile →</p><% } %>
                                        </div>
                                        <% if (typeof currentManagerTeam !== 'undefined' && currentManagerTeam === tId) { %>
                                            <form action="/auction/withdraw" method="POST" onsubmit="return confirm('Withdraw bid for <%= b.playerName %>?')" onclick="event.stopPropagation()" class="flex-shrink-0">
                                                <input type="hidden" name="playerId" value="<%= b.playerId %>">
                                                <input type="hidden" name="teamId" value="<%= tId %>">
                                                <button type="submit" class="bg-red-50 text-red-600 border border-red-200 hover:bg-red-600 hover:text-white px-3 py-1.5 rounded-xl text-[9px] font-black uppercase tracking-wider transition">
                                                    Withdraw
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="text-center py-12 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                                <p class="text-xs font-black uppercase text-slate-400 tracking-wider">No active player bids placed by this team yet.</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- SUB-TAB 2: ROSTER SIDE (EMPTY UNTIL AUCTION ENDS) -->
                    <div id="subTab-roster-<%= tId %>" class="hidden space-y-4">
                        <% if (t.roster && t.roster.length > 0) { %>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <% t.roster.forEach(r => {
                                    let full = findPlayerRecord(r.name);
                                %>
                                    <div class="p-4 rounded-2xl border border-slate-200 bg-emerald-50/30 flex items-center justify-between gap-3 <%= full ? 'hover:border-emerald-300 hover:bg-emerald-50 transition-colors cursor-pointer' : '' %>"
                                         <% if (full) { %>
                                         onclick="openBio(this, '<%= full.name %>', '<%= full.cardImage %>', `<%= full.experience || full.bio %>`, '<%= full.discord %>', '<%= full.goals || 0 %>', '<%= full.assists || 0 %>', '<%= full.saves || 0 %>', '<%= full.mvps || 0 %>', '<%= full.views ? full.views.length : 0 %>', '<%= full.position %>', '<%= full.country %>', '<%= full.timezone %>', '<%= full.highestBid || 0 %>', '<%= full.highestBidder || "None" %>', '<%= full._id || full.id %>', '<%= full.reservePrice || 0 %>', <%- (typeof managerPlayerNames !== 'undefined' && managerPlayerNames.includes((full.name||'').toLowerCase())) %>, <%- !!(typeof user !== 'undefined' && user && Array.isArray(user.watchlist) && user.watchlist.map(String).includes(String(full._id||full.id))) %>)"
                                         <% } %>>
                                        <div class="min-w-0">
                                            <h5 class="font-black italic uppercase text-slate-900 text-sm truncate"><%= r.name %></h5>
                                            <p class="text-[10px] text-slate-400 font-bold uppercase"><%= r.position %> | Acquired for <%= r.boughtFor || 0 %> Vollars</p>
                                        </div>
                                        <span class="text-[10px] font-black text-emerald-600 bg-emerald-100 px-2.5 py-1 rounded-lg uppercase flex-shrink-0">Signed</span>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="text-center py-12 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                                <p class="text-xs font-black uppercase text-slate-400 tracking-wider">Roster is empty. Player allocations will appear here once the auction ends.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% }) %>

        <% } else { %>
            <div class="bg-white p-12 rounded-[36px] border border-slate-200 text-center">
                <p class="text-sm font-black text-slate-400 uppercase tracking-widest">No auction teams configured by Admin yet.</p>
            </div>
        <% } %>

        <!-- ============================================================
             AUDIT LOG
             ============================================================ -->
        <% if (typeof auctionActivityFeed !== 'undefined' && auctionActivityFeed && auctionActivityFeed.length > 0) { %>
            <div class="mt-10">
                <div class="flex items-center gap-3 mb-4">
                    <span class="text-xl">📜</span>
                    <h3 class="text-xs font-black uppercase tracking-[0.25em] text-slate-400">Auction Audit Log</h3>
                </div>

                <div class="bg-white rounded-[28px] border border-slate-200 shadow-sm max-h-96 overflow-y-auto custom-scroll">
                    <% auctionActivityFeed.forEach((ev, idx) => {
                        let icon = '•';
                        let label = ev.type;
                        let colorClass = 'text-slate-500';

                        if (ev.type === 'bid') { icon = '💰'; label = 'Bid placed'; colorClass = 'text-blue-600'; }
                        else if (ev.type === 'withdraw') { icon = '↩️'; label = 'Bid withdrawn'; colorClass = 'text-amber-600'; }
                        else if (ev.type === 'won') { icon = '🏆'; label = 'Player won'; colorClass = 'text-emerald-600'; }
                        else if (ev.type === 'auction_start') { icon = '🚀'; label = 'Auction started'; colorClass = 'text-slate-900'; }
                        else if (ev.type === 'auction_end') { icon = '🔒'; label = 'Auction ended'; colorClass = 'text-slate-900'; }
                        else if (ev.type === 'rank_change') { icon = '🎖️'; label = 'Class updated'; colorClass = 'text-violet-600'; }
                    %>
                        <div class="flex items-center justify-between gap-3 px-5 py-3 <%= idx !== auctionActivityFeed.length - 1 ? 'border-b border-slate-100' : '' %>">
                            <div class="flex items-center gap-3 min-w-0">
                                <span class="text-base flex-shrink-0"><%= icon %></span>
                                <div class="min-w-0">
                                    <p class="text-[11px] font-black uppercase <%= colorClass %>">
                                        <%= label %>
                                        <% if (ev.playerName) { %><span class="text-slate-900">— <%= ev.playerName %></span><% } %>
                                    </p>
                                    <p class="text-[9px] text-slate-400 font-bold uppercase tracking-wider truncate">
                                        <% if (ev.teamName) { %><%= ev.teamName %><% } %>
                                        <% if (ev.meta && ev.meta.rank) { %>→ <%= ev.meta.rank %> Class<% } %>
                                        <% if (ev.meta && ev.meta.playersAssigned !== undefined) { %><%= ev.meta.playersAssigned %> players assigned<% } %>
                                    </p>
                                </div>
                            </div>
                            <div class="text-right flex-shrink-0">
                                <% if (ev.amount) { %>
                                    <p class="text-xs font-black text-slate-900"><%= Number(ev.amount).toLocaleString() %> V</p>
                                <% } %>
                                <p class="text-[8px] text-slate-400 font-bold uppercase"><%= new Date(ev.createdAt).toLocaleString() %></p>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </div>

    <!-- LIGHT THEME FIFA MODAL WITH BIDDING CAPABILITY FOR MANAGERS -->
    <div id="bioModal" class="modal" onclick="closeBio()">
        <div class="max-w-4xl w-full flex flex-col md:flex-row gap-8 items-center relative" id="modalContainer" onclick="event.stopPropagation()">
            <!-- Player Card Spotlight -->
            <div class="relative group w-[300px] h-[420px] flex-shrink-0">
                <div class="absolute -inset-2 bg-slate-300/40 blur-2xl rounded-full opacity-70"></div>
                <div class="relative w-full h-full bg-white rounded-[36px] overflow-hidden border border-slate-200 shadow-2xl">
                    <img id="modalImg" src="" class="w-full h-full object-cover">
                    <div id="modalImgPlaceholder" class="w-full h-full bg-gradient-to-b from-slate-100 to-slate-200 flex items-center justify-center">
