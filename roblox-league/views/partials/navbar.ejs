<script>
    // Configure Tailwind dark mode dynamically
    if (window.tailwind) {
        tailwind.config = { darkMode: 'class' };
    }

    // Apply global dark/light theme instantly across all pages
    (function() {
        const savedTheme = localStorage.getItem('vim_theme') || "<%= typeof user !== 'undefined' && user && user.theme ? user.theme : 'system' %>";
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        
        const isDark = savedTheme === 'dark' || (savedTheme === 'system' && systemPrefersDark);
        if (isDark) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    })();
</script>

<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">

<style>
    /* GLOBAL PAGE BACKGROUND FIX FOR ALL PAGES */
    html {
        background-color: #f8fafc;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    html.dark {
        background-color: #090d16 !important;
        color-scheme: dark;
    }

    body { 
        font-family: 'Inter', sans-serif; 
        margin: 0; 
        background-color: transparent !important;
    }

    html.dark body {
        color: #f8fafc;
    }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    html.dark ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    html.dark ::-webkit-scrollbar-thumb { background: #334155; }
    
    nav { z-index: 9999 !important; }

    /* =========================================================
       VIM CUSTOM CURSOR
       ========================================================= */

    @media (pointer: fine) {

        html,
        body,
        a,
        button,
        input,
        textarea,
        select,
        [role="button"] {
            cursor: none !important;
        }

        #vim-cursor-dot {
            position: fixed;
            top: 0;
            left: 0;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #ffffff;
            border: 2px solid #0088ff;
            box-shadow:
                0 0 8px rgba(0, 136, 255, 0.65),
                0 0 18px rgba(0, 198, 255, 0.35);
            pointer-events: none;
            z-index: 9999999;
            transform: translate(-50%, -50%);
            transition:
                width 0.18s ease,
                height 0.18s ease,
                border-color 0.18s ease,
                background-color 0.18s ease,
                box-shadow 0.18s ease;
        }

        #vim-cursor-ring {
            position: fixed;
            top: 0;
            left: 0;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1px solid rgba(0, 136, 255, 0.55);
            background: rgba(0, 136, 255, 0.035);
            pointer-events: none;
            z-index: 9999998;
            transform: translate(-50%, -50%);
            transition:
                width 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                height 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.22s ease,
                background-color 0.22s ease,
                box-shadow 0.22s ease;
        }

        html.dark #vim-cursor-dot {
            background: #0f172a;
            border-color: #00c6ff;
            box-shadow:
                0 0 8px rgba(0, 198, 255, 0.8),
                0 0 20px rgba(0, 136, 255, 0.45);
        }

        html.dark #vim-cursor-ring {
            border-color: rgba(0, 198, 255, 0.6);
            background: rgba(0, 198, 255, 0.035);
        }

        #vim-cursor-ring.hover {
            width: 48px;
            height: 48px;
            border-color: rgba(0, 198, 255, 0.8);
            background: rgba(0, 198, 255, 0.06);
            box-shadow:
                0 0 20px rgba(0, 136, 255, 0.18),
                inset 0 0 15px rgba(0, 198, 255, 0.04);
        }

        #vim-cursor-dot.hover {
            width: 5px;
            height: 5px;
            background: #00c6ff;
            border-color: #ffffff;
            box-shadow:
                0 0 10px rgba(0, 198, 255, 0.9),
                0 0 22px rgba(0, 136, 255, 0.55);
        }

        #vim-cursor-ring.click {
            width: 58px;
            height: 58px;
            border-color: rgba(0, 198, 255, 0);
            background: rgba(0, 198, 255, 0.08);
            box-shadow:
                0 0 0 1px rgba(0, 198, 255, 0.15),
                0 0 30px rgba(0, 136, 255, 0.25);
        }

        #vim-cursor-dot.hidden {
            opacity: 0;
        }

        #vim-cursor-ring.hidden {
            opacity: 0;
        }

        .vim-cursor-ripple {
            position: fixed;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            border: 1px solid rgba(0, 198, 255, 0.75);
            pointer-events: none;
            z-index: 9999997;
            transform: translate(-50%, -50%) scale(1);
            animation: vimCursorRipple 0.55s ease-out forwards;
        }

        @keyframes vimCursorRipple {
            0% {
                opacity: 0.9;
                width: 10px;
                height: 10px;
            }

            100% {
                opacity: 0;
                width: 58px;
                height: 58px;
            }
        }
    }

    /* Frosted Glass Header */
    .vim-nav-glass {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(226, 232, 240, 0.8);
    }

    html.dark .vim-nav-glass {
        background: rgba(15, 23, 42, 0.85);
        border-bottom: 1px solid rgba(30, 41, 59, 0.8);
    }

    /* Navigation Link Pills */
    .nav-link {
        color: #64748b;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .nav-link:hover {
        color: #0f172a;
        background-color: rgba(241, 245, 249, 0.8);
    }

    html.dark .nav-link {
        color: #94a3b8;
    }

    html.dark .nav-link:hover {
        color: #f8fafc;
        background-color: rgba(30, 41, 59, 0.8);
    }

    .nav-link.active {
        color: #0f172a;
        background-color: #f1f5f9;
        font-weight: 800;
        box-shadow: inset 0 0 0 1px rgba(203, 213, 225, 0.8);
    }

    html.dark .nav-link.active {
        color: #ffffff;
        background-color: #1e293b;
        box-shadow: inset 0 0 0 1px rgba(51, 65, 85, 0.8);
    }

    /* Discord Pill Button Glow */
    .glow-discord {
        box-shadow: 0 4px 14px rgba(88, 101, 242, 0.25);
        transition: all 0.2s ease;
    }

    .glow-discord:hover {
        box-shadow: 0 6px 20px rgba(88, 101, 242, 0.4);
        transform: translateY(-1px);
    }

    /* Mobile Menu Drawer Animation */
    #mobile-menu { 
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); 
        transform: translateY(-10px); 
        opacity: 0; 
        pointer-events: none; 
    }

    #mobile-menu.active { 
        transform: translateY(0); 
        opacity: 1; 
        pointer-events: all; 
    }

    /* =========================================================
       VIM MINI HELP / AI BUTTONS
       ========================================================= */

    .vim-floating-tools {
        position: fixed;
        right: 22px;
        bottom: 22px;
        z-index: 100000;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .vim-tool-button {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(203, 213, 225, 0.9);
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        color: #475569;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.12);
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
    }

    .vim-tool-button:hover {
        transform: translateY(-3px) scale(1.05);
        color: #0f172a;
        border-color: rgba(0, 136, 255, 0.4);
        box-shadow: 0 12px 30px rgba(0, 136, 255, 0.18);
    }

    html.dark .vim-tool-button {
        background: rgba(15, 23, 42, 0.88);
        border-color: rgba(51, 65, 85, 0.9);
        color: #cbd5e1;
    }

    html.dark .vim-tool-button:hover {
        color: #ffffff;
        border-color: rgba(0, 136, 255, 0.55);
        box-shadow: 0 12px 30px rgba(0, 136, 255, 0.18);
    }

    .vim-ai-button {
        background: linear-gradient(145deg, #0f172a, #1e293b);
        color: white;
        border-color: rgba(71, 85, 105, 0.8);
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.25);
    }

    .vim-ai-button:hover {
        color: white;
        border-color: rgba(0, 198, 255, 0.65);
        box-shadow: 0 12px 32px rgba(0, 136, 255, 0.3);
    }

    .vim-ai-button::after {
        content: "";
        position: absolute;
        inset: -3px;
        border-radius: 50%;
        border: 1px solid rgba(0, 198, 255, 0.2);
        animation: vimAiPulse 2.4s ease-in-out infinite;
        pointer-events: none;
    }

    @keyframes vimAiPulse {
        0%, 100% {
            transform: scale(1);
            opacity: 0.25;
        }

        50% {
            transform: scale(1.18);
            opacity: 0;
        }
    }

    .vim-tool-label {
        position: absolute;
        right: 56px;
        white-space: nowrap;
        background: #0f172a;
        color: white;
        padding: 6px 9px;
        border-radius: 8px;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        opacity: 0;
        transform: translateX(5px);
        pointer-events: none;
        transition: all 0.2s ease;
    }

    .vim-tool-button:hover .vim-tool-label {
        opacity: 1;
        transform: translateX(0);
    }

    /* =========================================================
       VIM AI CHAT PANEL
       ========================================================= */

    #vim-ai-panel {
        position: fixed;
        right: 22px;
        bottom: 82px;
        width: min(390px, calc(100vw - 32px));
        height: min(570px, calc(100vh - 110px));
        z-index: 100001;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(203, 213, 225, 0.9);
        box-shadow: 0 30px 80px rgba(15, 23, 42, 0.22);
        opacity: 0;
        transform: translateY(16px) scale(0.96);
        transform-origin: bottom right;
        pointer-events: none;
        transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    #vim-ai-panel.active {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: all;
    }

    html.dark #vim-ai-panel {
        background: rgba(9, 13, 22, 0.95);
        border-color: rgba(51, 65, 85, 0.85);
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
    }

    .vim-ai-header {
        padding: 17px 18px;
        border-bottom: 1px solid rgba(226, 232, 240, 0.8);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }

    html.dark .vim-ai-header {
        border-bottom-color: rgba(30, 41, 59, 0.9);
    }

    .vim-ai-brand {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .vim-ai-logo {
        width: 34px;
        height: 34px;
        border-radius: 11px;
        background: linear-gradient(145deg, #0f172a, #334155);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        box-shadow: 0 5px 15px rgba(15, 23, 42, 0.2);
    }

    .vim-ai-status {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 10px rgba(34, 197, 94, 0.7);
        display: inline-block;
        margin-right: 5px;
    }

    .vim-ai-close {
        width: 30px;
        height: 30px;
        border-radius: 9px;
        border: none;
        background: transparent;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .vim-ai-close:hover {
        background: #f1f5f9;
        color: #0f172a;
    }

    html.dark .vim-ai-close:hover {
        background: #1e293b;
        color: white;
    }

    /* AI messages */
    #vim-ai-messages {
        flex: 1;
        overflow-y: auto;
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 13px;
        scroll-behavior: smooth;
    }

    .vim-ai-message {
        max-width: 88%;
        padding: 11px 13px;
        border-radius: 14px;
        font-size: 12px;
        line-height: 1.55;
        animation: vimMessageIn 0.25s ease forwards;
    }

    @keyframes vimMessageIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .vim-ai-message.bot {
        align-self: flex-start;
        background: #f1f5f9;
        color: #334155;
        border-bottom-left-radius: 5px;
    }

    html.dark .vim-ai-message.bot {
        background: #172033;
        color: #cbd5e1;
    }

    .vim-ai-message.user {
        align-self: flex-end;
        background: linear-gradient(135deg, #0088ff, #00aeea);
        color: white;
        border-bottom-right-radius: 5px;
        box-shadow: 0 5px 15px rgba(0, 136, 255, 0.16);
    }

    .vim-ai-message strong {
        font-weight: 800;
    }

    .vim-ai-message a {
        color: #0088ff;
        font-weight: 800;
        text-decoration: none;
    }

    .vim-ai-message a:hover {
        text-decoration: underline;
    }

    .vim-ai-typing {
        align-self: flex-start;
        background: #f1f5f9;
        color: #94a3b8;
        padding: 11px 14px;
        border-radius: 14px;
        border-bottom-left-radius: 5px;
        display: flex;
        gap: 4px;
        animation: vimMessageIn 0.2s ease forwards;
    }

    html.dark .vim-ai-typing {
        background: #172033;
    }

    .vim-ai-typing span {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: currentColor;
        animation: vimTyping 1s infinite;
    }

    .vim-ai-typing span:nth-child(2) {
        animation-delay: 0.15s;
    }

    .vim-ai-typing span:nth-child(3) {
        animation-delay: 0.3s;
    }

    @keyframes vimTyping {
        0%, 60%, 100% {
            transform: translateY(0);
            opacity: 0.45;
        }

        30% {
            transform: translateY(-3px);
            opacity: 1;
        }
    }

    /* Suggested questions */
    .vim-ai-suggestions {
        padding: 0 18px 12px;
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        flex-shrink: 0;
    }

    .vim-ai-suggestion {
        border: 1px solid #e2e8f0;
        background: white;
        color: #475569;
        border-radius: 999px;
        padding: 7px 10px;
        font-size: 9px;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .vim-ai-suggestion:hover {
        border-color: #7dd3fc;
        color: #0284c7;
        background: #f0f9ff;
        transform: translateY(-1px);
    }

    html.dark .vim-ai-suggestion {
        background: #111827;
        border-color: #334155;
        color: #94a3b8;
    }

    html.dark .vim-ai-suggestion:hover {
        border-color: #0369a1;
        color: #7dd3fc;
        background: #0f172a;
    }

    /* Input */
    .vim-ai-input-wrap {
        padding: 12px 14px 14px;
        border-top: 1px solid rgba(226, 232, 240, 0.8);
        flex-shrink: 0;
    }

    html.dark .vim-ai-input-wrap {
        border-top-color: rgba(30, 41, 59, 0.9);
    }

    .vim-ai-input-box {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 5px 5px 5px 13px;
        transition: all 0.2s ease;
    }

    .vim-ai-input-box:focus-within {
        border-color: rgba(0, 136, 255, 0.5);
        box-shadow: 0 0 0 3px rgba(0, 136, 255, 0.08);
    }

    html.dark .vim-ai-input-box {
        background: #0f172a;
        border-color: #334155;
    }

    .vim-ai-input {
        flex: 1;
        min-width: 0;
        border: none;
        outline: none;
        background: transparent;
        color: #0f172a;
        font-size: 12px;
        font-weight: 600;
    }

    .vim-ai-input::placeholder {
        color: #94a3b8;
    }

    html.dark .vim-ai-input {
        color: #f8fafc;
    }

    .vim-ai-send {
        width: 34px;
        height: 34px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, #0088ff, #00b8ed);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .vim-ai-send:hover {
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(0, 136, 255, 0.25);
    }

    .vim-ai-disclaimer {
        text-align: center;
        color: #94a3b8;
        font-size: 8px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-top: 7px;
    }

    /* =========================================================
       MOBILE
       ========================================================= */

    @media (max-width: 640px) {

        .vim-floating-tools {
            right: 14px;
            bottom: 14px;
            gap: 8px;
        }

        .vim-tool-button {
            width: 42px;
            height: 42px;
        }

        .vim-tool-label {
            display: none;
        }

        #vim-ai-panel {
            right: 12px;
            bottom: 70px;
            width: calc(100vw - 24px);
            height: min(570px, calc(100vh - 90px));
            border-radius: 20px;
        }
    }
</style>

<nav class="fixed top-0 w-full vim-nav-glass h-20 transition-all duration-300">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 h-full flex items-center justify-between">
        
        <!-- BRAND LOGO & USER AVATAR -->
        <div class="flex items-center gap-4 lg:gap-6">
            <a href="/" class="flex items-center gap-3 shrink-0 group">
                <!-- Enlarged VIM Logo -->
                <img src="/images/vimlogo.png" alt="VIM Super League Logo" class="w-12 h-12 object-contain group-hover:scale-105 transition-transform drop-shadow-md" />
                
                <!-- Updated Brand Colors (White/Slate instead of Blue) -->
                <span class="text-lg md:text-xl font-black tracking-tight text-slate-900 dark:text-white uppercase whitespace-nowrap">
                    VIM <span class="text-slate-500 dark:text-slate-400 font-extrabold">SUPER LEAGUE</span>
                </span>
            </a>

            <!-- USER ACCOUNT BADGE -->
            <div class="flex items-center gap-3 border-l border-slate-200/80 dark:border-slate-800 pl-4 lg:pl-6">
                <% if (typeof user !== 'undefined' && user) { %>
                    <a href="/profile" class="flex items-center gap-2.5 bg-slate-100/80 dark:bg-slate-800/80 hover:bg-slate-200/60 dark:hover:bg-slate-700/60 px-3 py-1.5 rounded-full border border-slate-200/80 dark:border-slate-700 transition group">
                        <div class="w-6 h-6 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-full flex items-center justify-center font-black text-[10px]">
                            <%= user.name.charAt(0).toUpperCase() %>
                        </div>

                        <div class="text-left hidden md:block">
                            <p class="text-[10px] font-black text-slate-900 dark:text-slate-100 uppercase tracking-tight leading-none"><%= user.name %></p>
                        </div>
                    </a>

                    <a href="/logout" class="text-[9px] font-black uppercase tracking-wider text-slate-400 hover:text-rose-600 transition">
                        Logout
                    </a>
                <% } else { %>
                    <a href="/profile" class="bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-wider transition whitespace-nowrap shadow-sm">
                        Sign In
                    </a>
                <% } %>
            </div>
        </div>
        
        <!-- DESKTOP NAVIGATION LINKS -->
        <div class="hidden xl:flex items-center gap-1.5 bg-slate-100/50 dark:bg-slate-900/50 p-1.5 rounded-2xl border border-slate-200/60 dark:border-slate-800">
            <% 
                const currentPage = (typeof page !== 'undefined') ? page : ''; 
                const getActive = (p) => (currentPage === p) ? 'active' : ''; 
            %>

            <a href="/" class="nav-link px-4 py-2 rounded-xl text-[10px] font-extrabold uppercase tracking-wider <%= getActive('home') %>">Home</a>

            <a href="/market" class="nav-link px-4 py-2 rounded-xl text-[10px] font-extrabold uppercase tracking-wider <%= getActive('market') %>">Market</a>

            <a href="/matches" class="nav-link px-4 py-2 rounded-xl text-[10px] font-extrabold uppercase tracking-wider <%= getActive('matches') %>">Matches</a>

            <a href="/metrics" class="nav-link px-4 py-2 rounded-xl text-[10px] font-extrabold uppercase tracking-wider <%= getActive('metrics') %>">Metrics</a>

            <a href="/league-records" class="nav-link px-4 py-2 rounded-xl text-[10px] font-extrabold uppercase tracking-wider <%= getActive('records') %>">Records</a>

            <a href="/info" class="nav-link px-4 py-2 rounded-xl text-[10px] font-extrabold uppercase tracking-wider <%= getActive('info') %>">Info</a>

            <a href="/admin" class="nav-link px-4 py-2 rounded-xl text-[10px] font-extrabold uppercase tracking-wider <%= getActive('admin') %>">Admin</a>
        </div>

        <!-- COMMUNITY CTA & HANDBOOK -->
        <div class="hidden xl:flex items-center gap-4">

            <a href="https://vimsuperleague-rulebook.base44.app/" target="_blank" class="text-slate-400 hover:text-slate-900 dark:hover:text-white text-[10px] font-black uppercase tracking-widest transition-colors">
