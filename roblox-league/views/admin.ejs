<%- include('partials/navbar') %>

<main class="py-12 px-4 md:px-8 max-w-7xl mx-auto space-y-8 bg-slate-50 text-slate-900 min-h-screen">

    <!-- ========================================================= -->
    <!-- ERROR / STATUS BANNER
         Every admin action redirects back here with ?error=... on
         failure, but it was never actually shown anywhere — so failed
         saves (locked ranks, validation errors, etc.) looked like they
         silently did nothing. This surfaces it. -->
    <!-- ========================================================= -->
    <% if (typeof error !== 'undefined' && error) { %>
        <div id="adminErrorBanner" class="bg-rose-50 border border-rose-200 text-rose-700 px-5 py-4 rounded-2xl flex items-start justify-between gap-4 shadow-sm">
            <div class="flex items-start gap-3">
                <span class="text-lg leading-none">⚠️</span>
                <p class="text-xs font-bold leading-relaxed"><%= error %></p>
            </div>
            <button type="button" onclick="document.getElementById('adminErrorBanner').remove()" class="text-rose-400 hover:text-rose-600 text-sm font-black flex-shrink-0">✕</button>
        </div>
    <% } %>

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->
    <div class="border-b border-slate-200 pb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <span class="text-xs font-black uppercase tracking-widest text-blue-600 bg-blue-100 px-3 py-1 rounded-full border border-blue-200">
                Control Center
            </span>

            <h1 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-slate-900 mt-2">
                ADMIN <span class="text-blue-600">DASHBOARD</span>
            </h1>

            <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mt-1">
                League management • matches • players • teams • auctions
            </p>
        </div>
    </div>


    <!-- ========================================================= -->
    <!-- MAIN NAVIGATION -->
    <!-- ========================================================= -->
    <div class="flex flex-wrap gap-2 border-b border-slate-200 pb-4" id="adminTabs">

        <button
            onclick="switchTab('broadcast')"
            id="tab-broadcast"
            class="tab-btn active px-4 py-2.5 rounded-xl font-bold text-xs uppercase transition border bg-blue-600 text-white border-blue-600 shadow-md">
            Broadcast & Schedule
        </button>

        <button
            onclick="switchTab('reports')"
            id="tab-reports"
            class="tab-btn px-4 py-2.5 rounded-xl font-bold text-xs uppercase transition border bg-white text-slate-700 border-slate-200 hover:bg-slate-100">
            Match Center
        </button>

        <button
            onclick="switchTab('tables')"
            id="tab-tables"
            class="tab-btn px-4 py-2.5 rounded-xl font-bold text-xs uppercase transition border bg-white text-slate-700 border-slate-200 hover:bg-slate-100">
            Tables & Roster
        </button>

        <button
            onclick="switchTab('queue')"
            id="tab-queue"
            class="tab-btn px-4 py-2.5 rounded-xl font-bold text-xs uppercase transition border bg-white text-slate-700 border-slate-200 hover:bg-slate-100">
            Verification Queue
        </button>

        <button
            onclick="switchTab('market')"
            id="tab-market"
            class="tab-btn px-4 py-2.5 rounded-xl font-bold text-xs uppercase transition border bg-white text-slate-700 border-slate-200 hover:bg-slate-100">
            Player Market
        </button>

        <button
            onclick="switchTab('auction')"
            id="tab-auction"
            class="tab-btn px-4 py-2.5 rounded-xl font-bold text-xs uppercase transition border bg-white text-slate-700 border-slate-200 hover:bg-slate-100">
            Auction Control
        </button>

    </div>


    <!-- ========================================================= -->
    <!-- CATEGORY 1: BROADCAST & SCHEDULE -->
    <!-- ========================================================= -->
    <section id="section-broadcast" class="tab-section space-y-8">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

            <!-- LEFT -->
            <div class="space-y-8">

                <!-- LIVE STREAM -->
                <div class="bg-white border border-slate-200 p-6 md:p-8 rounded-3xl space-y-6 shadow-sm">

                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"></span>
                        <div>
                            <h3 class="text-xs font-black uppercase text-slate-700 tracking-widest">
                                Live Stream Broadcast
                            </h3>
                            <p class="text-[10px] text-slate-400 uppercase font-bold mt-1">
                                Control the league's current broadcast link
                            </p>
                        </div>
                    </div>

                    <form action="/admin/live" method="POST" class="space-y-4">
                        <div>
                            <label class="admin-label">YouTube Link</label>
                            <input
                                name="link"
                                value="<%= typeof liveLink !== 'undefined' ? liveLink : '' %>"
                                placeholder="https://youtube.com/live/..."
                                class="w-full mt-1 bg-slate-50 border border-slate-200 p-3.5 rounded-xl text-slate-900 placeholder-slate-400 outline-none focus:border-blue-500 focus:bg-white text-xs font-medium transition">
                        </div>

                        <button
                            type="submit"
                            class="w-full bg-blue-600 hover:bg-blue-700 py-3 rounded-xl font-bold uppercase text-xs text-white transition shadow-sm">
                            Update Broadcast Link
                        </button>
                    </form>
                </div>


                <!-- SCHEDULE MATCH -->
                <div class="bg-white border border-slate-200 p-6 md:p-8 rounded-3xl space-y-6 shadow-sm">

                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <span class="text-[9px] font-black uppercase tracking-widest text-blue-600 bg-blue-50 px-2.5 py-1 rounded-lg border border-blue-100">
                                Fixture Manager
                            </span>
                            <h3 class="text-xs font-black uppercase text-slate-700 tracking-widest mt-3">
                                Schedule New Match
                            </h3>
                            <p class="text-[10px] text-slate-400 uppercase font-bold mt-1">
                                Choose the exact date and time. Viewers will see it in their local timezone.
                            </p>
                        </div>

                        <span class="hidden sm:inline-flex text-[9px] font-black uppercase tracking-wider text-slate-400 bg-slate-50 border border-slate-200 px-2 py-1 rounded-lg">
                            Localized Time
                        </span>
                    </div>

                    <form action="/admin/add-match" method="POST" class="space-y-5">

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <div>
                                <label class="admin-label">Team A</label>
                                <select name="teamA" class="admin-input" required>
                                    <option value="" disabled selected>Select Team A...</option>
                                    <% if (typeof groups !== 'undefined') { %>
                                        <% groups.forEach(g => { %>
                                            <% (g.teams || []).forEach(t => { %>
                                                <option value="<%= t.name %>"><%= t.name %></option>
                                            <% }) %>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>

                            <div>
                                <label class="admin-label">Team A Logo URL</label>
                                <input name="logoA" placeholder="Optional logo URL" class="admin-input">
                            </div>

                            <div>
                                <label class="admin-label">Team B</label>
                                <select name="teamB" class="admin-input" required>
                                    <option value="" disabled selected>Select Team B...</option>
                                    <% if (typeof groups !== 'undefined') { %>
                                        <% groups.forEach(g => { %>
                                            <% (g.teams || []).forEach(t => { %>
                                                <option value="<%= t.name %>"><%= t.name %></option>
                                            <% }) %>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>

                            <div>
                                <label class="admin-label">Team B Logo URL</label>
                                <input name="logoB" placeholder="Optional logo URL" class="admin-input">
                            </div>
                        </div>


                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <div>
                                <label class="admin-label">Match Date & Time</label>
                                <input
                                    type="datetime-local"
                                    name="time"
                                    id="newMatchDateTime"
                                    class="admin-input"
                                    required>
                                <p class="text-[9px] text-slate-400 font-bold uppercase mt-1.5">
                                    Your browser's local time • stored as one real moment
                                </p>
                            </div>

                            <div>
                                <label class="admin-label">Tags</label>
                                <input
                                    name="tags"
                                    placeholder="LEAGUE, FINALS, MATCHDAY 3"
                                    class="admin-input">
                            </div>
                        </div>


                        <div class="bg-blue-50 border border-blue-100 rounded-2xl p-4 flex items-start gap-3">
                            <div class="w-8 h-8 rounded-xl bg-white border border-blue-100 flex items-center justify-center text-blue-600 font-black">
                                🌍
                            </div>
                            <div>
                                <p class="text-[10px] font-black uppercase tracking-wider text-blue-700">
                                    Timezone handled automatically
                                </p>
                                <p class="text-[10px] text-blue-600/80 font-semibold mt-1 leading-relaxed">
                                    Enter the fixture using your computer's local date and time. The public schedule can convert the stored match time for each viewer.
                                </p>
                            </div>
                        </div>


                        <button
                            type="submit"
                            class="w-full bg-slate-900 hover:bg-slate-800 text-white py-3.5 rounded-xl font-bold uppercase text-xs transition shadow-sm">
                            Schedule Match
                        </button>

                    </form>
                </div>


                <!-- ACTIVE SCHEDULE -->
                <div class="bg-white border border-slate-200 p-6 rounded-3xl shadow-sm space-y-5">

                    <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-3">
                        <div>
                            <span class="text-[9px] font-black uppercase tracking-widest text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-100">
                                Matchday Control
                            </span>
                            <h3 class="text-xs font-black uppercase text-slate-700 tracking-widest mt-3">
                                Active Schedule
                            </h3>
                            <p class="text-[10px] text-slate-400 uppercase font-bold mt-1">
                                Edit fixtures, start a match live, or remove a fixture.
                            </p>
                        </div>

                        <span class="text-[10px] font-black text-blue-600 bg-blue-50 border border-blue-100 px-2 py-1 rounded-lg">
                            <%= typeof matches !== 'undefined' ? matches.length : 0 %> MATCHES
                        </span>
                    </div>


                    <div class="max-h-[520px] overflow-y-auto space-y-3 pr-1">

                        <% if (typeof matches !== 'undefined' && matches.length > 0) { %>

                            <% matches.forEach((m) => { %>

                                <div
                                    class="schedule-card bg-slate-50 p-4 rounded-2xl border border-slate-200 space-y-3"
                                    data-match-id="<%= m.id || m._id %>"
                                    data-team-a="<%= m.teamA || '' %>"
                                    data-team-b="<%= m.teamB || '' %>"
                                    data-logo-a="<%= m.logoA || '' %>"
                                    data-logo-b="<%= m.logoB || '' %>"
                                    data-time="<%= m.time || '' %>"
                                    data-tags="<%= m.tags || '' %>">

                                    <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-3">

                                        <div class="min-w-0">
                                            <div class="flex items-center gap-2">
                                                <span class="w-2 h-2 rounded-full <%= m.isLive || m.status === 'live' ? 'bg-red-500 animate-pulse' : 'bg-slate-300' %>"></span>
                                                <span class="text-sm uppercase text-slate-900 font-black truncate">
                                                    <%= m.teamA %> <span class="text-slate-400">vs</span> <%= m.teamB %>
                                                </span>
                                            </div>

                                            <div class="flex flex-wrap items-center gap-2 mt-2">
                                                <span
                                                    class="vim-local-time text-[10px] text-blue-600 font-bold bg-blue-50 border border-blue-100 px-2 py-1 rounded-lg"
                                                    data-vim-datetime="<%= m.time || '' %>">
                                                    <%= m.time || 'Date not set' %>
                                                </span>

                                                <% if (m.isLive || m.status === 'live') { %>
                                                    <span class="text-[9px] font-black uppercase text-red-600 bg-red-50 border border-red-100 px-2 py-1 rounded-lg animate-pulse">
                                                        LIVE
                                                    </span>
                                                <% } else if (m.status === 'completed' || m.completed) { %>
                                                    <span class="text-[9px] font-black uppercase text-slate-500 bg-slate-100 border border-slate-200 px-2 py-1 rounded-lg">
                                                        COMPLETED
                                                    </span>
                                                <% } else { %>
                                                    <span class="text-[9px] font-black uppercase text-amber-600 bg-amber-50 border border-amber-100 px-2 py-1 rounded-lg">
                                                        SCHEDULED
                                                    </span>
                                                <% } %>
                                            </div>
                                        </div>


                                        <div class="flex flex-wrap gap-2 sm:justify-end">

                                            <% if (!(m.isLive || m.status === 'live')) { %>
                                                <form
                                                    action="/admin/set-match-live"
                                                    method="POST"
                                                    onsubmit="return confirm('Make this match LIVE now?');">

                                                    <input type="hidden" name="matchId" value="<%= m.id || m._id %>">

                                                    <button
                                                        type="submit"
                                                        class="text-red-600 hover:text-red-700 text-[9px] font-black uppercase px-3 py-2 rounded-lg bg-red-50 border border-red-200 transition">
                                                        Make LIVE
                                                    </button>
                                                </form>
                                            <% } %>

                                            <button
                                                type="button"
                                                onclick="openScheduleEditor(this)"
                                                class="text-blue-600 hover:text-blue-700 text-[9px] font-black uppercase px-3 py-2 rounded-lg bg-blue-50 border border-blue-200 transition">
                                                Edit
                                            </button>

                                            <form
                                                action="/admin/delete-match"
                                                method="POST"
                                                onsubmit="return confirm('Delete this match? This cannot be undone.');">

                                                <input
                                                    type="hidden"
                                                    name="matchId"
                                                    value="<%= m.id || m._id %>">

                                                <button
                                                    type="submit"
                                                    class="text-red-600 hover:text-red-700 text-[9px] font-black uppercase px-3 py-2 rounded-lg bg-red-50 border border-red-200 transition">
                                                    Delete
                                                </button>
                                            </form>

                                        </div>

                                    </div>


                                    <% if(m.tags) { %>
                                        <div class="flex gap-1 flex-wrap">
                                            <% m.tags.split(',').forEach(t => { %>
                                                <span class="bg-white text-blue-700 border border-blue-200 px-2 py-0.5 rounded text-[9px] font-bold uppercase">
                                                    <%= t.trim() %>
                                                </span>
                                            <% }) %>
                                        </div>
                                    <% } %>

                                </div>

                            <% }) %>

                        <% } else { %>

                            <p class="text-xs text-slate-400 text-center py-8">
                                No scheduled matches found.
                            </p>

                        <% } %>

                    </div>

                </div>

            </div>


            <!-- RIGHT -->
            <div class="space-y-8">

                <!-- HALL OF FAME -->
                <div class="bg-white border border-slate-200 p-6 md:p-8 rounded-3xl space-y-6 shadow-sm">

                    <div>
                        <span class="text-[9px] font-black uppercase tracking-widest text-amber-600 bg-amber-50 px-2.5 py-1 rounded-lg border border-amber-100">
                            VIM History
                        </span>

                        <h3 class="text-xs font-black uppercase text-slate-700 tracking-widest mt-3">
                            League Hall of Fame
                        </h3>

                        <p class="text-[10px] text-slate-400 uppercase font-bold mt-1">
                            Build a proper historical archive for seasons, tournaments and individual achievements.
                        </p>
                    </div>


                    <form action="/admin/add-record" method="POST" class="space-y-4">

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">

                            <div>
                                <label class="admin-label">Competition Type</label>
                                <select name="category" class="admin-input">
                                    <option value="season">Season</option>
                                    <option value="tournament">Tournament</option>
                                    <option value="career">Career / All-Time</option>
                                    <option value="special">Special Award</option>
                                </select>
                            </div>

                            <div>
                                <label class="admin-label">Season / Edition</label>
                                <input
                                    name="season"
                                    placeholder="e.g. VSL Season 3"
                                    class="admin-input">
                            </div>

                            <div>
                                <label class="admin-label">Competition / Tournament</label>
                                <input
                                    name="competition"
                                    placeholder="e.g. VIM Cup"
                                    class="admin-input">
                            </div>

                            <div>
                                <label class="admin-label">Award / Record</label>
                                <select name="recordType" class="admin-input">
                                    <option value="champion">Champion / Winner</option>
                                    <option value="runner_up">Runner-up</option>
                                    <option value="most_goals">Most Goals</option>
                                    <option value="most_assists">Most Assists</option>
                                    <option value="most_saves">Most Saves</option>
                                    <option value="mvp">MVP</option>
                                    <option value="best_manager">Best Manager</option>
                                    <option value="golden_boot">Golden Boot</option>
                                    <option value="golden_glove">Golden Glove</option>
                                    <option value="custom">Custom Record</option>
                                </select>
                            </div>

                        </div>


                        <input
                            name="title"
                            placeholder="Record title / display name"
                            required
                            class="admin-input">

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">

                            <div>
                                <label class="admin-label">Winner / Holder</label>
                                <input
                                    name="holder"
                                    placeholder="Player, manager or team"
                                    required
                                    class="admin-input">
                            </div>

                            <div>
                                <label class="admin-label">Value</label>
                                <input
                                    name="value"
                                    placeholder="e.g. 24 goals / 9 saves / 1 title"
                                    required
                                    class="admin-input">
                            </div>

                        </div>


                        <textarea
                            name="description"
                            placeholder="Optional note about the achievement..."
                            class="admin-input h-20"></textarea>


                        <button
                            type="submit"
                            class="w-full bg-amber-500 hover:bg-amber-600 py-3 rounded-xl font-black uppercase text-xs text-white transition shadow-sm">
                            Add Hall of Fame Record
                        </button>

                    </form>


                    <div class="border-t border-slate-200 pt-5">

                        <div class="flex items-center justify-between mb-3">
                            <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                                Archive
                            </p>

                            <span class="text-[9px] font-bold text-slate-400 uppercase">
                                <%= typeof records !== 'undefined' ? records.length : 0 %> records
                            </span>
                        </div>


                        <div class="max-h-[430px] overflow-y-auto space-y-3 pr-1">

                            <% if (typeof records !== 'undefined' && records.length > 0) { %>

                                <% records.forEach(rec => { %>

                                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 space-y-3">

                                        <div class="flex items-start justify-between gap-3">

                                            <div class="min-w-0">

                                                <div class="flex flex-wrap gap-1.5 mb-2">

                                                    <% if (rec.category) { %>
                                                        <span class="text-[8px] font-black uppercase tracking-wider text-amber-700 bg-amber-100 px-2 py-0.5 rounded">
                                                            <%= rec.category %>
                                                        </span>
                                                    <% } %>

                                                    <% if (rec.recordType) { %>
                                                        <span class="text-[8px] font-black uppercase tracking-wider text-blue-700 bg-blue-100 px-2 py-0.5 rounded">
                                                            <%= String(rec.recordType).replace(/_/g, ' ') %>
                                                        </span>
                                                    <% } %>

                                                    <% if (rec.season) { %>
                                                        <span class="text-[8px] font-black uppercase tracking-wider text-slate-500 bg-white border border-slate-200 px-2 py-0.5 rounded">
                                                            <%= rec.season %>
                                                        </span>
                                                    <% } %>

                                                </div>

                                                <p class="text-xs font-black text-slate-900">
                                                    <%= rec.title %>
                                                </p>

                                                <p class="text-[11px] text-slate-600 font-semibold mt-1">
                                                    <%= rec.holder %>
                                                    <% if (rec.value) { %>
                                                        <span class="text-blue-600">• <%= rec.value %></span>
                                                    <% } %>
                                                </p>

                                                <% if (rec.competition) { %>
                                                    <p class="text-[9px] text-slate-400 uppercase font-bold mt-1">
                                                        <%= rec.competition %>
                                                    </p>
                                                <% } %>

                                                <% if (rec.description) { %>
                                                    <p class="text-[10px] text-slate-400 mt-2 leading-relaxed">
                                                        <%= rec.description %>
                                                    </p>
                                                <% } %>

                                            </div>


                                            <div class="flex gap-1 shrink-0">

                                                <button
                                                    type="button"
                                                    onclick="openRecordEditor(this)"
                                                    data-record-id="<%= rec.id || rec._id %>"
                                                    data-title="<%= rec.title || '' %>"
                                                    data-holder="<%= rec.holder || '' %>"
                                                    data-value="<%= rec.value || '' %>"
                                                    data-category="<%= rec.category || 'season' %>"
                                                    data-season="<%= rec.season || '' %>"
                                                    data-competition="<%= rec.competition || '' %>"
                                                    data-record-type="<%= rec.recordType || 'custom' %>"
                                                    data-description="<%= rec.description || '' %>"
                                                    class="text-blue-600 hover:text-blue-700 text-[9px] font-black uppercase px-2 py-1 bg-blue-50 border border-blue-100 rounded-lg">
                                                    Edit
                                                </button>

                                                <form action="/admin/delete-record" method="POST" onsubmit="return confirm('Delete this Hall of Fame record? This cannot be undone.');">

                                                    <input
                                                        type="hidden"
                                                        name="recordId"
                                                        value="<%= rec.id || rec._id %>">

                                                    <button
                                                        type="submit"
                                                        class="text-red-600 hover:text-red-700 text-xs font-black px-2 py-1 rounded-lg bg-red-50 border border-red-100">
                                                        ×
                                                    </button>

                                                </form>

                                            </div>

                                        </div>

                                    </div>

                                <% }) %>

                            <% } else { %>

                                <p class="text-xs text-slate-400 text-center py-6">
                                    No Hall of Fame records added yet.
                                </p>

                            <% } %>

                        </div>

                    </div>

                </div>


                <!-- NEWS -->
                <div class="bg-white border border-slate-200 p-6 md:p-8 rounded-3xl space-y-6 shadow-sm">

                    <div>
                        <h3 class="text-xs font-black uppercase text-blue-600 tracking-widest">
                            News & Announcements
                        </h3>

                        <p class="text-[10px] text-slate-400 uppercase font-bold mt-1">
                            Publish league news and updates
                        </p>
                    </div>

                    <form action="/admin/add-story" method="POST" class="space-y-3">

                        <input
                            name="title"
                            placeholder="Story Title"
                            required
                            class="admin-input">

                        <textarea
                            name="description"
                            placeholder="Headline Summary..."
                            required
                            class="admin-input h-24"></textarea>

                        <input
                            name="image"
                            placeholder="Banner Image URL"
                            required
                            class="admin-input">

                        <button
                            type="submit"
                            class="w-full bg-slate-900 hover:bg-slate-800 text-white py-3 rounded-xl font-bold uppercase text-xs transition">
                            Publish Story
                        </button>

                    </form>


                    <div class="max-h-[220px] overflow-y-auto space-y-2 pr-1">

                        <% if (typeof stories !== 'undefined' && stories.length > 0) { %>

                            <% stories.forEach((story, sIdx) => { %>

                                <div class="flex items-center gap-3 bg-slate-50 p-3 rounded-xl border border-slate-200">

                                    <img
                                        src="<%= story.image %>"
                                        class="w-10 h-10 rounded-lg object-cover bg-slate-200">

                                    <div class="flex-1 truncate">

                                        <p class="text-xs font-bold text-slate-900 truncate">
                                            <%= story.title %>
                                        </p>

                                        <p class="text-[10px] text-slate-500 truncate">
                                            <%= story.description %>
                                        </p>

                                    </div>

                                    <form action="/admin/delete-story" method="POST" onsubmit="return confirm('Delete this story? This cannot be undone.');">

