<%- include('partials/navbar') %>

<style>
    /* Clean Light Glass Canvas */
    .bg-vim-canvas {
        background-color: #f8fafc;
        background-image: 
            radial-gradient(at 0% 0%, rgba(241, 245, 249, 0.9) 0px, transparent 50%),
            radial-gradient(at 100% 100%, rgba(226, 232, 240, 0.6) 0px, transparent 50%);
        background-attachment: fixed;
    }

    /* Glass Containers */
    .vim-glass-card {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(226, 232, 240, 0.8);
        box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.03);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .vim-glass-card:hover {
        background: rgba(255, 255, 255, 0.9);
        border-color: rgba(203, 213, 225, 1);
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.05);
    }

    /* Stat Pill Accents */
    .rank-pill-1 { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
    .rank-pill-2 { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
    .rank-pill-3 { background: #ffedd5; color: #c2410c; border: 1px solid #fed7aa; }
    .rank-pill-default { background: rgba(241, 245, 249, 0.6); color: #64748b; }
</style>

<div class="min-h-screen bg-vim-canvas text-slate-900 font-sans pb-24">
    <main class="py-12 px-4 sm:px-6 max-w-7xl mx-auto space-y-12">

        <!-- PAGE HEADER -->
        <div class="flex flex-col items-center text-center space-y-3">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-200/60 border border-slate-300/50">
                <span class="w-2 h-2 rounded-full bg-slate-900 animate-pulse"></span>
                <span class="text-[10px] font-extrabold uppercase tracking-widest text-slate-700">Live Analytics & Standings</span>
            </div>
            <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tight text-slate-900">
                LEAGUE <span class="text-slate-400 font-light">METRICS</span>
            </h1>
            <p class="text-xs font-bold uppercase tracking-[0.3em] text-slate-400">Season Standings & Individual Leaders</p>
        </div>

        <!-- QUICK SUMMARY METRICS CARDS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <% 
                let totalTeamsCount = 0;
                if (groups && groups.length > 0) {
                    groups.forEach(g => { totalTeamsCount += (g.teams ? g.teams.length : 0); });
                }
            %>
            <div class="vim-glass-card p-5 rounded-3xl flex items-center justify-between">
                <div>
                    <span class="text-[10px] font-black uppercase tracking-widest text-slate-400 block mb-1">Active Groups</span>
                    <span class="text-3xl font-black text-slate-900"><%= groups ? groups.length : 0 %></span>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-slate-100 border border-slate-200/80 flex items-center justify-center text-slate-700 font-black text-lg">
                    📊
                </div>
            </div>

            <div class="vim-glass-card p-5 rounded-3xl flex items-center justify-between">
                <div>
                    <span class="text-[10px] font-black uppercase tracking-widest text-slate-400 block mb-1">Registered Squads</span>
                    <span class="text-3xl font-black text-slate-900"><%= totalTeamsCount %></span>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-slate-100 border border-slate-200/80 flex items-center justify-center text-slate-700 font-black text-lg">
                    🛡️
                </div>
            </div>

            <div class="vim-glass-card p-5 rounded-3xl flex items-center justify-between">
                <div>
                    <span class="text-[10px] font-black uppercase tracking-widest text-slate-400 block mb-1">Top Goalscorer</span>
                    <span class="text-sm font-black text-slate-900 uppercase block truncate max-w-[120px]">
                        <%= (leaderboards && leaderboards.scorers && leaderboards.scorers[0]) ? leaderboards.scorers[0].name : 'N/A' %>
                    </span>
                    <span class="text-[10px] font-bold text-slate-400">
                        <%= (leaderboards && leaderboards.scorers && leaderboards.scorers[0]) ? leaderboards.scorers[0].value + ' Goals' : '0 Goals' %>
                    </span>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-amber-50 border border-amber-200/80 flex items-center justify-center text-amber-600 font-black text-lg">
                    ⚽
                </div>
            </div>

            <div class="vim-glass-card p-5 rounded-3xl flex items-center justify-between">
                <div>
                    <span class="text-[10px] font-black uppercase tracking-widest text-slate-400 block mb-1">Golden Glove</span>
                    <span class="text-sm font-black text-slate-900 uppercase block truncate max-w-[120px]">
                        <%= (leaderboards && leaderboards.saves && leaderboards.saves[0]) ? leaderboards.saves[0].name : 'N/A' %>
                    </span>
                    <span class="text-[10px] font-bold text-slate-400">
                        <%= (leaderboards && leaderboards.saves && leaderboards.saves[0]) ? leaderboards.saves[0].value + ' Saves' : '0 Saves' %>
                    </span>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-200/80 flex items-center justify-center text-emerald-600 font-black text-lg">
                    🧤
                </div>
            </div>
        </div>

        <!-- GROUP STANDINGS TABLES -->
        <div class="space-y-8">
            <% if (groups && groups.length > 0) { %>
                <% groups.forEach(group => { %>
                    <div class="vim-glass-card rounded-3xl overflow-hidden">
                        
                        <!-- Table Header Bar -->
                        <div class="px-6 py-5 border-b border-slate-200/80 flex items-center justify-between bg-white/40">
                            <div class="flex items-center gap-3">
                                <span class="w-3 h-3 rounded-full bg-slate-900"></span>
                                <h2 class="text-lg font-black uppercase text-slate-900 tracking-tight">
                                    <%= group.name %>
                                </h2>
                            </div>
                            <span class="px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-[10px] font-extrabold uppercase text-slate-600 tracking-wider">
                                Official Standings
                            </span>
                        </div>
                        
                        <!-- Table Data -->
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="text-[10px] uppercase font-black text-slate-400 border-b border-slate-100 bg-slate-50/50">
                                        <th class="py-4 px-6 text-center w-16">Pos</th>
                                        <th class="py-4 px-4">Club</th>
                                        <th class="py-4 text-center w-16">MP</th>
                                        <th class="py-4 text-center w-16">W</th>
                                        <th class="py-4 text-center w-16">L</th>
                                        <th class="py-4 text-right px-6 w-24">PTS</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 text-slate-800">
                                    <% group.teams.forEach((team, index) => { %>
                                        <% 
                                            let pillClass = "rank-pill-default";
                                            if(index === 0) pillClass = "rank-pill-1";
                                            if(index === 1) pillClass = "rank-pill-2";
                                            if(index === 2) pillClass = "rank-pill-3";
                                        %>
                                        <tr class="hover:bg-slate-50/80 transition-colors group">
                                            <td class="py-4 px-6 text-center">
                                                <span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-black <%= pillClass %>">
                                                    <%= index + 1 %>
                                                </span>
                                            </td>
                                            <td class="py-4 px-4">
                                                <div class="flex items-center gap-3">
                                                    <img src="<%= team.logo %>" onerror="this.onerror=null; this.src='https://via.placeholder.com/80/f1f5f9/475569?text=CLUB';" class="w-9 h-9 object-contain group-hover:scale-105 transition-transform">
                                                    <a href="/team/<%= group.id %>/<%= index %>" class="font-extrabold text-sm uppercase tracking-tight text-slate-900 hover:text-slate-600 transition-colors">
                                                        <%= team.name %>
                                                    </a>
                                                </div>
                                            </td>
                                            <td class="py-4 text-center text-xs font-extrabold text-slate-500"><%= team.mp || 0 %></td>
                                            <td class="py-4 text-center text-xs font-extrabold text-emerald-600"><%= team.wins || 0 %></td>
                                            <td class="py-4 text-center text-xs font-extrabold text-rose-500"><%= team.loses || 0 %></td>
                                            <td class="py-4 text-right px-6 font-black text-slate-900 text-lg tracking-tight">
                                                <%= team.pts || 0 %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="vim-glass-card p-16 rounded-3xl text-center">
                    <p class="text-xs font-black uppercase tracking-widest text-slate-400">No active group standings available</p>
                </div>
            <% } %>
        </div>

        <!-- PLAYER STAT LEADERBOARDS -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <% ['scorers', 'saves', 'assists'].forEach(type => { %>
                <div class="vim-glass-card rounded-3xl overflow-hidden flex flex-col justify-between">
                    <div>
                        <div class="p-5 border-b border-slate-100 bg-white/40 flex items-center justify-between">
                            <h3 class="text-xs font-black uppercase tracking-widest text-slate-900">
                                Top <%= type %>
                            </h3>
                            <span class="text-[10px] font-black uppercase text-slate-400 bg-slate-100 border border-slate-200/80 px-2.5 py-0.5 rounded-full">
                                Individual
                            </span>
                        </div>
                        
                        <div class="p-4 space-y-2">
                            <% if(leaderboards && leaderboards[type] && leaderboards[type].length > 0) { %>
                                <% const maxVal = leaderboards[type][0].value || 1; %>
                                <% leaderboards[type].slice(0, 8).forEach((player, index) => { %>
                                    <div class="flex items-center justify-between p-2.5 rounded-2xl bg-white/50 border border-slate-200/60 hover:bg-white transition-all group">
                                        <div class="flex items-center gap-3">
                                            <span class="w-6 h-6 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-[10px] font-black text-slate-600">
                                                <%= index + 1 %>
                                            </span>
                                            <span class="text-xs font-extrabold uppercase text-slate-800 truncate max-w-[110px]">
                                                <%= player.name %>
                                            </span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs font-black text-slate-900"><%= player.value %></span>
                                            <div class="h-1.5 w-12 bg-slate-100 rounded-full overflow-hidden border border-slate-200/50">
                                                <div class="h-full bg-slate-900 rounded-full" style="width: <%= (player.value / maxVal) * 100 %>%"></div>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="py-12 text-center">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">No stats recorded</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

    </main>
</div>