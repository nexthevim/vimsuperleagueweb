<%- include('partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
    --pf-paper: #f4f1e9;
    --pf-paper-2: rgba(255,253,248,.88);
    --pf-paper-solid: #fffdf8;

    --pf-ink: #123b3c;
    --pf-ink-deep: #073536;
    --pf-teal: #07595a;
    --pf-teal-2: #0a7778;

    --pf-coral: #f18470;
    --pf-coral-dark: #d96756;

    --pf-mint: #d9ece6;
    --pf-muted: #728081;

    --pf-line: rgba(18,59,60,.105);
    --pf-line-strong: rgba(18,59,60,.16);

    --pf-display: "DM Serif Display", Georgia, serif;
    --pf-body: "Manrope", system-ui, sans-serif;

    --pf-radius-xl: 1.75rem;
    --pf-radius-lg: 1.35rem;
    --pf-radius-md: 1rem;

    --pf-shadow:
        0 12px 40px rgba(18,59,60,.055),
        0 2px 8px rgba(18,59,60,.035);

    --pf-shadow-hover:
        0 22px 55px rgba(18,59,60,.10),
        0 4px 14px rgba(18,59,60,.055);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
}

/* =========================================================
   PAGE
========================================================= */

#profile-page {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    font-family: var(--pf-body);
    background:
        radial-gradient(circle at 8% 12%, rgba(241,132,112,.12), transparent 24rem),
        radial-gradient(circle at 92% 22%, rgba(7,89,90,.10), transparent 28rem),
        radial-gradient(circle at 55% 92%, rgba(217,236,230,.65), transparent 28rem),
        var(--pf-paper);

    color: var(--pf-ink);
    min-height: 100vh;

    padding: 6rem 1.1rem 4rem;

    -webkit-font-smoothing: antialiased;
}

#profile-page::before,
#profile-page::after {
    content: "";
    position: absolute;
    z-index: -1;
    pointer-events: none;
    border-radius: 999px;
    filter: blur(2px);
    animation: pfFloat 12s ease-in-out infinite;
}

#profile-page::before {
    width: 300px;
    height: 300px;
    top: 12rem;
    left: -150px;
    background: rgba(241,132,112,.055);
}

#profile-page::after {
    width: 360px;
    height: 360px;
    right: -180px;
    top: 40rem;
    background: rgba(7,89,90,.045);
    animation-delay: -5s;
}

html.dark #profile-page {
    background:
        radial-gradient(circle at 10% 8%, rgba(241,132,112,.07), transparent 25rem),
        radial-gradient(circle at 90% 25%, rgba(7,145,145,.07), transparent 28rem),
        radial-gradient(circle at 50% 95%, rgba(217,236,230,.025), transparent 28rem),
        #0b100e;

    color: #e8ece9;
}

.pf-shell {
    width: min(1180px, 100%);
    margin: 0 auto;
}

/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes pfPageIn {
    from {
        opacity: 0;
        transform: translateY(18px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes pfFadeUp {
    from {
        opacity: 0;
        transform: translateY(16px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes pfFloat {
    0%, 100% {
        transform: translate3d(0,0,0);
    }
    50% {
        transform: translate3d(0,-22px,0);
    }
}

@keyframes pfPulse {
    0%, 100% {
        box-shadow: 0 0 0 0 rgba(5,150,105,.08);
    }
    50% {
        box-shadow: 0 0 0 8px rgba(5,150,105,0);
    }
}

@keyframes pfShine {
    0% {
        transform: translateX(-120%);
    }
    45%, 100% {
        transform: translateX(120%);
    }
}

@keyframes pfSpin {
    to {
        transform: rotate(360deg);
    }
}

.pf-shell {
    animation: pfPageIn .65s cubic-bezier(.22,1,.36,1) both;
}

.pf-layout > *,
.pf-card,
.pf-discord-box {
    animation: pfFadeUp .65s cubic-bezier(.22,1,.36,1) both;
}

.pf-layout > *:nth-child(2) {
    animation-delay: .08s;
}

/* =========================================================
   TYPOGRAPHY
========================================================= */

.pf-display {
    font-family: var(--pf-display);
    font-weight: 400;
    letter-spacing: -.025em;
}

.pf-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    color: var(--pf-coral-dark);

    font-size: .61rem;
    font-weight: 800;
    letter-spacing: .17em;
    text-transform: uppercase;
}

.pf-eyebrow::before {
    content: "";
    width: 18px;
    height: 1px;
    background: currentColor;
    opacity: .8;
}

.pf-muted {
    color: var(--pf-muted);
    font-size: .75rem;
}

html.dark .pf-muted {
    color: #899793;
}

/* =========================================================
   BUTTONS
========================================================= */

.pf-btn {
    position: relative;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    min-height: 43px;
    padding: 0 17px;

    border-radius: 999px;
    border: 1px solid transparent;

    font-family: inherit;
    font-size: .61rem;
    font-weight: 800;
    letter-spacing: .085em;
    text-transform: uppercase;

    text-decoration: none;
    cursor: pointer;

    transition:
        transform .22s cubic-bezier(.22,1,.36,1),
        box-shadow .22s ease,
        background .22s ease,
        border-color .22s ease,
        color .22s ease;
}

.pf-btn:hover {
    transform: translateY(-2px);
}

.pf-btn:active {
    transform: translateY(0) scale(.98);
}

/* Clean teal button */

.pf-btn-teal {
    color: #fff;
    background: var(--pf-teal);
    box-shadow: 0 9px 24px rgba(7,89,90,.18);
}

.pf-btn-teal:hover {
    color: #fff;
    background: var(--pf-teal-2);
    box-shadow: 0 13px 30px rgba(7,89,90,.25);
}

/* Clean coral */

.pf-btn-coral {
    color: #fff;
    background: var(--pf-coral);
    box-shadow: 0 9px 24px rgba(241,132,112,.20);
}

.pf-btn-coral:hover {
    color: #fff;
    background: #ed7966;
    box-shadow: 0 13px 30px rgba(241,132,112,.27);
}

/* Ghost */

.pf-btn-ghost {
    color: var(--pf-ink);
    background: rgba(255,255,255,.25);
    border-color: var(--pf-line-strong);
    box-shadow: none;
}

.pf-btn-ghost:hover {
    color: var(--pf-ink);
    background: rgba(255,255,255,.65);
    border-color: rgba(18,59,60,.2);
}

html.dark .pf-btn-ghost {
    color: #e8ece9;
    background: rgba(255,255,255,.025);
    border-color: rgba(255,255,255,.13);
}

html.dark .pf-btn-ghost:hover {
    background: rgba(255,255,255,.07);
}

/* Danger */

.pf-btn-danger {
    color: #a61b1b;
    background: rgba(255,255,255,.65);
    border-color: rgba(185,28,28,.18);
    box-shadow: none;
}

.pf-btn-danger:hover {
    color: #991b1b;
    background: #fff5f4;
    border-color: rgba(185,28,28,.3);
}

html.dark .pf-btn-danger {
    background: rgba(185,28,28,.07);
    color: #fca5a5;
    border-color: rgba(248,113,113,.16);
}

/* Discord */

.pf-btn-discord {
    color: #5865F2;
    background: #fff;
    border-color: rgba(255,255,255,.4);
    box-shadow: 0 9px 24px rgba(0,0,0,.12);
}

.pf-btn-discord:hover {
    color: #4752c4;
    background: #fafaff;
    box-shadow: 0 13px 30px rgba(0,0,0,.16);
}

/* =========================================================
   CARDS
========================================================= */

.pf-card {
    position: relative;

    background: var(--pf-paper-2);
    border: 1px solid var(--pf-line);

    border-radius: var(--pf-radius-xl);

    padding: 1.35rem 1.4rem;

    box-shadow: var(--pf-shadow);

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);

    transition:
        transform .28s cubic-bezier(.22,1,.36,1),
        box-shadow .28s ease,
        border-color .28s ease;
}

.pf-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--pf-shadow-hover);
    border-color: rgba(18,59,60,.15);
}

html.dark .pf-card {
    background: rgba(21,26,24,.88);
    border-color: rgba(255,255,255,.075);
    box-shadow:
        0 15px 45px rgba(0,0,0,.22),
        0 2px 8px rgba(0,0,0,.15);
}

html.dark .pf-card:hover {
    border-color: rgba(255,255,255,.12);
}

/* Inner cards should not jump */

.pf-card .pf-card:hover {
    transform: none;
}

.pf-card-h {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    margin-bottom: 1rem;
}

.pf-card-h h2,
.pf-card-h h3 {
    margin: 0;
    font-size: .95rem;
    color: var(--pf-ink-deep);
}

html.dark .pf-card-h h2,
html.dark .pf-card-h h3 {
    color: #f0f4f1;
}

/* =========================================================
   HERO
========================================================= */

.pf-hero {
    position: relative;

    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;

    gap: 1.25rem;

    margin-bottom: 1.8rem;
    padding: 0 .25rem 1.45rem;

    border-bottom: 1px solid var(--pf-line);
}

html.dark .pf-hero {
    border-bottom-color: rgba(255,255,255,.08);
}

.pf-hero h1 {
    margin: .4rem 0 .3rem;

    font-size: clamp(2.55rem, 5vw, 3.65rem);
    line-height: .9;

    color: var(--pf-ink-deep);
}

html.dark .pf-hero h1 {
    color: #f2f6f3;
}

.pf-hero h1 em {
    font-style: italic;
    color: var(--pf-teal);
}

html.dark .pf-hero h1 em {
    color: #68b9b8;
}

.pf-hero p {
    margin: 0;

    color: var(--pf-muted);
    font-size: .82rem;
    font-weight: 500;
}

/* =========================================================
   STAT TILES
========================================================= */

.pf-stat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: .65rem;
}

@media (min-width: 640px) {
    .pf-stat-grid.four {
        grid-template-columns: repeat(4, 1fr);
    }
}

.pf-stat {
    position: relative;
    overflow: hidden;

    text-align: center;

    padding: 1rem .75rem;

    border-radius: 1.1rem;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.8),
            rgba(247,244,237,.8)
        );

    border: 1px solid var(--pf-line);

    transition:
        transform .25s cubic-bezier(.22,1,.36,1),
        border-color .25s ease,
        box-shadow .25s ease;
}

.pf-stat::after {
    content: "";
    position: absolute;
    width: 80px;
    height: 80px;
    top: -50px;
    right: -35px;
    border-radius: 50%;
    background: rgba(7,89,90,.055);
    transition: transform .35s ease;
}

.pf-stat:hover {
    transform: translateY(-3px);
    border-color: rgba(7,89,90,.18);
    box-shadow: 0 10px 25px rgba(18,59,60,.07);
}

.pf-stat:hover::after {
    transform: scale(1.5);
}

html.dark .pf-stat {
    background: #101412;
    border-color: rgba(255,255,255,.07);
}

html.dark .pf-stat:hover {
    border-color: rgba(255,255,255,.13);
}

.pf-stat span {
    position: relative;
    z-index: 1;

    display: block;

    font-size: .56rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;

    color: var(--pf-muted);
}

.pf-stat strong {
    position: relative;
    z-index: 1;

    display: block;

    margin-top: .25rem;

    font-family: var(--pf-display);
    font-size: 1.65rem;
    font-style: italic;

    color: var(--pf-ink-deep);
}

html.dark .pf-stat strong {
    color: #f0f4f1;
}

.pf-stat strong.em {
    color: #059669;
}

/* =========================================================
   PLAYER CARD
========================================================= */

.pf-card-frame {
    position: relative;
    overflow: hidden;

    aspect-ratio: 3/4;

    border-radius: 1.5rem;

    background:
        radial-gradient(circle at 50% 15%, rgba(125,211,252,.12), transparent 30%),
        #080d0c;

    border: 1px solid rgba(18,59,60,.18);

    box-shadow:
        0 24px 55px rgba(18,59,60,.14),
        0 4px 12px rgba(18,59,60,.06);

    transform: translateZ(0);
}

.pf-card-frame::after {
    content: "";

    position: absolute;
    z-index: 2;

    top: 0;
    bottom: 0;
    left: -100%;

    width: 45%;

    background: linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,.08),
        transparent
    );

    transform: skewX(-18deg);

    pointer-events: none;
}

.pf-card-frame:hover::after {
    animation: pfShine 1.2s ease;
}

.pf-card-frame img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
        transform .7s cubic-bezier(.22,1,.36,1),
        filter .4s ease;
}

.pf-card-frame:hover img {
    transform: scale(1.045);
    filter: saturate(1.04) contrast(1.02);
}

.pf-card-overlay {
    position: absolute;

    z-index: 3;

    left: 0;
    right: 0;
    bottom: 0;

    padding: 4rem 1rem 1rem;

    background:
        linear-gradient(
            to top,
            rgba(0,0,0,.94),
            rgba(0,0,0,.62) 45%,
            transparent
        );
}

.pf-card-overlay b {
    display: block;

    color: #fff;

    font-size: 1.15rem;
    font-weight: 800;

    text-transform: uppercase;
    font-style: italic;

    line-height: 1.1;
}

.pf-card-overlay span {
    color: #7dd3fc;

    font-size: .63rem;
    font-weight: 700;

    letter-spacing: .08em;
    text-transform: uppercase;
}

/* =========================================================
   FORM
========================================================= */

.pf-label {
    display: block;

    margin-bottom: .4rem;

    font-size: .56rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;

    color: var(--pf-muted);
}

.pf-input,
.pf-select,
.pf-area {
    width: 100%;

    padding: .88rem 1rem;

    border-radius: 1rem;

    border: 1.5px solid var(--pf-line);

    background: rgba(247,244,237,.72);
    color: var(--pf-ink);

    font-family: inherit;
    font-size: .84rem;
    font-weight: 600;

    outline: none;

    transition:
        border-color .22s ease,
        box-shadow .22s ease,
        background .22s ease,
        transform .22s ease;
}

.pf-input:hover,
.pf-select:hover,
.pf-area:hover {
    border-color: rgba(18,59,60,.18);
}

.pf-input:focus,
.pf-select:focus,
.pf-area:focus {
    border-color: var(--pf-teal);

    background: rgba(255,255,255,.92);

    box-shadow:
        0 0 0 4px rgba(7,89,90,.09),
        0 8px 20px rgba(7,89,90,.055);

    transform: translateY(-1px);
}

html.dark .pf-input,
html.dark .pf-select,
html.dark .pf-area {
    background: #101412;
    border-color: rgba(255,255,255,.1);
    color: #e8ece9;
}

html.dark .pf-input:focus,
html.dark .pf-select:focus,
html.dark .pf-area:focus {
    background: #121815;
    border-color: #5baead;
    box-shadow: 0 0 0 4px rgba(91,174,173,.08);
}

.pf-area {
    resize: vertical;
    min-height: 110px;
    line-height: 1.55;
}

.pf-grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
}

@media (min-width: 720px) {
    .pf-grid-2 {
        grid-template-columns: 1fr 1fr;
    }
}

.pf-grid-3 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
}

@media (min-width: 720px) {
    .pf-grid-3 {
        grid-template-columns: 1fr 1fr 1fr;
    }
}

/* =========================================================
   THEME BUTTONS
========================================================= */

.pf-theme-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: .55rem;
}

.theme-btn {
    min-height: 48px;

    border-radius: 999px;
    border: 1px solid var(--pf-line);

    background: rgba(247,244,237,.7);
    color: var(--pf-ink);

    font-family: inherit;

    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .07em;
    text-transform: uppercase;

    cursor: pointer;

    transition:
        transform .22s cubic-bezier(.22,1,.36,1),
        box-shadow .22s ease,
        background .22s ease,
        color .22s ease,
        border-color .22s ease;
}

.theme-btn:hover {
    transform: translateY(-2px);
    border-color: rgba(7,89,90,.2);
    box-shadow: 0 8px 18px rgba(18,59,60,.07);
}

.theme-btn.is-active {
    background: var(--pf-teal);
    color: #fff;
    border-color: var(--pf-teal);

    box-shadow:
        0 9px 22px rgba(7,89,90,.18);
}

html.dark .theme-btn {
    background: #101412;
    border-color: rgba(255,255,255,.1);
    color: #e8ece9;
}

html.dark .theme-btn:hover {
    background: #151b18;
}

html.dark .theme-btn.is-active {
    background: #f3f5f3;
    color: #0e1210;
    border-color: #f3f5f3;
}

/* =========================================================
   MANAGER LISTS
========================================================= */

.pf-list {
    display: flex;
    flex-direction: column;
    gap: .45rem;

    max-height: 16rem;

    overflow-y: auto;

    scrollbar-width: thin;
    scrollbar-color: rgba(18,59,60,.2) transparent;
}

.pf-list::-webkit-scrollbar {
    width: 5px;
}

.pf-list::-webkit-scrollbar-track {
    background: transparent;
}

.pf-list::-webkit-scrollbar-thumb {
    background: rgba(18,59,60,.16);
    border-radius: 999px;
}

.pf-row {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: .6rem;

    padding: .7rem .8rem;

    border-radius: 1rem;

    background: rgba(247,244,237,.7);
    border: 1px solid var(--pf-line);

    transition:
        transform .2s ease,
        border-color .2s ease,
        background .2s ease;
}

.pf-row:hover {
    transform: translateX(3px);
    border-color: rgba(18,59,60,.16);
    background: rgba(255,255,255,.72);
}

html.dark .pf-row {
    background: #101412;
    border-color: rgba(255,255,255,.07);
}

html.dark .pf-row:hover {
    background: #141916;
    border-color: rgba(255,255,255,.12);
}

.pf-row.win {
    border-color: rgba(5,150,105,.22);
    background: rgba(5,150,105,.055);
}

.pf-row.out {
    border-color: rgba(225,29,72,.18);
    background: rgba(225,29,72,.045);
}

.pf-row.ready {
    border-color: rgba(5,150,105,.30);
    background: rgba(5,150,105,.085);
    animation: pfPulse 2.4s ease-in-out infinite;
}

.pf-row.watch {
    border-color: rgba(217,119,6,.18);
    background: rgba(217,119,6,.055);
}

/* =========================================================
   BADGES
========================================================= */

.pf-badge {
    display: inline-flex;
    align-items: center;

    padding: .2rem .55rem;

    border-radius: 999px;

    font-size: .52rem;
    font-weight: 800;

    letter-spacing: .08em;
    text-transform: uppercase;

    background: rgba(18,59,60,.07);
    color: var(--pf-muted);
}

.pf-badge-ok {
    background: rgba(5,150,105,.12);
    color: #059669;
}

.pf-badge-warn {
    background: rgba(217,119,6,.12);
    color: #d97706;
}

.pf-badge-bad {
    background: rgba(225,29,72,.12);
    color: #e11d48;
}

/* =========================================================
   ALERTS
========================================================= */

.pf-alert {
    display: flex;

    gap: .75rem;
    align-items: flex-start;

    padding: .95rem 1.05rem;

    border-radius: 1.15rem;

    font-size: .79rem;
    font-weight: 600;

    line-height: 1.45;
}

.pf-alert-warn {
    background: rgba(245,158,11,.09);
    border: 1px solid rgba(245,158,11,.22);
    color: #b45309;
}

.pf-alert-bad {
    background: rgba(225,29,72,.07);
    border: 1px solid rgba(225,29,72,.18);
    color: #be123c;
}

html.dark .pf-alert-warn {
    background: rgba(245,158,11,.07);
    color: #fbbf24;
}

html.dark .pf-alert-bad {
    background: rgba(225,29,72,.06);
    color: #fb7185;
}

/* =========================================================
   LAYOUT
========================================================= */

.pf-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
}

@media (min-width: 960px) {
    .pf-layout {
        grid-template-columns: 340px 1fr;
        gap: 1.5rem;
        align-items: start;
    }
}

.pf-section-title {
    margin: 0 0 .85rem;

    font-size: 1.05rem;

    color: var(--pf-ink-deep);
}

html.dark .pf-section-title {
    color: #f0f4f1;
}

/* =========================================================
   DISCORD
========================================================= */

.pf-discord-box {
    position: relative;
    overflow: hidden;

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;

    gap: 1rem;

    padding: 1.3rem 1.35rem;

    border-radius: var(--pf-radius-xl);

    background:
        radial-gradient(circle at 85% 20%, rgba(255,255,255,.13), transparent 10rem),
        linear-gradient(135deg, #5865F2, #6977e4 50%, #7289da);

    color: #fff;

    box-shadow:
        0 18px 40px rgba(88,101,242,.23);

    animation-delay: .12s;
}

.pf-discord-box::before {
    content: "";

    position: absolute;

    width: 180px;
    height: 180px;

    right: -50px;
    bottom: -110px;

    border-radius: 50%;

    background: rgba(255,255,255,.08);
}

.pf-discord-box h3 {
    margin: 0 0 .25rem;

    font-size: 1.08rem;
    font-family: var(--pf-display);
}

.pf-discord-box p {
    margin: 0;

    font-size: .75rem;
    opacity: .9;
}

/* =========================================================
   CLASS GRID
========================================================= */

.pf-class-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: .4rem;
}

.pf-class {
    text-align: center;

    padding: .7rem .25rem;

    border-radius: .9rem;

    background: rgba(247,244,237,.7);
    border: 1px solid var(--pf-line);

    transition:
        transform .2s ease,
        background .2s ease;
}

.pf-class:hover {
    transform: translateY(-2px);
    background: rgba(255,255,255,.8);
}

html.dark .pf-class {
    background: #101412;
    border-color: rgba(255,255,255,.07);
}

html.dark .pf-class:hover {
    background: #151a17;
}

.pf-class span {
    display: block;

    font-size: .53rem;
    font-weight: 800;

    letter-spacing: .1em;
    text-transform: uppercase;

    color: var(--pf-muted);
}

.pf-class b {
    font-family: var(--pf-display);
    font-size: 1.05rem;
    font-style: italic;
}

/* =========================================================
   EMPTY STATE
========================================================= */

.pf-empty {
    padding: 1rem;

    text-align: center;

    color: var(--pf-muted);

    font-size: .78rem;
    font-style: italic;
    font-weight: 600;

    border-radius: .9rem;
    border: 1px dashed var(--pf-line);
}

/* =========================================================
   LINKS
========================================================= */

.pf-link {
    position: relative;

    color: var(--pf-teal);

    font-weight: 800;
    font-size: .68rem;

    letter-spacing: .06em;
    text-transform: uppercase;

    text-decoration: none;

    transition: color .2s ease;
}

.pf-link::after {
    content: "";

    position: absolute;

    left: 0;
    right: 0;
    bottom: -3px;

    height: 1.5px;

    background: currentColor;

    transform: scaleX(0);
    transform-origin: right;

    transition:
        transform .3s cubic-bezier(.22,1,.36,1);
}

.pf-link:hover {
    color: var(--pf-teal-2);
}

.pf-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 640px) {

    #profile-page {
        padding:
            5.2rem .8rem
            2.5rem;
    }

    .pf-hero {
        align-items: flex-start;
        padding-bottom: 1.2rem;
    }

    .pf-hero h1 {
        font-size: 2.55rem;
    }

    .pf-hero > div:last-child {
        width: 100%;
    }

    .pf-hero > div:last-child .pf-btn {
        flex: 1;
    }

    .pf-card {
        border-radius: 1.35rem;
        padding: 1.05rem;
    }

    .pf-theme-row {
        gap: .4rem;
    }

    .theme-btn {
        font-size: .52rem;
    }

    .pf-class-grid {
        gap: .3rem;
    }

    .pf-class {
        padding: .6rem .15rem;
    }

    .pf-card-frame {
        border-radius: 1.2rem;
    }

    .pf-discord-box {
        border-radius: 1.35rem;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
        scroll-behavior: auto !important;
    }
}
</style>


<div id="profile-page">

<div class="pf-shell">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="pf-hero">

        <div>
            <div class="pf-eyebrow">Your account</div>

            <h1 class="pf-display">
                Player <em>Hub</em>
            </h1>

            <p>
                Dashboard, card, and settings — all in one place.
            </p>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:.5rem;align-items:center">

            <a href="/market" class="pf-btn pf-btn-teal">
                Open market
            </a>

            <form
                action="/profile/delete"
                method="POST"
                onsubmit="return confirm('Are you sure? This will permanently remove your market card and player stats.')"
                style="margin:0"
            >
                <button type="submit" class="pf-btn pf-btn-danger">
                    Delete account
                </button>
            </form>

        </div>

    </header>


    <!-- =====================================================
         MANAGER DASHBOARD
    ====================================================== -->

    <% if (
        typeof isManager !== 'undefined' &&
        isManager &&
        typeof myAuctionState !== 'undefined' &&
        myAuctionState
    ) { %>

    <section class="pf-card" style="margin-bottom:1.5rem">

        <div class="pf-card-h">

            <div>

                <div class="pf-eyebrow">
                    Manager only
                </div>

                <h2
                    class="pf-display pf-section-title"
                    style="margin:.2rem 0 0"
                >
                    Manager Dashboard —
                    <%= myAuctionState.team.name %>
                </h2>

                <p
                    class="pf-muted"
                    style="margin:.15rem 0 0"
                >
                    Private to you. No other manager can see this.
                </p>

            </div>

        </div>


        <!-- MANAGER STATS -->

        <div
            class="pf-stat-grid four"
            style="margin-bottom:1rem"
        >

            <div class="pf-stat">
                <span>Total budget</span>

                <strong>
                    <%= Number(myAuctionState.budget).toLocaleString() %>
                </strong>
            </div>

            <div class="pf-stat">
                <span>Available</span>

                <strong class="em">
                    <%= Number(myAuctionState.availableBudget).toLocaleString() %>
                </strong>
            </div>

            <div class="pf-stat">
                <span>Roster</span>

                <strong>
                    <%= myAuctionState.totalPlayers %>
                    <span style="font-size:.7em;opacity:.5">
                        /<%= myAuctionState.rosterMax %>
                    </span>
                </strong>
            </div>

            <div class="pf-stat">
                <span>Slots left</span>

                <strong>
                    <%= myAuctionState.remainingSlots.total %>
                </strong>
            </div>

        </div>


        <!-- CLASS SLOTS -->

        <p
            class="pf-muted"
            style="
                margin:0 0 .5rem;
                font-size:.62rem;
                font-weight:800;
                letter-spacing:.1em;
                text-transform:uppercase
            "
        >
            Class slots
        </p>

        <div
            class="pf-class-grid"
            style="margin-bottom:.75rem"
        >

            <% ['SS','S','A','B','C'].forEach(k => {

                const has = myAuctionState.caps[k] !== undefined;
                const count = myAuctionState.counts[k] || 0;
                const cap = has ? myAuctionState.caps[k] : null;

            %>

                <div class="pf-class">

                    <span>
                        <%= k %>
                    </span>

                    <b>

                        <%= count %>

                        <% if (has) { %>

                            <span
                                style="
                                    opacity:.45;
                                    font-size:.75em
                                "
                            >
                                /<%= cap %>
                            </span>

                        <% } %>

                    </b>

                </div>

            <% }) %>

        </div>

        <p
            class="pf-muted"
            style="margin:0 0 1rem"
        >
            Caps auto-adjust:
            0 SS → 4S/6A ·
            1 SS → 3S/5A ·
            2 SS → 2S/3A.
            Manager = 1 roster slot.
        </p>


        <!-- ROSTER WARNING -->

        <% const needMore =
            Math.max(
                0,
                myAuctionState.rosterMin -
                myAuctionState.totalPlayers
            );
        %>


        <% if (needMore > 0) { %>

            <div
                class="pf-alert pf-alert-warn"
                style="margin-bottom:.65rem"
            >

                <span>⚠️</span>

                <p style="margin:0">

                    Roster warning:
                    you still need at least

                    <strong>
                        <%= needMore %>
                    </strong>

                    more player(s) to hit the
                    <%= myAuctionState.rosterMin %>-player minimum.

                    Available:
                    <%= Number(
                        myAuctionState.availableBudget
                    ).toLocaleString() %>
                    V.

                </p>

            </div>

        <% } %>


        <!-- BUDGET WARNING -->

        <% if (
            myAuctionState.availableBudget < 2500 &&
            myAuctionState.totalPlayers <
            myAuctionState.rosterMin
        ) { %>

            <div
                class="pf-alert pf-alert-bad"
                style="margin-bottom:.65rem"
            >

                <span>🚨</span>

                <p style="margin:0">

                    Budget critical:
                    you may not have enough left to reach the
                    <%= myAuctionState.rosterMin %>-player minimum.

                </p>

            </div>

        <% } %>


        <!-- MANAGER COLUMNS -->

        <div
            style="
                display:grid;
                grid-template-columns:1fr;
                gap:.85rem;
                margin-top:1rem
            "
        >

            <style>
                @media(min-width:900px){
                    .pf-mgr-cols{
                        grid-template-columns:
                            1fr 1fr 1fr!important
                    }
                }
            </style>

            <div
                class="pf-mgr-cols"
                style="
                    display:grid;
                    grid-template-columns:1fr;
                    gap:.85rem
                "
            >

                <!-- WINNING -->

                <div
                    class="pf-card"
                    style="
                        padding:1rem;
                        box-shadow:none
                    "
                >

                    <p
                        style="
                            margin:0 0 .65rem;
                            font-size:.62rem;
                            font-weight:800;
                            letter-spacing:.1em;
                            text-transform:uppercase;
                            color:#059669
                        "
                    >
                        Currently winning
                        (<%= myAuctionState.provisional.length %>)
                    </p>

                    <% if (
                        myAuctionState.provisional.length > 0
                    ) { %>

                        <div class="pf-list">

                            <% myAuctionState.provisional.forEach(
                                ({player, amount, isManager}) => {
                            %>

                                <div class="pf-row win">

                                    <span
                                        style="
                                            font-size:.8rem;
                                            font-weight:800;
                                            overflow:hidden;
                                            text-overflow:ellipsis;
                                            white-space:nowrap
                                        "
                                    >

                                        <%= player.name %>

                                        <% if (isManager) { %>

                                            <span class="pf-badge">
                                                mgr
                                            </span>

                                        <% } %>

                                    </span>

                                    <strong
                                        style="
                                            font-size:.8rem;
                                            color:#059669;
                                            flex-shrink:0
                                        "
                                    >
                                        <%= isManager
                                            ? '—'
                                            : Number(amount)
                                                .toLocaleString()
                                        %>
                                    </strong>

                                </div>

                            <% }) %>

                        </div>

                    <% } else { %>

                        <div class="pf-empty">
                            No active winning bids yet.
                        </div>

                    <% } %>

                </div>


                <!-- OUTBID -->

                <div
                    class="pf-card"
                    style="
                        padding:1rem;
                        box-shadow:none
                    "
                >

                    <p
                        style="
                            margin:0 0 .65rem;
                            font-size:.62rem;
                            font-weight:800;
                            letter-spacing:.1em;
                            text-transform:uppercase;
                            color:#e11d48
                        "
                    >
                        Outbid / locked
                        (<%= typeof myOutbidPlayers !== 'undefined'
                            ? myOutbidPlayers.length
                            : 0 %>)
                    </p>


                    <% if (
                        typeof myOutbidPlayers !== 'undefined' &&
                        myOutbidPlayers.length > 0
                    ) { %>

                        <% const readyWithdraw =
                            myOutbidPlayers.filter(
                                x => x.canWithdraw
                            );
                        %>


                        <% if (readyWithdraw.length > 0) { %>

                            <div
                                class="pf-alert pf-alert-warn"
                                style="
                                    margin-bottom:.55rem;
                                    background:rgba(5,150,105,.08);
                                    border-color:rgba(5,150,105,.25);
                                    color:#047857
                                "
                            >

                                <div>

                                    <strong
                                        style="
                                            font-size:.65rem;
                                            letter-spacing:.08em;
                                            text-transform:uppercase
                                        "
                                    >
                                        You can withdraw now
                                    </strong>

                                    <p
                                        style="
                                            margin:.25rem 0 0;
                                            font-size:.72rem
                                        "
                                    >
                                        <%= readyWithdraw
                                            .map(x => x.name)
                                            .join(', ') %>
                                    </p>

                                </div>

                            </div>

                        <% } %>


                        <div class="pf-list">

                            <% myOutbidPlayers.forEach(p => { %>

                                <div
                                    class="
                                        pf-row
                                        <%= p.canWithdraw
                                            ? 'ready'
                                            : 'out' %>
                                    "
                                >

                                    <div style="min-width:0">

                                        <p
                                            style="
                                                margin:0;
                                                font-size:.8rem;
                                                font-weight:800;
                                                overflow:hidden;
                                                text-overflow:ellipsis;
                                                white-space:nowrap
                                            "
                                        >
                                            <%= p.name %>
                                        </p>

                                        <p
                                            class="pf-muted"
                                            style="
                                                margin:.15rem 0 0;
                                                font-size:.62rem
                                            "
                                        >
                                            Your bid
                                            <%= Number(
                                                p.myBidAmount || 0
                                            ).toLocaleString() %>

                                            · now

                                            <%= Number(
                                                p.highestBid || 0
                                            ).toLocaleString() %>

                                            by
                                            <%= p.highestBidder || '—' %>
                                        </p>


                                        <% if (p.canWithdraw) { %>

                                            <span
                                                class="
                                                    pf-badge
                                                    pf-badge-ok
                                                "
                                                style="
                                                    margin-top:.25rem
                                                "
                                            >
                                                Unlocked
                                            </span>

                                        <% } else { %>

                                            <p
                                                class="
                                                    pf-muted
                                                    outbid-countdown
                                                "
                                                data-remaining="<%= Number(
                                                    p.remainingMs
                                                ) || 0 %>"
                                                style="
                                                    margin:.25rem 0 0;
                                                    font-size:.62rem;
                                                    font-weight:800;
                                                    color:#d97706
                                                "
                                            >
                                                Unlock in
                                                <span class="countdown-text">
                                                    …
                                                </span>
                                            </p>

                                        <% } %>

                                    </div>


                                    <strong
                                        style="
                                            font-size:.8rem;
                                            flex-shrink:0;
                                            color:<%= p.canWithdraw
                                                ? '#059669'
                                                : '#e11d48' %>
                                        "
                                    >
                                        <%= Number(
                                            p.myBidAmount ||
                                            p.highestBid ||
                                            0
                                        ).toLocaleString() %>
                                    </strong>

                                </div>

                            <% }) %>

                        </div>


                        <p
                            class="pf-muted"
                            style="
                                margin:.55rem 0 0;
                                font-size:.68rem;
                                line-height:1.4
                            "
                        >
                            Highest bids: withdraw anytime.
                            Outbid: locked 12h, then free.
                        </p>

                    <% } else { %>

                        <div class="pf-empty">
                            You haven't been outbid on anything.
                        </div>

                    <% } %>

                </div>


                <!-- WATCHLIST -->

                <div
                    class="pf-card"
                    style="
                        padding:1rem;
                        box-shadow:none
                    "
                >

                    <p
                        style="
                            margin:0 0 .65rem;
                            font-size:.62rem;
                            font-weight:800;
                            letter-spacing:.1em;
                            text-transform:uppercase;
                            color:#d97706
                        "
                    >
                        Watchlist
                        (<%= typeof myWatchlistPlayers !== 'undefined'
                            ? myWatchlistPlayers.length
                            : 0 %>)
                    </p>


                    <% if (
                        typeof myWatchlistPlayers !== 'undefined' &&
                        myWatchlistPlayers.length > 0
                    ) { %>

                        <div class="pf-list">

                            <% myWatchlistPlayers.forEach(p => {

                                const amWinningWatched =
                                    (p.highestBidder || '')
                                        .toLowerCase() ===
                                    myAuctionState.team.name
                                        .toLowerCase() &&
                                    Number(p.highestBid) > 0;

                            %>

                                <div class="pf-row watch">

                                    <div style="min-width:0">

                                        <p
                                            style="
                                                margin:0;
                                                font-size:.8rem;
                                                font-weight:800;
                                                overflow:hidden;
                                                text-overflow:ellipsis;
                                                white-space:nowrap
                                            "
                                        >
                                            <%= p.name %>
                                        </p>

                                        <p
                                            class="pf-muted"
                                            style="
                                                margin:.15rem 0 0;
                                                font-size:.62rem;
                                                color:<%= amWinningWatched
                                                    ? '#059669'
                                                    : 'inherit' %>
                                            "
                                        >
                                            <%= amWinningWatched
                                                ? "You're winning"
                                                : (p.highestBidder ||
                                                   'No bids yet') %>
                                        </p>

                                    </div>

                                    <strong
                                        style="
                                            font-size:.8rem;
                                            flex-shrink:0
                                        "
                                    >
                                        <%= Number(
                                            p.highestBid ||
                                            p.reservePrice ||
                                            0
                                        ).toLocaleString() %>
                                    </strong>

                                </div>

                            <% }) %>

                        </div>

                    <% } else { %>

                        <div class="pf-empty">
                            Star players in the Market to track them here.
                        </div>

                    <% } %>

                </div>

            </div>

        </div>


        <div
            style="
                text-align:center;
                margin-top:1.15rem
            "
        >

            <a
                href="/market"
                class="pf-btn pf-btn-coral"
            >
                Go to auction hub →
            </a>

        </div>

    </section>

    <% } %>


    <!-- =====================================================
         RECENT BIDS
    ====================================================== -->

    <% if (
        typeof myRecentBids !== 'undefined' &&
        myRecentBids &&
        myRecentBids.length > 0
    ) { %>

        <section
            class="pf-card"
            style="margin-bottom:1.5rem"
        >

            <div class="pf-card-h">

                <div>

                    <div class="pf-eyebrow">
                        Auction activity
                    </div>

                    <h2
                        class="pf-display pf-section-title"
                        style="margin:.2rem 0 0"
                    >
                        Recent bids on you
                    </h2>

                    <p
                        class="pf-muted"
                        style="margin:.15rem 0 0"
                    >
                        Teams bidding on your card
                    </p>

                </div>

            </div>


            <div
                class="pf-list"
                style="max-height:18rem"
            >

                <% myRecentBids.forEach(b => { %>

                    <div class="pf-row">

                        <div style="min-width:0">

                            <p
                                style="
                                    margin:0;
                                    font-size:.85rem;
                                    font-weight:800
                                "
                            >
                                <%= b.teamName || 'Unknown team' %>
                            </p>

                            <p
                                class="pf-muted"
                                style="
                                    margin:.15rem 0 0;
                                    font-size:.65rem
                                "
                            >

                                <%= b.managerName
                                    ? ('mgr ' + b.managerName + ' · ')
                                    : '' %>

                                <%= b.createdAt
                                    ? new Date(
                                        b.createdAt
                                      ).toLocaleString()
                                    : '' %>

                            </p>

                        </div>

                        <strong
                            style="
                                color:#059669;
                                font-size:.95rem
                            "
                        >
                            <%= Number(
                                b.amount || 0
                            ).toLocaleString() %>
                        </strong>

                    </div>

                <% }) %>

            </div>

        </section>

    <% } else if (
        typeof auctionSettings !== 'undefined' &&
        auctionSettings &&
        auctionSettings.status === 'live'
    ) { %>

        <div
            class="pf-card"
            style="
                margin-bottom:1.5rem;
                text-align:center;
                border-style:dashed
            "
        >

            <p
                class="pf-muted"
                style="
                    margin:0;
                    font-weight:700;
                    letter-spacing:.08em;
                    text-transform:uppercase;
                    font-size:.7rem
                "
            >
                No bids on your card yet — auction is live
            </p>

        </div>

    <% } %>


    <!-- =====================================================
         DISCORD
    ====================================================== -->

    <section
        class="pf-discord-box"
        style="margin-bottom:1.5rem"
    >

        <div>

            <h3>
                Connect Discord
            </h3>

            <p>
                Link your Discord for role sync, pings,
                and easier verification. (Coming soon)
            </p>

        </div>

        <button
            type="button"
            class="pf-btn pf-btn-discord"
            onclick="alert('Discord connect is coming soon — placeholder for now.')"
        >
            Connect Discord
        </button>

    </section>


    <!-- =====================================================
         MAIN PROFILE AREA
    ====================================================== -->

    <div class="pf-layout">


        <!-- =================================================
             LEFT
        ================================================== -->

        <div
            style="
                display:flex;
                flex-direction:column;
                gap:1rem
            "
        >

            <!-- PLAYER CARD -->

            <div class="pf-card">

                <div
                    class="pf-card-h"
                    style="margin-bottom:.75rem"
                >

                    <p
                        class="pf-muted"
                        style="
                            margin:0;
                            font-size:.58rem;
                            font-weight:800;
                            letter-spacing:.12em;
                            text-transform:uppercase
                        "
                    >
                        Official player card
                    </p>

                    <% if (user && user.cardImage) { %>

                        <span class="pf-badge pf-badge-ok">
                            Verified
                        </span>

                    <% } %>

                </div>


                <div class="pf-card-frame">

                    <% if (user && user.cardImage) { %>

                        <img
                            src="<%= user.cardImage %>"
                            alt="<%= user.name %> Card"
                        >

                    <% } else { %>

                        <div
                            style="
                                width:100%;
                                height:100%;
                                display:flex;
                                flex-direction:column;
                                align-items:center;
                                justify-content:center;
                                padding:1.5rem;
                                text-align:center;
                                gap:.75rem
                            "
                        >

                            <div
                                style="
                                    width:2.5rem;
                                    height:2.5rem;
                                    border:2px solid rgba(56,189,248,.25);
                                    border-top-color:#38bdf8;
                                    border-radius:50%;
                                    animation:pfSpin .9s linear infinite
                                "
                            ></div>

                            <div>

                                <p
                                    style="
                                        margin:0;
                                        color:#fff;
                                        font-size:.75rem;
                                        font-weight:800;
                                        letter-spacing:.08em;
                                        text-transform:uppercase
                                    "
                                >
                                    Card pending
                                </p>

                                <p
                                    class="pf-muted"
                                    style="
                                        margin:.35rem 0 0;
                                        font-size:.7rem
                                    "
                                >
                                    An admin will generate your market card soon.
                                </p>

                            </div>

                        </div>

                    <% } %>


                    <div class="pf-card-overlay">

                        <div
                            style="
                                display:flex;
                                justify-content:space-between;
                                align-items:flex-end;
                                gap:.5rem
                            "
                        >

                            <div>

                                <b>
                                    <%= user
                                        ? user.name
                                        : 'Unknown' %>
                                </b>

                                <span>
                                    @<%= user
                                        ? user.discord
                                        : 'none' %>
                                </span>

                            </div>

                            <span
                                style="
                                    background:var(--pf-teal);
                                    color:#fff;
                                    font-size:.55rem;
                                    font-weight:800;
                                    padding:.25rem .5rem;
                                    border-radius:.4rem;
                                    letter-spacing:.06em;
                                    text-transform:uppercase
                                "
                            >
                                <%= user
                                    ? user.position
                                    : '???' %>
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- PLAYER STATS -->

            <div class="pf-stat-grid">

                <div class="pf-stat">

                    <span>Goals</span>

                    <strong>
                        <%= user ? user.goals : 0 %>
                    </strong>

                </div>

                <div class="pf-stat">

                    <span>Assists</span>

                    <strong>
                        <%= user ? user.assists : 0 %>
                    </strong>

                </div>

                <div class="pf-stat">

                    <span>Saves</span>

                    <strong>
                        <%= user
                            ? (user.saves || 0)
                            : 0 %>
                    </strong>

                </div>

                <div class="pf-stat">

                    <span>MVPs</span>

                    <strong>
                        <%= user ? user.mvps : 0 %>
                    </strong>

                </div>

            </div>

        </div>


        <!-- =================================================
             RIGHT
        ================================================== -->

        <div
            style="
                display:flex;
                flex-direction:column;
                gap:1rem
            "
        >


            <!-- THEME -->

            <div class="pf-card">

                <div class="pf-card-h">

                    <h3 class="pf-display">
                        Website theme
                    </h3>

                </div>

                <div class="pf-theme-row">

                    <button
                        type="button"
                        onclick="setTheme('light')"
                        id="btn-theme-light"
                        class="theme-btn"
                    >
                        ☀️ Light
                    </button>

                    <button
                        type="button"
                        onclick="setTheme('dark')"
                        id="btn-theme-dark"
                        class="theme-btn"
                    >
                        🌙 Dark
                    </button>

                    <button
                        type="button"
                        onclick="setTheme('system')"
                        id="btn-theme-system"
                        class="theme-btn"
                    >
                        💻 System
                    </button>

                </div>

            </div>


            <!-- EDIT PROFILE -->

            <div class="pf-card">

                <div
                    class="pf-card-h"
                    style="
                        border-bottom:1px solid var(--pf-line);
                        padding-bottom:.85rem;
                        margin-bottom:1.15rem
                    "
                >

                    <div>

                        <h3
                            class="pf-display"
                            style="margin:0"
                        >
                            Edit profile
                        </h3>

                        <p
                            class="pf-muted"
                            style="margin:.25rem 0 0"
                        >
                            Changes show up on the Market card.
                        </p>

                    </div>

                </div>


                <form
                    action="/profile/update"
                    method="POST"
                    style="
                        display:flex;
                        flex-direction:column;
                        gap:1.05rem
                    "
                >


                    <!-- NAME / DISCORD -->

                    <div class="pf-grid-2">

                        <div>

                            <label class="pf-label">
                                Display name
                            </label>

                            <input
                                class="pf-input"
                                name="name"
                                value="<%= user ? user.name : '' %>"
                                required
                            >

                        </div>


                        <div>

                            <label class="pf-label">
                                Discord handle
                            </label>

                            <input
                                class="pf-input"
                                name="discord"
                                value="<%= user ? user.discord : '' %>"
                                required
                                placeholder="username"
                            >

                        </div>

                    </div>


                    <!-- POSITION / COUNTRY / TIMEZONE -->

                    <div class="pf-grid-3">

                        <div>

                            <label class="pf-label">
                                Position
                            </label>

                            <select
                                class="pf-select"
                                name="position"
                            >

                                <option
                                    value="FWD"
                                    <%= user &&
                                        user.position === 'FWD'
                                        ? 'selected'
                                        : '' %>
                                >
                                    Forward (FWD)
                                </option>

                                <option
                                    value="MID"
                                    <%= user &&
                                        user.position === 'MID'
                                        ? 'selected'
                                        : '' %>
                                >
                                    Midfield (MID)
                                </option>

                                <option
                                    value="DEF"
                                    <%= user &&
                                        user.position === 'DEF'
                                        ? 'selected'
                                        : '' %>
                                >
                                    Defense (DEF)
                                </option>

                                <option
                                    value="GK"
                                    <%= user &&
                                        user.position === 'GK'
                                        ? 'selected'
                                        : '' %>
                                >
                                    Goalkeeper (GK)
                                </option>

                            </select>

                        </div>


                        <div>

                            <label class="pf-label">
                                Country
                            </label>

                            <input
                                class="pf-input"
                                name="country"
                                value="<%= user ? user.country : '' %>"
                                required
                                placeholder="e.g. India, USA"
                            >

                        </div>


                        <div>

                            <label class="pf-label">
                                Timezone
                            </label>

                            <input
                                class="pf-input"
                                name="timezone"
                                value="<%= user ? user.timezone : '' %>"
                                placeholder="e.g. GMT+5:30"
                            >

                        </div>

                    </div>


                    <!-- BIO -->

                    <div>

                        <label class="pf-label">
                            Market biography
                        </label>

                        <textarea
                            class="pf-area"
                            name="bio"
                            rows="4"
                            placeholder="Experience, past teams, playstyle…"
                        ><%= user
                            ? (user.bio || user.experience)
                            : '' %></textarea>

                    </div>


                    <!-- ACTIONS -->

                    <div
                        style="
                            display:flex;
                            flex-wrap:wrap;
                            gap:.55rem;
                            align-items:center;
                            padding-top:.25rem
                        "
                    >

                        <button
                            type="submit"
                            class="pf-btn pf-btn-coral"
                        >
                            Save profile
                        </button>

                        <a
                            href="/market"
                            class="pf-link"
                        >
                            View on market
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
</div>


<!-- =========================================================
     THEME SCRIPT
========================================================= -->

<script>

if (window.tailwind) {
    tailwind.config = {
        darkMode: 'class'
    };
}


function setTheme(mode) {

    localStorage.setItem(
        'vim_theme',
        mode
    );

    const isDark =
        mode === 'dark' ||
        (
            mode === 'system' &&
            window.matchMedia(
                '(prefers-color-scheme: dark)'
            ).matches
        );


    if (isDark) {
        document.documentElement.classList.add('dark');
    } else {
        document.documentElement.classList.remove('dark');
    }


    fetch('/profile/update-theme', {
        method: 'POST',

        headers: {
            'Content-Type': 'application/json'
        },

        body: JSON.stringify({
            theme: mode
        })

    }).catch(() => {});


    document
        .querySelectorAll('.theme-btn')
        .forEach(btn => {
            btn.classList.remove('is-active');
        });


    const activeBtn =
        document.getElementById(
            'btn-theme-' + mode
        );


    if (activeBtn) {
        activeBtn.classList.add('is-active');
    }

}


(function() {

    const savedTheme =
        localStorage.getItem('vim_theme') ||
        "<%= user
            ? (user.theme || 'system')
            : 'system' %>";

    setTheme(savedTheme);

})();

</script>


<!-- =========================================================
     OUTBID COUNTDOWN
========================================================= -->

<script>

(function() {

    function fmt(ms) {

        if (ms <= 0) {
            return '0m';
        }


        var h =
            Math.floor(
                ms / 3600000
            );

        var m =
            Math.floor(
                (ms % 3600000) / 60000
            );

        var s =
            Math.floor(
                (ms % 60000) / 1000
            );


        if (h > 0) {
            return h + 'h ' + m + 'm';
        }


        if (m > 0) {
            return m + 'm ' + s + 's';
        }


        return s + 's';

    }


    function tick() {

        document
            .querySelectorAll(
                '.outbid-countdown'
            )
            .forEach(function(el) {

                var rem =
                    Number(
                        el.getAttribute(
                            'data-remaining'
                        )
                    ) || 0;


                rem = Math.max(
                    0,
                    rem - 1000
                );


                el.setAttribute(
                    'data-remaining',
                    String(rem)
                );


                var span =
                    el.querySelector(
                        '.countdown-text'
                    );


                if (span) {
                    span.textContent =
                        fmt(rem);
                }


                if (rem <= 0) {

                    el.textContent =
                        'Unlocked — refresh to withdraw';

                    el.style.color =
                        '#059669';

                }

            });

    }


    tick();

    setInterval(
        tick,
        1000
    );

})();

</script>
