    <!-- =====================================================
         TEAL FEATURED SPACES → FEATURED MATCHDAYS
         ===================================================== -->
    <section class="vsl-featured">
        <div class="vsl-shell vsl-featured-inner">
            <div class="vsl-section-title">
                <div class="vsl-eyebrow">Featured matchdays</div>
                <h2 class="vsl-display">The scoreboard never sleeps.</h2>
                <p>Recent VIM results, laid out like a little matchday wall rather than another spreadsheet.</p>
            </div>

            <div class="vsl-results-grid" id="tour-results">
                <% if (vslRecent.length) { %>
                    <% vslRecent.forEach((r) => { %>
