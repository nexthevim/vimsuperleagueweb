<!-- MULTI-TIER DUAL CONVEYOR CARDS DISPLAY -->
        <% if(players.length > 0) { %>
            <% 
                let fullList = players.length < 6 ? [...players, ...players, ...players, ...players] : [...players, ...players]; 
                let tier1 = fullList.slice(0, Math.ceil(fullList.length / 2));
                let tier2 = fullList.slice(Math.ceil(fullList.length / 2));
                let tiers = [
                    { list: tier1, anim: 'animate-conveyor-1', label: 'Top Tier Prospects' },
                    { list: tier2, anim: 'animate-conveyor-2', label: 'Midfield, Defensive Anchors & Free Agents' }
                ];
            %>

            <div class="mk-lanes mb-20">
                <% tiers.forEach((t, idx) => { %>
                    <div class="mk-lane">
                        <div class="mk-lane-label"><span><%= t.label %></span></div>
                        <div class="<%= t.anim %> gap-7 px-5" id="cardContainer<%= idx %>">
                            <% t.list.forEach(p => { %>
                                <% 
                                    let posClass = 'pos-pro';
                                    let pos = (p.position || 'PRO').toUpperCase();
                                    if(pos === 'FWD' || pos === 'FORWARD') posClass = 'pos-fwd';
                                    else if(pos === 'MID' || pos === 'MIDFIELD') posClass = 'pos-mid';
                                    else if(pos === 'DEF' || pos === 'DEFENSE') posClass = 'pos-def';
                                    else if(pos === 'GK' || pos === 'GOALKEEPER') posClass = 'pos-gk';

                                    let rankClass = 'rank-c';
                                    let rank = (p.rank || 'C').toUpperCase();
                                    if(rank === 'SS') rankClass = 'rank-ss';
                                    else if(rank === 'S') rankClass = 'rank-s';
                                    else if(rank === 'A') rankClass = 'rank-a';
                                    else if(rank === 'B') rankClass = 'rank-b';

                                    let pId = p._id || p.id || '';

                                    // VSL Season 4: manager accounts are never auctionable, and
                                    // every other player gets a manager-specific status badge.
                                    let isMgrAccount = (typeof managerPlayerNames !== 'undefined' && managerPlayerNames.includes((p.name || '').toLowerCase()));

                                    let myBadge = null;
                                    if (!isMgrAccount && typeof isManager !== 'undefined' && isManager && typeof myAuctionState !== 'undefined' && myAuctionState) {
                                        const amWinning = Number(p.highestBid || 0) > 0 && (p.highestBidder || '').toLowerCase() === myAuctionState.team.name.toLowerCase();
                                        const amOutbid = myAuctionState.outbidPlayerIds.includes(String(pId));
                                        if (amWinning) myBadge = 'winning';
                                        else if (amOutbid) myBadge = 'outbid';
                                        else if (typeof myEligibility !== 'undefined' && myEligibility && myEligibility[String(pId)] === false) myBadge = 'ineligible';
                                    }

                                    let isWatched = (typeof user !== 'undefined' && user && Array.isArray(user.watchlist) && user.watchlist.map(String).includes(String(pId)));
                                    let eligibleAttr = (typeof myEligibility !== 'undefined' && myEligibility) ? (myEligibility[String(pId)] === true) : true;
                                %>
                                <div class="player-card card-item w-[260px] h-[350px] glass-light rounded-[28px] border border-slate-200 shadow-md flex-shrink-0 relative group"
                                     data-name="<%= p.name.toLowerCase() %>"
                                     data-search="<%= ((p.name || '') + ' ' + (p.discord || '') + ' ' + (p.country || '')).toLowerCase() %>"
                                     data-pos="<%= pos %>"
                                     data-class="<%= rank %>"
                                     data-eligible="<%= eligibleAttr %>"
                                      
                                     onmouseleave="resetTilt(this)"
                                     onmousemove="tiltCard(event, this)" onclick="openBio(this, '<%= p.name %>', '<%= p.cardImage %>', `<%= (p.experience || p.bio || '').toString().replace(/`/g, '').replace(/\\/g, '') %>`, '<%= p.discord %>', '<%= p.goals || 0 %>', '<%= p.assists || 0 %>', '<%= p.saves || 0 %>', '<%= p.mvps || 0 %>', '<%= p.views ? p.views.length : 0 %>', '<%= p.position %>', '<%= p.country %>', '<%= p.timezone %>', '<%= p.highestBid || 0 %>', '<%= p.highestBidder || 'None' %>', '<%= pId %>', '<%= p.reservePrice || 0 %>', <%- isMgrAccount %>, <%- isWatched %>)">
                                    
                                    <!-- Shiny Dynamic Sweeping Glare -->
                                    <div class="card-sheen"></div>

                                    <% if (p.cardImage && p.cardImage.trim() !== "") { %>
                                        <img src="<%= p.cardImage %>" class="card-img w-full h-full object-cover">
                                    <% } else { %>
                                        <div class="card-img w-full h-full bg-gradient-to-b from-slate-100 to-slate-200 flex items-center justify-center relative">
                                            <span class="absolute top-10 text-[64px] font-black italic text-slate-300/40 select-none uppercase tracking-tighter"><%= p.position || 'PRO' %></span>
                                            <svg class="w-24 h-24 text-slate-300" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                                        </div>
                                    <% } %>

                                    <!-- MANAGER BADGE (not auctionable) -->
                                    <% if (isMgrAccount) { %>
                                        <div class="absolute top-4 right-4 z-30">
                                            <span class="bg-slate-900 text-white text-[9px] font-black px-2.5 py-1 rounded-xl uppercase shadow-lg tracking-wider border border-white/20">👔 MANAGER</span>
                                        </div>
                                    <% } else { %>
                                        <!-- WATCHLIST STAR (managers only) -->
                                        <% if (typeof isManager !== 'undefined' && isManager) { %>
                                            <button type="button"
                                                onclick="event.stopPropagation(); toggleWatchlistStar(this, '<%= pId %>')"
                                                data-watching="<%= isWatched %>"
                                                class="watchlist-star-btn absolute top-4 right-4 z-30 w-8 h-8 rounded-full flex items-center justify-center text-base transition-all shadow-lg border border-white/30 <%= isWatched ? 'bg-amber-400 text-white' : 'bg-black/30 text-white/80 hover:bg-black/50' %>">
                                                <%= isWatched ? '★' : '☆' %>
                                            </button>
                                        <% } %>

                                        <!-- MY STATUS BADGE (winning / outbid / ineligible) -->
                                        <% if (myBadge === 'winning') { %>
                                            <div class="absolute top-4 left-4 z-30">
                                                <span class="bg-emerald-500 text-white text-[9px] font-black px-2.5 py-1 rounded-xl uppercase shadow-lg tracking-wider">🟢 Winning</span>
                                            </div>
                                        <% } else if (myBadge === 'outbid') { %>
                                            <div class="absolute top-4 left-4 z-30">
                                                <span class="bg-rose-500 text-white text-[9px] font-black px-2.5 py-1 rounded-xl uppercase shadow-lg tracking-wider">🔴 Outbid</span>
                                            </div>
                                        <% } else if (myBadge === 'ineligible') { %>
                                            <div class="absolute top-4 left-4 z-30">
                                                <span class="bg-slate-600 text-white text-[9px] font-black px-2.5 py-1 rounded-xl uppercase shadow-lg tracking-wider">⚠️ Ineligible</span>
                                            </div>
                                        <% } %>
                                    <% } %>

                                    <!-- RANK BADGE AT BOTTOM RIGHT ON HOVER / ALWAYS VISIBLE -->
                                    <div class="absolute bottom-4 right-4 z-20 transition-all duration-300 transform group-hover:scale-110">
                                        <span class="<%= rankClass %> text-[10px] font-black px-2.5 py-1 rounded-xl uppercase shadow-lg tracking-wider border border-white/20"><%= rank %> RANK</span>
                                    </div>

                                    <!-- Card Overlays -->
                                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent p-5 flex flex-col justify-end z-10">
                                        <div class="flex justify-between items-center mb-1">
                                            <span class="<%= posClass %> text-[9px] font-black px-2.5 py-1 rounded-lg italic uppercase shadow-sm tracking-wide"><%= p.position || 'PRO' %></span>
                                            <div class="flex items-center gap-1 bg-white/20 backdrop-filter blur-md px-2 py-0.5 rounded-md border border-white/20">
                                                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                                <span class="text-[9px] text-white font-black"><%= p.views ? p.views.length : 0 %></span>
                                            </div>
                                        </div>
                                        
                                        <h3 class="font-black text-2xl italic uppercase tracking-tighter text-white drop-shadow-md"><%= p.name %></h3>
                                        
                                        <!-- Highest Bid Info in Market -->
                                        <div class="mt-1 flex items-center justify-between text-[9px] font-black text-emerald-400">
                                            <span>TOP BID: <%= p.highestBid ? p.highestBid + ' Vollars' : 'No Bids' %></span>
                                            <% if (p.highestBidder) { %>
                                                <span class="text-slate-300 text-[8px] uppercase truncate max-w-[90px]">(<%= p.highestBidder %>)</span>
                                            <% } %>
                                        </div>

                                        <!-- Stat Strip Preview -->
                                        <div class="grid grid-cols-4 gap-1 mt-2 pt-2 border-t border-white/15 text-center">
                                            <div><p class="text-[7px] font-black text-white/50 uppercase">G</p><p class="text-xs font-black text-white"><%= p.goals || 0 %></p></div>
                                            <div><p class="text-[7px] font-black text-white/50 uppercase">A</p><p class="text-xs font-black text-white"><%= p.assists || 0 %></p></div>
                                            <div><p class="text-[7px] font-black text-white/50 uppercase">S</p><p class="text-xs font-black text-white"><%= p.saves || 0 %></p></div>
                                            <div><p class="text-[7px] font-black text-blue-400 uppercase">MVP</p><p class="text-xs font-black text-blue-400"><%= p.mvps || 0 %></p></div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>


    <% if (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.status === 'soft_lock') { %>
        <div class="max-w-7xl mx-auto px-6 mb-4">
            <div class="bg-violet-50 border border-violet-200 text-violet-900 rounded-2xl px-5 py-3 flex items-center gap-3 shadow-sm">
