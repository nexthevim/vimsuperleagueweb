        {
            keywords: ['match', 'matches', 'fixture', 'fixtures', 'schedule', 'game'],
            response: `The <strong>Matches</strong> hub covers fixtures, live scores, and reports.<br><br><a href="/matches">Open Matches →</a>`
        },
        {
            keywords: ['metric', 'metrics', 'stats', 'statistics', 'leaderboard'],
            response: `<strong>Metrics</strong> tracks league performance and leaderboards.<br><br><a href="/metrics">Open Metrics →</a>`
        },
        {
            keywords: ['record', 'records', 'history', 'achievement'],
            response: `<strong>League Records</strong> holds historic awards and milestones.<br><br><a href="/league-records">Open Records →</a>`
        },
        {
            keywords: ['info', 'information', 'rules', 'handbook', 'what is vim', 'how does vim'],
            response: `<strong>VIM Super League</strong> — market, fixtures, stats, records, and community in one place.<br><br><a href="/info">League Info →</a>`
        },
        {
