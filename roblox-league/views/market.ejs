<script>
    // MODE SWITCHER LOGIC (MARKET vs AUCTION HUB)
    function switchMode(mode) {
        const mSec = document.getElementById('marketSection');
        const aSec = document.getElementById('auctionSection');
        const mBtn = document.getElementById('viewMarketBtn');
        const aBtn = document.getElementById('viewAuctionBtn');
        const sWrap = document.getElementById('searchWrapper');
        const fWrap = document.getElementById('filterWrapper');
        const cWrap = document.getElementById('countWrapper');

        if(mode === 'auction') {
            mSec.classList.add('hidden');
            aSec.classList.remove('hidden');
            aBtn.className = 'px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-white text-slate-900 shadow-sm';
            mBtn.className = 'px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 text-slate-500 hover:text-slate-900';
            if(sWrap) sWrap.classList.add('hidden');
            if(fWrap) fWrap.classList.add('hidden');
            if(cWrap) cWrap.classList.add('hidden');
        } else {
            aSec.classList.add('hidden');
            mSec.classList.remove('hidden');
            mBtn.className = 'px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-white text-slate-900 shadow-sm';
            aBtn.className = 'px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 text-slate-500 hover:text-slate-900';
            if(sWrap) sWrap.classList.remove('hidden');
            if(fWrap) fWrap.classList.remove('hidden');
            if(cWrap) cWrap.classList.remove('hidden');
        }
    }

    // AUCTION TEAM SELECTION LOGIC
    function selectAuctionTeam(teamId) {
        document.querySelectorAll('.team-tile').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.team-tile').forEach(el => el.classList.add('border-slate-200'));
        document.querySelectorAll('.team-details-panel').forEach(el => el.classList.add('hidden'));

        const targetTile = document.getElementById('teamTile-' + teamId);
        const targetPanel = document.getElementById('teamDetails-' + teamId);

        if(targetTile) {
            targetTile.classList.add('active');
            targetTile.classList.remove('border-slate-200');
        }
        if(targetPanel) {
            targetPanel.classList.remove('hidden');
            targetPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    }

    // AUCTION TEAM SUB-TAB LOGIC (BIDDING VS ROSTER)
    function switchTeamSubTab(teamId, tabType) {
        const biddingTab = document.getElementById('subTab-bidding-' + teamId);
        const rosterTab = document.getElementById('subTab-roster-' + teamId);
        const biddingBtn = document.getElementById('tabBtn-bidding-' + teamId);
        const rosterBtn = document.getElementById('tabBtn-roster-' + teamId);

        if(tabType === 'roster') {
            biddingTab.classList.add('hidden');
            rosterTab.classList.remove('hidden');
            rosterBtn.className = 'px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-slate-900 text-white transition';
            biddingBtn.className = 'px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider text-slate-400 hover:text-slate-900 transition';
        } else {
            rosterTab.classList.add('hidden');
            biddingTab.classList.remove('hidden');
            biddingBtn.className = 'px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-slate-900 text-white transition';
            rosterBtn.className = 'px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider text-slate-400 hover:text-slate-900 transition';
        }
    }

    // FORM TOGGLE
    function toggleAuth() {
        document.getElementById('registerBox').classList.toggle('hidden-form');
        document.getElementById('loginBox').classList.toggle('hidden-form');
    }

    // SEARCH & POSITION FILTERING LOGIC
    let activePosFilter = 'ALL';
    let activeClassFilter = 'ALL';
    let eligibleOnly = false;

    function setFilter(pos) {
        activePosFilter = pos;
        document.querySelectorAll('.filter-btn[data-pos-filter]').forEach(btn => {
            if(btn.dataset.posFilter === pos) {
                btn.className = 'filter-btn active text-[10px] font-black px-3.5 py-1.5 rounded-xl transition bg-slate-900 text-white';
            } else {
                btn.className = 'filter-btn text-[10px] font-black px-3.5 py-1.5 rounded-xl text-slate-500 hover:text-slate-900 transition';
            }
        });
        filterCards();
    }

    function setClassFilter(cls) {
        activeClassFilter = cls;
        document.querySelectorAll('.filter-btn[data-class-filter]').forEach(btn => {
            if(btn.dataset.classFilter === cls) {
                btn.className = 'filter-btn active text-[10px] font-black px-3.5 py-1.5 rounded-xl transition bg-slate-900 text-white';
            } else {
                btn.className = 'filter-btn text-[10px] font-black px-3.5 py-1.5 rounded-xl text-slate-500 hover:text-slate-900 transition';
            }
        });
        filterCards();
    }

    function toggleEligibleFilter() {
        eligibleOnly = !eligibleOnly;
        const btn = document.getElementById('eligibleFilterBtn');
        if (btn) {
            btn.className = eligibleOnly
                ? 'text-[10px] font-black px-3.5 py-1.5 rounded-xl transition bg-emerald-600 text-white'
                : 'text-[10px] font-black px-3.5 py-1.5 rounded-xl transition text-emerald-600 hover:bg-emerald-50';
        }
        filterCards();
    }

    function filterCards() {
        const query = document.getElementById('searchInput').value.toLowerCase().trim().replace(/^@/, '');
        const cards = document.querySelectorAll('.card-item');

        cards.forEach(card => {
            const searchBlob = card.getAttribute('data-search') || card.getAttribute('data-name') || '';
            const pos = card.getAttribute('data-pos');
            const cls = card.getAttribute('data-class') || 'C';
            const eligible = card.getAttribute('data-eligible');

            const matchesSearch = searchBlob.includes(query);
            const matchesPos = activePosFilter === 'ALL' || pos.includes(activePosFilter);
            const matchesClass = activeClassFilter === 'ALL' || cls === activeClassFilter;
            const matchesEligible = !eligibleOnly || eligible === 'true';

            if (matchesSearch && matchesPos && matchesClass && matchesEligible) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }

    // 3D DYNAMIC MOUSE TILT & INSPECT SHINE EFFECT
    function tiltCard(e, el) {
        const rect = el.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const xc = rect.width / 2;
        const yc = rect.height / 2;
        const dx = (x - xc) / xc;
        const dy = (y - yc) / yc;
        el.style.transform = `rotateY(${dx * 14}deg) rotateX(${-dy * 14}deg) translateY(-6px)`;
    }

    function resetTilt(el) {
        el.style.transform = `rotateY(0deg) rotateX(0deg) translateY(0px)`;
    }

    // FIFA MODAL LOGIC WITH POSITION COLOR MAPPING & AUCTION BID DATA
    async function openBio(el, name, img, bio, discord, g, a, s, m, currentViews, pos, country, tz, highestBid, bidder, playerId, reservePrice, isMgrAccount, isWatched) {
        el.classList.add('card-active-anim');

        window.currentModalPlayerId = playerId;

        document.getElementById('modalName').innerText = name;

        // MANAGER ACCOUNTS: never auctionable — swap the whole bidding
        // section for a clear notice instead of a bid form.
        const mgrNotice = document.getElementById('modalManagerNotice');
        const biddingBox = document.getElementById('modalBiddingBox');
        if (mgrNotice && biddingBox) {
            if (isMgrAccount) {
                mgrNotice.classList.remove('hidden');
                biddingBox.classList.add('hidden');
            } else {
                mgrNotice.classList.add('hidden');
                biddingBox.classList.remove('hidden');
            }
        }

        const modalStar = document.getElementById('modalWatchlistStar');
        if (modalStar) {
            if (isMgrAccount) {
                modalStar.classList.add('hidden');
            } else {
                modalStar.classList.remove('hidden');
                modalStar.dataset.watching = isWatched ? 'true' : 'false';
                modalStar.textContent = isWatched ? '★' : '☆';
                modalStar.className = 'absolute top-4 right-4 z-30 w-10 h-10 rounded-full flex items-center justify-center text-lg transition-all shadow-lg border border-white/30 ' +
                    (isWatched ? 'bg-amber-400 text-white' : 'bg-black/30 text-white/80 hover:bg-black/50');
            }
        }
        
        const modalImg = document.getElementById('modalImg');
        const placeholder = document.getElementById('modalImgPlaceholder');
        if(img && img.trim() !== "" && img !== "undefined") {
            modalImg.src = img;
            modalImg.style.display = "block";
            placeholder.style.display = "none";
        } else {
            modalImg.style.display = "none";
            placeholder.style.display = "flex";
        }

        document.getElementById('modalBio').innerText = bio;
        document.getElementById('modalDiscord').innerText = "@" + discord;
        
        // Dynamic Badge Styling in Modal
        const posBadge = document.getElementById('modalPosBadge');
        const posUpper = (pos || 'PRO').toUpperCase();
        posBadge.innerText = posUpper;
        
        let posClass = 'pos-pro';
        if(posUpper === 'FWD' || posUpper === 'FORWARD') posClass = 'pos-fwd';
        else if(posUpper === 'MID' || posUpper === 'MIDFIELD') posClass = 'pos-mid';
        else if(posUpper === 'DEF' || posUpper === 'DEFENSE') posClass = 'pos-def';
        else if(posUpper === 'GK' || posUpper === 'GOALKEEPER') posClass = 'pos-gk';
        
        posBadge.className = `${posClass} text-white text-[10px] font-black px-3 py-1 rounded-lg italic uppercase tracking-wider`;

        document.getElementById('modalCountryBadge').innerText = country || 'UNKNOWN';
        document.getElementById('modalTZ').innerText = "TIMEZONE: " + (tz || 'N/A');
        
        document.getElementById('mGoals').innerText = g;
        document.getElementById('mAssists').innerText = a;
        document.getElementById('mSaves').innerText = s;
        document.getElementById('mMvps').innerText = m;
        document.getElementById('modalViews').innerText = currentViews;

        // Set Auction Details in Modal safely
        const hBid = (highestBid && highestBid !== 'undefined' && highestBid !== 'null') ? highestBid : '0';
        const hBidder = (bidder && bidder !== 'undefined' && bidder !== 'null' && bidder !== 'None') ? bidder : null;
        const rPrice = (reservePrice && reservePrice !== 'undefined' && reservePrice !== 'null') ? reservePrice : '0';

        if(document.getElementById('modalHighestBid')) {
    document.getElementById('modalHighestBid').innerText = hBid + " Vollars" + (hBidder ? " (" + hBidder + ")" : "");
}
if(document.getElementById('modalReservePrice')) {
    document.getElementById('modalReservePrice').innerText = rPrice + " Vollars";
}
if(document.getElementById('modalPlayerId')) {
    document.getElementById('modalPlayerId').value = (playerId && playerId !== 'undefined' && playerId !== 'null') ? playerId : '';
}
if(document.getElementById('modalWithdrawPlayerId')) {
    document.getElementById('modalWithdrawPlayerId').value =
        (playerId && playerId !== 'undefined' && playerId !== 'null') ? playerId : '';
}
if(document.getElementById('modalBidInput')) {
    const minNextBid = computeMinNextBid(parseInt(hBid) || 0, parseInt(rPrice) || 0);
    document.getElementById('modalBidInput').min = minNextBid;
    document.getElementById('modalBidInput').placeholder = `Min bid: ${minNextBid.toLocaleString()} Vollars`;
    document.getElementById('modalBidInput').value = '';
    renderQuickBidButtons(minNextBid, parseInt(hBid) || 0);
}
// Reset the bid button back to its default "Place Bid" state every time
// the modal is opened, so a previous "Update Bid" edit-mode doesn't stick.
const resetBidBtn = document.getElementById('modalBidButton');
if (resetBidBtn) {
    resetBidBtn.innerText = 'Place Bid';
    resetBidBtn.classList.remove('bg-amber-500', 'hover:bg-amber-400');
    resetBidBtn.classList.add('bg-slate-900', 'hover:bg-slate-800');
}

try {
    const response = await fetch(`/market/view/${name}`, { method: 'POST' });
    const data = await response.json();
    if(data.success) {
        document.getElementById('modalViews').innerText = data.count;
    }
} catch(e) {
    console.error("View count update failed", e);
}

setTimeout(() => {
    const modal = document.getElementById('bioModal');
    const container = document.getElementById('modalContainer');
    modal.style.display = 'flex';
    setTimeout(() => {
        modal.classList.add('active');
        container.classList.add('show');
        el.classList.remove('card-active-anim');
    }, 50);
}, 350);
}

function editCurrentBid() {
    const bidInput = document.getElementById('modalBidInput');
    const bidButton = document.getElementById('modalBidButton');

    if (!bidInput || !bidButton) return;

    bidInput.focus();
    bidInput.select();

    bidButton.innerText = 'Update Bid';
    bidButton.classList.remove('bg-slate-900', 'hover:bg-slate-800');
    bidButton.classList.add('bg-amber-500', 'hover:bg-amber-400');
}

// Mirrors the server's BID_INCREMENT_TIERS purely for instant UI feedback
// (quick-bid buttons, placeholder text) — /auction/bid re-validates for real.
function getClientMinIncrement(amount) {
    if (amount < 5000) return 100;
    if (amount < 20000) return 250;
    return 500;
}

function computeMinNextBid(currentHigh, reservePrice) {
    if (currentHigh > 0) {
        const step = getClientMinIncrement(currentHigh);
        return Math.ceil((currentHigh + step) / step) * step;
    }
    return reservePrice;
}

function renderQuickBidButtons(minNextBid, currentHigh) {
    const wrap = document.getElementById('modalQuickBidRow');
    if (!wrap) return;

    const step = getClientMinIncrement(currentHigh || minNextBid);
    const options = [minNextBid, minNextBid + step, minNextBid + step * 2];

    wrap.innerHTML = options.map(amt =>
        `<button type="button" onclick="setBidAmount(${amt})" class="flex-1 bg-slate-100 hover:bg-slate-900 hover:text-white text-slate-700 text-[10px] font-black py-2 rounded-lg uppercase tracking-wider transition">+${(amt - currentHigh).toLocaleString()}<span class="block text-[8px] opacity-70">${amt.toLocaleString()}</span></button>`
    ).join('');
}

function setBidAmount(amount) {
    const input = document.getElementById('modalBidInput');
    if (input) input.value = amount;
}

// WATCHLIST — works from both the market grid star and the modal star.
async function toggleWatchlistStar(btn, playerId) {
    try {
        const res = await fetch('/auction/watchlist/toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ playerId })
        });
        const data = await res.json();

        if (!data.success) {
            alert(data.error || 'Could not update watchlist.');
            return;
        }

        const watching = data.watching;

        // Update every star for this player on the page (grid can have
        // duplicate cards from the scrolling conveyor effect).
        document.querySelectorAll(`.watchlist-star-btn[onclick*="'${playerId}'"]`).forEach(el => {
            el.dataset.watching = watching ? 'true' : 'false';
            el.textContent = watching ? '★' : '☆';
            el.className = 'watchlist-star-btn absolute top-4 right-4 z-30 w-8 h-8 rounded-full flex items-center justify-center text-base transition-all shadow-lg border border-white/30 ' +
                (watching ? 'bg-amber-400 text-white' : 'bg-black/30 text-white/80 hover:bg-black/50');
        });

        if (btn && btn.id === 'modalWatchlistStar') {
            btn.dataset.watching = watching ? 'true' : 'false';
            btn.textContent = watching ? '★' : '☆';
            btn.className = 'absolute top-4 right-4 z-30 w-10 h-10 rounded-full flex items-center justify-center text-lg transition-all shadow-lg border border-white/30 ' +
                (watching ? 'bg-amber-400 text-white' : 'bg-black/30 text-white/80 hover:bg-black/50');
        }

    } catch (e) {
        console.error('Watchlist toggle failed', e);
    }
}

function closeBio() { 
    const modal = document.getElementById('bioModal');
    const container = document.getElementById('modalContainer');
    container.classList.remove('show');
    modal.classList.remove('active');
    setTimeout(() => { modal.style.display = 'none'; }, 350);
}

</script>
