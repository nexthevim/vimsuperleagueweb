<script>
(function () {

    // A broad but not exhaustive list of languages Google Translate supports.
    const VIM_LANGUAGES = [
        { code: 'en', name: 'English' },
        { code: 'es', name: 'Spanish' },
        { code: 'fr', name: 'French' },
        { code: 'de', name: 'German' },
        { code: 'it', name: 'Italian' },
        { code: 'pt', name: 'Portuguese' },
        { code: 'nl', name: 'Dutch' },
        { code: 'ru', name: 'Russian' },
        { code: 'zh-CN', name: 'Chinese (Simplified)' },
        { code: 'zh-TW', name: 'Chinese (Traditional)' },
        { code: 'ja', name: 'Japanese' },
        { code: 'ko', name: 'Korean' },
        { code: 'ar', name: 'Arabic' },
        { code: 'hi', name: 'Hindi' },
        { code: 'bn', name: 'Bengali' },
        { code: 'ur', name: 'Urdu' },
        { code: 'tr', name: 'Turkish' },
        { code: 'vi', name: 'Vietnamese' },
        { code: 'th', name: 'Thai' },
        { code: 'id', name: 'Indonesian' },
        { code: 'ms', name: 'Malay' },
        { code: 'fil', name: 'Filipino' },
        { code: 'pl', name: 'Polish' },
        { code: 'uk', name: 'Ukrainian' },
        { code: 'ro', name: 'Romanian' },
        { code: 'el', name: 'Greek' },
        { code: 'cs', name: 'Czech' },
        { code: 'sv', name: 'Swedish' },
        { code: 'da', name: 'Danish' },
        { code: 'fi', name: 'Finnish' },
        { code: 'no', name: 'Norwegian' },
        { code: 'hu', name: 'Hungarian' },
        { code: 'he', name: 'Hebrew' },
        { code: 'fa', name: 'Persian' },
        { code: 'sw', name: 'Swahili' },
        { code: 'ta', name: 'Tamil' },
        { code: 'te', name: 'Telugu' },
        { code: 'mr', name: 'Marathi' },
        { code: 'gu', name: 'Gujarati' },
        { code: 'pa', name: 'Punjabi' },
        { code: 'ml', name: 'Malayalam' },
        { code: 'kn', name: 'Kannada' },
        { code: 'si', name: 'Sinhala' },
        { code: 'ne', name: 'Nepali' },
        { code: 'my', name: 'Burmese' },
        { code: 'km', name: 'Khmer' },
        { code: 'lo', name: 'Lao' },
        { code: 'am', name: 'Amharic' },
        { code: 'af', name: 'Afrikaans' },
        { code: 'sr', name: 'Serbian' },
        { code: 'hr', name: 'Croatian' },
        { code: 'bg', name: 'Bulgarian' },
        { code: 'sk', name: 'Slovak' },
        { code: 'sl', name: 'Slovenian' },
        { code: 'lt', name: 'Lithuanian' },
        { code: 'lv', name: 'Latvian' },
        { code: 'et', name: 'Estonian' }
    ];

    const listEl = document.getElementById('vim-lang-list');
    const searchEl = document.getElementById('vim-lang-search');
    const currentEl = document.getElementById('vim-lang-current');
    const menuEl = document.getElementById('vim-lang-menu');
    const buttonEl = document.getElementById('vim-lang-button');

    if (!listEl || !searchEl || !currentEl || !menuEl || !buttonEl) return;

    function getActiveLangCode() {
        const match = document.cookie.match(/googtrans=\/en\/([a-zA-Z-]+)/);
        return match ? match[1] : 'en';
    }

    function renderList(filterText) {
        const activeCode = getActiveLangCode();
        const term = (filterText || '').trim().toLowerCase();

        listEl.innerHTML = '';

        VIM_LANGUAGES
            .filter(lang => !term || lang.name.toLowerCase().includes(term) || lang.code.toLowerCase().includes(term))
            .forEach(lang => {
                const row = document.createElement('button');
                row.type = 'button';
                row.className =
                    'w-full text-left px-3 py-2 rounded-xl text-xs font-bold flex items-center justify-between transition ' +
                    (lang.code === activeCode
                        ? 'bg-slate-900 dark:bg-white text-white dark:text-slate-900'
                        : 'text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800');

                row.innerHTML =
                    '<span>' + lang.name + '</span>' +
                    '<span class="opacity-50 uppercase text-[9px]">' + lang.code + '</span>';

                row.addEventListener('click', function () {
                    vimSetLanguage(lang.code);
                });

                listEl.appendChild(row);
            });

        if (!listEl.children.length) {
            listEl.innerHTML = '<p class="text-[10px] text-slate-400 uppercase font-bold text-center py-4">No matches</p>';
        }
    }

    window.vimFilterLangList = function () {
        renderList(searchEl.value);
    };

    window.vimSetLanguage = function (code) {
        const domain = window.location.hostname;
        const value = 'en|' + code;

        // Set with and without an explicit domain so it sticks whether the
        // site is served from a bare domain, a subdomain, or localhost.
        document.cookie = 'googtrans=/en/' + code + '; path=/';
        document.cookie = 'googtrans=/en/' + code + '; path=/; domain=' + domain;
        document.cookie = 'googtrans=/en/' + code + '; path=/; domain=.' + domain;

        window.location.reload();
    };

    window.vimToggleLangMenu = function () {
        const isHidden = menuEl.classList.contains('hidden');

        if (isHidden) {
            menuEl.classList.remove('hidden');
            searchEl.value = '';
            renderList('');
            setTimeout(function () { searchEl.focus(); }, 30);
        } else {
            menuEl.classList.add('hidden');
        }
    };

    document.addEventListener('click', function (event) {
        const switcher = document.getElementById('vim-lang-switcher');
        if (switcher && !switcher.contains(event.target)) {
            menuEl.classList.add('hidden');
        }
    });

    // Reflect the currently-active language (if any) in the pill button.
    const activeLang = VIM_LANGUAGES.find(l => l.code === getActiveLangCode());
    currentEl.textContent = activeLang ? activeLang.code.toUpperCase() : 'EN';

    renderList('');
})();
</script>


