<%- include('partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
    --pf-paper: #f7f4ed;
    --pf-paper-2: #fffdf8;
    --pf-ink: #123b3c;
    --pf-ink-deep: #083536;
    --pf-teal: #07595a;
    --pf-coral: #f18470;
    --pf-coral-dark: #dc6957;
    --pf-mint: #d9ece6;
    --pf-muted: #728081;
    --pf-line: rgba(18,59,60,.12);
    --pf-display: "DM Serif Display", Georgia, serif;
    --pf-body: "Manrope", system-ui, sans-serif;
}

#profile-page {
    font-family: var(--pf-body);
    background: var(--pf-paper);
    color: var(--pf-ink);
    min-height: 100vh;
    padding: 5.5rem 1.1rem 3.5rem;
    -webkit-font-smoothing: antialiased;
}

html.dark #profile-page {
    background: #0e1210;
    color: #e8ece9;
}

.pf-shell {
    width: min(1180px, 100%);
    margin: 0 auto;
}

.pf-display {
    font-family: var(--pf-display);
    font-weight: 400;
    letter-spacing: -.02em;
}

.pf-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--pf-coral-dark);
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
}
.pf-eyebrow::before {
    content: "";
    width: 16px;
    height: 1px;
    background: currentColor;
}

/* 3D buttons */
.pf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    font-family: inherit;
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
}
.pf-btn:hover { transform: translateY(-3px); }
.pf-btn:active { transform: translateY(2px); }

.pf-btn-coral {
    background: var(--pf-coral);
    color: #fff;
    box-shadow: 0 5px 0 #c95e4e, 0 12px 24px rgba(241,132,112,.25);
}
.pf-btn-coral:hover {
    background: #f48d7a;
    color: #fff;
    box-shadow: 0 3px 0 #c95e4e, 0 14px 28px rgba(241,132,112,.3);
}
.pf-btn-coral:active { box-shadow: 0 2px 0 #c95e4e, 0 6px 12px rgba(241,132,112,.2); }

.pf-btn-teal {
    background: var(--pf-teal);
    color: #fff;
    box-shadow: 0 5px 0 #043d3e, 0 12px 24px rgba(7,89,90,.2);
}
.pf-btn-teal:hover {
    background: #096565;
    color: #fff;
    box-shadow: 0 3px 0 #043d3e, 0 14px 28px rgba(7,89,90,.28);
}
.pf-btn-teal:active { box-shadow: 0 2px 0 #043d3e, 0 6px 12px rgba(7,89,90,.18); }

.pf-btn-ghost {
    background: transparent;
    color: var(--pf-ink);
    border: 1.5px solid var(--pf-line);
    box-shadow: 0 4px 0 rgba(18,59,60,.06);
}
.pf-btn-ghost:hover {
    background: rgba(18,59,60,.04);
    color: var(--pf-ink);
}
html.dark .pf-btn-ghost {
    color: #e8ece9;
    border-color: rgba(255,255,255,.14);
    box-shadow: 0 4px 0 rgba(0,0,0,.25);
}

.pf-btn-danger {
    background: #fff;
    color: #b91c1c;
    border: 1.5px solid rgba(185,28,28,.25);
    box-shadow: 0 4px 0 rgba(185,28,28,.12);
}
.pf-btn-danger:hover {
    background: #fef2f2;
    color: #991b1b;
}

/* Cards with soft curve */
.pf-card {
    background: var(--pf-paper-2);
    border: 1px solid var(--pf-line);
    border-radius: 1.35rem;
    padding: 1.35rem 1.4rem;
    box-shadow: 0 10px 28px rgba(18,59,60,.05);
}
html.dark .pf-card {
    background: #151a18;
    border-color: rgba(255,255,255,.08);
    box-shadow: 0 10px 28px rgba(0,0,0,.25);
}

.pf-card-h {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
}
.pf-card-h h2, .pf-card-h h3 {
    margin: 0;
    font-size: 0.95rem;
    color: var(--pf-ink-deep);
}
html.dark .pf-card-h h2, html.dark .pf-card-h h3 { color: #f0f4f1; }

/* Header */
.pf-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.35rem;
    border-bottom: 1px solid var(--pf-line);
}
html.dark .pf-hero { border-bottom-color: rgba(255,255,255,.08); }

.pf-hero h1 {
    margin: 0.35rem 0 0.25rem;
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    line-height: 0.95;
    color: var(--pf-ink-deep);
}
html.dark .pf-hero h1 { color: #f2f6f3; }
.pf-hero h1 em {
    font-style: italic;
    color: var(--pf-teal);
}
.pf-hero p {
    margin: 0;
    color: var(--pf-muted);
    font-size: 0.85rem;
}

/* Stat tiles */
.pf-stat-grid {
    display: grid;
    grid-cols: 2;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
}
@media (min-width: 640px) {
    .pf-stat-grid.four { grid-template-columns: repeat(4, 1fr); }
}
.pf-stat {
    text-align: center;
    padding: 1rem 0.75rem;
    border-radius: 1.1rem;
    background: var(--pf-paper);
    border: 1px solid var(--pf-line);
}
html.dark .pf-stat {
    background: #101412;
    border-color: rgba(255,255,255,.07);
}
.pf-stat span {
    display: block;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pf-muted);
}
.pf-stat strong {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--pf-display);
    font-size: 1.65rem;
    font-style: italic;
    color: var(--pf-ink-deep);
}
html.dark .pf-stat strong { color: #f0f4f1; }
.pf-stat strong.em { color: #059669; }

/* Player card frame */
.pf-card-frame {
    position: relative;
    aspect-ratio: 3/4;
    border-radius: 1.25rem;
    overflow: hidden;
    background: #0a0f0e;
    border: 1px solid rgba(18,59,60,.2);
    box-shadow: 0 18px 40px rgba(18,59,60,.15);
}
.pf-card-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}
.pf-card-frame:hover img { transform: scale(1.04); }
.pf-card-overlay {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 1.25rem 1rem 1rem;
    background: linear-gradient(to top, rgba(0,0,0,.9), transparent);
}
.pf-card-overlay b {
    display: block;
    color: #fff;
    font-size: 1.15rem;
    font-weight: 800;
    text-transform: uppercase;
    font-style: italic;
    line-height: 1.1;
}
.pf-card-overlay span {
    color: #7dd3fc;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

/* Form */
.pf-label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pf-muted);
}
.pf-input, .pf-select, .pf-area {
    width: 100%;
    padding: 0.85rem 1rem;
    border-radius: 0.9rem;
    border: 1.5px solid var(--pf-line);
    background: var(--pf-paper);
    color: var(--pf-ink);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.pf-input:focus, .pf-select:focus, .pf-area:focus {
    border-color: var(--pf-teal);
    box-shadow: 0 0 0 3px rgba(7,89,90,.12);
}
html.dark .pf-input, html.dark .pf-select, html.dark .pf-area {
    background: #101412;
    border-color: rgba(255,255,255,.1);
    color: #e8ece9;
}
.pf-area { resize: vertical; min-height: 110px; line-height: 1.55; }

.pf-grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
}
@media (min-width: 720px) {
    .pf-grid-2 { grid-template-columns: 1fr 1fr; }
}
.pf-grid-3 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
}
@media (min-width: 720px) {
    .pf-grid-3 { grid-template-columns: 1fr 1fr 1fr; }
}

/* Theme pills */
.pf-theme-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.55rem;
}
.theme-btn {
    min-height: 48px;
    border-radius: 999px;
    border: 1.5px solid var(--pf-line);
    background: var(--pf-paper);
    color: var(--pf-ink);
    font-family: inherit;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    box-shadow: 0 4px 0 rgba(18,59,60,.06);
}
.theme-btn:hover { transform: translateY(-2px); }
.theme-btn.is-active {
    background: var(--pf-teal);
    color: #fff;
    border-color: transparent;
    box-shadow: 0 5px 0 #043d3e, 0 10px 20px rgba(7,89,90,.2);
}
html.dark .theme-btn {
    background: #101412;
    border-color: rgba(255,255,255,.1);
    color: #e8ece9;
    box-shadow: 0 4px 0 rgba(0,0,0,.3);
}
html.dark .theme-btn.is-active {
    background: #fff;
    color: #0e1210;
    box-shadow: 0 5px 0 #c5c5c5;
}

/* Manager lists */
.pf-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    max-height: 16rem;
    overflow-y: auto;
}
.pf-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.65rem 0.8rem;
    border-radius: 0.9rem;
    background: var(--pf-paper);
    border: 1px solid var(--pf-line);
}
html.dark .pf-row {
    background: #101412;
    border-color: rgba(255,255,255,.07);
}
.pf-row.win { border-color: rgba(5,150,105,.25); background: rgba(5,150,105,.06); }
.pf-row.out { border-color: rgba(225,29,72,.2); background: rgba(225,29,72,.05); }
.pf-row.ready { border-color: rgba(5,150,105,.35); background: rgba(5,150,105,.1); }
.pf-row.watch { border-color: rgba(217,119,6,.2); background: rgba(217,119,6,.06); }

.pf-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}
.pf-badge-ok { background: rgba(5,150,105,.12); color: #059669; }
.pf-badge-warn { background: rgba(217,119,6,.12); color: #d97706; }
.pf-badge-bad { background: rgba(225,29,72,.12); color: #e11d48; }

.pf-alert {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.95rem 1.05rem;
    border-radius: 1.1rem;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.45;
}
.pf-alert-warn {
    background: rgba(245,158,11,.1);
    border: 1px solid rgba(245,158,11,.25);
    color: #b45309;
}
.pf-alert-bad {
    background: rgba(225,29,72,.08);
    border: 1px solid rgba(225,29,72,.2);
    color: #be123c;
}

.pf-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
}
@media (min-width: 960px) {
    .pf-layout { grid-template-columns: 340px 1fr; gap: 1.5rem; }
}

.pf-section-title {
    margin: 0 0 0.85rem;
    font-size: 1.05rem;
    color: var(--pf-ink-deep);
}
html.dark .pf-section-title { color: #f0f4f1; }

.pf-discord-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    border-radius: 1.25rem;
    background: linear-gradient(135deg, #5865F2, #7289da);
    color: #fff;
    box-shadow: 0 12px 28px rgba(88,101,242,.28);
}
.pf-discord-box h3 {
    margin: 0 0 0.2rem;
    font-size: 1rem;
    font-family: var(--pf-display);
}
.pf-discord-box p {
    margin: 0;
    font-size: 0.78rem;
    opacity: 0.9;
}
.pf-btn-discord {
    background: #fff;
    color: #5865F2;
    box-shadow: 0 5px 0 #d1d5f0, 0 10px 20px rgba(0,0,0,.12);
}
.pf-btn-discord:hover {
    background: #f8f9ff;
    color: #4752c4;
    box-shadow: 0 3px 0 #d1d5f0, 0 12px 24px rgba(0,0,0,.14);
}

.pf-class-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.4rem;
}
.pf-class {
    text-align: center;
    padding: 0.65rem 0.25rem;
    border-radius: 0.85rem;
    background: var(--pf-paper);
    border: 1px solid var(--pf-line);
}
html.dark .pf-class {
    background: #101412;
    border-color: rgba(255,255,255,.07);
}
.pf-class span {
    display: block;
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pf-muted);
}
.pf-class b {
    font-family: var(--pf-display);
    font-size: 1.05rem;
    font-style: italic;
}

.pf-muted { color: var(--pf-muted); font-size: 0.75rem; }
.pf-empty {
    padding: 1rem;
    text-align: center;
    color: var(--pf-muted);
    font-size: 0.8rem;
    font-style: italic;
    font-weight: 600;
}

/* underline link anim */
.pf-link {
    position: relative;
    color: var(--pf-teal);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
}
.pf-link::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1.5px;
    background: var(--pf-teal);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s cubic-bezier(0.22,1,0.36,1);
}
.pf-link:hover::after { transform: scaleX(1); }
</style>

<div id="profile-page">
<div class="pf-shell">

    <!-- HEADER -->
    <header class="pf-hero">
        <div>
            <div class="pf-eyebrow">Your account</div>
            <h1 class="pf-display">Player <em>Hub</em></h1>
            <p>Dashboard, card, and settings — all in one place.</p>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center">
            <a href="/market" class="pf-btn pf-btn-teal">Open market</a>
            <form action="/profile/delete" method="POST" onsubmit="return confirm('Are you sure? This will permanently remove your market card and player stats.')" style="margin:0">
                <button type="submit" class="pf-btn pf-btn-danger">Delete account</button>
            </form>
        </div>
    </header>

    <!-- MANAGER DASHBOARD -->
    <% if (typeof isManager !== 'undefined' && isManager && typeof myAuctionState !== 'undefined' && myAuctionState) { %>
    <section class="pf-card" style="margin-bottom:1.5rem">
        <div class="pf-card-h">
            <div>
                <div class="pf-eyebrow">Manager only</div>
                <h2 class="pf-display pf-section-title" style="margin:0.2rem 0 0">Manager Dashboard — <%= myAuctionState.team.name %></h2>
                <p class="pf-muted" style="margin:0.15rem 0 0">Private to you. No other manager can see this.</p>
            </div>
        </div>

        <div class="pf-stat-grid four" style="margin-bottom:1rem">
            <div class="pf-stat">
                <span>Total budget</span>
                <strong><%= Number(myAuctionState.budget).toLocaleString() %></strong>
            </div>
            <div class="pf-stat">
                <span>Available</span>
                <strong class="em"><%= Number(myAuctionState.availableBudget).toLocaleString() %></strong>
            </div>
            <div class="pf-stat">
                <span>Roster</span>
                <strong><%= myAuctionState.totalPlayers %><span style="font-size:0.7em;opacity:0.5">/<%= myAuctionState.rosterMax %></span></strong>
            </div>
            <div class="pf-stat">
                <span>Slots left</span>
                <strong><%= myAuctionState.remainingSlots.total %></strong>
            </div>
        </div>

        <p class="pf-muted" style="margin:0 0 0.5rem;font-size:0.62rem;font-weight:800;letter-spacing:0.1em;text-transform:uppercase">Class slots</p>
        <div class="pf-class-grid" style="margin-bottom:0.75rem">
            <% ['SS','S','A','B','C'].forEach(k => {
                const has = myAuctionState.caps[k] !== undefined;
                const count = myAuctionState.counts[k] || 0;
                const cap = has ? myAuctionState.caps[k] : null;
            %>
                <div class="pf-class">
                    <span><%= k %></span>
                    <b><%= count %><% if (has) { %><span style="opacity:0.45;font-size:0.75em">/<%= cap %></span><% } %></b>
                </div>
            <% }) %>
        </div>
        <p class="pf-muted" style="margin:0 0 1rem">Caps auto-adjust: 0 SS → 4S/6A · 1 SS → 3S/5A · 2 SS → 2S/3A. Manager = 1 roster slot.</p>

        <% const needMore = Math.max(0, myAuctionState.rosterMin - myAuctionState.totalPlayers); %>
        <% if (needMore > 0) { %>
            <div class="pf-alert pf-alert-warn" style="margin-bottom:0.65rem">
                <span>⚠️</span>
                <p style="margin:0">Roster warning: you still need at least <strong><%= needMore %></strong> more player(s) to hit the <%= myAuctionState.rosterMin %>-player minimum. Available: <%= Number(myAuctionState.availableBudget).toLocaleString() %> V.</p>
            </div>
        <% } %>
        <% if (myAuctionState.availableBudget < 2500 && myAuctionState.totalPlayers < myAuctionState.rosterMin) { %>
            <div class="pf-alert pf-alert-bad" style="margin-bottom:0.65rem">
                <span>🚨</span>
                <p style="margin:0">Budget critical: you may not have enough left to reach the <%= myAuctionState.rosterMin %>-player minimum.</p>
            </div>
        <% } %>

        <div style="display:grid;grid-template-columns:1fr;gap:0.85rem;margin-top:1rem">
            <style>@media(min-width:900px){.pf-mgr-cols{grid-template-columns:1fr 1fr 1fr!important}}</style>
            <div class="pf-mgr-cols" style="display:grid;grid-template-columns:1fr;gap:0.85rem">
                <!-- WINNING -->
                <div class="pf-card" style="padding:1rem;box-shadow:none">
                    <p style="margin:0 0 0.65rem;font-size:0.62rem;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;color:#059669">Currently winning (<%= myAuctionState.provisional.length %>)</p>
                    <% if (myAuctionState.provisional.length > 0) { %>
                        <div class="pf-list">
                            <% myAuctionState.provisional.forEach(({player, amount, isManager}) => { %>
                                <div class="pf-row win">
                                    <span style="font-size:0.8rem;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                        <%= player.name %><% if (isManager) { %> <span class="pf-badge">mgr</span><% } %>
                                    </span>
                                    <strong style="font-size:0.8rem;color:#059669;flex-shrink:0"><%= isManager ? '—' : Number(amount).toLocaleString() %></strong>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="pf-empty">No active winning bids yet.</div>
                    <% } %>
                </div>

                <!-- OUTBID -->
                <div class="pf-card" style="padding:1rem;box-shadow:none">
                    <p style="margin:0 0 0.65rem;font-size:0.62rem;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;color:#e11d48">Outbid / locked (<%= typeof myOutbidPlayers !== 'undefined' ? myOutbidPlayers.length : 0 %>)</p>
                    <% if (typeof myOutbidPlayers !== 'undefined' && myOutbidPlayers.length > 0) { %>
                        <% const readyWithdraw = myOutbidPlayers.filter(x => x.canWithdraw); %>
                        <% if (readyWithdraw.length > 0) { %>
                            <div class="pf-alert pf-alert-warn" style="margin-bottom:0.55rem;background:rgba(5,150,105,.08);border-color:rgba(5,150,105,.25);color:#047857">
                                <div>
                                    <strong style="font-size:0.65rem;letter-spacing:0.08em;text-transform:uppercase">You can withdraw now</strong>
                                    <p style="margin:0.25rem 0 0;font-size:0.72rem"><%= readyWithdraw.map(x => x.name).join(', ') %></p>
                                </div>
                            </div>
                        <% } %>
                        <div class="pf-list">
                            <% myOutbidPlayers.forEach(p => { %>
                                <div class="pf-row <%= p.canWithdraw ? 'ready' : 'out' %>">
                                    <div style="min-width:0">
                                        <p style="margin:0;font-size:0.8rem;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= p.name %></p>
                                        <p class="pf-muted" style="margin:0.15rem 0 0;font-size:0.62rem">
                                            Your bid <%= Number(p.myBidAmount || 0).toLocaleString() %> · now <%= Number(p.highestBid || 0).toLocaleString() %> by <%= p.highestBidder || '—' %>
                                        </p>
                                        <% if (p.canWithdraw) { %>
                                            <span class="pf-badge pf-badge-ok" style="margin-top:0.25rem">Unlocked</span>
                                        <% } else { %>
                                            <p class="pf-muted outbid-countdown" data-remaining="<%= Number(p.remainingMs) || 0 %>" style="margin:0.25rem 0 0;font-size:0.62rem;font-weight:800;color:#d97706">
                                                Unlock in <span class="countdown-text">…</span>
                                            </p>
                                        <% } %>
                                    </div>
                                    <strong style="font-size:0.8rem;flex-shrink:0;color:<%= p.canWithdraw ? '#059669' : '#e11d48' %>"><%= Number(p.myBidAmount || p.highestBid || 0).toLocaleString() %></strong>
                                </div>
                            <% }) %>
                        </div>
                        <p class="pf-muted" style="margin:0.55rem 0 0;font-size:0.68rem;line-height:1.4">Highest bids: withdraw anytime. Outbid: locked 12h, then free.</p>
                    <% } else { %>
                        <div class="pf-empty">You haven't been outbid on anything.</div>
                    <% } %>
                </div>

                <!-- WATCHLIST -->
                <div class="pf-card" style="padding:1rem;box-shadow:none">
                    <p style="margin:0 0 0.65rem;font-size:0.62rem;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;color:#d97706">Watchlist (<%= typeof myWatchlistPlayers !== 'undefined' ? myWatchlistPlayers.length : 0 %>)</p>
                    <% if (typeof myWatchlistPlayers !== 'undefined' && myWatchlistPlayers.length > 0) { %>
                        <div class="pf-list">
                            <% myWatchlistPlayers.forEach(p => {
                                const amWinningWatched = (p.highestBidder || '').toLowerCase() === myAuctionState.team.name.toLowerCase() && Number(p.highestBid) > 0;
                            %>
                                <div class="pf-row watch">
                                    <div style="min-width:0">
                                        <p style="margin:0;font-size:0.8rem;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= p.name %></p>
                                        <p class="pf-muted" style="margin:0.15rem 0 0;font-size:0.62rem;color:<%= amWinningWatched ? '#059669' : 'inherit' %>"><%= amWinningWatched ? "You're winning" : (p.highestBidder || 'No bids yet') %></p>
                                    </div>
                                    <strong style="font-size:0.8rem;flex-shrink:0"><%= Number(p.highestBid || p.reservePrice || 0).toLocaleString() %></strong>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="pf-empty">Star players in the Market to track them here.</div>
                    <% } %>
                </div>
            </div>
        </div>

        <div style="text-align:center;margin-top:1.15rem">
            <a href="/market" class="pf-btn pf-btn-coral">Go to auction hub →</a>
        </div>
    </section>
    <% } %>

    <!-- RECENT BIDS ON YOU -->
    <% if (typeof myRecentBids !== 'undefined' && myRecentBids && myRecentBids.length > 0) { %>
    <section class="pf-card" style="margin-bottom:1.5rem">
        <div class="pf-card-h">
            <div>
                <div class="pf-eyebrow">Auction activity</div>
                <h2 class="pf-display pf-section-title" style="margin:0.2rem 0 0">Recent bids on you</h2>
                <p class="pf-muted" style="margin:0.15rem 0 0">Teams bidding on your card</p>
            </div>
        </div>
        <div class="pf-list" style="max-height:18rem">
            <% myRecentBids.forEach(b => { %>
                <div class="pf-row">
                    <div style="min-width:0">
                        <p style="margin:0;font-size:0.85rem;font-weight:800"><%= b.teamName || 'Unknown team' %></p>
                        <p class="pf-muted" style="margin:0.15rem 0 0;font-size:0.65rem">
                            <%= b.managerName ? ('mgr ' + b.managerName + ' · ') : '' %><%= b.createdAt ? new Date(b.createdAt).toLocaleString() : '' %>
                        </p>
                    </div>
                    <strong style="color:#059669;font-size:0.95rem"><%= Number(b.amount || 0).toLocaleString() %></strong>
                </div>
            <% }) %>
        </div>
    </section>
    <% } else if (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.status === 'live') { %>
    <div class="pf-card" style="margin-bottom:1.5rem;text-align:center;border-style:dashed">
        <p class="pf-muted" style="margin:0;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;font-size:0.7rem">No bids on your card yet — auction is live</p>
    </div>
    <% } %>

    <!-- DISCORD CONNECT (placeholder) -->
    <section class="pf-discord-box" style="margin-bottom:1.5rem">
        <div>
            <h3>Connect Discord</h3>
            <p>Link your Discord for role sync, pings, and easier verification. (Coming soon)</p>
        </div>
        <button type="button" class="pf-btn pf-btn-discord" onclick="alert('Discord connect is coming soon — placeholder for now.')">
            Connect Discord
        </button>
    </section>

    <div class="pf-layout">
        <!-- LEFT: card + stats -->
        <div style="display:flex;flex-direction:column;gap:1rem">
            <div class="pf-card">
                <div class="pf-card-h" style="margin-bottom:0.75rem">
                    <p class="pf-muted" style="margin:0;font-size:0.58rem;font-weight:800;letter-spacing:0.12em;text-transform:uppercase">Official player card</p>
                    <% if (user && user.cardImage) { %>
                        <span class="pf-badge pf-badge-ok">Verified</span>
                    <% } %>
                </div>
                <div class="pf-card-frame">
                    <% if (user && user.cardImage) { %>
                        <img src="<%= user.cardImage %>" alt="<%= user.name %> Card">
                    <% } else { %>
                        <div style="width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:1.5rem;text-align:center;gap:0.75rem">
                            <div style="width:2.5rem;height:2.5rem;border:2px solid rgba(56,189,248,.25);border-top-color:#38bdf8;border-radius:50%;animation:pfspin 0.9s linear infinite"></div>
                            <style>@keyframes pfspin{to{transform:rotate(360deg)}}</style>
                            <div>
                                <p style="margin:0;color:#fff;font-size:0.75rem;font-weight:800;letter-spacing:0.08em;text-transform:uppercase">Card pending</p>
                                <p class="pf-muted" style="margin:0.35rem 0 0;font-size:0.7rem">An admin will generate your market card soon.</p>
                            </div>
                        </div>
                    <% } %>
                    <div class="pf-card-overlay">
                        <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:0.5rem">
                            <div>
                                <b><%= user ? user.name : 'Unknown' %></b>
                                <span>@<%= user ? user.discord : 'none' %></span>
                            </div>
                            <span style="background:var(--pf-teal);color:#fff;font-size:0.55rem;font-weight:800;padding:0.25rem 0.5rem;border-radius:0.35rem;letter-spacing:0.06em;text-transform:uppercase"><%= user ? user.position : '???' %></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pf-stat-grid">
                <div class="pf-stat"><span>Goals</span><strong><%= user ? user.goals : 0 %></strong></div>
                <div class="pf-stat"><span>Assists</span><strong><%= user ? user.assists : 0 %></strong></div>
                <div class="pf-stat"><span>Saves</span><strong><%= user ? (user.saves || 0) : 0 %></strong></div>
                <div class="pf-stat"><span>MVPs</span><strong><%= user ? user.mvps : 0 %></strong></div>
            </div>
        </div>

        <!-- RIGHT: theme + form -->
        <div style="display:flex;flex-direction:column;gap:1rem">
            <div class="pf-card">
                <div class="pf-card-h">
                    <h3 class="pf-display">Website theme</h3>
                </div>
                <div class="pf-theme-row">
                    <button type="button" onclick="setTheme('light')" id="btn-theme-light" class="theme-btn">☀️ Light</button>
                    <button type="button" onclick="setTheme('dark')" id="btn-theme-dark" class="theme-btn">🌙 Dark</button>
                    <button type="button" onclick="setTheme('system')" id="btn-theme-system" class="theme-btn">💻 System</button>
                </div>
            </div>

            <div class="pf-card">
                <div class="pf-card-h" style="border-bottom:1px solid var(--pf-line);padding-bottom:0.85rem;margin-bottom:1.15rem">
                    <div>
                        <h3 class="pf-display" style="margin:0">Edit profile</h3>
                        <p class="pf-muted" style="margin:0.25rem 0 0">Changes show up on the Market card.</p>
                    </div>
                </div>

                <form action="/profile/update" method="POST" style="display:flex;flex-direction:column;gap:1.05rem">
                    <div class="pf-grid-2">
                        <div>
                            <label class="pf-label">Display name</label>
                            <input class="pf-input" name="name" value="<%= user ? user.name : '' %>" required>
                        </div>
                        <div>
                            <label class="pf-label">Discord handle</label>
                            <input class="pf-input" name="discord" value="<%= user ? user.discord : '' %>" required placeholder="username">
                        </div>
                    </div>

                    <div class="pf-grid-3">
                        <div>
                            <label class="pf-label">Position</label>
                            <select class="pf-select" name="position">
                                <option value="FWD" <%= user && user.position === 'FWD' ? 'selected' : '' %>>Forward (FWD)</option>
                                <option value="MID" <%= user && user.position === 'MID' ? 'selected' : '' %>>Midfield (MID)</option>
                                <option value="DEF" <%= user && user.position === 'DEF' ? 'selected' : '' %>>Defense (DEF)</option>
                                <option value="GK" <%= user && user.position === 'GK' ? 'selected' : '' %>>Goalkeeper (GK)</option>
                            </select>
                        </div>
                        <div>
                            <label class="pf-label">Country</label>
                            <input class="pf-input" name="country" value="<%= user ? user.country : '' %>" required placeholder="e.g. India, USA">
                        </div>
                        <div>
                            <label class="pf-label">Timezone</label>
                            <input class="pf-input" name="timezone" value="<%= user ? user.timezone : '' %>" placeholder="e.g. GMT+5:30">
                        </div>
                    </div>

                    <div>
                        <label class="pf-label">Market biography</label>
                        <textarea class="pf-area" name="bio" rows="4" placeholder="Experience, past teams, playstyle…"><%= user ? (user.bio || user.experience) : '' %></textarea>
                    </div>

                    <div style="display:flex;flex-wrap:wrap;gap:0.55rem;align-items:center;padding-top:0.25rem">
                        <button type="submit" class="pf-btn pf-btn-coral">Save profile</button>
                        <a href="/market" class="pf-link">View on market</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>
</div>

<script>
    if (window.tailwind) {
        tailwind.config = { darkMode: 'class' };
    }
    function setTheme(mode) {
        localStorage.setItem('vim_theme', mode);
        const isDark = mode === 'dark' || (mode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');
        fetch('/profile/update-theme', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ theme: mode })
        }).catch(() => {});
        document.querySelectorAll('.theme-btn').forEach(btn => btn.classList.remove('is-active'));
        const activeBtn = document.getElementById('btn-theme-' + mode);
        if (activeBtn) activeBtn.classList.add('is-active');
    }
    (function() {
        const savedTheme = localStorage.getItem('vim_theme') || "<%= user ? (user.theme || 'system') : 'system' %>";
        setTheme(savedTheme);
    })();
</script>
<script>
(function() {
    function fmt(ms) {
        if (ms <= 0) return '0m';
        var h = Math.floor(ms / 3600000);
        var m = Math.floor((ms % 3600000) / 60000);
        var s = Math.floor((ms % 60000) / 1000);
        if (h > 0) return h + 'h ' + m + 'm';
        if (m > 0) return m + 'm ' + s + 's';
        return s + 's';
    }
    function tick() {
        document.querySelectorAll('.outbid-countdown').forEach(function(el) {
            var rem = Number(el.getAttribute('data-remaining')) || 0;
            rem = Math.max(0, rem - 1000);
            el.setAttribute('data-remaining', String(rem));
            var span = el.querySelector('.countdown-text');
            if (span) span.textContent = fmt(rem);
            if (rem <= 0) {
                el.textContent = 'Unlocked — refresh to withdraw';
                el.style.color = '#059669';
            }
        });
    }
    tick();
    setInterval(tick, 1000);
})();
</script>
