            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 8s-.2-1.4-.8-2c-.7-.8-1.6-.8-2-.9C17.2 4.7 12 4.7 12 4.7s-5.2 0-8.2.4c-.4 0-1.3.1-2 .9C1.2 6.6 1 8 1 8S.8 9.6.8 11.3v1.4C.8 14.4 1 16 1 16s.2 1.4.8 2c.7.8 1.7.8 2.1.9 1.5.1 6.1.4 8.1.4s6.6-.3 8.1-.4c.4 0 1.3-.1 2-.9.6-.6.8-2 .8-2s.2-1.6.2-3.3v-1.4C23.2 9.6 23 8 23 8zM9.8 14.6V8.9l5.3 2.9-5.3 2.8z"/></svg>
