    // SEARCH & POSITION FILTERING LOGIC
    let activePosFilter = 'ALL';
    let activeClassFilter = 'ALL';
    let eligibleOnly = false;

    function setFilter(pos) {
        activePosFilter = pos;
        document.querySelectorAll('.filter-btn[data-pos-filter]').forEach(btn => {
            if(btn.dataset.posFilter === pos) {
                btn.className = 'filter-btn active';
            } else {
                btn.className = 'filter-btn';
            }
        });
        filterCards();
    }

    function setClassFilter(cls) {
        activeClassFilter = cls;
        document.querySelectorAll('.filter-btn[data-class-filter]').forEach(btn => {
            if(btn.dataset.classFilter === cls) {
                btn.className = 'filter-btn active';
            } else {
                btn.className = 'filter-btn';
            }
        });
        filterCards();
    }

    function toggleEligibleFilter() {
        eligibleOnly = !eligibleOnly;
        const btn = document.getElementById('eligibleFilterBtn');
        if (btn) {
            btn.className = eligibleOnly ? 'mk-pill on' : 'mk-pill';
        }
        filterCards();
    }

    function filterCards() {
        const query = document.getElementById('searchInput').value.toLowerCase().trim().replace(/^@/, '');
        const cards = document.querySelectorAll('.card-item');

        cards.forEach(card => {
            const searchBlob = card.getAttribute('data-search') || card.getAttribute('data-name') || '';
            const pos = card.getAttribute('data-pos');
            const cls = card.getAttribute('data-class') || 'C';
            const eligible = card.getAttribute('data-eligible');

            const matchesSearch = searchBlob.includes(query);
            const matchesPos = activePosFilter === 'ALL' || pos.includes(activePosFilter);
            const matchesClass = activeClassFilter === 'ALL' || cls === activeClassFilter;
            const matchesEligible = !eligibleOnly || eligible === 'true';

            if (matchesSearch && matchesPos && matchesClass && matchesEligible) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }

    // 3D DYNAMIC MOUSE TILT & INSPECT SHINE EFFECT

    window.managerAvailableBudget = <%= (typeof myAuctionState !== 'undefined' && myAuctionState) ? Number(myAuctionState.availableBudget) : 0 %>;
    window.managerCommitted = <%= (typeof myAuctionState !== 'undefined' && myAuctionState) ? Number(myAuctionState.committed) : 0 %>;
    window.managerBudget = <%= (typeof myAuctionState !== 'undefined' && myAuctionState) ? Number(myAuctionState.budget) : 0 %>;
    window.managerSpent = <%= (typeof myAuctionState !== 'undefined' && myAuctionState) ? Number(myAuctionState.spent) : 0 %>;

    function tiltCard(e, el) {
        const rect = el.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const midX = rect.width / 2;
        const midY = rect.height / 2;
        const rotateY = ((x - midX) / midX) * 8;
        const rotateX = ((midY - y) / midY) * 8;
        el.style.transform = 'perspective(1000px) rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg) scale3d(1.03,1.03,1.03)';
        el.onmouseleave = function() {
            el.style.transform = '';
            el.onmouseleave = null;
        };
    }

    function resetTilt(el) {
        el.style.transform = `rotateY(0deg) rotateX(0deg) translateY(0px)`;
    }

