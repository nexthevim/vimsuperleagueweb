                                    </label>

                                    <select
                                        name="lineupB_fwd2"
                                        id="lineupB_fwd2"
                                        class="player-select">
                                        <option value="">Select player...</option>
                                    </select>

                                    <div class="grid grid-cols-2 gap-2 mt-2">
                                        <input type="text" name="lineupB_fwd2_number" id="lineupB_fwd2_number" placeholder="Shirt #" maxlength="3" class="admin-input text-center">
                                        <input type="number" name="lineupB_fwd2_rating" id="lineupB_fwd2_rating" placeholder="Rating" step="0.1" min="0" max="10" class="admin-input text-center">
                                    </div>

                                </div>

                            </div>

                            <p class="text-[9px] text-slate-400 font-bold uppercase tracking-wider">
                                Shirt # and Rating are optional — ratings show as a colour-coded badge on the public lineup card.
                            </p>

                        </div>

                    </div>


                    <!-- OLD COMPATIBILITY LINEUP FIELDS -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                        <div>

                            <label class="admin-label">
                                Legacy Team A Lineup
                            </label>

                            <textarea
                                name="lineupA"
                                rows="4"
                                placeholder="GK:PlayerOne:8.5&#10;DEF:PlayerTwo:7.9"
                                class="w-full bg-white border border-slate-200 p-3 rounded-xl text-slate-900 text-xs outline-none focus:border-emerald-500 font-mono"></textarea>

                        </div>


                        <div>

                            <label class="admin-label">
                                Legacy Team B Lineup
                            </label>

                            <textarea
                                name="lineupB"
                                rows="4"
                                placeholder="GK:PlayerThree:8.0&#10;MID:PlayerFour:8.2"
                                class="w-full bg-white border border-slate-200 p-3 rounded-xl text-slate-900 text-xs outline-none focus:border-emerald-500 font-mono"></textarea>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- PLAYER MATCH STATS -->
                <!-- ================================================= -->
                <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 space-y-6">

                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3">

                        <div>

                            <h3 class="text-xs font-black uppercase text-emerald-600 tracking-wider">
                                04 • Match Player Statistics
                            </h3>

                            <p class="text-[10px] text-slate-400 uppercase font-bold mt-1">
                                Stats for this match only — player database remains the main source of career totals
                            </p>

                        </div>

                    </div>


                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                        <!-- TEAM A -->
                        <div class="bg-white border border-slate-200 rounded-2xl p-5 space-y-4">

                            <div class="flex justify-between items-center">

                                <div>
                                    <p class="text-xs font-black uppercase text-blue-600">
                                        Team A Players
                                    </p>

                                    <p class="text-[10px] text-slate-400 uppercase font-bold">
                                        Goals • assists • saves • rating
                                    </p>
                                </div>

                                <button
                                    type="button"
                                    onclick="addStatRow('teamA')"
                                    class="text-[10px] bg-blue-100 hover:bg-blue-200 text-blue-700 px-3 py-1.5 rounded-lg font-bold uppercase border border-blue-200">
                                    + Player
                                </button>

                            </div>

                            <div
                                id="statRows-teamA"
                                class="space-y-2">

                            </div>

                        </div>


                        <!-- TEAM B -->
                        <div class="bg-white border border-slate-200 rounded-2xl p-5 space-y-4">

                            <div class="flex justify-between items-center">

                                <div>
                                    <p class="text-xs font-black uppercase text-red-600">
                                        Team B Players
                                    </p>

                                    <p class="text-[10px] text-slate-400 uppercase font-bold">
                                        Goals • assists • saves • rating
                                    </p>
                                </div>

                                <button
                                    type="button"
                                    onclick="addStatRow('teamB')"
                                    class="text-[10px] bg-red-100 hover:bg-red-200 text-red-700 px-3 py-1.5 rounded-lg font-bold uppercase border border-red-200">
                                    + Player
                                </button>

                            </div>

                            <div
                                id="statRows-teamB"
                                class="space-y-2">

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- MVP -->
                <!-- ================================================= -->
                <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200">

                    <div class="mb-5">

                        <h3 class="text-xs font-black uppercase text-emerald-600 tracking-wider">
                            05 • Player of the Match
                        </h3>

                        <p class="text-[10px] text-slate-400 uppercase font-bold mt-1">
                            Select the MVP from the match lineup
                        </p>

                    </div>


                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                        <div>

                            <label class="admin-label">
                                MVP Player
                            </label>

                            <select
                                name="mvpName"
                                id="mvpSelect"
                                class="player-select">

                                <option value="">
                                    Select MVP...
                                </option>

                            </select>

                        </div>


                        <div>

                            <label class="admin-label">
                                MVP Card Image Override
                            </label>

                            <input
                                name="mvpCardUrl"
                                placeholder="Optional image URL"
                                class="admin-input">

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- TEAM TOTALS -->
                <!-- ================================================= -->
                <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200">

                    <div class="mb-5">

                        <h3 class="text-xs font-black uppercase text-emerald-600 tracking-wider">
                            06 • Match Totals
                        </h3>

                        <p class="text-[10px] text-slate-400 uppercase font-bold mt-1">
                            Team-level totals for the completed match
                        </p>

                    </div>


                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                        <div class="bg-white p-5 rounded-2xl border border-blue-200 space-y-3">

                            <p class="text-xs font-black text-blue-600 uppercase">
                                Team A
                            </p>

                            <input
                                type="number"
                                name="assistsA"
                                min="0"
                                placeholder="Total Assists"
                                class="admin-input">

                            <input
                                type="number"
                                name="savesA"
                                min="0"
                                placeholder="Total Saves"
                                class="admin-input">

                        </div>


                        <div class="bg-white p-5 rounded-2xl border border-red-200 space-y-3">

                            <p class="text-xs font-black text-red-600 uppercase">
                                Team B
                            </p>

                            <input
                                type="number"
                                name="assistsB"
                                min="0"
                                placeholder="Total Assists"
                                class="admin-input">

                            <input
                                type="number"
                                name="savesB"
                                min="0"
                                placeholder="Total Saves"
                                class="admin-input">

                        </div>

                    </div>

                </div>


                <!-- SAVE -->
                <button
                    type="submit"
                    class="w-full bg-emerald-600 hover:bg-emerald-700 py-4 rounded-xl font-black uppercase text-xs text-white shadow-sm transition">
                    Save Complete Match Report
                </button>

            </form>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- CATEGORY 3: TABLES & ROSTER -->
    <!-- ========================================================= -->
    <section id="section-tables" class="tab-section hidden space-y-8">

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <!-- LEAGUE TABLES -->
            <div class="bg-white border border-slate-200 p-6 md:p-8 rounded-3xl space-y-8 lg:col-span-3 shadow-sm">

                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-200 pb-5">

                    <div>
                        <span class="text-xs font-black uppercase tracking-widest text-indigo-600 bg-indigo-100 px-3 py-1 rounded-full border border-indigo-200">
                            Competition Management
                        </span>

                        <h3 class="text-xl font-black italic uppercase text-slate-900 mt-2">
                            League Standings & Rosters
                        </h3>

                        <p class="text-[10px] text-slate-400 uppercase font-bold mt-1">
                            Manage standings manually while keeping team rosters connected to the player database and auction results.
                        </p>
                    </div>


                    <form
                        action="/admin/add-group"
                        method="POST"
                        class="flex gap-2 w-full sm:w-auto">

                        <input
                            name="name"
                            placeholder="New Group / Division"
                            required
                            class="bg-slate-50 border border-slate-200 px-3 py-2 rounded-xl text-xs text-slate-900 outline-none flex-1">

                        <button
                            type="submit"
                            class="bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-xl text-xs font-bold uppercase text-white transition">
                            Create
                        </button>

                    </form>

                </div>


                <% if (typeof groups !== 'undefined' && groups.length > 0) { %>

                    <div class="space-y-8">

                        <% groups.forEach(group => { %>

                            <div class="space-y-6 p-5 border border-slate-200 rounded-2xl bg-slate-50">

                                <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-3 border-b border-slate-200 pb-3">

                                    <div>
                                        <p class="text-[9px] font-black uppercase tracking-widest text-indigo-500">
                                            Division / Table
                                        </p>
                                        <h4 class="text-blue-600 font-black italic uppercase text-lg mt-1">
                                            <%= group.name %>
                                        </h4>
                                    </div>

                                    <form
                                        action="/admin/delete-group"
                                        method="POST"
                                        onsubmit="return confirm('Delete this whole division and its teams? This cannot be undone.');">

                                        <input
                                            type="hidden"
                                            name="groupId"
                                            value="<%= group.id || group._id %>">

                                        <button
                                            type="submit"
                                            class="text-red-600 hover:text-red-700 text-[10px] font-bold border border-red-200 px-3 py-1 rounded-full uppercase bg-red-50">
                                            Delete Division
                                        </button>

                                    </form>

                                </div>


                                <div class="space-y-4">

                                    <% (group.teams || []).forEach((team, index) => { %>

                                        <div class="bg-white p-4 rounded-xl border border-slate-200 space-y-4 shadow-sm">

                                            <!-- TEAM TABLE ROW -->
                                            <div class="flex flex-col xl:flex-row justify-between items-start xl:items-center gap-3">

                                                <form
                                                    action="/admin/update-team"
                                                    method="POST"
                                                    class="grid grid-cols-2 sm:grid-cols-7 gap-2 items-center text-slate-900 flex-1 w-full">

                                                    <input type="hidden" name="groupId" value="<%= group.id || group._id %>">
                                                    <input type="hidden" name="teamIndex" value="<%= index %>">

                                                    <div class="flex items-center gap-2 col-span-2 min-w-0">
                                                        <img
                                                            src="<%= team.logo %>"
                                                            class="w-7 h-7 object-contain bg-slate-100 rounded p-0.5 shrink-0">

                                                        <div class="min-w-0">
                                                            <span class="font-black text-xs truncate block">
                                                                <%= team.name %>
                                                            </span>
                                                            <span class="text-[8px] text-slate-400 uppercase font-bold">
                                                                Team management
                                                            </span>
                                                        </div>
                                                    </div>

                                                    <div>
                                                        <span class="table-label">MP</span>
                                                        <input name="mp" type="number" min="0" value="<%= team.mp || 0 %>" class="table-input">
                                                    </div>

                                                    <div>
                                                        <span class="table-label">W</span>
                                                        <input name="wins" type="number" min="0" value="<%= team.wins || 0 %>" class="table-input">
                                                    </div>

                                                    <div>
                                                        <span class="table-label">L</span>
                                                        <input name="loses" type="number" min="0" value="<%= team.loses || 0 %>" class="table-input">
                                                    </div>

                                                    <div>
                                                        <span class="table-label">PTS</span>
                                                        <input name="pts" type="number" min="0" value="<%= team.pts || 0 %>" class="table-input text-blue-600 font-bold">
                                                    </div>

                                                    <button
                                                        type="submit"
                                                        class="bg-blue-600 hover:bg-blue-700 py-1.5 rounded-lg text-[10px] font-bold uppercase text-white transition col-span-2 sm:col-span-1">
                                                        Save
                                                    </button>

                                                </form>


                                                <form
                                                    action="/admin/delete-team"
                                                    method="POST"
                                                    onsubmit="return confirm('Delete this team? This cannot be undone.');">

                                                    <input type="hidden" name="groupId" value="<%= group.id || group._id %>">
                                                    <input type="hidden" name="teamIndex" value="<%= index %>">

                                                    <button
                                                        type="submit"
                                                        class="bg-red-50 hover:bg-red-100 text-red-600 px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase transition border border-red-200">
                                                        Delete
                                                    </button>

                                                </form>

                                            </div>


                                            <!-- ROSTER -->
                                            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-4">

                                                <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-2">

                                                    <div>
                                                        <p class="text-[9px] font-black uppercase tracking-widest text-indigo-500">
                                                            Squad Roster
                                                        </p>
                                                        <p class="text-[10px] text-slate-400 font-bold uppercase mt-1">
                                                            Auction winners can be added automatically by the backend later.
                                                        </p>
                                                    </div>

                                                    <span class="text-[9px] font-black uppercase text-slate-500 bg-white border border-slate-200 px-2 py-1 rounded-lg">
                                                        <%= (team.roster || []).length %> Players
                                                    </span>

                                                </div>


                                                <div class="flex flex-wrap gap-2">

                                                    <% (team.roster || []).forEach((player, pIdx) => { %>

                                                        <div class="bg-white px-3 py-2 rounded-lg flex items-center gap-2 border border-slate-200 shadow-sm">

                                                            <div class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center text-[9px] font-black text-indigo-600">
                                                                <%= player.name ? player.name.charAt(0).toUpperCase() : 'P' %>
                                                            </div>

                                                            <span class="text-xs uppercase <%= player.isManager ? 'text-blue-600 font-black' : 'text-slate-700 font-bold' %>">
                                                                <%= player.isManager ? 'MGR: ' : '' %><%= player.name %>
                                                            </span>

                                                            <form
                                                                action="/admin/delete-from-roster"
                                                                method="POST"
                                                                onsubmit="return confirm('Remove this player from the team roster?');">

                                                                <input type="hidden" name="groupId" value="<%= group.id || group._id %>">
                                                                <input type="hidden" name="teamIndex" value="<%= index %>">
                                                                <input type="hidden" name="playerIndex" value="<%= pIdx %>">

                                                                <button
                                                                    type="submit"
                                                                    class="text-red-500 font-bold hover:text-red-700 px-1">
                                                                    ×
                                                                </button>

                                                            </form>

                                                        </div>

                                                    <% }) %>

                                                    <% if (!(team.roster || []).length) { %>
                                                        <p class="text-[10px] text-slate-400 uppercase font-bold py-2">
                                                            No players currently assigned.
                                                        </p>
                                                    <% } %>

                                                </div>


                                                <form
                                                    action="/admin/add-to-roster"
                                                    method="POST"
                                                    class="grid grid-cols-1 sm:grid-cols-[1fr_auto_auto] gap-2">

                                                    <input type="hidden" name="groupId" value="<%= group.id || group._id %>">
                                                    <input type="hidden" name="teamIndex" value="<%= index %>">

                                                    <select
                                                        name="playerId"
                                                        class="admin-input"
                                                        required>

                                                        <option value="" disabled selected>
                                                            Select player from Player DB...
                                                        </option>

                                                        <% if (typeof players !== 'undefined') { %>
                                                            <% players.filter(p => p.verified).forEach(p => { %>
                                                                <option value="<%= p.id || p._id %>">
                                                                    <%= p.name %> (<%= p.position || 'Player' %>)
                                                                </option>
                                                            <% }) %>
                                                        <% } %>

                                                    </select>


                                                    <select
                                                        name="isManager"
                                                        class="admin-input">

                                                        <option value="false">Player</option>
                                                        <option value="true">Manager</option>

                                                    </select>


                                                    <button
                                                        type="submit"
                                                        class="bg-slate-900 hover:bg-slate-800 px-4 py-2 rounded-lg text-xs font-bold uppercase text-white transition">
                                                        Add to Roster
                                                    </button>

                                                </form>


                                                <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-3">
                                                    <p class="text-[9px] font-black uppercase tracking-wider text-indigo-700">
                                                        Automatic Auction Integration
                                                    </p>
                                                    <p class="text-[10px] text-indigo-600/80 font-semibold mt-1 leading-relaxed">
                                                        When the auction backend finalizes a winning bid, the player should be linked to this team's roster automatically. Manual roster additions remain available for admin corrections.
                                                    </p>
                                                </div>

                                            </div>

                                        </div>

                                    <% }) %>


                                    <!-- ADD TEAM -->
                                    <form
                                        action="/admin/update-team"
                                        method="POST"
                                        class="grid grid-cols-1 sm:grid-cols-3 gap-2 p-4 border border-dashed border-slate-300 rounded-xl bg-white">

                                        <input type="hidden" name="groupId" value="<%= group.id || group._id %>">

                                        <input
                                            name="teamName"
                                            required
                                            placeholder="New Team Name"
                                            class="bg-slate-50 p-2.5 rounded-lg text-xs text-slate-900 border border-slate-200 outline-none">

                                        <input
                                            name="logo"
                                            placeholder="Logo Image URL"
                                            class="bg-slate-50 p-2.5 rounded-lg text-xs text-slate-900 border border-slate-200 outline-none">

                                        <button
                                            type="submit"
                                            class="bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold uppercase rounded-lg py-2 transition">
                                            Add Team
                                        </button>

                                    </form>

                                </div>

                            </div>

                        <% }) %>

                    </div>

                <% } else { %>

                    <div class="py-12 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                        <p class="text-xs text-slate-400 uppercase font-bold tracking-widest">
                            No divisions created yet
                        </p>
                    </div>

                <% } %>

            </div>

        </div>

    </section>
<!-- CATEGORY 4: VERIFICATION QUEUE -->
    <!-- ========================================================= -->
    <section id="section-queue" class="tab-section hidden space-y-8">

        <div class="bg-white border border-slate-200 p-6 md:p-8 rounded-3xl space-y-6 shadow-sm">

            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">

                <div>

                    <span class="text-xs font-black uppercase tracking-widest text-amber-700 bg-amber-100 px-3 py-1 rounded-full border border-amber-200">
                        Registrations
                    </span>

                    <h2 class="text-2xl font-black italic uppercase text-amber-600 mt-2">
                        Verification Queue
                    </h2>

                </div>


                <input
                    type="text"
                    onkeyup="filterQueue(this)"
                    placeholder="Filter by name or Discord..."
                    class="bg-slate-50 border border-slate-200 px-4 py-2.5 rounded-xl text-xs text-slate-900 outline-none w-full md:w-64 focus:border-amber-500 transition-all">

            </div>


            <div class="space-y-3" id="queueList">

                <% let pending = (typeof players !== 'undefined') ? players.filter(p => !p.verified) : []; %>

                <% if (pending.length > 0) { %>

                    <% pending.forEach(player => { %>

                        <details
                            data-search="<%= ((player.name || '') + ' ' + (player.discord || '')).toLowerCase() %>"
                            class="queue-card group bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden hover:border-amber-400 transition">

                            <summary class="p-4 cursor-pointer flex items-center justify-between list-none">

                                <div class="flex items-center gap-4">

                                    <div class="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center font-black italic text-amber-600 uppercase border border-amber-200">
                                        <%= player.name ? player.name.charAt(0) : 'P' %>
                                    </div>

                                    <div>

                                        <p class="font-bold text-slate-900 uppercase text-sm">
                                            <%= player.name %>
                                        </p>

                                        <p class="text-[11px] text-blue-600 font-medium">
                                            <%= player.discord %>
                                        </p>

                                    </div>

                                </div>

                                <span class="text-xs font-bold uppercase text-amber-600 group-open:rotate-180 transition-transform">
                                    Review Details ↓
                                </span>

                            </summary>


                            <div class="p-6 bg-white border-t border-slate-200 space-y-6">

                                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                                    <div class="space-y-4">

                                        <div>

                                            <p class="text-[10px] font-bold uppercase text-slate-500 mb-1">
                                                User Password
                                            </p>

                                            <p class="bg-slate-50 p-3 rounded-lg text-xs text-amber-600 font-mono border border-slate-200">
                                                <%= player.password %>
                                            </p>

                                        </div>


                                        <div>

                                            <p class="text-[10px] font-bold uppercase text-slate-500 mb-1">
                                                Bio / Notes
                                            </p>

                                            <div class="bg-slate-50 p-3 rounded-lg text-xs text-slate-700 italic border border-slate-200">
                                                "<%= player.experience || player.bio %>"
                                            </div>

                                        </div>

                                    </div>


                                    <div class="lg:col-span-2 space-y-4">

                                        <form
                                            action="/admin/approve-player"
                                            method="POST"
                                            class="space-y-4">

                                            <input
                                                type="hidden"
                                                name="playerId"
                                                value="<%= player.id || player._id %>">

                                            <div>

                                                <label class="text-xs font-bold uppercase text-slate-700 block mb-1">
                                                    Market Card Image URL
                                                </label>

                                                <input
                                                    name="cardImage"
                                                    placeholder="Custom Card URL (Optional)"
                                                    class="w-full bg-slate-50 border border-slate-200 p-3 rounded-xl text-slate-900 text-xs outline-none focus:border-blue-500">

                                            </div>

                                            <div>

                                                <label class="text-xs font-bold uppercase text-slate-700 block mb-1">
                                                    Player Rank
                                                </label>

                                                <select
                                                    name="rank"
                                                    class="w-full bg-slate-50 border border-slate-200 p-3 rounded-xl text-slate-900 text-xs outline-none focus:border-blue-500 uppercase font-bold">
                                                    <option value="C" selected>C Rank</option>
                                                    <option value="B">B Rank</option>
                                                    <option value="A">A Rank</option>
                                                    <option value="S">S Rank</option>
                                                    <option value="SS">SS Rank</option>
                                                </select>

                                            </div>

                                            <button
                                                type="submit"
                                                class="w-full bg-emerald-600 hover:bg-emerald-700 py-3 rounded-xl text-xs font-bold uppercase text-white transition">
                                                Approve & Verify Player
                                            </button>

                                        </form>


                                        <form
                                            action="/admin/delete-player"
                                            method="POST"
                                            onsubmit="return confirm('Reject application?');">

                                            <input
                                                type="hidden"
                                                name="playerId"
                                                value="<%= player.id || player._id %>">

                                            <button
                                                type="submit"
                                                class="w-full bg-red-50 hover:bg-red-100 text-red-600 py-3 rounded-xl text-xs font-bold uppercase transition border border-red-200">
                                                Reject Application
                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </details>

                    <% }) %>

                <% } else { %>

                    <div class="py-10 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-200">

                        <p class="text-xs text-slate-400 uppercase font-bold tracking-widest">
                            No pending registrations
                        </p>

                    </div>

                <% } %>

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- CATEGORY 5: PLAYER MARKET -->
    <!-- ========================================================= -->
    <section id="section-market" class="tab-section hidden space-y-8">

        <div class="bg-white border border-slate-200 p-6 md:p-8 rounded-3xl space-y-6 shadow-sm">

            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">

                <div>

                    <span class="text-xs font-black uppercase tracking-widest text-blue-600 bg-blue-100 px-3 py-1 rounded-full border border-blue-200">
                        Player Database
                    </span>

                    <h2 class="text-2xl font-black italic uppercase text-slate-900 mt-2">
                        Verified Player Market
                    </h2>

                    <p class="text-xs text-slate-500 uppercase font-bold tracking-wider mt-1">
                        Player profile • career stats • card • bio
                    </p>

                </div>


                <input
                    type="text"
                    id="playerSearch"
                    onkeyup="filterPlayers()"
                    placeholder="Search name, Discord, position, rank..."
                    class="bg-slate-50 border border-slate-200 px-4 py-2.5 rounded-xl text-xs text-slate-900 outline-none w-full md:w-64 focus:border-blue-500 transition-all">

            </div>


            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
                id="marketList">

                <% if (typeof players !== 'undefined') { %>

                    <% players.filter(p => p.verified).forEach(player => { %>

                        <% let pId = (player.id || player._id).toString(); %>

                        <details
                            class="player-card group bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden hover:border-blue-400 transition"
                            data-name="<%= (player.name || '').toLowerCase() %>"
                            data-search="<%= ((player.name || '') + ' ' + (player.discord || '') + ' ' + (player.position || '') + ' ' + (player.rank || '')).toLowerCase() %>">

                            <summary class="p-4 cursor-pointer flex items-center justify-between list-none">

                                <div class="flex items-center gap-3">

                                    <%
                                        let adminPreviewImg =
                                            (player.cardImage &&
                                            player.cardImage !== 'none' &&
                                            player.cardImage !== '')
                                            ? player.cardImage
                                            : `https://www.roblox.com/headshot-thumbnail/image?userName=${encodeURIComponent(player.name)}&width=420&height=420&format=png`;
                                    %>

                                    <img
                                        src="<%= adminPreviewImg %>"
                                        class="w-10 h-10 rounded-xl object-cover bg-slate-200 border border-slate-300"
                                        onerror="this.src='https://www.roblox.com/headshot-thumbnail/image?userName=Roblox&width=420&height=420&format=png'">

                                    <div>

                                        <p class="font-bold text-slate-900 uppercase text-sm">
                                            <%= player.name %>
                                        </p>

                                        <p class="text-[10px] text-blue-600 font-bold uppercase">
                                            <%= player.position || 'No Position' %>
                                        </p>

                                    </div>

                                </div>


                                <div class="flex items-center gap-2">

                                    <%
                                        let curRank = (player.rank || 'C').toUpperCase();
                                        let rankBadgeClass = 'bg-slate-200 text-slate-600';
                                        if (curRank === 'SS') rankBadgeClass = 'bg-gradient-to-r from-fuchsia-500 to-amber-400 text-white';
                                        else if (curRank === 'S') rankBadgeClass = 'bg-gradient-to-r from-amber-500 to-red-500 text-white';
                                        else if (curRank === 'A') rankBadgeClass = 'bg-gradient-to-r from-violet-500 to-blue-500 text-white';
                                        else if (curRank === 'B') rankBadgeClass = 'bg-gradient-to-r from-emerald-500 to-emerald-600 text-white';
                                    %>

                                    <span class="text-[10px] font-black px-2 py-0.5 rounded uppercase <%= rankBadgeClass %>">
                                        <%= curRank %> Rank
                                    </span>

                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-slate-200 text-slate-600 uppercase">
                                        ID: <%= pId.slice(-4) %>
                                    </span>

                                    <span class="text-xs font-bold text-slate-400 group-open:rotate-180 transition-transform">
                                        ↓
                                    </span>

                                </div>

                            </summary>


                            <div class="p-6 bg-white border-t border-slate-200 space-y-6">

                                <!-- SECURITY -->
                                <div class="bg-amber-50 border border-amber-200 p-3 rounded-xl">

                                    <p class="text-[10px] font-bold uppercase text-amber-700 mb-1">
                                        User Credentials
                                    </p>

                                    <div class="flex items-center justify-between gap-3">

                                        <p class="text-xs text-slate-700 font-mono">
                                            Password:
                                            <span id="passText-<%= pId %>">
                                                ••••••••
                                            </span>
                                        </p>

                                        <button
                                            type="button"
                                            onclick="togglePasswordView('<%= pId %>', '<%= player.password %>')"
                                            class="text-[10px] font-bold text-amber-700 uppercase hover:underline">
                                            Toggle
                                        </button>

                                    </div>

                                </div>


                                <!-- PLAYER STATS -->
                                <form
                                    action="/admin/update-market-player"
                                    method="POST"
                                    class="space-y-5">

                                    <input
                                        type="hidden"
                                        name="playerId"
                                        value="<%= pId %>">

                                    <input
                                        type="hidden"
                                        name="username"
                                        value="<%= player.name %>">


                                    <!-- RANK -->
                                    <div>

                                        <label class="admin-label">
                                            Player Rank
                                        </label>

                                        <select
                                            name="rank"
                                            class="admin-input uppercase font-black">
                                            <option value="C" <%= curRank === 'C' ? 'selected' : '' %>>C Rank</option>
                                            <option value="B" <%= curRank === 'B' ? 'selected' : '' %>>B Rank</option>
                                            <option value="A" <%= curRank === 'A' ? 'selected' : '' %>>A Rank</option>
                                            <option value="S" <%= curRank === 'S' ? 'selected' : '' %>>S Rank</option>
                                            <option value="SS" <%= curRank === 'SS' ? 'selected' : '' %>>SS Rank</option>
                                        </select>

                                        <p class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-1">
                                            Shown as the colour-coded badge on this player's market card.
                                        </p>

                                    </div>


                                    <div>

                                        <div class="flex justify-between items-center mb-3">

                                            <div>

                                                <p class="text-xs font-black uppercase text-blue-600">
                                                    Career Statistics
                                                </p>

                                                <p class="text-[10px] text-slate-400 uppercase font-bold">
                                                    Main source for leaderboard data
                                                </p>

                                            </div>

                                        </div>


                                        <div class="grid grid-cols-2 gap-3">

                                            <div>
                                                <label class="admin-label">Goals</label>

                                                <input
                                                    name="goals"
                                                    type="number"
                                                    value="<%= player.goals || 0 %>"
                                                    class="admin-input">
                                            </div>


                                            <div>
                                                <label class="admin-label">Assists</label>

                                                <input
                                                    name="assists"
                                                    type="number"
                                                    value="<%= player.assists || 0 %>"
                                                    class="admin-input">
                                            </div>


                                            <div>
                                                <label class="admin-label">Saves</label>

                                                <input
                                                    name="saves"
                                                    type="number"
                                                    value="<%= player.saves || 0 %>"
                                                    class="admin-input">
                                            </div>


                                            <div>
                                                <label class="admin-label">MVPs</label>

                                                <input
                                                    name="mvps"
                                                    type="number"
                                                    value="<%= player.mvps || 0 %>"
                                                    class="admin-input">
                                            </div>

                                        </div>

                                    </div>


                                    <!-- CARD -->
                                    <div>

                                        <label class="admin-label">
                                            Custom Card Image URL
                                        </label>

                                        <input
                                            name="cardImage"
                                            value="<%= player.cardImage || '' %>"
                                            placeholder="Roblox Headshot Default"
                                            class="admin-input">

                                    </div>


                                    <!-- BIO -->
                                    <div>

                                        <label class="admin-label">
                                            Player Bio
                                        </label>

                                        <textarea
                                            name="bio"
                                            class="admin-input h-24"><%= player.bio || '' %></textarea>

                                    </div>


                                    <!-- SAVE / DELETE -->
                                    <div class="flex gap-2 pt-2">

                                        <button
                                            type="submit"
                                            class="flex-1 bg-blue-600 hover:bg-blue-700 py-3 rounded-xl font-bold uppercase text-xs text-white transition">
                                            Save Player
                                        </button>

                                        <button
                                            type="button"
                                            onclick="triggerDelete('<%= pId %>')"
                                            class="bg-red-50 hover:bg-red-100 text-red-600 px-4 py-3 rounded-xl text-xs font-bold uppercase transition border border-red-200">
                                            Delete
                                        </button>

                                    </div>

                                </form>

                            </div>

                        </details>

                    <% }) %>

                <% } %>

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- CATEGORY 6: AUCTION CONTROL -->
    <!-- ========================================================= -->
    <section id="section-auction" class="tab-section hidden space-y-6">

        <div class="flex flex-col gap-6 w-full max-w-6xl mx-auto">

            <!-- SESSION CONTROL -->
            <div class="bg-white border border-slate-200 p-5 md:p-6 rounded-2xl space-y-5 w-full shadow-sm">

                <div>
                    <span class="text-xs font-black uppercase tracking-widest text-purple-600 bg-purple-100 px-3 py-1 rounded-full border border-purple-200">
                        Auction Session
                    </span>

                    <h2 class="text-xl font-black italic uppercase text-slate-900 mt-2">
                        Auction Control
                    </h2>

                    <p class="text-[10px] text-slate-400 uppercase font-bold mt-1">
                        One league-wide auction session. No separate team clocks.
                    </p>
                </div>


                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4">

                    <div class="flex justify-between items-center gap-3">

                        <div>
                            <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                                Current Session
                            </p>

                            <p class="text-sm font-black uppercase text-slate-900 mt-1">
                                <%= typeof auctionSession !== 'undefined' && auctionSession && auctionSession.name ? auctionSession.name : 'Auction Session' %>
                            </p>
                        </div>

                        <%
                            let auctionStatus =
                                (typeof auctionSession !== 'undefined' && auctionSession && auctionSession.status)
                                    ? String(auctionSession.status).toLowerCase()
                                    : 'idle';
                        %>

                        <% if (auctionStatus === 'live' || auctionStatus === 'active') { %>
                            <span class="text-[9px] font-black uppercase text-red-600 bg-red-50 border border-red-100 px-2 py-1 rounded-lg animate-pulse">
                                LIVE
                            </span>
                        <% } else if (auctionStatus === 'paused') { %>
                            <span class="text-[9px] font-black uppercase text-amber-700 bg-amber-50 border border-amber-200 px-2 py-1 rounded-lg">
                                ⏸ PAUSED
                            </span>
                        <% } else if (auctionStatus === 'processing') { %>
                            <span class="text-[9px] font-black uppercase text-blue-600 bg-blue-50 border border-blue-100 px-2 py-1 rounded-lg animate-pulse">
                                FINALIZING…
                            </span>
                        <% } else if (auctionStatus === 'ended' || auctionStatus === 'closed') { %>
                            <span class="text-[9px] font-black uppercase text-slate-500 bg-slate-100 border border-slate-200 px-2 py-1 rounded-lg">
                                ENDED
                            </span>
                        <% } else { %>
                            <span class="text-[9px] font-black uppercase text-amber-600 bg-amber-50 border border-amber-100 px-2 py-1 rounded-lg">
                                READY
                            </span>
                        <% } %>

                    </div>


                    <div class="grid grid-cols-3 gap-3 mt-4">

                        <div class="bg-white rounded-xl border border-slate-200 p-3">
                            <p class="text-[8px] font-black uppercase text-slate-400">Teams</p>
                            <p class="text-lg font-black text-purple-600 mt-1">
                                <%= typeof auctionTeams !== 'undefined' ? auctionTeams.length : 0 %>
                            </p>
                        </div>

                        <div class="bg-white rounded-xl border border-slate-200 p-3">
                            <p class="text-[8px] font-black uppercase text-slate-400">Min Squad</p>
                            <p class="text-lg font-black text-purple-600 mt-1">
                                <%= typeof auctionSession !== 'undefined' && auctionSession && auctionSession.minRosterSize ? auctionSession.minRosterSize : 10 %>
                            </p>
                        </div>

                        <div class="bg-white rounded-xl border border-slate-200 p-3">
                            <p class="text-[8px] font-black uppercase text-slate-400">Max Squad</p>
                            <p class="text-lg font-black text-purple-600 mt-1">
                                <%= typeof auctionSession !== 'undefined' && auctionSession && auctionSession.maxRosterSize ? auctionSession.maxRosterSize : 16 %>
                            </p>
                        </div>

                    </div>

                </div>

                <div class="bg-fuchsia-50 border border-fuchsia-100 rounded-2xl p-4 space-y-1.5">
                    <p class="text-[9px] font-black uppercase tracking-wider text-fuchsia-700">
                        VSL Class Reserve Prices
                    </p>
                    <div class="grid grid-cols-5 gap-1.5 text-center">
                        <div class="bg-white rounded-lg py-1.5"><p class="text-[8px] font-black text-slate-400">SS</p><p class="text-[10px] font-black text-fuchsia-700">10,000</p></div>
                        <div class="bg-white rounded-lg py-1.5"><p class="text-[8px] font-black text-slate-400">S</p><p class="text-[10px] font-black text-fuchsia-700">8,000</p></div>
                        <div class="bg-white rounded-lg py-1.5"><p class="text-[8px] font-black text-slate-400">A</p><p class="text-[10px] font-black text-fuchsia-700">6,000</p></div>
                        <div class="bg-white rounded-lg py-1.5"><p class="text-[8px] font-black text-slate-400">B</p><p class="text-[10px] font-black text-fuchsia-700">4,000</p></div>
                        <div class="bg-white rounded-lg py-1.5"><p class="text-[8px] font-black text-slate-400">C</p><p class="text-[10px] font-black text-fuchsia-700">2,500</p></div>
                    </div>
                    <p class="text-[9px] text-fuchsia-600/80 font-semibold leading-relaxed pt-1">
                        Assigned automatically from each player's class the moment you press Start Auction.
                    </p>
                </div>


                <!-- SESSION SETTINGS -->
                <form action="/admin/auction/update-session" method="POST" class="space-y-4">

                    <div>
                        <label class="admin-label">Session Name</label>
                        <input
                            name="name"
                            value="<%= typeof auctionSession !== 'undefined' && auctionSession ? (auctionSession.name || '') : '' %>"
                            placeholder="e.g. VSL Season 4 Auction"
                            class="admin-input">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="admin-label">Min Roster Size</label>
                            <input
                                type="number"
                                name="minRosterSize"
                                min="1"
                                max="50"
                                value="<%= typeof auctionSession !== 'undefined' && auctionSession && auctionSession.minRosterSize ? auctionSession.minRosterSize : 10 %>"
                                class="admin-input"
                                required>
                        </div>

                        <div>
                            <label class="admin-label">Max Roster Size</label>
                            <input
                                type="number"
                                name="maxRosterSize"
                                min="1"
                                max="50"
                                value="<%= typeof auctionSession !== 'undefined' && auctionSession && auctionSession.maxRosterSize ? auctionSession.maxRosterSize : 16 %>"
                                class="admin-input"
                                required>
                        </div>
                    </div>

                    <p class="text-[9px] text-slate-400 font-bold uppercase mt-1.5">
                        VSL Season 4 defaults: 10–16 players. The bidding system already blocks any bid that would make a team's roster impossible to complete within these limits.
                    </p>

                    <button
                        type="submit"
                        class="w-full bg-slate-900 hover:bg-slate-800 py-3 rounded-xl font-bold uppercase text-xs text-white transition">
                        Save Session Settings
                    </button>

                </form>


                <!-- PRE-END-AUCTION ROSTER READINESS CHECK -->
                <% if (typeof rosterReadiness !== 'undefined' && rosterReadiness && rosterReadiness.length > 0) { %>
                    <%
                        const shortTeams = rosterReadiness.filter(t => t.belowMinimum);
                    %>
                    <div class="bg-white border border-slate-200 rounded-2xl p-4 space-y-3">
                        <div class="flex items-center justify-between">
                            <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">
                                Pre-End Roster Check <span class="text-slate-300">(min <%= typeof auctionSession !== 'undefined' && auctionSession && auctionSession.minRosterSize ? auctionSession.minRosterSize : 10 %> players)</span>
                            </p>
                            <% if (shortTeams.length > 0) { %>
                            <p class="text-[9px] text-rose-500 font-bold uppercase tracking-wider leading-relaxed">
                                End is blocked until every team has at least the minimum roster (manager + winning bids).
                            </p>
                        <% } else { %>
                            <p class="text-[9px] text-emerald-600 font-bold uppercase tracking-wider leading-relaxed">
                                All teams meet the minimum — End Auction is available.
                            </p>
                        <% } %>
                    </div>
                <% } %>

                <!-- START / PAUSE / RESUME / END -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">

                    <form
                        action="/admin/auction/start"
                        method="POST"
                        onsubmit="return confirm('Start the auction? Registration closes and ranks freeze while live.');">
                        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 py-3 rounded-xl font-black uppercase text-[10px] text-white transition shadow-sm">
                            ▶ Start Auction
                        </button>
                    </form>

                    <% if (auctionStatus === 'live' || auctionStatus === 'active') { %>
                        <form action="/admin/auction/pause" method="POST"
                            onsubmit="return confirm('Pause the auction? Bidding, registration, and rank edits freeze until you resume.');">
                            <button type="submit" class="w-full bg-amber-500 hover:bg-amber-600 py-3 rounded-xl font-black uppercase text-[10px] text-white transition shadow-sm">
                                ⏸ Pause Auction
                            </button>
                        </form>
                    <% } else if (auctionStatus === 'paused') { %>
                        <form action="/admin/auction/resume" method="POST">
                            <button type="submit" class="w-full bg-emerald-500 hover:bg-emerald-600 py-3 rounded-xl font-black uppercase text-[10px] text-white transition shadow-sm">
                                ▶ Resume Auction
                            </button>
                        </form>
                    <% } else { %>
                        <button type="button" disabled class="w-full bg-slate-100 text-slate-400 py-3 rounded-xl font-black uppercase text-[10px] cursor-not-allowed">
                            ⏸ Pause (start first)
                        </button>
                    <% } %>

                    <%
                        const canEndAuction = (auctionStatus === 'live' || auctionStatus === 'active' || auctionStatus === 'paused')
                            && !(typeof rosterReadiness !== 'undefined' && rosterReadiness.some(t => t.belowMinimum));
                    %>
                    <form action="/admin/auction/end" method="POST" class="sm:col-span-2"
                        onsubmit="return confirm('End the auction now? Finalizes winners, deducts budgets, assigns rosters. Cannot be undone.');">
                        <button type="submit" <%= canEndAuction ? '' : 'disabled' %>
                            class="w-full py-3 rounded-xl font-black uppercase text-[10px] text-white transition shadow-sm <%= canEndAuction ? 'bg-red-600 hover:bg-red-700' : 'bg-slate-300 cursor-not-allowed' %>">
                            ■ End Auction<%= canEndAuction ? '' : ' (blocked — under minimum)' %>
                        </button>
                    </form>
                </div>


                <!-- FORCE DROP A BID (admin mercy) -->
                <div class="bg-white border border-slate-200 rounded-2xl p-4 space-y-3">
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Force-Drop Bid</p>
                        <p class="text-[9px] text-slate-400 font-bold mt-0.5">Remove one team's bid on a player (e.g. accidental lock). Highest bid recalculates.</p>
                    </div>
                    <form action="/admin/auction/force-drop-bid" method="POST" class="space-y-2"
                        onsubmit="return confirm('Force-drop this bid? The player\'s highest bidder will be recalculated.');">
                        <select name="teamId" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800">
                            <option value="">Select team…</option>
                            <% if (typeof auctionTeams !== 'undefined') { auctionTeams.forEach(t => { %>
                                <option value="<%= t._id || t.id %>"><%= t.name %></option>
                            <% }) } %>
                        </select>
                        <select name="playerId" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800">
                            <option value="">Select player…</option>
                            <% if (typeof players !== 'undefined') { players.filter(p => p.verified && Number(p.highestBid||0) > 0).forEach(p => { %>
                                <option value="<%= p._id || p.id %>"><%= p.name %> — <%= Number(p.highestBid||0).toLocaleString() %> V (<%= p.highestBidder || '—' %>)</option>
                            <% }) } %>
                        </select>
                        <button type="submit" class="w-full bg-rose-500 hover:bg-rose-600 text-white py-2.5 rounded-xl font-black uppercase text-[10px] transition">
                            ↩ Force-Drop / Clear Ghost
                        </button>
                    </form>
                    <form action="/admin/auction/reconcile-highs" method="POST"
                        onsubmit="return confirm('Recompute ALL player high bids from real team bid rows? Safe — does not invent bids.');"
                        class="pt-1">
                        <button type="submit" class="w-full bg-slate-800 hover:bg-slate-900 text-white py-2.5 rounded-xl font-black uppercase text-[10px] transition">
                            Reconcile all high bids
                        </button>
                        <p class="text-[8px] text-slate-400 font-bold uppercase mt-1.5 text-center">
                            Fixes players still showing a team after withdraw
                        </p>
                    </form>
                    <form action="/admin/auction/fix-all" method="POST"
                        onsubmit="return confirm('FIX ALL: recompute every player high from real bids, clear ghost highs, and normalize team bid lists. Does NOT wipe real bids or end the auction.');"
                        class="pt-1">
                        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-xl font-black uppercase text-[11px] transition shadow-sm">
                            Fix all auction display / ghosts
                        </button>
                        <p class="text-[8px] text-indigo-400/80 font-bold uppercase mt-1.5 text-center">
                            One click — safe during live auction
                        </p>
                    </form>
                </div>

                <form
                    action="/admin/auction/reset-bids"
                    method="POST"
                    onsubmit="return confirm('Reset ALL live bids and clear the auction leaderboard (Top Bids / Rising)? Sold players and final rosters are NOT touched. Team bid lists will be emptied.');">

                    <button
                        type="submit"
                        class="w-full bg-amber-500 hover:bg-amber-600 py-3 rounded-xl font-black uppercase text-[10px] text-white transition shadow-sm">
                        🔄 Reset Top Bids / Leaderboard
                    </button>
                </form>

                <% if (auctionStatus === 'live' || auctionStatus === 'paused') { %>
                    <form
                        action="/admin/auction/reset"
                        method="POST"
                        onsubmit="return confirm('Reset the auction back to READY? This re-closes bidding but does NOT clear bids already placed. Only use this if the auction was started by mistake.');">

                        <button
                            type="submit"
                            class="w-full bg-white hover:bg-slate-100 text-slate-500 border border-slate-200 py-2.5 rounded-xl font-black uppercase text-[9px] transition">
                            ↺ Reset To "Ready" (undo accidental start)
                        </button>
                    </form>
                <% } %>


                <div class="bg-purple-50 border border-purple-100 rounded-2xl p-4">
                    <p class="text-[9px] font-black uppercase tracking-wider text-purple-700">
                        How this works
                    </p>
                    <p class="text-[10px] text-purple-600/80 font-semibold mt-1 leading-relaxed">
                        All enrolled teams share the same auction state. Starting the auction locks classes and closes registration; ending it automatically assigns every player to whoever actually holds the highest bid — no manual per-team roster picking needed anymore.
                    </p>
                </div>

            </div>


            <!-- TEAM SETUP -->
            <div class="bg-white border border-slate-200 p-5 md:p-6 rounded-2xl space-y-5 w-full min-w-0 shadow-sm">

                <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 border-b border-slate-200 pb-4">

                    <div>
                        <span class="text-xs font-black uppercase tracking-widest text-purple-600 bg-purple-100 px-3 py-1 rounded-full border border-purple-200">
                            Auction Teams
                        </span>

                        <h3 class="text-xl font-black italic uppercase text-slate-900 mt-1">
                            Enrolled Teams
                        </h3>

                        <p class="text-[10px] text-slate-400 uppercase font-bold mt-1">
                            Assign manager + starting budget. Auction timing is controlled by the session above.
                        </p>
                    </div>

                    <span class="text-[10px] font-black text-purple-600 bg-purple-50 border border-purple-100 px-2 py-1 rounded-lg">
                        <%= typeof auctionTeams !== 'undefined' ? auctionTeams.length : 0 %> ENROLLED
                    </span>

                </div>


                <!-- ADD / UPDATE TEAM -->
                <form
                    action="/admin/add-auction-team"
                    method="POST"
                    class="bg-slate-50 border border-slate-200 rounded-2xl p-5 space-y-4">

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">

                        <div>
                            <label class="admin-label">Select Team</label>
                            <select name="teamName" class="admin-input" required>
                                <option value="" disabled selected>Select an active team...</option>

                                <% if (typeof groups !== 'undefined') { %>
                                    <% groups.forEach(g => { %>
                                        <% (g.teams || []).forEach(t => { %>
                                            <option value="<%= t.name %>">
                                                <%= t.name %> (<%= g.name %>)
                                            </option>
                                        <% }) %>
                                    <% }) %>
                                <% } %>

                            </select>
                        </div>


                        <div>
                            <label class="admin-label">Starting Budget (Vollars)</label>
                            <input
                                type="number"
                                name="budget"
                                min="0"
                                value="100000"
                                placeholder="e.g. 100000"
                                class="admin-input"
                                required>
                            <p class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-1">VSL Season 4 default: 100,000</p>
                        </div>


                        <div>
                            <label class="admin-label">Assign Manager</label>

                            <input
                                type="search"
                                id="managerSearch"
                                class="admin-input mb-2"
                                placeholder="Search Roblox name or Discord…"
                                autocomplete="off"
                                oninput="filterManagerSelect(this.value)">

                            <select
                                name="managerName"
                                id="managerSelect"
                                class="admin-input"
                                size="6"
                                required
                                style="height: auto; min-height: 9.5rem;">

                                <option value="" disabled selected>
                                    Choose assigned manager...
                                </option>

                                <% if (typeof players !== 'undefined') { %>
                                    <% players.filter(p => p.verified).forEach(p => { %>
                                        <option
                                            value="<%= p.name %>"
                                            data-search="<%= ((p.name || '') + ' ' + (p.discord || '') + ' ' + (p.position || '') + ' ' + (p.rank || '')).toLowerCase() %>">
                                            <%= p.name %><% if (p.discord) { %> · @<%= p.discord %><% } %> (<%= p.position || 'Player' %><% if (p.rank) { %> · <%= p.rank %><% } %>)
                                        </option>
                                    <% }) %>
                                <% } %>

                            </select>
                            <p class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-1">
                                Type to filter by Roblox name or Discord handle
                            </p>
                        </div>

                    </div>

                    <p class="text-[10px] text-slate-500 font-semibold leading-relaxed bg-slate-50 border border-slate-200 rounded-xl px-4 py-3">
                        Class caps adjust automatically: <span class="font-black text-slate-700">0 SS → 4 S / 6 A</span>,
                        <span class="font-black text-slate-700">1 SS → 3 S / 5 A</span>,
                        <span class="font-black text-slate-700">2 SS → 2 S / 3 A</span>.
                        The assigned manager counts as 1 roster slot and toward their class.
                    </p>

                    <button
                        type="submit"
                        class="w-full bg-purple-600 hover:bg-purple-700 py-3 rounded-xl font-bold uppercase text-xs text-white transition shadow-sm">
                        Enroll Team in Auction
                    </button>

                </form>


                <!-- ACTIVE AUCTION TEAMS -->
                <div
                    class="grid grid-cols-1 md:grid-cols-2 gap-4"
                    id="auctionTeamsList">

                    <% if (typeof auctionTeams !== 'undefined' && auctionTeams.length > 0) { %>

                        <% auctionTeams.forEach(aTeam => { %>

                            <div class="bg-slate-50 border border-slate-200 p-5 rounded-2xl space-y-4 relative">

                                <div class="flex justify-between items-start gap-3">

                                    <div>
                                        <p class="text-[9px] font-black uppercase tracking-widest text-purple-500">
                                            Auction Participant
                                        </p>

                                        <h4 class="font-black italic uppercase text-slate-900 text-base mt-1">
                                            <%= aTeam.name %>
                                        </h4>

                                        <p class="text-[11px] font-bold text-purple-600 uppercase mt-1">
                                            Manager: <%= aTeam.manager || 'Unassigned' %>
                                        </p>
                                    </div>


                                    <form
                                        action="/admin/delete-auction-team"
                                        method="POST"
                                        onsubmit="return confirm('Remove this team from the auction session? This does not delete the actual league team.');">

                                        <input
                                            type="hidden"
                                            name="teamId"
                                            value="<%= aTeam.id || aTeam._id %>">

                                        <button
                                            class="text-red-600 hover:text-red-700 text-[9px] font-black uppercase px-2 py-1 bg-red-50 border border-red-100 rounded-lg">
                                            Remove
                                        </button>

                                    </form>

                                </div>

                                <!-- CHANGE MANAGER — bids/budget stay on the team -->
                                <form action="/admin/auction/change-manager" method="POST"
                                    class="bg-white border border-slate-200 rounded-xl p-3 space-y-2"
                                    onsubmit="return confirm('Change manager for this team? Bids and budget stay on the team.');">
                                    <input type="hidden" name="teamId" value="<%= aTeam._id || aTeam.id %>">
                                    <p class="text-[9px] font-black uppercase text-slate-500 tracking-wider">Change manager</p>
                                    <input type="search"
                                        class="admin-input text-[11px] py-2 mb-1 change-mgr-search"
                                        placeholder="Search Roblox / Discord…"
                                        autocomplete="off"
                                        oninput="filterChangeMgrSelect(this)">
                                    <select name="managerName" required
                                        class="admin-input text-[11px] change-mgr-select"
                                        size="4"
                                        style="height: auto; min-height: 6rem;">
                                        <option value="" disabled selected>New manager…</option>
                                        <% if (typeof players !== 'undefined') { %>
                                            <% players.filter(p => p.verified).forEach(p => { %>
                                                <option
                                                    value="<%= p.name %>"
                                                    data-search="<%= ((p.name || '') + ' ' + (p.discord || '')).toLowerCase() %>"
                                                    <%= (aTeam.manager || '').toLowerCase() === (p.name || '').toLowerCase() ? 'selected' : '' %>>
                                                    <%= p.name %><% if (p.discord) { %> · @<%= p.discord %><% } %>
                                                </option>
                                            <% }) %>
                                        <% } %>
                                    </select>
                                    <button type="submit"
                                        class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-2 rounded-lg text-[10px] font-black uppercase transition">
                                        Assign new manager
                                    </button>
                                    <p class="text-[8px] text-slate-400 font-semibold leading-relaxed">
                                        Old manager loses bid rights. Team bids, budget, and locks stay the same.
                                    </p>
                                </form>


                                <div class="grid grid-cols-2 gap-2">

                                    <div class="bg-white p-3 rounded-xl border border-slate-200">
                                        <p class="text-[8px] font-black uppercase text-slate-400">
                                            Total budget
                                        </p>
                                        <p class="text-sm font-black text-emerald-600 font-mono mt-1">
                                            <%= Number(aTeam.budget || 0).toLocaleString() %> V
                                        </p>
                                    </div>

                                    <div class="bg-white p-3 rounded-xl border border-slate-200">
                                        <p class="text-[8px] font-black uppercase text-slate-400">
                                            Locked in bids
                                        </p>
                                        <%
                                            const lockedBids = Array.isArray(aTeam.bids)
                                                ? aTeam.bids.reduce((s, b) => s + (Number(b.amount) || 0), 0)
                                                : 0;
                                            const availNow = Number(aTeam.budget || 0) - Number(aTeam.spent || 0) - lockedBids;
                                            const winningN = Array.isArray(aTeam.wonPlayers) ? aTeam.wonPlayers.length : 0;
                                            const outbidN = Array.isArray(aTeam.outbidPlayers) ? aTeam.outbidPlayers.length : 0;
                                        %>
                                        <p class="text-sm font-black text-amber-600 font-mono mt-1">
                                            <%= lockedBids.toLocaleString() %> V
                                        </p>
                                        <p class="text-[8px] text-slate-400 font-bold mt-0.5">Free ~<%= availNow.toLocaleString() %> V</p>
                                    </div>

                                </div>

                                <div class="grid grid-cols-2 gap-2">
                                    <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-3">
                                        <p class="text-[8px] font-black uppercase text-emerald-600">Currently winning</p>
                                        <p class="text-sm font-black text-emerald-700 mt-1"><%= winningN %></p>
                                        <% if (winningN > 0) { %>
                                            <p class="text-[8px] text-emerald-700/80 font-semibold mt-1 leading-snug truncate">
                                                <%= aTeam.wonPlayers.map(x => x.name).join(', ') %>
                                            </p>
                                        <% } %>
                                    </div>
                                    <div class="bg-rose-50 border border-rose-100 rounded-xl p-3">
                                        <p class="text-[8px] font-black uppercase text-rose-600">Outbid (locked)</p>
                                        <p class="text-sm font-black text-rose-700 mt-1"><%= outbidN %></p>
                                        <% if (outbidN > 0) { %>
                                            <p class="text-[8px] text-rose-700/80 font-semibold mt-1 leading-snug truncate">
                                                <%= aTeam.outbidPlayers.map(x => x.name).join(', ') %>
                                            </p>
                                        <% } %>
                                    </div>
                                </div>

                                <form action="/admin/auction/update-team-budget" method="POST"
                                    class="bg-white border border-slate-200 rounded-xl p-3 space-y-2"
                                    onsubmit="return confirm('Update budget for <%= (aTeam.name || '').replace(/'/g, "\\'") %>?');">
                                    <input type="hidden" name="teamId" value="<%= aTeam._id || aTeam.id %>">
                                    <p class="text-[9px] font-black uppercase text-slate-500 tracking-wider">Edit money</p>
                                    <div class="grid grid-cols-2 gap-2">
                                        <div>
                                            <label class="text-[8px] font-bold uppercase text-slate-400">Total budget</label>
                                            <input type="number" name="budget" min="0" step="1"
                                                value="<%= Number(aTeam.budget || 0) %>"
                                                class="admin-input text-[11px] py-2">
                                        </div>
                                        <div>
                                            <label class="text-[8px] font-bold uppercase text-slate-400">Spent (end only)</label>
                                            <input type="number" name="spent" min="0" step="1"
                                                value="<%= Number(aTeam.spent || 0) %>"
                                                class="admin-input text-[11px] py-2">
                                        </div>
                                    </div>
                                    <button type="submit"
                                        class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-2 rounded-lg text-[10px] font-black uppercase transition">
                                        Save budget
                                    </button>
                                    <p class="text-[8px] text-slate-400 font-semibold leading-relaxed">
                                        Free money = total − spent − locked bids. Raise total to give them more to bid with. Does not remove their bids.
                                    </p>
                                </form>

                                <!-- CLASS BREAKDOWN (auto caps from SS count) -->
                                <div class="bg-white p-3 rounded-xl border border-slate-200 space-y-2">
                                    <span class="text-[9px] font-black uppercase text-slate-400">Class Breakdown</span>
                                    <% if (Array.isArray(aTeam.roster) && aTeam.roster.length > 0) { %>
                                        <%
                                            const classCounts = { SS: 0, S: 0, A: 0, B: 0, C: 0 };
                                            aTeam.roster.forEach(r => {
                                                const rc = (r.rank || 'C').toUpperCase();
                                                if (classCounts[rc] !== undefined) classCounts[rc]++;
                                            });
                                            const ssN = classCounts.SS;
                                            const sCapHint = ssN >= 2 ? 2 : (ssN === 1 ? 3 : 4);
                                            const aCapHint = ssN >= 2 ? 3 : (ssN === 1 ? 5 : 6);
                                        %>
                                        <div class="grid grid-cols-5 gap-1 pt-1">
                                            <% ['SS','S','A','B','C'].forEach(k => { %>
                                                <div class="text-center bg-slate-50 rounded-lg py-1">
                                                    <p class="text-[7px] font-black text-slate-400"><%= k %></p>
                                                    <p class="text-[11px] font-black text-slate-900"><%= classCounts[k] %></p>
                                                </div>
                                            <% }) %>
                                        </div>
                                        <p class="text-[8px] text-slate-400 font-bold uppercase">Caps now: SS 2 · S <%= sCapHint %> · A <%= aCapHint %></p>
                                    <% } else { %>
                                        <p class="text-[9px] text-slate-400 font-bold">No roster yet — caps start at SS 2 / S 4 / A 6</p>
                                    <% } %>
                                </div>


                                <div class="bg-white p-3 rounded-xl border border-slate-200 space-y-2">

                                    <div class="flex justify-between items-center">
                                        <span class="text-[9px] font-black uppercase text-slate-400">
                                            Session State
                                        </span>

                                        <%
                                            const teamAuctionStatus =
                                                (aTeam.status || auctionStatus || 'ready').toString().toLowerCase();
                                        %>

                                        <% if (teamAuctionStatus === 'live' || teamAuctionStatus === 'active') { %>
                                            <span class="text-[9px] font-black uppercase text-red-600">
                                                LIVE
                                            </span>
                                        <% } else if (teamAuctionStatus === 'ended' || teamAuctionStatus === 'closed') { %>
                                            <span class="text-[9px] font-black uppercase text-slate-500">
                                                ENDED
                                            </span>
                                        <% } else { %>
                                            <span class="text-[9px] font-black uppercase text-amber-600">
                                                READY
                                            </span>
                                        <% } %>
                                    </div>

                                    <div class="h-px bg-slate-100"></div>

                                    <p class="text-[9px] text-slate-400 font-bold uppercase leading-relaxed">
                                        This team follows the global auction session. Individual start/end clocks are intentionally removed.
                                    </p>

                                </div>


                                <!-- OVER-LIMIT NOTICE -->
                                <% 
                                    const wonCount =
                                        Array.isArray(aTeam.wonPlayers)
                                            ? aTeam.wonPlayers.length
                                            : (Array.isArray(aTeam.roster) ? aTeam.roster.length : 0);

                                    const maxRoster =
                                        (typeof auctionSession !== 'undefined' && auctionSession && auctionSession.maxRosterSize)
                                            ? Number(auctionSession.maxRosterSize)
                                            : 7;
                                %>

                                <% if (wonCount > maxRoster) { %>

                                    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 space-y-3">

                                        <div>
                                            <p class="text-[9px] font-black uppercase tracking-wider text-amber-700">
                                                Squad Selection Required
                                            </p>

                                            <p class="text-[10px] text-amber-600/90 font-semibold mt-1">
                                                This team has <strong><%= wonCount %></strong> auction wins but can finish with only <strong><%= maxRoster %></strong> players.
                                            </p>
                                        </div>

                                        <form action="/admin/auction/finalize-roster" method="POST" class="space-y-3">

                                            <input
                                                type="hidden"
                                                name="teamId"
                                                value="<%= aTeam.id || aTeam._id %>">

                                            <div class="space-y-2">

                                                <% if (Array.isArray(aTeam.wonPlayers)) { %>

                                                    <% aTeam.wonPlayers.forEach((player, playerIndex) => { %>

                                                        <label class="flex items-center gap-3 bg-white border border-amber-100 rounded-lg p-2.5 cursor-pointer hover:border-amber-300 transition">

                                                            <input
                                                                type="checkbox"
                                                                name="selectedPlayers[]"
                                                                value="<%= player.id || player._id || player.playerId || player.name %>"
                                                                class="w-4 h-4 accent-amber-500"
                                                                <%= playerIndex < maxRoster ? 'checked' : '' %>>

                                                            <span class="text-[10px] font-black uppercase text-slate-700">
                                                                <%= player.name || player %>
                                                            </span>

                                                        </label>

                                                    <% }) %>

                                                <% } else { %>

                                                    <p class="text-[10px] text-slate-400 uppercase font-bold">
                                                        Auction winners will appear here once the backend exposes them.
                                                    </p>

                                                <% } %>

                                            </div>

                                            <button
                                                type="submit"
                                                class="w-full bg-amber-500 hover:bg-amber-600 text-white py-2.5 rounded-lg text-[10px] font-black uppercase transition">
                                                Finalize Selected Roster
                                            </button>

                                        </form>

                                    </div>

                                <% } else if (wonCount > 0) { %>

                                    <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-3">
                                        <p class="text-[9px] font-black uppercase tracking-wider text-emerald-700">
                                            Roster Can Finalize Automatically
                                        </p>
                                        <p class="text-[10px] text-emerald-600/80 font-semibold mt-1">
                                            <%= wonCount %> player(s) won • limit is <%= maxRoster %>. No manager selection is required.
                                        </p>
                                    </div>

                                <% } %>

                            </div>

                        <% }) %>

                    <% } else { %>

                        <div class="col-span-full py-12 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-200">

                            <p class="text-xs text-slate-400 uppercase font-bold tracking-widest">
                                No teams added to the auction yet
                            </p>

                        </div>

                    <% } %>

                </div>


            </div>

        </div>

        <!-- AUCTION AUDIT LOG (full width) -->
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden w-full">
            <div class="px-5 py-4 border-b border-slate-100 flex flex-wrap items-center justify-between gap-2 bg-slate-50">
                <div>
                    <p class="text-[11px] font-black uppercase tracking-wider text-slate-800">Auction audit log</p>
                    <p class="text-[10px] text-slate-400 font-semibold mt-0.5">Bids · withdraws · force-drops · ranks · start/end</p>
                </div>
                <span class="text-[10px] font-bold text-slate-500 bg-white border border-slate-200 px-2.5 py-1 rounded-lg">
                    <%= typeof auctionActivityFeed !== 'undefined' ? auctionActivityFeed.length : 0 %> recent
                </span>
            </div>
            <div class="max-h-[480px] overflow-y-auto overflow-x-auto">
                <% if (typeof auctionActivityFeed === 'undefined' || !auctionActivityFeed || !auctionActivityFeed.length) { %>
                    <p class="text-center text-xs text-slate-400 font-bold uppercase tracking-wider py-12">No auction events yet</p>
                <% } else { %>
                    <table class="w-full text-left border-collapse min-w-[640px]">
                        <thead class="sticky top-0 bg-slate-50 border-b border-slate-200">
                            <tr class="text-[9px] font-black uppercase tracking-wider text-slate-400">
                                <th class="px-4 py-2 w-28">Type</th>
                                <th class="px-4 py-2">Player</th>
                                <th class="px-4 py-2">Team / Manager</th>
                                <th class="px-4 py-2 text-right">Amount</th>
                                <th class="px-4 py-2 text-right">When</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                        <% auctionActivityFeed.forEach(function(ev) {
                            var t = String(ev.type || '').toLowerCase();
                            var badge = 'bg-slate-100 text-slate-600';
                            var label = t || 'event';
                            if (t === 'bid') { badge = 'bg-blue-50 text-blue-700'; label = 'BID'; }
                            else if (t === 'withdraw') { badge = 'bg-amber-50 text-amber-700'; label = (ev.meta && ev.meta.forced) ? 'FORCE DROP' : 'WITHDRAW'; }
                            else if (t === 'won') { badge = 'bg-emerald-50 text-emerald-700'; label = 'WON'; }
                            else if (t === 'auction_start') { badge = 'bg-red-50 text-red-700'; label = 'START'; }
                            else if (t === 'auction_end') { badge = 'bg-slate-800 text-white'; label = 'END'; }
                            else if (t === 'rank_change') { badge = 'bg-purple-50 text-purple-700'; label = 'RANK'; }
                        %>
                            <tr class="hover:bg-slate-50/80">
                                <td class="px-4 py-2.5 align-middle">
                                    <span class="text-[9px] font-black uppercase tracking-wide px-2 py-1 rounded-md <%= badge %>"><%= label %></span>
                                </td>
                                <td class="px-4 py-2.5 text-xs font-bold text-slate-900">
                                    <%= ev.playerName || '—' %>
                                    <% if (ev.meta && ev.meta.oldRank && ev.meta.rank) { %>
                                        <span class="text-slate-400 font-semibold"> (<%= ev.meta.oldRank %>→<%= ev.meta.rank %>)</span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-2.5 text-[11px] font-semibold text-slate-600">
                                    <%= ev.teamName || '' %><% if (ev.managerName) { %> · <%= ev.managerName %><% } %>
                                    <% if (ev.meta && ev.meta.ghostClear) { %> <span class="text-amber-600">· ghost</span><% } %>
                                </td>
                                <td class="px-4 py-2.5 text-xs font-black text-slate-900 text-right font-mono">
                                    <% if (ev.amount) { %><%= Number(ev.amount).toLocaleString() %> V<% } else { %>—<% } %>
                                </td>
                                <td class="px-4 py-2.5 text-[10px] text-slate-400 font-bold text-right whitespace-nowrap">
                                    <%= ev.createdAt ? new Date(ev.createdAt).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '' %>
                                </td>
                            </tr>
                        <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>

    </section>
<!-- SHARED ADMIN STYLES -->
<!-- ============================================================= -->
<style>

    .admin-label {
        display: block;
        margin-bottom: 0.3rem;
        font-size: 10px;
        line-height: 1rem;
        font-weight: 700;
        text-transform: uppercase;
        color: rgb(100 116 139);
    }

    .admin-input {
        width: 100%;
        background: rgb(248 250 252);
        border: 1px solid rgb(226 232 240);
        padding: 0.75rem;
        border-radius: 0.75rem;
        color: rgb(15 23 42);
        font-size: 0.75rem;
        outline: none;
        transition: all 0.15s ease;
    }

    .admin-input:focus {
        border-color: rgb(59 130 246);
        background: white;
    }

    .player-select {
        width: 100%;
        background: rgb(248 250 252);
        border: 1px solid rgb(226 232 240);
        padding: 0.75rem;
        border-radius: 0.75rem;
        color: rgb(15 23 42);
        font-size: 0.75rem;
        outline: none;
        transition: all 0.15s ease;
    }

    .player-select:focus {
        border-color: rgb(16 185 129);
        background: white;
    }

    .table-label {
        font-size: 9px;
        color: rgb(148 163 184);
        text-transform: uppercase;
        display: block;
        margin-bottom: 2px;
    }

    .table-input {
        width: 100%;
        background: rgb(248 250 252);
        border: 1px solid rgb(226 232 240);
        border-radius: 0.25rem;
        padding: 0.375rem;
        color: rgb(15 23 42);
        text-align: center;
        font-size: 0.75rem;
        outline: none;
    }

    .table-input:focus {
        border-color: rgb(59 130 246);
        background: white;
    }

    /* =========================================================
       ADMIN MODALS
       ========================================================= */

    .admin-modal {
        position: fixed;
        inset: 0;
        z-index: 200000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }

    .admin-modal.hidden {
        display: none;
    }

    .admin-modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .admin-modal-card {
        position: relative;
        width: 100%;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
        background: white;
        border: 1px solid rgb(226 232 240);
        border-radius: 1.5rem;
        padding: 1.5rem;
        box-shadow: 0 30px 90px rgba(15, 23, 42, 0.25);
        animation: adminModalIn 0.22s ease-out;
    }

    .admin-modal-close {
        width: 34px;
        height: 34px;
        border: 1px solid rgb(226 232 240);
        background: rgb(248 250 252);
        color: rgb(100 116 139);
        border-radius: 10px;
        font-size: 20px;
        line-height: 1;
        font-weight: 900;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .admin-modal-close:hover {
        background: rgb(241 245 249);
        color: rgb(15 23 42);
        transform: scale(1.04);
    }

    @keyframes adminModalIn {
        from {
            opacity: 0;
            transform: translateY(10px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @media (max-width: 640px) {
        .admin-modal {
            padding: 0.6rem;
            align-items: flex-end;
        }

        .admin-modal-card {
            max-height: calc(100vh - 1.2rem);
            border-radius: 1.25rem;
            padding: 1.1rem;
        }
    }

</style>


<!-- ============================================================= -->
<!-- ADMIN JAVASCRIPT -->
<!-- ============================================================= -->
<script>

    /* ============================================================
       MATCH CENTER DATA
       (verified players for lineup/MVP/stat selects, and existing
       match reports so the editor can be pre-filled when an admin
       picks a match from the dropdown)
    ============================================================ */

    const ADMIN_VERIFIED_PLAYERS = <%- JSON.stringify(
        (typeof players !== 'undefined' ? players : [])
            .filter(p => p.verified)
            .map(p => ({ name: p.name, position: p.position || 'FWD' }))
    ).replace(/</g, '\\u003c') %>;

    const ADMIN_MATCHES_DATA = <%- JSON.stringify(
        (typeof matches !== 'undefined' ? matches : []).map(m => ({
            id: (m._id || m.id || '').toString(),
            details: m.details || null
        }))
    ).replace(/</g, '\\u003c') %>;

    /* ============================================================
       HELPER FUNCTIONS & SCHEDULE EDITOR
    ============================================================ */

    function pad(number) {
        return String(number).padStart(2, '0');
    }

    function toDateTimeLocalValue(dateInput) {
        if (!dateInput) return '';
        const date = new Date(dateInput);
        if (Number.isNaN(date.getTime())) return '';
        return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
    }

    function openScheduleEditor(button) {
        const card = button.closest('.schedule-card');
        if (!card) return;
        const modal = document.getElementById('scheduleEditorModal');
        if (!modal) return;
        document.getElementById('scheduleEditId').value = card.dataset.matchId || '';
        document.getElementById('scheduleEditTeamA').value = card.dataset.teamA || '';
        document.getElementById('scheduleEditTeamB').value = card.dataset.teamB || '';
        document.getElementById('scheduleEditLogoA').value = card.dataset.logoA || '';
        document.getElementById('scheduleEditLogoB').value = card.dataset.logoB || '';
        document.getElementById('scheduleEditTime').value = toDateTimeLocalValue(card.dataset.time || '');
        document.getElementById('scheduleEditTags').value = card.dataset.tags || '';
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
    }

    function closeScheduleEditor() {
        const modal = document.getElementById('scheduleEditorModal');
        if (!modal) return;
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }

    /* ============================================================ HALL OF FAME EDITOR ============================================================ */
    function openRecordEditor(button) {
        const modal = document.getElementById('recordEditorModal');
        if (!modal) return;
        document.getElementById('recordEditId').value = button.dataset.recordId || '';
        document.getElementById('recordEditTitle').value = button.dataset.title || '';
        document.getElementById('recordEditHolder').value = button.dataset.holder || '';
        document.getElementById('recordEditValue').value = button.dataset.value || '';
        document.getElementById('recordEditCategory').value = button.dataset.category || 'season';
        document.getElementById('recordEditSeason').value = button.dataset.season || '';
        document.getElementById('recordEditCompetition').value = button.dataset.competition || '';
        document.getElementById('recordEditType').value = button.dataset.recordType || 'custom';
        document.getElementById('recordEditDescription').value = button.dataset.description || '';
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
    }

    function closeRecordEditor() {
        const modal = document.getElementById('recordEditorModal');
        if (!modal) return;
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }

    /* ============================================================ LOCAL TIME DISPLAY ============================================================ */
    function formatVimLocalTimes() {
        const elements = document.querySelectorAll('[data-vim-datetime]');
        elements.forEach(element => {
            const raw = element.getAttribute('data-vim-datetime');
            if (!raw) return;
            const date = new Date(raw);
            if (Number.isNaN(date.getTime())) {
                return;
            }
            element.textContent = date.toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
        });
    }

    /* ============================================================ MATCH CENTER HELPERS ============================================================ */

    // Builds the shared <option> list (verified players only, matching
    // what the backend accepts) for every lineup/MVP/stat-row select.
    function buildPlayerOptionsHTML(placeholder, selected) {
        let html = `<option value="">${placeholder}</option>`;
        ADMIN_VERIFIED_PLAYERS.forEach(p => {
            const isSelected = selected && selected === p.name ? 'selected' : '';
            html += `<option value="${p.name}" ${isSelected}>${p.name} (${p.position})</option>`;
        });
        return html;
    }

    // Fills the fixed lineup + MVP selects on the page with real players.
    function populatePlayerSelects() {
        document.querySelectorAll('select.player-select[id^="lineup"]').forEach(select => {
            const current = select.value;
            select.innerHTML = buildPlayerOptionsHTML('Select player...', current);
        });

        const mvpSelect = document.getElementById('mvpSelect');
        if (mvpSelect) {
            const current = mvpSelect.value;
            mvpSelect.innerHTML = buildPlayerOptionsHTML('Select MVP...', current);
        }
    }

    let statRowCounter = 0;

    // Adds one "player + type + value + assists" row to the match stats
    // section. team is 'teamA' or 'teamB' and feeds the field names the
    // /admin/update-match-details route already expects (teamAPlayer,
    // teamAType, teamAMainValue, teamAAssists — or the teamB equivalents).
    function addStatRow(team, prefill) {
        const container = document.getElementById(`statRows-${team}`);
        if (!container) return;

        prefill = prefill || {};
        const rowId = `statRow-${team}-${statRowCounter++}`;
        const fieldPrefix = team === 'teamB' ? 'teamB' : 'teamA';

        const row = document.createElement('div');
        row.id = rowId;
        row.className = 'grid grid-cols-12 gap-2 items-center bg-slate-50 border border-slate-200 rounded-xl p-2';

        row.innerHTML = `
            <div class="col-span-4">
                <select name="${fieldPrefix}Player" class="player-select text-[11px] p-2">
                    ${buildPlayerOptionsHTML('Player...', prefill.name || '')}
                </select>
            </div>
            <div class="col-span-3">
                <select name="${fieldPrefix}Type" class="player-select text-[11px] p-2">
                    ${['Goal', 'Assist', 'Save', 'Clean Sheet', 'Rating'].map(t =>
                        `<option value="${t}" ${prefill.type === t ? 'selected' : ''}>${t}</option>`
                    ).join('')}
                </select>
            </div>
            <div class="col-span-2">
                <input type="number" name="${fieldPrefix}MainValue" placeholder="Value" value="${prefill.value != null ? prefill.value : ''}" class="admin-input text-[11px] p-2">
            </div>
            <div class="col-span-2">
                <input type="number" name="${fieldPrefix}Assists" placeholder="Assists" value="${prefill.assists != null ? prefill.assists : ''}" class="admin-input text-[11px] p-2">
            </div>
            <div class="col-span-1 text-center">
                <button type="button" onclick="removeStatRow('${rowId}')" class="text-red-500 hover:text-red-700 font-black text-xs" title="Remove player">✕</button>
            </div>
        `;

        container.appendChild(row);
    }

    function removeStatRow(rowId) {
        const row = document.getElementById(rowId);
        if (row) row.remove();
    }

    // Fires when an admin picks a match in the "Select Match" dropdown.
    // Wires the hidden matchId used by the report form, and — if that
    // match already has a saved report — pre-fills every field so the
    // admin is editing the existing report instead of starting blank.
    function handleMatchSelect(matchId) {
        const hiddenId = document.getElementById('hiddenMatchId');
        if (hiddenId) hiddenId.value = matchId || '';

        clearMatchEditor(true);

        const match = ADMIN_MATCHES_DATA.find(m => m.id === matchId);
        const details = match && match.details ? match.details : null;

        if (!details) return;

        const form = document.querySelector('form[action="/admin/update-match-details"]');
        if (!form) return;

        const setVal = (name, value) => {
            const field = form.elements[name];
            if (field && value !== undefined && value !== null) field.value = value;
        };

        setVal('narrative', details.narrative);
        setVal('highlights', details.highlights);
        setVal('standouts', details.standouts);
        setVal('possessionA', details.possessionA);
        setVal('possessionB', details.possessionB);
        setVal('goalsA', details.goalsA);
        setVal('goalsB', details.goalsB);
        setVal('lineupA', details.lineupA);
        setVal('lineupB', details.lineupB);
        setVal('mvpCardUrl', details.mvpCardUrl);
        setVal('assistsA', details.assistsA);
        setVal('savesA', details.savesA);
        setVal('assistsB', details.assistsB);
        setVal('savesB', details.savesB);

        ['A', 'B'].forEach(side => {
            ['gk', 'def1', 'def2', 'mid1', 'mid2', 'fwd1', 'fwd2'].forEach(slot => {
                setVal(`lineup${side}_${slot}`, details[`lineup${side}_${slot}`]);
                setVal(`lineup${side}_${slot}_number`, details[`lineup${side}_${slot}_number`]);
                setVal(`lineup${side}_${slot}_rating`, details[`lineup${side}_${slot}_rating`]);
            });
        });

        if (details.mvpName) setVal('mvpName', details.mvpName);

        // Re-populate selects now that values are set, keeping selections.
        populatePlayerSelects();

        (details.teamAPlayers || []).forEach(p => addStatRow('teamA', p));
        (details.teamBPlayers || []).forEach(p => addStatRow('teamB', p));
    }

    function clearMatchEditor(keepMatchId) {
        const form = document.querySelector( 'form[action="/admin/update-match-details"]' );
        if (!form) return;
        form.reset();
        const hiddenId = document.getElementById('hiddenMatchId');
        if (hiddenId && !keepMatchId) {
            hiddenId.value = '';
        }
        document .querySelectorAll('.player-select') .forEach(select => {
            select.value = '';
        });
        document .querySelectorAll('[id^="statRows-"]') .forEach(container => {
            container.innerHTML = '';
        });
    }

    /* ============================================================ SAFETY: CLOSE MODALS WITH ESCAPE ============================================================ */
    document.addEventListener('keydown', function(event) {
        if (event.key !== 'Escape') return;
        closeScheduleEditor();
        closeRecordEditor();
    });

    /* ============================================================ ADMIN INITIALIZATION ============================================================ */
    document.addEventListener('DOMContentLoaded', function() {
        formatVimLocalTimes();
        populatePlayerSelects();
        const defaultTab = document.querySelector('.tab-section:not(.hidden)');
        if (!defaultTab) {
            switchTab('broadcast');
        }
    });

    /* ============================================================
       TAB SWITCHING
    ============================================================ */

    function switchTab(tabName) {

        const sections = document.querySelectorAll('.tab-section');

        sections.forEach(section => {
            section.classList.add('hidden');
        });


        const tabs = document.querySelectorAll('.tab-btn');

        tabs.forEach(tab => {

            tab.classList.remove(
                'bg-blue-600',
                'text-white',
                'border-blue-600',
                'shadow-md'
            );

            tab.classList.add(
                'bg-white',
                'text-slate-700',
                'border-slate-200'
            );

        });


        const activeSection = document.getElementById(`section-${tabName}`);

        if (activeSection) {
            activeSection.classList.remove('hidden');
        }


        const activeTab = document.getElementById(`tab-${tabName}`);

        if (activeTab) {

            activeTab.classList.remove(
                'bg-white',
                'text-slate-700',
                'border-slate-200'
            );

            activeTab.classList.add(
                'bg-blue-600',
                'text-white',
                'border-blue-600',
                'shadow-md'
            );

        }

    }


    /* ============================================================
       SEARCH — Verification Queue & Player Market
       (data-search on each card already includes name + discord, so a
       partial Discord handle match works the same as a name match)
    ============================================================ */

    function filterQueue(inputEl) {
        const query = (inputEl.value || '').toLowerCase().trim();
        document.querySelectorAll('#queueList .queue-card').forEach(card => {
            const haystack = card.getAttribute('data-search') || '';
            card.style.display = haystack.includes(query) ? '' : 'none';
        });
    }

    
    function filterChangeMgrSelect(inputEl) {
        const q = (inputEl.value || '').toLowerCase().trim();
        const form = inputEl.closest('form');
        if (!form) return;
        const select = form.querySelector('.change-mgr-select');
        if (!select) return;
        Array.from(select.options).forEach((opt, i) => {
            if (i === 0 && (!opt.value || opt.disabled)) {
                opt.hidden = false;
                return;
            }
            const hay = (opt.getAttribute('data-search') || opt.textContent || '').toLowerCase();
            opt.hidden = !(!q || hay.includes(q));
        });
    }

    function filterManagerSelect(query) {
        const q = (query || '').toLowerCase().trim();
        const select = document.getElementById('managerSelect');
        if (!select) return;
        const options = Array.from(select.options);
        options.forEach((opt, i) => {
            if (i === 0 && (!opt.value || opt.disabled)) {
                opt.hidden = false;
                return;
            }
            const hay = (opt.getAttribute('data-search') || opt.textContent || '').toLowerCase();
            opt.hidden = !(!q || hay.includes(q));
        });
        if (select.value) {
            const selected = options.find(o => o.value === select.value);
            if (selected && selected.hidden) select.value = '';
        }
    }

    function filterPlayers() {
        const input = document.getElementById('playerSearch');
        const query = (input ? input.value : '').toLowerCase().trim();
        document.querySelectorAll('#marketList .player-card').forEach(card => {
            const haystack = card.getAttribute('data-search') || card.getAttribute('data-name') || '';
            card.style.display = haystack.includes(query) ? '' : 'none';
        });
    }

    /* ============================================================
       PASSWORD VIEW
    ============================================================ */

    function togglePasswordView(id, actualPass) {

        const textElement =
            document.getElementById(`passText-${id}`);

        if (!textElement) return;


        if (textElement.innerText === '••••••••') {

            textElement.innerText = actualPass;

        } else {

            textElement.innerText = '••••••••';

        }

    }


    /* ============================================================
       DELETE PLAYER
    ============================================================ */

    function triggerDelete(id) {

        if (!confirm('PERMANENTLY DELETE THIS PLAYER FROM THE MARKET?')) {
            return;
        }

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/admin/delete-player';

        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'playerId';
        input.value = id;

        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();

    }

</script>
