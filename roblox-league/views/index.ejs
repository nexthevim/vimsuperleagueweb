            <a href="/market" class="vsl-service">
                <div class="vsl-service-icon" aria-hidden="true">
                    <svg viewBox="0 0 32 32" fill="none">
                        <circle cx="16" cy="11" r="5.5" fill="#ede9fe"/>
                        <path d="M7 26c1.5-5 5-7.5 9-7.5s7.5 2.5 9 7.5" stroke="#fff" stroke-width="3" stroke-linecap="round" fill="none"/>
                        <path d="M7 26c1.5-5 5-7.5 9-7.5s7.5 2.5 9 7.5" stroke="#5b21b6" stroke-width="1.5" stroke-linecap="round" fill="none"/>
                        <circle cx="16" cy="11" r="5.5" stroke="#5b21b6" stroke-width="1.5" fill="none"/>
                    </svg>
                </div>
                <h3>Player profiles</h3>
                <p>Find the players behind the lineups and keep an eye on the talent moving through VIM.</p>
                <span class="vsl-mini-link">Browse players</span>
            </a>

            <a href="/matches" class="vsl-service">
                <div class="vsl-service-icon" aria-hidden="true">
                    <svg viewBox="0 0 32 32" fill="none">
