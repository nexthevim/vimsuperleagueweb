            modalImg.style.display = "block";
            placeholder.style.display = "none";
        } else {
            modalImg.style.display = "none";
            placeholder.style.display = "flex";
        }

        document.getElementById('modalBio').innerText = bio;
        document.getElementById('modalDiscord').innerText = "@" + discord;
        
        // Dynamic Badge Styling in Modal
        const posBadge = document.getElementById('modalPosBadge');
        const posUpper = (pos || 'PRO').toUpperCase();
        posBadge.innerText = posUpper;
        
        let posClass = 'pos-pro';
        if(posUpper === 'FWD' || posUpper === 'FORWARD') posClass = 'pos-fwd';
        else if(posUpper === 'MID' || posUpper === 'MIDFIELD') posClass = 'pos-mid';
        else if(posUpper === 'DEF' || posUpper === 'DEFENSE') posClass = 'pos-def';
        else if(posUpper === 'GK' || posUpper === 'GOALKEEPER') posClass = 'pos-gk';
        
        posBadge.className = `${posClass} text-white text-[10px] font-black px-3 py-1 rounded-lg italic uppercase tracking-wider`;

        document.getElementById('modalCountryBadge').innerText = country || 'UNKNOWN';
        document.getElementById('modalTZ').innerText = "TIMEZONE: " + (tz || 'N/A');
        
        document.getElementById('mGoals').innerText = g;
        document.getElementById('mAssists').innerText = a;
        document.getElementById('mSaves').innerText = s;
        document.getElementById('mMvps').innerText = m;
        document.getElementById('modalViews').innerText = currentViews;

        // Set Auction Details in Modal safely
        const hBid = (highestBid && highestBid !== 'undefined' && highestBid !== 'null') ? highestBid : '0';
        const hBidder = (bidder && bidder !== 'undefined' && bidder !== 'null' && bidder !== 'None') ? bidder : null;
        const rPrice = (reservePrice && reservePrice !== 'undefined' && reservePrice !== 'null') ? reservePrice : '0';

        const hasRealBid = !!(hBidder && (parseInt(hBid, 10) || 0) > 0);
        const bidLabel = document.getElementById('modalHighestBidLabel');
        const bidEl = document.getElementById('modalHighestBid');
        if (bidEl) {
            if (hasRealBid) {
                if (bidLabel) bidLabel.innerText = 'Highest Bid';
                bidEl.innerText = Number(hBid).toLocaleString() + ' Vollars (' + hBidder + ')';
                bidEl.classList.remove('text-slate-400');
                bidEl.classList.add('text-emerald-600');
            } else {
                if (bidLabel) bidLabel.innerText = 'Current Bid';
                bidEl.innerText = 'No bids yet';
                bidEl.classList.add('text-slate-400');
                bidEl.classList.remove('text-emerald-600');
            }
        }
        if (document.getElementById('modalReservePrice')) {
            document.getElementById('modalReservePrice').innerText = Number(rPrice).toLocaleString() + ' Vollars';
        }
        if (document.getElementById('modalPlayerId')) {
            document.getElementById('modalPlayerId').value = (playerId && playerId !== 'undefined' && playerId !== 'null') ? playerId : '';
        }
        if (document.getElementById('modalWithdrawPlayerId')) {
            document.getElementById('modalWithdrawPlayerId').value =
                (playerId && playerId !== 'undefined' && playerId !== 'null') ? playerId : '';
        }
        if (document.getElementById('modalBidInput')) {
            const minNextBid = computeMinNextBid(hasRealBid ? (parseInt(hBid, 10) || 0) : 0, parseInt(rPrice, 10) || 0);
            document.getElementById('modalBidInput').min = minNextBid;
            document.getElementById('modalBidInput').placeholder = 'Min bid: ' + minNextBid.toLocaleString() + ' Vollars';
            document.getElementById('modalBidInput').value = '';
            renderQuickBidButtons(minNextBid, hasRealBid ? (parseInt(hBid, 10) || 0) : 0);
        }
// Reset the bid button back to its default "Place Bid" state every time
