<%- include('partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* —— not a template. intentional layout. —— */
    body {
        margin: 0;
        background: #0c0c0c;
        color: #ececec;
        font-family: 'IBM Plex Sans', system-ui, sans-serif;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
    }

    .h {
        padding-top: 4.5rem;
        background: #0c0c0c;
    }

    .h-wide {
        width: min(1320px, calc(100% - 2rem));
        margin: 0 auto;
    }

    /* top strip under nav */
    .h-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.85rem 0 0.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        margin-bottom: 1.25rem;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: rgba(255,255,255,0.45);
    }
    .h-top strong { color: #fff; font-weight: 700; }
    .h-top a { color: #8ec5ff; text-decoration: none; font-weight: 600; }
    .h-top a:hover { text-decoration: underline; }

    /* HERO — asymmetric */
    .h-hero {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 1.25rem;
        align-items: stretch;
        margin-bottom: 1.5rem;
    }

    .h-hero-main {
        position: relative;
        min-height: 420px;
        border-radius: 4px;
        overflow: hidden;
        background:
            linear-gradient(90deg, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.35) 55%, rgba(0,0,0,0.15) 100%),
            url('/images/vimgfx.png') center center / cover no-repeat;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 2rem 2rem 2.15rem;
    }

    .h-hero-main h1 {
        margin: 0 0 0.65rem;
        font-family: 'Archivo Black', Impact, sans-serif;
        font-size: clamp(2.4rem, 5.5vw, 4.1rem);
        line-height: 0.95;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        max-width: 11ch;
    }

    .h-hero-main p {
        margin: 0 0 1.35rem;
        max-width: 28rem;
        font-size: 0.95rem;
        line-height: 1.55;
        color: rgba(255,255,255,0.72);
        font-weight: 500;
    }

    .h-btns {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
    }

    .h-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.7rem 1.05rem;
        font-size: 0.78rem;
        font-weight: 700;
        text-decoration: none;
        border-radius: 3px;
        transition: transform 0.15s ease, background 0.15s ease;
    }
    .h-btn:hover { transform: translateY(-1px); }
    .h-btn-w { background: #fff; color: #0c0c0c; }
    .h-btn-w:hover { background: #e8e8e8; color: #0c0c0c; }
    .h-btn-o {
        background: transparent;
        color: #fff;
        border: 1px solid rgba(255,255,255,0.35);
    }
    .h-btn-o:hover { border-color: #fff; color: #fff; background: rgba(255,255,255,0.06); }

    /* side column: search + next match */
    .h-side {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .h-search {
        position: relative;
        background: #161616;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 4px;
        padding: 0.85rem;
    }
    .h-search label {
        display: block;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.4);
        margin-bottom: 0.55rem;
    }
    .h-search-row {
        display: flex;
        gap: 0.4rem;
    }
    .h-search input {
        flex: 1;
        min-width: 0;
        border: 0;
        outline: none;
        background: #0c0c0c;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 3px;
        padding: 0.7rem 0.85rem;
        color: #fff;
        font-family: inherit;
        font-size: 0.88rem;
        font-weight: 500;
    }
    .h-search input::placeholder { color: rgba(255,255,255,0.3); }
    .h-search button {
        border: 0;
        border-radius: 3px;
        padding: 0.7rem 0.95rem;
        background: #3b82f6;
        color: #fff;
        font-family: inherit;
        font-size: 0.75rem;
        font-weight: 700;
        cursor: pointer;
    }
    .h-search button:hover { background: #2563eb; }
    #search-results-dropdown {
        position: absolute;
        left: 0.85rem; right: 0.85rem;
        top: calc(100% - 0.25rem);
        background: #1a1a1a;
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 4px;
        padding: 0.65rem;
        max-height: 18rem;
        overflow-y: auto;
        z-index: 40;
        box-shadow: 0 16px 40px rgba(0,0,0,0.5);
    }

    .h-next {
        flex: 1;
        background: #161616;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 4px;
        padding: 1rem 1.05rem;
        display: flex;
        flex-direction: column;
    }
    .h-next-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 1rem;
    }
    .h-next-head span {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.4);
    }
    .h-next-head a {
        font-size: 0.72rem;
        font-weight: 600;
        color: #8ec5ff;
        text-decoration: none;
    }
    .h-next-head a:hover { text-decoration: underline; }

    .h-match {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 0.75rem;
        align-items: center;
        flex: 1;
    }
    .h-team {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        text-align: center;
    }
    .h-team img { width: 3.25rem; height: 3.25rem; object-fit: contain; }
    .h-team b {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        line-height: 1.25;
    }
    .h-vs {
        text-align: center;
        font-family: 'Archivo Black', sans-serif;
        font-size: 1.1rem;
        color: rgba(255,255,255,0.35);
    }
    .h-vs small {
        display: block;
        margin-top: 0.35rem;
        font-family: 'IBM Plex Sans', sans-serif;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.45);
    }

    /* 3D nav tiles — hand-made feel */
    .h-tiles {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.75rem;
        margin-bottom: 2rem;
    }

    .h-tile {
        position: relative;
        display: block;
        text-decoration: none;
        color: #fff;
        border-radius: 6px;
        padding: 1.15rem 1rem 1.05rem;
        background: #151515;
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow:
            0 1px 0 rgba(255,255,255,0.06) inset,
            0 8px 0 #0a0a0a,
            0 12px 24px rgba(0,0,0,0.35);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
        transform: translateY(0);
    }
    .h-tile:hover {
        transform: translateY(-6px);
        box-shadow:
            0 1px 0 rgba(255,255,255,0.08) inset,
            0 14px 0 #0a0a0a,
            0 20px 32px rgba(0,0,0,0.45);
        color: #fff;
    }
    .h-tile:active {
        transform: translateY(2px);
        box-shadow:
            0 1px 0 rgba(255,255,255,0.04) inset,
            0 4px 0 #0a0a0a,
            0 6px 12px rgba(0,0,0,0.3);
    }

    .h-tile-ico {
        width: 3rem;
        height: 3rem;
        margin-bottom: 0.75rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .h-tile-ico svg { width: 1.75rem; height: 1.75rem; }
    .h-tile:nth-child(1) .h-tile-ico { background: #1d4ed8; }
    .h-tile:nth-child(2) .h-tile-ico { background: #15803d; }
    .h-tile:nth-child(3) .h-tile-ico { background: #7c3aed; }
    .h-tile:nth-child(4) .h-tile-ico { background: #c2410c; }

    .h-tile strong {
        display: block;
        font-size: 0.95rem;
        font-weight: 700;
        margin-bottom: 0.2rem;
    }
    .h-tile span {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.45);
        line-height: 1.35;
    }

    /* two column body */
    .h-body {
        display: grid;
        grid-template-columns: 1.35fr 0.65fr;
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .h-block {
        background: #141414;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 4px;
        padding: 1.15rem 1.2rem 1.25rem;
    }
    .h-block-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 1rem;
        padding-bottom: 0.65rem;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .h-block-title h2 {
        margin: 0;
        font-family: 'Archivo Black', sans-serif;
        font-size: 1rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
    }
    .h-block-title a {
        font-size: 0.72rem;
        font-weight: 600;
        color: #8ec5ff;
        text-decoration: none;
    }

    .h-stream {
        background: #000;
        border-radius: 3px;
        min-height: 240px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.06);
    }
    .h-stream iframe {
        width: 100%;
        min-height: 260px;
        border: 0;
        display: block;
    }
    .h-stream-off {
        min-height: 240px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        color: rgba(255,255,255,0.35);
        font-size: 0.85rem;
    }
    .h-stream-off b {
        color: rgba(255,255,255,0.7);
        font-size: 0.95rem;
    }

    /* results list — compact, not cards */
    .h-results { list-style: none; margin: 0; padding: 0; }
    .h-results li { border-bottom: 1px solid rgba(255,255,255,0.06); }
    .h-results li:last-child { border-bottom: 0; }
    .h-results a {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.75rem;
        align-items: center;
        padding: 0.7rem 0.15rem;
        text-decoration: none;
        color: inherit;
    }
    .h-results a:hover { background: rgba(255,255,255,0.03); }
    .h-res-teams {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        min-width: 0;
    }
    .h-res-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        font-weight: 600;
    }
    .h-res-row img { width: 1.25rem; height: 1.25rem; object-fit: contain; }
    .h-res-row span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .h-res-score {
        font-family: 'Archivo Black', sans-serif;
        font-size: 1.05rem;
        text-align: right;
        line-height: 1.35;
        min-width: 1.5rem;
    }
    .h-res-score .dim { color: rgba(255,255,255,0.4); }

    /* about strip */
    .h-about {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 1.5rem;
        align-items: center;
        margin-bottom: 2rem;
        padding: 1.5rem;
        background: #121212;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 4px;
    }
    .h-about-ph {
        min-height: 200px;
        background: #1a1a1a;
        border: 1px dashed rgba(255,255,255,0.12);
        border-radius: 3px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,0.3);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        position: relative;
        overflow: hidden;
    }
    .h-about-ph img {
        position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    }
    .h-about h2 {
        margin: 0 0 0.65rem;
        font-family: 'Archivo Black', sans-serif;
        font-size: 1.35rem;
        text-transform: uppercase;
        letter-spacing: 0.01em;
    }
    .h-about p {
        margin: 0 0 0.75rem;
        font-size: 0.92rem;
        line-height: 1.6;
        color: rgba(255,255,255,0.6);
    }

    /* stories — simple grid */
    .h-stories {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.85rem;
        margin-bottom: 2rem;
    }
    .h-story {
        background: #141414;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 4px;
        overflow: hidden;
    }
    .h-story-img {
        aspect-ratio: 16/9;
        background: #1a1a1a;
    }
    .h-story-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .h-story-body { padding: 0.9rem 1rem 1.05rem; }
    .h-story-body small {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.4);
    }
    .h-story-body h3 {
        margin: 0.3rem 0 0.35rem;
        font-size: 0.95rem;
        font-weight: 700;
        line-height: 1.25;
    }
    .h-story-body p {
        margin: 0;
        font-size: 0.8rem;
        line-height: 1.45;
        color: rgba(255,255,255,0.5);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* footer */
    .h-foot {
        border-top: 1px solid rgba(255,255,255,0.1);
        padding: 1.75rem 0 2rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 1.25rem;
        align-items: flex-start;
    }
    .h-foot p {
        margin: 0;
        max-width: 22rem;
        font-size: 0.85rem;
        line-height: 1.55;
        color: rgba(255,255,255,0.45);
    }
    .h-socials {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .h-social {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 0.9rem;
        background: #1a1a1a;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 3px;
        color: #fff;
        text-decoration: none;
        font-size: 0.78rem;
        font-weight: 600;
    }
    .h-social:hover { background: #222; color: #fff; }
    .h-social svg { width: 1rem; height: 1rem; }

    .h-empty {
        padding: 1.5rem;
        text-align: center;
        color: rgba(255,255,255,0.35);
        font-size: 0.8rem;
        font-weight: 600;
    }

    @media (max-width: 960px) {
        .h-hero, .h-body, .h-about { grid-template-columns: 1fr; }
        .h-tiles { grid-template-columns: 1fr 1fr; }
        .h-stories { grid-template-columns: 1fr; }
        .h-hero-main { min-height: 340px; }
    }
    @media (max-width: 520px) {
        .h-tiles { grid-template-columns: 1fr; }
        .h-search-row { flex-direction: column; }
    }

    /* tour — keep working, quieter */
    #vim-tour-overlay { position: fixed; inset: 0; z-index: 50000; pointer-events: none; opacity: 0; visibility: hidden; transition: opacity 0.2s ease, visibility 0.2s ease; }
    #vim-tour-overlay.active { opacity: 1; visibility: visible; }
    #vim-tour-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.8); pointer-events: auto; }
    #vim-tour-spotlight { position: absolute; width: 80px; height: 80px; border-radius: 4px; border: 2px solid #3b82f6; box-shadow: 0 0 0 4px rgba(59,130,246,0.2); pointer-events: none; transform: translate(-50%, -50%); transition: left 0.35s ease, top 0.35s ease, width 0.3s ease, height 0.3s ease; }
    #vim-tour-card { position: fixed; width: min(340px, calc(100vw - 28px)); background: #1a1a1a; color: #eee; border: 1px solid rgba(255,255,255,0.12); border-radius: 6px; padding: 1.1rem; box-shadow: 0 20px 50px rgba(0,0,0,0.5); z-index: 50002; pointer-events: auto; }
    .vim-tour-eyebrow { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #8ec5ff; margin-bottom: 0.3rem; }
    .vim-tour-title { font-family: 'Archivo Black', sans-serif; font-size: 1.15rem; margin-bottom: 0.35rem; text-transform: uppercase; }
    .vim-tour-description { color: rgba(255,255,255,0.55); font-size: 0.85rem; line-height: 1.5; margin-bottom: 0.9rem; }
    .vim-tour-progress { display: flex; gap: 4px; margin-bottom: 0.85rem; }
    .vim-tour-progress span { height: 3px; width: 16px; border-radius: 2px; background: rgba(255,255,255,0.12); }
    .vim-tour-progress span.active { width: 26px; background: #3b82f6; }
    .vim-tour-actions { display: flex; justify-content: space-between; align-items: center; }
    .vim-tour-skip { border: 0; background: transparent; color: rgba(255,255,255,0.45); font-size: 0.7rem; font-weight: 600; cursor: pointer; }
    .vim-tour-next { border: 0; background: #3b82f6; color: #fff; font-size: 0.72rem; font-weight: 700; padding: 0.55rem 0.9rem; border-radius: 3px; cursor: pointer; }
    #vim-tour-launcher { position: fixed; right: 1rem; bottom: 1rem; width: 2.35rem; height: 2.35rem; border-radius: 4px; background: #1a1a1a; color: #fff; border: 1px solid rgba(255,255,255,0.15); z-index: 40000; font-weight: 700; cursor: pointer; }
</style>

<div class="h">
<div class="h-wide">

<div id="vim-tour-overlay" aria-hidden="true">
    <div id="vim-tour-backdrop"></div>
    <div id="vim-tour-spotlight"></div>
    <div id="vim-tour-card">
        <div class="vim-tour-eyebrow" id="vim-tour-eyebrow">VIMSL</div>
        <div class="vim-tour-title" id="vim-tour-title">Welcome</div>
        <div class="vim-tour-description" id="vim-tour-description">Quick tour of the league site.</div>
        <div class="vim-tour-progress" id="vim-tour-progress"></div>
        <div class="vim-tour-actions">
            <button type="button" id="vim-tour-skip" class="vim-tour-skip">Skip</button>
            <button type="button" id="vim-tour-next" class="vim-tour-next">Next</button>
        </div>
    </div>
</div>
<button id="vim-tour-launcher" type="button" title="Tour">?</button>

<div class="h-top">
    <div><strong>VIM Super League</strong> · Roblox football</div>
    <div>Need help? <a href="https://discord.gg/" target="_blank" rel="noopener">Discord</a></div>
</div>

<!-- HERO -->
<section class="h-hero">
    <div class="h-hero-main" id="tour-featured-match">
        <h1>Season's on. Find your club.</h1>
        <p>Fixtures, the player market, and live results — the league hub for managers and free agents.</p>
        <div class="h-btns">
            <a class="h-btn h-btn-w" href="/market">Open market</a>
            <a class="h-btn h-btn-o" href="/matches">Fixtures</a>
        </div>
    </div>

    <div class="h-side">
        <div class="h-search">
            <label for="live-search-input">Search</label>
            <form id="search-form" action="/matches" method="GET" class="h-search-row">
                <input id="live-search-input" name="q" type="text" placeholder="Teams, players, matches…" autocomplete="off">
                <button type="submit" id="search-btn">Go</button>
            </form>
            <div id="search-results-dropdown" class="hidden"></div>
        </div>

        <div class="h-next">
            <div class="h-next-head">
                <span>Next up</span>
                <a href="/matches">All matches</a>
            </div>
            <% const matchList = (typeof matches !== 'undefined' && matches) ? matches : []; %>
            <% let nextMatch = matchList.find(m => m.status === 'upcoming'); %>
            <% if (nextMatch) { %>
                <div class="h-match">
                    <div class="h-team">
                        <img src="<%= nextMatch.logoA %>" alt="">
                        <b><%= nextMatch.teamA %></b>
                    </div>
                    <div class="h-vs">VS<small><%= nextMatch.time || 'TBC' %></small></div>
                    <div class="h-team">
                        <img src="<%= nextMatch.logoB %>" alt="">
                        <b><%= nextMatch.teamB %></b>
                    </div>
                </div>
            <% } else { %>
                <div class="h-empty">No upcoming fixture</div>
            <% } %>
        </div>
    </div>
</section>

<!-- 3D TILES -->
<nav class="h-tiles" aria-label="Main sections">
    <a class="h-tile" href="/market">
        <div class="h-tile-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M8 4h8l2 3v2H6V7l2-3z" fill="#fff" opacity="0.95"/><path d="M7 9h10v9a2 2 0 01-2 2H9a2 2 0 01-2-2V9z" fill="#93c5fd"/><circle cx="12" cy="14" r="2" fill="#1e3a8a"/></svg>
        </div>
        <strong>Market</strong>
        <span>Cards, ranks, registration</span>
    </a>
    <a class="h-tile" href="/matches">
        <div class="h-tile-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" fill="#fff"/><path d="M12 3.5l2.5 7.5H22l-6 4.5 2.5 7.5L12 18.5 5.5 23l2.5-7.5-6-4.5h7.5L12 3.5z" fill="#166534" opacity="0.2"/><circle cx="12" cy="12" r="3.2" fill="#166534"/></svg>
        </div>
        <strong>Matches</strong>
        <span>Schedule and scorelines</span>
    </a>
    <a class="h-tile" href="/metrics">
        <div class="h-tile-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="13" width="4" height="7" rx="1" fill="#e9d5ff"/><rect x="10" y="8" width="4" height="12" rx="1" fill="#c4b5fd"/><rect x="16" y="4" width="4" height="16" rx="1" fill="#fff"/></svg>
        </div>
        <strong>Metrics</strong>
        <span>Goals, assists, form</span>
    </a>
    <a class="h-tile" href="/records">
        <div class="h-tile-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M8 4h8v5a4 4 0 01-8 0V4z" fill="#fed7aa"/><path d="M8 5H5.5A2.5 2.5 0 008 9.5V5zm8 0h2.5A2.5 2.5 0 0116 9.5V5z" fill="#fdba74"/><path d="M11 13h2v3h-2v-3z" fill="#fb923c"/><rect x="8" y="16" width="8" height="2.5" rx="1" fill="#fff"/><rect x="7" y="18.5" width="10" height="2" rx="1" fill="#c2410c"/></svg>
        </div>
        <strong>Records</strong>
        <span>Season landmarks</span>
    </a>
</nav>

<!-- STREAM + RESULTS -->
<section class="h-body">
    <div class="h-block">
        <div class="h-block-title">
            <h2>Live / stream</h2>
        </div>
        <div class="h-stream">
            <% if (typeof liveLink !== 'undefined' && liveLink && String(liveLink).trim() !== '') { %>
                <%
                    let embedLink = liveLink;
                    if (liveLink.includes('watch?v=')) embedLink = liveLink.replace('watch?v=', 'embed/').split('&')[0];
                    else if (liveLink.includes('youtu.be/')) embedLink = liveLink.replace('youtu.be/', 'youtube.com/embed/').split('?')[0];
                %>
                <iframe src="<%= embedLink %>" allowfullscreen title="Stream"></iframe>
            <% } else { %>
                <div class="h-stream-off">
                    <b>Nothing live right now</b>
                    <span>Broadcast drops in when a match is on</span>
                </div>
            <% } %>
        </div>
    </div>

    <div class="h-block" id="tour-results">
        <div class="h-block-title">
            <h2>Recent</h2>
            <a href="/matches">More</a>
        </div>
        <ul class="h-results">
            <%
                const recent = matchList
                    .filter(m => m.status === 'completed' || m.status === 'complete' || (m.details && (m.details.goalsA != null || m.details.goalsB != null)))
                    .slice(-6)
                    .reverse();
            %>
            <% if (recent.length) { %>
                <% recent.forEach(r => { %>
                    <li>
                        <a href="/match/<%= r._id || r.id || '' %>">
                            <div class="h-res-teams">
                                <div class="h-res-row">
                                    <img src="<%= r.logoA %>" alt="">
                                    <span><%= r.teamA %></span>
                                </div>
                                <div class="h-res-row">
                                    <img src="<%= r.logoB %>" alt="">
                                    <span style="color:rgba(255,255,255,0.5)"><%= r.teamB %></span>
                                </div>
                            </div>
                            <div class="h-res-score">
                                <div><%= (r.details && r.details.goalsA != null) ? r.details.goalsA : 0 %></div>
                                <div class="dim"><%= (r.details && r.details.goalsB != null) ? r.details.goalsB : 0 %></div>
                            </div>
                        </a>
                    </li>
                <% }) %>
            <% } else { %>
                <li class="h-empty">No results posted</li>
            <% } %>
        </ul>
    </div>
</section>

<!-- ABOUT -->
<section class="h-about">
    <div class="h-about-ph">
        <!-- <img src="/images/about.png" alt=""> -->
        Image slot
    </div>
    <div>
        <h2>What this is</h2>
        <p>
            VIM Super League is a competitive Roblox football setup — clubs, a player market, fixtures, and a season that actually tracks.
        </p>
        <p>
            Managers build squads. Players register and get signed. Matchdays go up on the site so everyone can follow along without digging through chats.
        </p>
        <div class="h-btns" style="margin-top:0.5rem">
            <a class="h-btn h-btn-w" href="/market">Join the market</a>
            <a class="h-btn h-btn-o" href="https://discord.gg/" target="_blank" rel="noopener">Discord</a>
        </div>
    </div>
</section>

<!-- STORIES -->
<% if (typeof stories !== 'undefined' && stories && stories.length) { %>
<section style="margin-bottom:0.5rem">
    <div class="h-block-title" style="border:0;padding:0;margin-bottom:0.85rem">
        <h2 style="font-family:'Archivo Black',sans-serif;font-size:1rem;text-transform:uppercase;margin:0">Stories</h2>
    </div>
    <div class="h-stories">
        <% stories.slice().reverse().slice(0, 3).forEach(story => { %>
            <article class="h-story">
                <div class="h-story-img">
                    <% if (story.image) { %><img src="<%= story.image %>" alt=""><% } %>
                </div>
                <div class="h-story-body">
                    <small><%= story.date || 'Post' %></small>
                    <h3><%= story.title %></h3>
                    <p><%= story.description %></p>
                </div>
            </article>
        <% }) %>
    </div>
</section>
<% } %>

<footer class="h-foot">
    <div>
        <p style="color:#fff;font-weight:700;margin-bottom:0.35rem">VIM Super League</p>
        <p>Competitive Roblox football. Market, fixtures, records — run by the community.</p>
    </div>
    <div class="h-socials">
        <a class="h-social" href="https://discord.gg/" target="_blank" rel="noopener">
