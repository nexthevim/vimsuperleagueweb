                <div>
                    <p class="text-xs font-black uppercase tracking-wider">Soft lock active</p>
                    <p class="text-[10px] font-bold leading-relaxed">
                        Each team has <strong>5 total</strong> bid/raise attempts (not per player).
                        Unlocked outbid withdraws still allowed — no extra budget.
                        <% if (typeof softLockInfo !== 'undefined' && softLockInfo && softLockInfo.active && !softLockInfo.spectator) { %>
                            <span class="text-violet-700">Your team: <%= softLockInfo.remaining %> / <%= softLockInfo.max %> attempts left (used <%= softLockInfo.used %>).</span>
                        <% } %>
                    </p>
                </div>
            </div>
        </div>
    <% } %>
    <% if (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.status === 'paused') { %>
        <div class="max-w-7xl mx-auto px-6 mb-4">
            <div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-2xl px-5 py-3 flex items-center gap-3 shadow-sm">
                <span class="text-xl">⏸</span>
                <div>
                    <p class="text-xs font-black uppercase tracking-wider">Auction Paused</p>
                    <p class="text-[10px] font-bold">Bidding is frozen. Admin is reviewing — wait for End or Resume.</p>
                </div>
            </div>
        </div>
    <% } %>

    
    </div><!-- /marketSection -->

<!-- MODE 2: AUCTION HUB VIEW -->
    <div id="auctionSection" class="hidden max-w-7xl mx-auto px-6 mb-24">
        <%
            function hueFromName(str) {
                let h = 0;
                str = str || 'Team';
                for (let i = 0; i < str.length; i++) {
                    h = str.charCodeAt(i) + ((h << 5) - h);
                }
                return Math.abs(h) % 360;
            }
            function findPlayerRecord(idOrName) {
                if (!idOrName || typeof players === 'undefined') return null;
                return players.find(p => {
                    let pid = (p._id || p.id || '').toString();
                    return pid === idOrName.toString() ||
                        (p.name && p.name.toLowerCase() === idOrName.toString().toLowerCase());
                }) || null;
            }

            let sessionStatus = (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.status) || 'ready';
            let statusLabel = 'READY';
            let statusDot = 'bg-slate-400';
            let statusRing = 'border-slate-200 bg-slate-50 text-slate-600';
            if (sessionStatus === 'live') {
                statusLabel = 'LIVE';
                statusDot = 'bg-emerald-400 animate-pulse';
                statusRing = 'border-emerald-200 bg-emerald-50 text-emerald-700';
            } else if (sessionStatus === 'ended') {
                statusLabel = 'ENDED';
                statusDot = 'bg-rose-400';
                statusRing = 'border-rose-200 bg-rose-50 text-rose-700';
            }
            let squadCap = (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.maxRosterSize) || 16;
            let squadMin = (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.minRosterSize) || 10;
            let sessionName = (typeof auctionSettings !== 'undefined' && auctionSettings && auctionSettings.name) || 'VIM Auction';
        %>

        <!-- HERO STATUS -->
        <div class="relative overflow-hidden rounded-[32px] mb-8 border border-slate-200 shadow-xl shadow-slate-200/50">
            <div class="absolute inset-0 bg-gradient-to-br from-white via-slate-50 to-emerald-50/50"></div>
            <div class="absolute inset-0 opacity-80" style="background-image: radial-gradient(circle at 12% 40%, rgba(16,185,129,0.1), transparent 42%), radial-gradient(circle at 88% 15%, rgba(251,191,36,0.1), transparent 38%);"></div>
            <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-slate-900 via-emerald-500 to-slate-900"></div>

            <div class="relative p-6 md:p-8 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                <div class="flex items-start gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-white border border-slate-200 flex items-center justify-center text-3xl shadow-sm">🏆</div>
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-[0.25em] text-slate-400"><%= sessionName %></p>
                        <h3 class="text-3xl font-black italic uppercase tracking-tighter text-slate-900 mt-1">Auction Hub</h3>
                        <p class="text-[11px] text-slate-500 font-bold mt-1">Franchise bids · live roster pressure · full audit trail</p>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    <div class="<%= statusRing %> border px-4 py-2.5 rounded-2xl flex items-center gap-2 shadow-sm">
                        <span class="w-2 h-2 rounded-full <%= statusDot %>"></span>
                        <div>
                            <p class="text-[8px] font-black uppercase tracking-widest opacity-70">Status</p>
                            <p class="text-sm font-black uppercase tracking-wider leading-none"><%= statusLabel %></p>
                        </div>
                    </div>
                    <div class="bg-white border border-slate-200 text-slate-900 px-4 py-2.5 rounded-2xl shadow-sm">
                        <p class="text-[8px] font-black uppercase tracking-widest text-slate-400">Roster</p>
                        <p class="text-sm font-black"><%= squadMin %>–<%= squadCap %> <span class="text-slate-400 font-bold text-[10px]">players</span></p>
                    </div>
                    <div class="bg-white border border-slate-200 text-slate-900 px-4 py-2.5 rounded-2xl shadow-sm">
                        <p class="text-[8px] font-black uppercase tracking-widest text-slate-400">Franchises</p>
                        <p class="text-sm font-black"><%= typeof auctionTeams !== 'undefined' ? auctionTeams.length : 0 %></p>
                    </div>
                </div>
            </div>
        </div>

        <% if (typeof isManager !== 'undefined' && isManager && typeof myAuctionState !== 'undefined' && myAuctionState) { %>
            <div class="mb-8 grid grid-cols-2 md:grid-cols-4 gap-3">
                <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
                    <p class="text-[9px] font-black uppercase text-slate-400">Your budget left</p>
                    <p class="text-xl font-black text-emerald-600 mt-1"><%= Number(myAuctionState.availableBudget).toLocaleString() %></p>
                </div>
                <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
                    <p class="text-[9px] font-black uppercase text-slate-400">Roster slots</p>
                    <p class="text-xl font-black text-slate-900 mt-1"><%= myAuctionState.totalPlayers %><span class="text-sm text-slate-400">/<%= myAuctionState.rosterMax %></span></p>
                </div>
                <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
                    <p class="text-[9px] font-black uppercase text-slate-400">Winning</p>
                    <p class="text-xl font-black text-emerald-600 mt-1"><%= (myAuctionState.provisional || []).filter(x => !x.isManager).length %></p>
                </div>
                <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
                    <p class="text-[9px] font-black uppercase text-slate-400">Outbid</p>
                    <p class="text-xl font-black text-rose-600 mt-1"><%= typeof myOutbidPlayers !== 'undefined' ? myOutbidPlayers.length : 0 %></p>
                </div>
            </div>
        <% } %>

        <% if (typeof auctionTeams !== 'undefined' && auctionTeams && auctionTeams.length > 0) { %>

            <div class="flex items-center justify-between gap-3 mb-4">
                <h3 class="text-[11px] font-black uppercase tracking-[0.25em] text-slate-400">Registered Franchises</h3>
                <p class="text-[10px] font-bold text-slate-400 uppercase">Tap a team to inspect bids</p>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 mb-8">
                <% auctionTeams.forEach((t, i) => {
                    let tId = t._id || t.id || '';
                    let reserved = (t.bids || []).reduce((sum, b) => sum + (Number(b.amount) || 0), 0);
                    let remaining = (t.budget || 0) - (t.spent || 0) - reserved;
                    let committedPct = (t.budget && t.budget > 0) ? Math.min(100, Math.round(((t.spent || 0) + reserved) / t.budget * 100)) : 0;
                    let hue = hueFromName(t.name);
                    let bidCount = (t.bids || []).length;
                    let rosterCount = (t.roster || []).length;
                %>
                    <div onclick="selectAuctionTeam('<%= tId %>')"
                         id="teamTile-<%= tId %>"
                         class="team-tile cursor-pointer bg-white border-2 rounded-[24px] p-4 text-center relative overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl <%= i === 0 ? 'active' : 'border-slate-200' %>"
                         style="--team-hue: <%= hue %>;">
                        <div class="absolute inset-x-0 top-0 h-1.5" style="background: hsl(<%= hue %> 75% 48%);"></div>
                        <div class="absolute -right-6 -top-6 w-20 h-20 rounded-full opacity-10" style="background: hsl(<%= hue %> 75% 48%);"></div>

                        <div class="w-20 h-20 mx-auto rounded-2xl bg-slate-50 border border-slate-100 p-2 flex items-center justify-center shadow-sm mb-3 mt-1">
                            <% if (t.logo) { %>
                                <img src="<%= t.logo %>" class="w-full h-full object-contain">
                            <% } else { %>
                                <span class="text-2xl font-black" style="color: hsl(<%= hue %> 65% 42%);"><%= (t.name || '?').charAt(0) %></span>
                            <% } %>
                        </div>

                        <h4 class="font-black italic uppercase text-sm text-slate-900 truncate"><%= t.name %></h4>
                        <p class="text-[9px] text-slate-400 font-bold uppercase truncate mb-3">Mgr · <%= t.manager || 'Unassigned' %></p>

                        <div class="grid grid-cols-2 gap-1.5 text-left mb-2">
                            <div class="bg-slate-50 rounded-xl px-2 py-1.5 border border-slate-100">
                                <span class="block text-[7px] text-slate-400 font-black uppercase">Left</span>
                                <span class="text-[11px] font-black text-emerald-600"><%= Number(remaining).toLocaleString() %></span>
                            </div>
                            <div class="bg-slate-50 rounded-xl px-2 py-1.5 border border-slate-100">
                                <span class="block text-[7px] text-slate-400 font-black uppercase">Bids</span>
                                <span class="text-[11px] font-black text-slate-900"><%= bidCount %></span>
                            </div>
                        </div>

                        <div class="h-1.5 rounded-full bg-slate-100 overflow-hidden">
                            <div class="h-full rounded-full transition-all" style="width: <%= committedPct %>%; background: hsl(<%= hue %> 75% 48%);"></div>
                        </div>
                        <p class="text-[8px] font-bold text-slate-400 mt-1.5 uppercase"><%= committedPct %>% committed · <%= rosterCount %> signed</p>
                    </div>
                <% }) %>
            </div>

            <!-- TEAM DETAIL PANELS -->
            <% auctionTeams.forEach((t, i) => {
                let tId = t._id || t.id || '';
                let reserved = (t.bids || []).reduce((sum, b) => sum + (Number(b.amount) || 0), 0);
                let remaining = (t.budget || 0) - (t.spent || 0) - reserved;
                let hue = hueFromName(t.name);
            %>
                <div id="teamDetails-<%= tId %>" class="team-details-panel <%= i === 0 ? '' : 'hidden' %> mb-8">
                    <div class="bg-white rounded-[28px] border border-slate-200 shadow-lg overflow-hidden">
                        <div class="px-6 py-5 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100" style="background: linear-gradient(135deg, hsl(<%= hue %> 40% 97%), white);">
                            <div class="flex items-center gap-4">
                                <div class="w-14 h-14 rounded-2xl bg-white border border-slate-200 p-1.5 flex items-center justify-center shadow-sm">
                                    <% if (t.logo) { %>
                                        <img src="<%= t.logo %>" class="w-full h-full object-contain">
                                    <% } else { %>
                                        <span class="text-xl font-black" style="color: hsl(<%= hue %> 65% 42%);"><%= (t.name || '?').charAt(0) %></span>
                                    <% } %>
                                </div>
                                <div>
                                    <h4 class="text-xl font-black italic uppercase text-slate-900 tracking-tight"><%= t.name %></h4>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">Manager · <%= t.manager || 'Unassigned' %></p>
                                </div>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                <div class="bg-slate-900 text-white px-3 py-2 rounded-xl">
                                    <p class="text-[7px] font-black uppercase text-slate-400">Budget</p>
                                    <p class="text-sm font-black"><%= Number(t.budget || 0).toLocaleString() %></p>
                                </div>
                                <div class="bg-emerald-50 border border-emerald-100 text-emerald-700 px-3 py-2 rounded-xl">
                                    <p class="text-[7px] font-black uppercase text-emerald-500">Remaining</p>
                                    <p class="text-sm font-black"><%= Number(remaining).toLocaleString() %></p>
                                </div>
                                <div class="bg-slate-50 border border-slate-100 px-3 py-2 rounded-xl">
                                    <p class="text-[7px] font-black uppercase text-slate-400">Spent</p>
                                    <p class="text-sm font-black text-slate-900"><%= Number(t.spent || 0).toLocaleString() %></p>
                                </div>
                            </div>
                        </div>

                        <div class="px-6 pt-4 flex gap-2">
                            <button type="button" id="tabBtn-bidding-<%= tId %>" onclick="switchTeamSubTab('<%= tId %>', 'bidding')"
                                class="px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-slate-900 text-white transition">
                                Live Bids
                            </button>
                            <button type="button" id="tabBtn-roster-<%= tId %>" onclick="switchTeamSubTab('<%= tId %>', 'roster')"
                                class="px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider text-slate-400 hover:text-slate-900 transition">
                                Final Roster
                            </button>
                        </div>

                        <div id="subTab-bidding-<%= tId %>" class="p-6">
                            <% if (t.bids && t.bids.length > 0) { %>
                                <div class="space-y-2">
                                    <% t.bids.forEach(b => {
                                        const full = findPlayerRecord(b.playerId || b.playerName);
                                        const isWinning = full && (full.highestBidder || '').toLowerCase() === (t.name || '').toLowerCase()
                                            && Number(full.highestBid || 0) === Number(b.amount || 0);
                                    %>
                                        <div class="flex items-center justify-between gap-3 bg-slate-50 hover:bg-slate-100 border border-slate-100 rounded-2xl px-4 py-3 transition cursor-pointer"
                                             <% if (full) { %>
                                             onmousemove="tiltCard(event, this)" onclick="openBio(this, '<%= full.name %>', '<%= full.cardImage %>', `<%= (full.experience || full.bio || '').toString().replace(/`/g,'') %>`, '<%= full.discord %>', '<%= full.goals || 0 %>', '<%= full.assists || 0 %>', '<%= full.saves || 0 %>', '<%= full.mvps || 0 %>', '<%= full.views ? full.views.length : 0 %>', '<%= full.position %>', '<%= full.country %>', '<%= full.timezone %>', '<%= full.highestBid || 0 %>', '<%= full.highestBidder || "None" %>', '<%= full._id || full.id %>', '<%= full.reservePrice || 0 %>', <%- (typeof managerPlayerNames !== 'undefined' && managerPlayerNames.includes((full.name||'').toLowerCase())) %>, <%- !!(typeof user !== 'undefined' && user && Array.isArray(user.watchlist) && user.watchlist.map(String).includes(String(full._id||full.id))) %>)"
                                             <% } %>>
                                            <div class="flex items-center gap-3 min-w-0">
                                                <% if (full && full.cardImage) { %>
                                                    <img src="<%= full.cardImage %>" class="w-11 h-11 rounded-xl object-cover border border-slate-200" alt="">
                                                <% } else { %>
                                                    <div class="w-11 h-11 rounded-xl bg-slate-200 flex items-center justify-center text-[10px] font-black text-slate-400"><%= (b.playerName || '?').charAt(0) %></div>
                                                <% } %>
                                                <div class="min-w-0">
                                                    <h5 class="font-black italic uppercase text-slate-900 text-sm truncate"><%= b.playerName || (full && full.name) || 'Player' %></h5>
                                                    <p class="text-[9px] text-slate-400 font-bold uppercase"><%= full ? (full.position || 'PRO') : '—' %> · <%= full ? (full.rank || 'C') : '' %></p>
                                                </div>
                                            </div>
                                            <div class="text-right flex-shrink-0">
                                                <p class="text-sm font-black text-slate-900"><%= Number(b.amount || 0).toLocaleString() %> V</p>
                                                <% if (isWinning) { %>
                                                    <span class="text-[8px] font-black uppercase text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md">Winning</span>
                                                <% } else { %>
                                                    <span class="text-[8px] font-black uppercase text-rose-500 bg-rose-50 px-2 py-0.5 rounded-md">Outbid</span>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div class="text-center py-14 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                                    <p class="text-xs font-black uppercase text-slate-400 tracking-wider">No active bids from this franchise yet</p>
                                </div>
                            <% } %>
                        </div>

                        <div id="subTab-roster-<%= tId %>" class="p-6 hidden">
                            <% if (t.roster && t.roster.length > 0) { %>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                    <% t.roster.forEach(r => {
                                        const full = findPlayerRecord(r.name);
                                    %>
                                        <div class="flex items-center justify-between gap-3 bg-slate-50 border border-slate-100 rounded-2xl px-4 py-3"
                                             <% if (full) { %>
                                             onmousemove="tiltCard(event, this)" onclick="openBio(this, '<%= full.name %>', '<%= full.cardImage %>', `<%= (full.experience || full.bio || '').toString().replace(/`/g,'') %>`, '<%= full.discord %>', '<%= full.goals || 0 %>', '<%= full.assists || 0 %>', '<%= full.saves || 0 %>', '<%= full.mvps || 0 %>', '<%= full.views ? full.views.length : 0 %>', '<%= full.position %>', '<%= full.country %>', '<%= full.timezone %>', '<%= full.highestBid || 0 %>', '<%= full.highestBidder || "None" %>', '<%= full._id || full.id %>', '<%= full.reservePrice || 0 %>', false, false)"
                                             class="cursor-pointer hover:bg-slate-100"
                                             <% } %>>
                                            <div class="min-w-0">
                                                <h5 class="font-black italic uppercase text-slate-900 text-sm truncate"><%= r.name %></h5>
                                                <p class="text-[10px] text-slate-400 font-bold uppercase"><%= r.position || 'PRO' %> · <%= r.rank || '' %> · <%= Number(r.boughtFor || 0).toLocaleString() %> V</p>
                                            </div>
                                            <span class="text-[9px] font-black text-emerald-600 bg-emerald-50 border border-emerald-100 px-2.5 py-1 rounded-lg uppercase flex-shrink-0">Signed</span>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div class="text-center py-14 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                                    <p class="text-xs font-black uppercase text-slate-400 tracking-wider">Roster fills when the admin ends the auction</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>

        <% } else { %>
            <div class="bg-white p-12 rounded-[32px] border border-dashed border-slate-200 text-center">
                <p class="text-sm font-black text-slate-400 uppercase tracking-widest">No auction teams configured yet</p>
                <p class="text-[11px] text-slate-400 font-bold mt-2">Admin can enroll franchises from the Auction Control tab</p>
            </div>
        <% } %>

        <!-- AUDIT LOG -->
        <% if (typeof auctionActivityFeed !== 'undefined' && auctionActivityFeed && auctionActivityFeed.length > 0) { %>
            <div class="mt-10">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-9 h-9 rounded-xl bg-slate-900 text-white flex items-center justify-center text-sm">📜</div>
                    <div>
                        <h3 class="text-[11px] font-black uppercase tracking-[0.25em] text-slate-400">Auction Feed</h3>
                        <p class="text-[9px] font-bold text-slate-400 uppercase">Public trail of bids, wins & session events</p>
                    </div>
                </div>

                <div class="bg-white rounded-[28px] border border-slate-200 shadow-sm max-h-96 overflow-y-auto custom-scroll divide-y divide-slate-100">
                    <% auctionActivityFeed.forEach((ev) => {
                        let icon = '•';
                        let label = ev.type;
                        let colorClass = 'text-slate-500';
                        if (ev.type === 'bid') { icon = '💰'; label = 'Bid'; colorClass = 'text-emerald-600'; }
                        else if (ev.type === 'withdraw') { icon = '↩️'; label = 'Withdraw'; colorClass = 'text-amber-600'; }
                        else if (ev.type === 'won') { icon = '🏆'; label = 'Won'; colorClass = 'text-emerald-700'; }
                        else if (ev.type === 'auction_start') { icon = '🚀'; label = 'Started'; colorClass = 'text-slate-900'; }
                        else if (ev.type === 'auction_end') { icon = '🔒'; label = 'Ended'; colorClass = 'text-rose-600'; }
                        else if (ev.type === 'rank_change') { icon = '🎖️'; label = 'Class'; colorClass = 'text-violet-600'; }
                    %>
                        <div class="flex items-center justify-between gap-3 px-5 py-3.5 hover:bg-slate-50/80 transition">
                            <div class="flex items-center gap-3 min-w-0">
                                <span class="text-base flex-shrink-0 w-7 text-center"><%= icon %></span>
                                <div class="min-w-0">
                                    <p class="text-[11px] font-black uppercase <%= colorClass %>">
                                        <%= label %><% if (ev.playerName) { %> <span class="text-slate-900">· <%= ev.playerName %></span><% } %>
                                    </p>
                                    <p class="text-[9px] text-slate-400 font-bold uppercase tracking-wider truncate">
                                        <% if (ev.teamName) { %><%= ev.teamName %><% } %>
                                        <% if (ev.managerName) { %> · <%= ev.managerName %><% } %>
                                        <% if (ev.meta && ev.meta.rank) { %> · → <%= ev.meta.rank %><% } %>
                                    </p>
                                </div>
                            </div>
                            <div class="text-right flex-shrink-0">
                                <% if (ev.amount) { %>
                                    <p class="text-xs font-black text-slate-900"><%= Number(ev.amount).toLocaleString() %> V</p>
                                <% } %>
                                <p class="text-[8px] text-slate-400 font-bold uppercase"><%= ev.createdAt ? new Date(ev.createdAt).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '' %></p>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </div>

    </div><!-- /mk-shell -->

</div><!-- /mk-wrap -->

<!-- LIGHT THEME FIFA MODAL WITH BIDDING CAPABILITY FOR MANAGERS -->
    <div id="bioModal" class="modal" onclick="closeBio()">
        <div class="max-w-5xl w-full flex flex-col md:flex-row gap-6 items-center relative" id="modalContainer" onclick="event.stopPropagation()">
            <!-- Player Card Spotlight -->
            <div class="relative group w-[300px] h-[420px] flex-shrink-0">
                <div class="absolute -inset-2 bg-slate-300/40 blur-2xl rounded-full opacity-70"></div>
                <div class="relative w-full h-full bg-white rounded-[36px] overflow-hidden border border-slate-200 shadow-2xl">
                    <img id="modalImg" src="" class="w-full h-full object-cover">
                    <div id="modalImgPlaceholder" class="w-full h-full bg-gradient-to-b from-slate-100 to-slate-200 flex items-center justify-center">
                        <svg class="w-40 h-40 text-slate-300" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                    </div>

                    <!-- WATCHLIST STAR — visible corner of the player profile -->
                    <% if (typeof isManager !== 'undefined' && isManager) { %>
                        <button type="button"
                            id="modalWatchlistStar"
                            onclick="toggleWatchlistStar(this, window.currentModalPlayerId)"
                            data-watching="false"
