// Mirrors the server's BID_INCREMENT_TIERS purely for instant UI feedback
// (quick-bid buttons, placeholder text) — /auction/bid re-validates for real.
function getClientMinIncrement(amount) {
    if (amount < 5000) return 100;
    if (amount < 20000) return 250;
    return 500;
}

function computeMinNextBid(currentHigh, reservePrice) {
    if (currentHigh > 0) {
        const step = getClientMinIncrement(currentHigh);
        return Math.ceil((currentHigh + step) / step) * step;
    }
    return reservePrice;
}

function renderQuickBidButtons(minNextBid, currentHigh) {
    const wrap = document.getElementById('modalQuickBidRow');
    if (!wrap) return;

    const step = getClientMinIncrement(currentHigh || minNextBid);
    const options = [minNextBid, minNextBid + step, minNextBid + step * 2];
    const labels = ['Min', '+1 step', '+2 steps'];

    wrap.innerHTML = options.map((amt, i) =>
        `<button type="button" onclick="setBidAmount(${amt})" class="bg-slate-50 hover:bg-slate-900 hover:text-white text-slate-800 border border-slate-200 hover:border-slate-900 text-[11px] font-black py-2.5 rounded-xl transition">
            <span class="block text-[8px] uppercase tracking-wider opacity-60 mb-0.5">${labels[i]}</span>
            ${amt.toLocaleString()}
        </button>`
    ).join('');
}


function confirmBidSubmit(e) {
    const input = document.getElementById('modalBidInput');
    const nameEl = document.getElementById('modalName');
    const amount = Number(input && input.value);
    const playerName = (nameEl && nameEl.textContent) || 'this player';
    if (!amount || amount <= 0) {
        alert('Enter a valid bid amount.');
        return false;
    }
    // Approximate remaining: free current win on this player if we're leading at same amount isn't known client-side easily —
    // use availableBudget from server snapshot (page load). Server still validates for real.
    const avail = Number(window.managerAvailableBudget) || 0;
    // If already winning this player, roughly free that amount (modalHighestBid may be ours)
    let freed = 0;
    try {
        const high = document.getElementById('modalHighestBid');
        const highText = high ? high.textContent : '';
        // not reliable to know if we're the holder; keep simple
    } catch (_) {}
    const remainingAfter = avail - amount + freed;
    const msg =
        'Confirm bid of ' + amount.toLocaleString() + ' Vollars on ' + playerName + '?\n\n' +
        'Available budget now: ' + avail.toLocaleString() + ' V\n' +
        'After this bid (approx): ' + Math.max(0, remainingAfter).toLocaleString() + ' V left for other targets.\n\n' +
        'Server will still reject if over budget or illegal.';
    return confirm(msg);
}

function setBidAmount(amount) {
    const input = document.getElementById('modalBidInput');
    if (input) input.value = amount;
}

// WATCHLIST — works from both the market grid star and the modal star.
async function toggleWatchlistStar(btn, playerId) {
    try {
        const res = await fetch('/auction/watchlist/toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ playerId })
        });
        const data = await res.json();

        if (!data.success) {
            alert(data.error || 'Could not update watchlist.');
            return;
        }

        const watching = data.watching;

        // Update every star for this player on the page (grid can have
        // duplicate cards from the scrolling conveyor effect).
        document.querySelectorAll(`.watchlist-star-btn[onclick*="'${playerId}'"]`).forEach(el => {
            el.dataset.watching = watching ? 'true' : 'false';
            el.textContent = watching ? '★' : '☆';
            el.className = 'watchlist-star-btn absolute top-4 right-4 z-30 w-8 h-8 rounded-full flex items-center justify-center text-base transition-all shadow-lg border border-white/30 ' +
                (watching ? 'bg-amber-400 text-white' : 'bg-black/30 text-white/80 hover:bg-black/50');
        });

        if (btn && btn.id === 'modalWatchlistStar') {
            btn.dataset.watching = watching ? 'true' : 'false';
            btn.textContent = watching ? '★' : '☆';
            btn.className = 'absolute top-4 right-4 z-30 w-10 h-10 rounded-full flex items-center justify-center text-lg transition-all shadow-lg border border-white/30 ' +
                (watching ? 'bg-amber-400 text-white' : 'bg-black/30 text-white/80 hover:bg-black/50');
        }

    } catch (e) {
        console.error('Watchlist toggle failed', e);
    }
}

let modalBidHistoryOpen = false;

function toggleModalBidHistory() {
    const panel = document.getElementById('modalBidHistoryPanel');
    const arrow = document.getElementById('modalExpandBidsArrow');
    if (!panel) return;

    modalBidHistoryOpen = !modalBidHistoryOpen;
    if (modalBidHistoryOpen) {
        panel.classList.remove('hidden');
        if (arrow) {
            arrow.textContent = '‹';
            arrow.style.transform = 'rotate(90deg)';
        }
        loadModalBidHistory(window.currentModalPlayerId);
    } else {
        panel.classList.add('hidden');
        if (arrow) {
            arrow.textContent = '›';
            arrow.style.transform = '';
        }
    }
}

async function loadModalBidHistory(playerId) {
    const list = document.getElementById('modalBidHistoryList');
    if (!list) return;
    if (!playerId) {
        list.innerHTML = '<p class="text-[10px] text-slate-400 italic font-bold">No player selected.</p>';
        return;
    }
    list.innerHTML = '<p class="text-[10px] text-slate-400 italic font-bold">Loading…</p>';
    try {
        const res = await fetch('/api/player/' + encodeURIComponent(playerId) + '/bids');
        const data = await res.json();
        if (!data.success || !data.bids || data.bids.length === 0) {
            list.innerHTML = '<p class="text-[10px] text-slate-400 italic font-bold">No bids yet on this player.</p>';
            return;
        }
        list.innerHTML = data.bids.map(b => {
            const when = b.createdAt ? new Date(b.createdAt).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
            return `<div class="bg-slate-50 border border-slate-100 rounded-xl px-3 py-2">
                <div class="flex items-center justify-between gap-2">
                    <span class="text-[11px] font-black text-slate-900 uppercase truncate">${b.teamName || 'Unknown'}</span>
                    <span class="text-[11px] font-black text-emerald-600 flex-shrink-0">${Number(b.amount || 0).toLocaleString()}</span>
                </div>
                <p class="text-[8px] text-slate-400 font-bold uppercase mt-0.5 truncate">${b.managerName ? b.managerName + ' · ' : ''}${when}</p>
            </div>`;
        }).join('');
    } catch (e) {
        console.error('Bid history load failed', e);
        list.innerHTML = '<p class="text-[10px] text-rose-500 italic font-bold">Could not load bids.</p>';
    }
}

function closeBio() {
    const modal = document.getElementById('bioModal');
    const container = document.getElementById('modalContainer');
    container.classList.remove('show');
    modal.classList.remove('active');
    modalBidHistoryOpen = false;
    const panel = document.getElementById('modalBidHistoryPanel');
    if (panel) panel.classList.add('hidden');
    const arrow = document.getElementById('modalExpandBidsArrow');
    if (arrow) { arrow.textContent = '›'; arrow.style.transform = ''; }
    setTimeout(() => { modal.style.display = 'none'; }, 350);
}

</script>
