                modalStar.classList.remove('hidden');
                modalStar.dataset.watching = isWatched ? 'true' : 'false';
                modalStar.textContent = isWatched ? '★' : '☆';
                modalStar.className = 'absolute top-4 right-4 z-30 w-10 h-10 rounded-full flex items-center justify-center text-lg transition-all shadow-lg border border-white/30 ' +
                    (isWatched ? 'bg-amber-400 text-white' : 'bg-black/30 text-white/80 hover:bg-black/50');
            }
        }
        
        const modalImg = document.getElementById('modalImg');
        const placeholder = document.getElementById('modalImgPlaceholder');
        if(img && img.trim() !== "" && img !== "undefined") {
