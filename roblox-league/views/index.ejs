<%- include('partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Syne:wght@700;800;900&display=swap" rel="stylesheet">

<style>
    :root {
        --ink: #111315;
        --ink-2: #25292d;
        --paper: #f3f0e8;
        --paper-2: #e8e3d8;
        --line: rgba(17, 19, 21, .16);
        --muted: #6f726f;
        --blue: #1677ff;
        --green: #6f8f63;
        --orange: #e36b32;
        --red: #d94b45;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: 'Plus Jakarta Sans', sans-serif;
        overflow-x: hidden;
    }

    ::selection {
        background: var(--ink);
        color: var(--paper);
    }

    .vim-page {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        background:
            linear-gradient(rgba(17,19,21,.045) 1px, transparent 1px),
            linear-gradient(90deg, rgba(17,19,21,.045) 1px, transparent 1px),
            var(--paper);
        background-size: 48px 48px;
    }

    .vim-page::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: -1;
        background: radial-gradient(circle at 72% 8%, rgba(111,143,99,.16), transparent 24rem);
    }

    .display {
        font-family: 'Syne', sans-serif;
        letter-spacing: -.055em;
    }

    .eyebrow {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 10px;
        line-height: 1;
        font-weight: 900;
        letter-spacing: .18em;
        text-transform: uppercase;
    }

    .eyebrow::before {
        content: "";
        width: 24px;
        height: 2px;
        background: currentColor;
    }

    /* HERO — deliberately editorial rather than card-based */
    .vim-hero {
        position: relative;
        min-height: min(820px, calc(100vh - 64px));
        display: flex;
        align-items: flex-end;
        overflow: hidden;
        background: #1a1d1f;
        color: white;
    }

    .vim-hero-art {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(90deg, rgba(10,12,13,.92) 0%, rgba(10,12,13,.62) 43%, rgba(10,12,13,.2) 100%),
            linear-gradient(0deg, rgba(10,12,13,.85) 0%, transparent 50%),
            url('/images/vimgfx.png') center/cover no-repeat;
        transform: scale(1.035);
        transition: transform 1.2s cubic-bezier(.16,1,.3,1);
    }

    .vim-hero:hover .vim-hero-art { transform: scale(1.055); }

    .vim-hero-grid {
        position: absolute;
        inset: 0;
        opacity: .18;
        background:
            linear-gradient(90deg, transparent 49.8%, white 50%, transparent 50.2%),
            linear-gradient(transparent 49.8%, white 50%, transparent 50.2%);
        background-size: 180px 180px;
        mask-image: linear-gradient(to bottom, transparent, black 30%, black 75%, transparent);
        transform: perspective(600px) rotateX(58deg) scale(1.7) translateY(18%);
        transform-origin: center bottom;
        pointer-events: none;
    }

    .vim-hero-copy {
        position: relative;
        z-index: 2;
        width: min(1400px, calc(100% - 48px));
        margin: 0 auto;
        padding: 110px 0 74px;
    }

    .hero-kicker {
        color: #b8c8b1;
        margin-bottom: 22px;
    }

    .hero-title {
        max-width: 920px;
        margin: 0;
        font-size: clamp(4rem, 10vw, 9.4rem);
        line-height: .78;
        text-transform: uppercase;
    }

    .hero-title .outline {
        color: transparent;
        -webkit-text-stroke: 1.5px rgba(255,255,255,.82);
    }

    .hero-subrow {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 310px;
        gap: 50px;
        align-items: end;
        margin-top: 52px;
    }

    .hero-copy {
        max-width: 590px;
        color: rgba(255,255,255,.72);
        font-size: 14px;
        line-height: 1.8;
    }

    .hero-meta {
        border-top: 1px solid rgba(255,255,255,.35);
        padding-top: 13px;
        display: flex;
        justify-content: space-between;
        gap: 16px;
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: .16em;
        font-weight: 900;
        color: rgba(255,255,255,.62);
    }

    .hero-scroll {
        position: absolute;
        right: 26px;
        bottom: 34px;
        writing-mode: vertical-rl;
        font-size: 9px;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: rgba(255,255,255,.55);
    }

    /* Search becomes a command strip */
    .arena-search {
        position: relative;
        z-index: 10;
        width: min(1400px, calc(100% - 48px));
        margin: -1px auto 0;
        background: var(--ink);
        color: white;
        border-top: 4px solid var(--green);
        display: grid;
        grid-template-columns: 150px 1fr auto;
        align-items: center;
    }

    .arena-label {
        height: 76px;
        display: flex;
        align-items: center;
        padding: 0 22px;
        border-right: 1px solid rgba(255,255,255,.14);
        font-size: 10px;
        font-weight: 900;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .arena-form {
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 0 24px;
    }

    .arena-form svg { color: #8d948f; }

    .arena-input {
        width: 100%;
        border: 0;
        outline: 0;
        background: transparent;
        color: white;
        font-size: 15px;
        font-weight: 700;
    }

    .arena-input::placeholder { color: #777c7a; }

    .arena-submit {
        height: 76px;
        padding: 0 28px;
        border: 0;
        border-left: 1px solid rgba(255,255,255,.14);
        background: var(--green);
        color: white;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: .16em;
        cursor: pointer;
        transition: background .2s ease, padding .2s ease;
    }

    .arena-submit:hover { background: #829f75; padding-inline: 34px; }

    #search-results-dropdown {
        background: #191c1e !important;
        color: white;
        border: 1px solid rgba(255,255,255,.12) !important;
        border-radius: 0 !important;
        box-shadow: 0 30px 80px rgba(0,0,0,.3) !important;
    }

    /* Main editorial canvas */
    .vim-main {
        width: min(1400px, calc(100% - 48px));
        margin: 0 auto;
        padding-bottom: 100px;
    }

    .section-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 24px;
        padding-bottom: 17px;
        border-bottom: 1px solid var(--line);
        margin-bottom: 26px;
    }

    .section-head h2 {
        margin: 7px 0 0;
        font-size: clamp(2rem, 4vw, 4rem);
        line-height: .92;
    }

    .section-link {
        color: var(--ink);
        font-size: 10px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .13em;
        text-decoration: none;
        white-space: nowrap;
    }

    .section-link:hover { text-decoration: underline; text-underline-offset: 5px; }

    /* Matchday */
    .matchday {
        padding: 110px 0 90px;
    }

    .match-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(290px, .75fr);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
    }

    .fixture {
        position: relative;
        min-height: 390px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 28px;
        border-right: 1px solid var(--line);
        overflow: hidden;
        background: rgba(255,255,255,.24);
    }

    .fixture::after {
        content: "VIMSL";
        position: absolute;
        right: -10px;
        bottom: -42px;
        font-family: 'Syne', sans-serif;
        font-size: 150px;
        font-weight: 900;
        letter-spacing: -.08em;
        color: rgba(17,19,21,.045);
        pointer-events: none;
    }

    .fixture-top {
        display: flex;
        justify-content: space-between;
        align-items: start;
        gap: 20px;
    }

    .match-number {
        font-family: 'Syne', sans-serif;
        font-size: 12px;
        font-weight: 900;
    }

    .live-dot {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--red);
        font-size: 9px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .14em;
    }

    .live-dot::before {
        content: "";
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
        box-shadow: 0 0 0 5px rgba(217,75,69,.1);
    }

    .fixture-teams {
        display: grid;
        grid-template-columns: 1fr 110px 1fr;
        align-items: center;
        gap: 15px;
        position: relative;
        z-index: 1;
    }

    .fixture-team {
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
    }

    .fixture-team.right {
        flex-direction: row-reverse;
        text-align: right;
    }

    .fixture-team img {
        width: 74px;
        height: 74px;
        object-fit: contain;
        filter: drop-shadow(0 8px 12px rgba(0,0,0,.12));
        transition: transform .35s cubic-bezier(.16,1,.3,1);
    }

    .fixture:hover .fixture-team:first-child img { transform: translateX(-5px) rotate(-3deg); }
    .fixture:hover .fixture-team.right img { transform: translateX(5px) rotate(3deg); }

    .team-name {
        font-family: 'Syne', sans-serif;
        font-size: clamp(1.1rem, 2vw, 1.75rem);
        font-weight: 900;
        line-height: .95;
        text-transform: uppercase;
    }

    .vs-mark {
        text-align: center;
        font-family: 'Syne', sans-serif;
        font-size: 25px;
        font-weight: 900;
        color: var(--green);
    }

    .fixture-time {
        display: block;
        margin-top: 7px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 9px;
        font-weight: 900;
        color: var(--muted);
        letter-spacing: .12em;
    }

    .fixture-foot {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        position: relative;
        z-index: 1;
        padding-top: 18px;
        border-top: 1px dashed var(--line);
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .12em;
        color: var(--muted);
    }

    .broadcast {
        min-height: 390px;
        background: #16191b;
        color: white;
        padding: 28px;
        position: relative;
        overflow: hidden;
    }

    .broadcast::before {
        content: "";
        position: absolute;
        inset: 0;
        opacity: .14;
        background:
            linear-gradient(90deg, transparent 49%, #fff 49.4%, #fff 50.6%, transparent 51%),
            linear-gradient(transparent 49%, #fff 49.4%, #fff 50.6%, transparent 51%);
        background-size: 130px 130px;
        transform: perspective(500px) rotateX(58deg) scale(1.8);
        transform-origin: center bottom;
    }

    .broadcast-inner { position: relative; z-index: 1; height: 100%; min-height: 330px; display: flex; flex-direction: column; }

    .broadcast-head {
        display: flex;
        justify-content: space-between;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: rgba(255,255,255,.58);
    }

    .broadcast-screen {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .broadcast-screen .offline {
        font-family: 'Syne', sans-serif;
        font-size: clamp(1.7rem, 3vw, 2.6rem);
        line-height: .9;
        letter-spacing: -.05em;
        text-transform: uppercase;
    }

    .broadcast-screen .small {
        display: block;
        margin-top: 12px;
        font: 800 9px 'Plus Jakarta Sans', sans-serif;
        letter-spacing: .16em;
        color: #777e7c;
    }

    /* Guide — giant numbered rail */
    .guide {
        padding: 15px 0 105px;
    }

    .guide-rail {
        border-top: 1px solid var(--line);
    }

    .guide-step {
        display: grid;
        grid-template-columns: 120px minmax(190px, .8fr) 1.4fr;
        gap: 30px;
        align-items: center;
        padding: 28px 0;
        border-bottom: 1px solid var(--line);
        transition: padding .35s ease, background .35s ease;
    }

    .guide-step:hover {
        padding-left: 18px;
        padding-right: 18px;
        background: rgba(111,143,99,.07);
    }

    .guide-number {
        font-family: 'Syne', sans-serif;
        font-size: 4rem;
        line-height: .8;
        color: rgba(17,19,21,.15);
    }

    .guide-title {
        font-family: 'Syne', sans-serif;
        font-size: clamp(1.5rem, 3vw, 2.8rem);
        font-weight: 900;
        line-height: .9;
        text-transform: uppercase;
    }

    .guide-copy {
        max-width: 520px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.7;
    }

    /* Results become a scoreboard */
    .results { padding: 20px 0 105px; }

    .scoreboard {
        border-top: 3px solid var(--ink);
    }

    .score-row {
        display: grid;
        grid-template-columns: 95px minmax(0, 1fr) 80px minmax(0, 1fr) 110px;
        align-items: center;
        min-height: 78px;
        border-bottom: 1px solid var(--line);
        text-decoration: none;
        color: var(--ink);
        transition: background .25s ease, padding .25s ease;
    }

    .score-row:hover {
        background: rgba(17,19,21,.045);
        padding-inline: 12px;
    }

    .score-time {
        color: var(--muted);
        font-size: 9px;
        font-weight: 900;
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    .score-team {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 11px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .score-team.right { justify-content: flex-end; }

    .score-team img { width: 28px; height: 28px; object-fit: contain; }

    .score {
        text-align: center;
        font-family: 'Syne', sans-serif;
        font-size: 21px;
        font-weight: 900;
    }

    .final-tag {
        justify-self: end;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--green);
    }

    /* Journal / editorial */
    .journal { padding: 15px 0 105px; }

    .story-grid {
        display: grid;
        grid-template-columns: 1.6fr .7fr .7fr;
        gap: 1px;
        background: var(--ink);
        border: 1px solid var(--ink);
    }

    .story {
        position: relative;
        min-height: 350px;
        overflow: hidden;
        background: var(--ink);
        color: white;
        text-decoration: none;
    }

    .story:first-child { min-height: 520px; }

    .story img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: .72;
        transition: transform .7s cubic-bezier(.16,1,.3,1), opacity .5s ease;
    }

    .story::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(0deg, rgba(10,11,12,.92), rgba(10,11,12,.05) 75%);
    }

    .story:hover img {
        transform: scale(1.055);
        opacity: .86;
    }

    .story-content {
        position: absolute;
        z-index: 2;
        inset: auto 22px 22px;
    }

    .story-date {
        font-size: 8px;
        font-weight: 900;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: rgba(255,255,255,.62);
    }

    .story h3 {
        margin: 8px 0 7px;
        font-family: 'Syne', sans-serif;
        font-size: clamp(1.25rem, 2.6vw, 2.8rem);
        line-height: .9;
        letter-spacing: -.04em;
        text-transform: uppercase;
    }

    .story:not(:first-child) h3 { font-size: 1.35rem; }

    .story p {
        margin: 0;
        color: rgba(255,255,255,.68);
        font-size: 10px;
        line-height: 1.55;
    }

    /* Closing frame */
    .closing {
        position: relative;
        overflow: hidden;
        min-height: 330px;
        background: var(--green);
        color: white;
        padding: 50px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .closing::before {
        content: "90+";
        position: absolute;
        right: -15px;
        bottom: -80px;
        font-family: 'Syne', sans-serif;
        font-size: clamp(12rem, 27vw, 28rem);
        font-weight: 900;
        letter-spacing: -.12em;
        color: rgba(255,255,255,.1);
        line-height: .8;
    }

    .closing h2 {
        position: relative;
        z-index: 1;
        max-width: 800px;
        margin: 0;
        font-size: clamp(3rem, 7vw, 7rem);
        line-height: .78;
        text-transform: uppercase;
    }

    .closing-foot {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 25px;
    }

    .closing-copy {
        max-width: 390px;
        color: rgba(255,255,255,.72);
        font-size: 11px;
        line-height: 1.6;
    }

    .closing-button {
        display: inline-flex;
        align-items: center;
        gap: 18px;
        background: white;
        color: var(--ink);
        padding: 17px 21px;
        text-decoration: none;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: .14em;
        text-transform: uppercase;
        transition: transform .25s ease;
    }

    .closing-button:hover { transform: translateX(5px); }

    /* Existing tour: adapt its colors to the new language */
    #vim-tour-card {
        border-radius: 0 !important;
        background: #f3f0e8 !important;
        color: #111315 !important;
        border: 1px solid rgba(17,19,21,.25) !important;
        box-shadow: 18px 18px 0 rgba(17,19,21,.28) !important;
    }

    #vim-tour-card::before {
        background: #f3f0e8 !important;
        border-left-color: rgba(17,19,21,.25) !important;
        border-top-color: rgba(17,19,21,.25) !important;
    }

    .vim-tour-eyebrow { color: #6f8f63 !important; }
    .vim-tour-description { color: #6f726f !important; }

    .vim-tour-next {
        border-radius: 0 !important;
        background: #111315 !important;
        box-shadow: none !important;
    }

    .vim-tour-progress span.active { background: #6f8f63 !important; }

    #vim-tour-spotlight {
        border-color: #91b184 !important;
        box-shadow: 0 0 0 4px rgba(111,143,99,.12), 0 0 35px rgba(111,143,99,.35) !important;
    }

    #vim-tour-launcher {
        border-radius: 0 !important;
        background: #111315 !important;
    }

    @media (max-width: 900px) {
        .hero-subrow,
        .match-grid { grid-template-columns: 1fr; }

        .fixture { border-right: 0; border-bottom: 1px solid var(--line); }

        .story-grid { grid-template-columns: 1fr 1fr; }
        .story:first-child { grid-column: 1 / -1; }

        .guide-step { grid-template-columns: 75px 1fr; }
        .guide-copy { grid-column: 2; }
    }

    @media (max-width: 640px) {
        .vim-hero { min-height: 690px; }
        .vim-hero-copy,
        .vim-main,
        .arena-search { width: min(100% - 28px, 1400px); }

        .hero-title { font-size: clamp(3.4rem, 18vw, 6rem); }
        .hero-subrow { margin-top: 34px; gap: 25px; }
        .hero-scroll { display: none; }

        .arena-search { display: block; }
        .arena-label { height: 44px; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.14); }
        .arena-form { height: 62px; padding: 0 15px; }
        .arena-submit { width: 100%; height: 54px; border-left: 0; border-top: 1px solid rgba(255,255,255,.14); }

        .matchday,
        .guide,
        .results,
        .journal { padding-bottom: 72px; }

        .fixture { min-height: 330px; padding: 20px; }
        .fixture-teams { grid-template-columns: 1fr 50px 1fr; gap: 5px; }
        .fixture-team { flex-direction: column; text-align: center; gap: 8px; }
        .fixture-team.right { flex-direction: column; text-align: center; }
        .fixture-team img { width: 58px; height: 58px; }
        .team-name { font-size: 14px; }

        .broadcast { min-height: 290px; }
        .broadcast-inner { min-height: 230px; }

        .guide-step { grid-template-columns: 55px 1fr; gap: 15px; }
        .guide-number { font-size: 2.8rem; }
        .guide-copy { grid-column: 2; }

        .score-row { grid-template-columns: 48px 1fr 58px 1fr; gap: 5px; }
        .final-tag { display: none; }
        .score-team { font-size: 9px; gap: 6px; }
        .score-team img { width: 22px; height: 22px; }

        .story-grid { grid-template-columns: 1fr; }
        .story:first-child { grid-column: auto; min-height: 400px; }
        .story:not(:first-child) { min-height: 280px; }

        .closing { padding: 32px 24px; min-height: 380px; }
        .closing-foot { flex-direction: column; align-items: start; }

        .section-head { align-items: start; flex-direction: column; gap: 12px; }
    }

    @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            scroll-behavior: auto !important;
            transition: none !important;
            animation: none !important;
        }
    }
</style>

<!-- =========================================================
     HOMEPAGE TOUR
     ========================================================= -->

<div id="vim-tour-overlay" aria-hidden="true">
    <div id="vim-tour-backdrop"></div>
    <div id="vim-tour-spotlight"></div>

    <div id="vim-tour-card">
        <div class="vim-tour-eyebrow" id="vim-tour-eyebrow">
            VIM SUPER LEAGUE
        </div>

        <div class="vim-tour-title" id="vim-tour-title">
            Welcome to VIMSL
        </div>

        <div class="vim-tour-description" id="vim-tour-description">
            Let's take a quick look around the league.
        </div>

        <div class="vim-tour-progress" id="vim-tour-progress"></div>

        <div class="vim-tour-actions">
            <button type="button" id="vim-tour-skip" class="vim-tour-skip">
                Skip Tour
            </button>

            <button type="button" id="vim-tour-next" class="vim-tour-next">
                Next →
            </button>
        </div>
    </div>
</div>

<button
    id="vim-tour-launcher"
    type="button"
    aria-label="Replay VIMSL tutorial"
    title="Replay VIMSL tutorial"
>
    ?
</button>



<div class="vim-page">

    <!-- HERO / MATCHDAY OPENING -->
    <header class="vim-hero">
        <div class="vim-hero-art"></div>
        <div class="vim-hero-grid"></div>

        <div class="vim-hero-copy">
            <div class="eyebrow hero-kicker">VIM SUPER LEAGUE · OFFICIAL</div>

            <h1 class="display hero-title">
                THIS IS<br>
                <span class="outline">YOUR</span><br>
                LEAGUE.
            </h1>

            <div class="hero-subrow">
                <p class="hero-copy">
                    Fixtures. Players. Markets. Stories. Everything happening inside VIM Super League,
                    brought together as one living matchday experience.
                </p>

                <div class="hero-meta">
                    <span>Season // Live</span>
                    <span>Est. VIMSL</span>
                </div>
            </div>
        </div>

        <div class="hero-scroll">Scroll to enter the league ↓</div>
    </header>

    <!-- SEARCH / COMMAND STRIP -->
    <div class="arena-search">
        <div class="arena-label">Search Arena</div>

        <form id="search-form" action="/matches" method="GET" class="arena-form">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0a7 7 0 0114 0z"></path>
            </svg>

            <input
                id="live-search-input"
                name="q"
                type="text"
                placeholder="Search teams, players, or matches..."
                autocomplete="off"
                class="arena-input"
            >
        </form>

        <button type="submit" form="search-form" id="search-btn" class="arena-submit">
            ENTER
        </button>

        <div
            id="search-results-dropdown"
            class="hidden absolute left-0 right-0 mt-2 p-4 space-y-4 max-h-96 overflow-y-auto text-left z-50"
        ></div>
    </div>

    <main class="vim-main">

        <!-- MATCHDAY -->
        <section class="matchday" id="tour-featured-match">
            <div class="section-head">
                <div>
                    <div class="eyebrow">Matchday</div>
                    <h2 class="display">Next on the pitch.</h2>
                </div>
                <a href="/matches" class="section-link">Full fixtures →</a>
            </div>

            <div class="match-grid">
                <div class="fixture">
                    <div class="fixture-top">
                        <span class="match-number">01 // UPCOMING</span>
                        <span class="live-dot">Schedule</span>
                    </div>

                    <% let nextMatch = matches.find(m => m.status === 'upcoming'); %>

                    <% if(nextMatch) { %>
                        <div class="fixture-teams">
                            <div class="fixture-team">
                                <img src="<%= nextMatch.logoA %>" alt="">
                                <div class="team-name"><%= nextMatch.teamA %></div>
                            </div>

                            <div class="vs-mark">
                                VS
                                <span class="fixture-time"><%= nextMatch.time %></span>
                            </div>

                            <div class="fixture-team right">
                                <img src="<%= nextMatch.logoB %>" alt="">
                                <div class="team-name"><%= nextMatch.teamB %></div>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="fixture-teams" style="grid-template-columns:1fr;">
                            <div style="text-align:center;">
                                <div class="display" style="font-size:clamp(2rem,5vw,4rem);">NO FIXTURE.</div>
                                <div class="fixture-time">The next match has not been scheduled yet.</div>
                            </div>
                        </div>
                    <% } %>

                    <div class="fixture-foot">
                        <span>VIM Super League</span>
                        <span>Matchday // Upcoming</span>
                    </div>
                </div>

                <div class="broadcast">
                    <div class="broadcast-inner">
                        <div class="broadcast-head">
                            <span>Broadcast Feed</span>
                            <span><%= liveLink && liveLink.trim() !== "" ? '● Live' : 'Offline' %></span>
                        </div>

                        <% if(liveLink && liveLink.trim() !== "") { %>
                            <%
                                let embedLink = liveLink;
                                if (liveLink.includes('watch?v=')) {
                                    embedLink = liveLink.replace('watch?v=', 'embed/').split('&')[0];
                                } else if (liveLink.includes('youtu.be/')) {
                                    embedLink = liveLink.replace('youtu.be/', 'youtube.com/embed/').split('?')[0];
                                }
                            %>

                            <div class="broadcast-screen">
                                <iframe
                                    class="w-full h-full min-h-[260px]"
                                    style="border:0;"
                                    src="<%= embedLink %>"
                                    frameborder="0"
                                    allowfullscreen
                                ></iframe>
                            </div>
                        <% } else { %>
                            <div class="broadcast-screen">
                                <div>
                                    <div class="offline">Broadcast<br>Offline.</div>
                                    <span class="small">No live transmission active</span>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </section>

        <!-- HOW IT WORKS -->
        <section class="guide">
            <div class="section-head">
                <div>
                    <div class="eyebrow">The route in</div>
                    <h2 class="display">Three moves.<br>One league.</h2>
                </div>
            </div>

            <div class="guide-rail">
                <div class="guide-step">
                    <div class="guide-number">01</div>
                    <div class="guide-title">Join<br>Community</div>
                    <div class="guide-copy">
                        Connect your Discord account and introduce yourself to active scouts and team leaders.
                    </div>
                </div>

                <div class="guide-step">
                    <div class="guide-number">02</div>
                    <div class="guide-title">Build<br>Identity</div>
                    <div class="guide-copy">
                        Register your player profile, stats, position and role preferences through the live Market Hub.
                    </div>
                </div>

                <div class="guide-step">
                    <div class="guide-number">03</div>
                    <div class="guide-title">Enter<br>Matchday</div>
                    <div class="guide-copy">
                        Get recruited to an official roster and compete for championship titles.
                    </div>
                </div>
            </div>
        </section>

        <!-- RESULTS -->
        <section class="results" id="tour-results">
            <div class="section-head">
                <div>
                    <div class="eyebrow">Scoreboard</div>
                    <h2 class="display">The final whistle.</h2>
                </div>
                <a href="/matches" class="section-link">All results →</a>
            </div>

            <div class="scoreboard">
                <% let recentResults = matches.filter(m => m.status === 'completed').reverse().slice(0, 6); %>

                <% if(recentResults.length > 0) { %>
                    <% recentResults.forEach(r => { %>
                        <a href="/match/<%= r.id %>" class="score-row">
                            <span class="score-time"><%= r.time %></span>

                            <span class="score-team">
                                <img src="<%= r.logoA %>" alt="">
                                <span><%= r.teamA %></span>
                            </span>

                            <span class="score">
                                <%= (r.details && r.details.goalsA) ? r.details.goalsA : 0 %>
                                —
                                <%= (r.details && r.details.goalsB) ? r.details.goalsB : 0 %>
                            </span>

                            <span class="score-team right">
                                <span><%= r.teamB %></span>
                                <img src="<%= r.logoB %>" alt="">
                            </span>

                            <span class="final-tag">Final · View match →</span>
                        </a>
                    <% }) %>
                <% } else { %>
                    <div style="padding:55px 0; color:var(--muted); font-size:10px; font-weight:900; text-transform:uppercase; letter-spacing:.15em;">
                        No recent match results available.
                    </div>
                <% } %>
            </div>
        </section>

        <!-- JOURNAL -->
        <section class="journal">
            <div class="section-head">
                <div>
                    <div class="eyebrow">The Journal</div>
                    <h2 class="display">League stories.</h2>
                </div>
            </div>

            <div class="story-grid">
                <% if (typeof stories !== 'undefined' && stories.length > 0) { %>
                    <% stories.slice().reverse().slice(0, 3).forEach(story => { %>
                        <a href="#" class="story">
                            <img src="<%= story.image %>" alt="">
                            <div class="story-content">
                                <div class="story-date"><%= story.date || 'League story' %></div>
                                <h3><%= story.title %></h3>
                                <p><%= story.description %></p>
                            </div>
                        </a>
                    <% }) %>
                <% } else { %>
                    <div style="grid-column:1/-1; padding:70px; background:#111315; color:#777; text-align:center; font-size:10px; font-weight:900; text-transform:uppercase; letter-spacing:.15em;">
                        No league stories published yet.
                    </div>
                <% } %>
            </div>
        </section>

        <!-- CLOSING FRAME -->
        <section class="closing">
            <div class="eyebrow" style="color:rgba(255,255,255,.7);">Your next move</div>

            <h2 class="display">Ready for<br>matchday?</h2>

            <div class="closing-foot">
                <p class="closing-copy">
                    Set up your player identity, enter the market and start connecting with teams inside VIM Super League.
                </p>

                <a href="/market" class="closing-button">
                    Enter the Market
                    <span>↗</span>
                </a>
            </div>
        </section>

    </main>
</div>

<!-- =========================================================
     HOMEPAGE TOUR SCRIPT
     ========================================================= -->

<script>
(function () {
    const overlay = document.getElementById('vim-tour-overlay');
    const backdrop = document.getElementById('vim-tour-backdrop');
    const spotlight = document.getElementById('vim-tour-spotlight');
    const card = document.getElementById('vim-tour-card');

    const eyebrow = document.getElementById('vim-tour-eyebrow');
    const title = document.getElementById('vim-tour-title');
    const description = document.getElementById('vim-tour-description');
    const progress = document.getElementById('vim-tour-progress');

    const nextButton = document.getElementById('vim-tour-next');
    const skipButton = document.getElementById('vim-tour-skip');
    const launcher = document.getElementById('vim-tour-launcher');

    if (!overlay || !spotlight || !card) return;

    const tourSteps = [
        {
            selector: '[data-tour="market"]',
            mobileSelector: '[data-tour="market-mobile"]',
            eyebrow: 'PLAYER MARKET',
            title: 'Build your player profile',
            description: 'The Market is where you can browse registered players, inspect their cards, stats, positions and player information.'
        },
        {
            selector: '[data-tour="matches"]',
            mobileSelector: '[data-tour="matches-mobile"]',
            eyebrow: 'MATCH CENTER',
            title: 'Follow the fixtures',
            description: 'Matches contains upcoming fixtures, completed games and individual match details.'
        },
        {
            selector: '[data-tour="metrics"]',
            mobileSelector: '[data-tour="metrics-mobile"]',
            eyebrow: 'LEAGUE METRICS',
            title: 'Track the numbers',
            description: 'Metrics is where the league statistics come together — goals, assists, saves, MVPs and other player records.'
        },
        {
            selector: '[data-tour="records"]',
            mobileSelector: '[data-tour="records-mobile"]',
            eyebrow: 'LEAGUE RECORDS',
            title: 'Explore the history',
            description: 'Records gives you the bigger picture: notable league achievements, historical records and milestones.'
        },
        {
            selector: '#live-search-input',
            eyebrow: 'SEARCH ARENA',
            title: 'Find anything quickly',
            description: 'Search for teams, players or matches directly from the homepage. Start typing and the live suggestions will appear.'
        },
        {
            selector: '#tour-featured-match',
            eyebrow: 'FEATURED FIXTURE',
            title: 'See what is coming up',
            description: 'The homepage automatically highlights the next scheduled match so you can jump into the action quickly.'
        },
        {
            selector: '#tour-results',
            eyebrow: 'SCOREBOARD',
            title: 'Keep up with results',
            description: 'Recent completed matches appear here with their final scores. You can open any match for its full details.'
        }
    ];

    let currentStep = 0;

    function isMobileLayout() {
        return window.innerWidth < 1280;
    }

    function getTarget(step) {
        let target = null;

        if (isMobileLayout() && step.mobileSelector) {
            target = document.querySelector(step.mobileSelector);
        }

        if (!target && step.selector) {
            target = document.querySelector(step.selector);
        }

        return target;
    }

    function createProgress() {
        progress.innerHTML = '';

        tourSteps.forEach(function (_, index) {
            const dot = document.createElement('span');

            if (index === currentStep) {
                dot.classList.add('active');
            }

            progress.appendChild(dot);
        });
    }

    function positionTourCard(target) {
        const margin = 16;
        const cardWidth = Math.min(360, window.innerWidth - 32);

        card.style.width = cardWidth + 'px';

        if (window.innerWidth <= 640) {
            card.classList.add('centered');
            card.style.left = '16px';
            card.style.top = 'auto';
            card.style.bottom = '20px';
            return;
        }

        card.classList.remove('centered');

        const rect = target.getBoundingClientRect();

        let left = rect.left;
        let top = rect.bottom + 22;

        if (left + cardWidth > window.innerWidth - margin) {
            left = window.innerWidth - cardWidth - margin;
        }

        if (left < margin) {
            left = margin;
        }

        const estimatedCardHeight = 220;

        if (top + estimatedCardHeight > window.innerHeight - margin) {
            top = rect.top - estimatedCardHeight - 22;

            if (top < margin) {
                top = margin;
                card.classList.add('centered');
            }
        }

        card.style.left = left + 'px';
        card.style.top = top + 'px';
        card.style.bottom = 'auto';
    }

    function moveSpotlight(target) {
        const rect = target.getBoundingClientRect();

        const isSmall = window.innerWidth <= 640;

        let width = rect.width;
        let height = rect.height;

        if (width < 55) width = 55;
        if (height < 45) height = 45;

        const padding = isSmall ? 10 : 9;

        spotlight.style.left = (rect.left + rect.width / 2) + 'px';
        spotlight.style.top = (rect.top + rect.height / 2) + 'px';
        spotlight.style.width = (width + padding * 2) + 'px';
        spotlight.style.height = (height + padding * 2) + 'px';
    }

    function showStep(index) {
        currentStep = index;

        const step = tourSteps[currentStep];
        const target = getTarget(step);

        if (!target) {
            if (currentStep < tourSteps.length - 1) {
                showStep(currentStep + 1);
            } else {
                finishTour();
            }

            return;
        }

        if (isMobileLayout() && step.mobileSelector) {
            const mobileMenu = document.getElementById('mobile-menu');

            if (mobileMenu && !mobileMenu.classList.contains('active')) {
                mobileMenu.classList.add('active');
            }
        }

        target.scrollIntoView({
            behavior: 'smooth',
            block: 'center',
            inline: 'center'
        });

        setTimeout(function () {
            moveSpotlight(target);
            positionTourCard(target);
        }, 120);

        eyebrow.textContent = step.eyebrow;
        title.textContent = step.title;
        description.textContent = step.description;

        createProgress();

        if (currentStep === tourSteps.length - 1) {
            nextButton.textContent = 'Finish ✓';
        } else {
            nextButton.textContent = 'Next →';
        }
    }

    function startTour() {
        currentStep = 0;

        overlay.classList.add('active');
        overlay.setAttribute('aria-hidden', 'false');

        document.body.style.overflow = 'hidden';

        showStep(0);
    }

    function finishTour() {
        overlay.classList.remove('active');
        overlay.setAttribute('aria-hidden', 'true');

        document.body.style.overflow = '';

        localStorage.setItem('vim_home_tour_seen', 'true');

        const mobileMenu = document.getElementById('mobile-menu');

        if (mobileMenu) {
            mobileMenu.classList.remove('active');
        }
    }

    nextButton.addEventListener('click', function () {
        if (currentStep >= tourSteps.length - 1) {
            finishTour();
            return;
        }

        showStep(currentStep + 1);
    });

    skipButton.addEventListener('click', function () {
        finishTour();
    });

    backdrop.addEventListener('click', function () {
        finishTour();
    });

    launcher.addEventListener('click', function () {
        startTour();
    });

    document.addEventListener('keydown', function (event) {
        if (!overlay.classList.contains('active')) return;

        if (event.key === 'Escape') {
            finishTour();
        }

        if (event.key === 'ArrowRight') {
            if (currentStep < tourSteps.length - 1) {
                showStep(currentStep + 1);
            }
        }

        if (event.key === 'ArrowLeft') {
            if (currentStep > 0) {
                showStep(currentStep - 1);
            }
        }
    });

    window.addEventListener('resize', function () {
        if (!overlay.classList.contains('active')) return;

        const step = tourSteps[currentStep];
        const target = getTarget(step);

        if (target) {
            moveSpotlight(target);
            positionTourCard(target);
        }
    });

    /*
     * First visit only.
     *
     * If you want to test the tour again in your browser console:
     *
     * localStorage.removeItem('vim_home_tour_seen')
     *
     * Then refresh the homepage.
     */

    const hasSeenTour = localStorage.getItem('vim_home_tour_seen');

    if (!hasSeenTour) {
        setTimeout(function () {
            startTour();
        }, 900);
    }
})();
</script>
<!-- =========================================================
     EXISTING HOMEPAGE SEARCH
     ========================================================= -->

<script>
    // Embed existing EJS data directly into browser JS
    const localMatches = <%- JSON.stringify(matches || []) %>;
    const localPlayers = <%- typeof players !== 'undefined' ? JSON.stringify(players) : '[]' %>;

    const searchInput = document.getElementById('live-search-input');
    const dropdown = document.getElementById('search-results-dropdown');
    const searchForm = document.getElementById('search-form');

    let debounceTimer;
    let topTargetUrl = '';

    // Handle typing input
    searchInput.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);

        const query = e.target.value.trim().toLowerCase();

        if (query.length < 1) {
            dropdown.classList.add('hidden');
            dropdown.innerHTML = '';
            topTargetUrl = '';
            return;
        }

        debounceTimer = setTimeout(() => {

            // Try server endpoint first
            fetch(`/api/search?q=${encodeURIComponent(query)}`)
                .then(res => res.ok ? res.json() : Promise.reject('No server API'))
                .then(data => renderSearchResults(data, query))
                .catch(() => {

                    // Client-Side Search Engine Fallback
                    const matchedMatches = localMatches.filter(m => 
                        (m.teamA && m.teamA.toLowerCase().includes(query)) ||
                        (m.teamB && m.teamB.toLowerCase().includes(query))
                    );

                    const matchedPlayers = localPlayers.filter(p =>
                        (p.name && p.name.toLowerCase().includes(query)) ||
                        (p.role && p.role.toLowerCase().includes(query))
                    );

                    renderSearchResults(
                        {
                            matches: matchedMatches,
                            players: matchedPlayers
                        },
                        query
                    );
                });

        }, 150);
    });

    function renderSearchResults(data, query) {
        const { players, matches } = data;

        let html = '';

        topTargetUrl = '';

        const hasMatches = matches && matches.length > 0;
        const hasPlayers = players && players.length > 0;

        if (!hasMatches && !hasPlayers) {
            dropdown.innerHTML = `
                <div class="text-center py-4 text-xs font-semibold text-gray-400 uppercase tracking-wider">
                    No matching teams or players found for "${query}"
                </div>
            `;

            dropdown.classList.remove('hidden');

            return;
        }

        // 1. Render Matches
        if (hasMatches) {

            if (!topTargetUrl) {
                topTargetUrl = `/match/${matches[0].id || ''}`;
            }

            html += `
                <div>
                    <span class="text-[10px] font-bold text-sky-500 uppercase tracking-widest block mb-2 px-2">
                        Matches & Teams
                    </span>

                    <div class="space-y-1">
            `;

            matches.forEach(m => {

                const matchUrl = m.id
                    ? `/match/${m.id}`
                    : `/matches?q=${encodeURIComponent(query)}`;

                html += `
                    <a 
                        href="${matchUrl}" 
                        class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-100 transition border border-transparent hover:border-slate-200"
                    >
                        <div class="flex items-center gap-3">
                            <span class="w-2 h-2 rounded-full bg-sky-500"></span>

                            <span class="text-xs font-bold text-gray-800 uppercase">
                                ${m.teamA}
                                <span class="text-sky-500">vs</span>
                                ${m.teamB}
                            </span>
                        </div>

                        <span class="text-[10px] text-gray-400 font-semibold uppercase px-2 py-0.5 bg-slate-100 rounded-md">
                            ${m.status || m.time || 'Fixture'}
                        </span>
                    </a>
                `;
            });

            html += `
                    </div>
                </div>
            `;
        }

        // 2. Render Players
        if (hasPlayers) {

            if (!topTargetUrl) {
                topTargetUrl = players[0].id
                    ? `/player/${players[0].id}`
                    : `/market`;
            }

            html += `
                <div class="${hasMatches ? 'pt-3 border-t border-slate-100' : ''}">
                    <span class="text-[10px] font-bold text-sky-500 uppercase tracking-widest block mb-2 px-2">
                        Registered Players
                    </span>

                    <div class="space-y-1">
            `;

            players.forEach(p => {

                const playerUrl = p.id
                    ? `/player/${p.id}`
                    : `/market?search=${encodeURIComponent(p.name)}`;

                html += `
                    <a 
                        href="${playerUrl}" 
                        class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-100 transition border border-transparent hover:border-slate-200"
                    >
                        <div class="flex items-center gap-3">
                            <div class="w-7 h-7 rounded-full bg-sky-100 text-sky-600 flex items-center justify-center font-bold text-xs uppercase shrink-0">
                                ${p.name ? p.name.charAt(0) : 'P'}
                            </div>

                            <div>
                                <span class="text-xs font-bold text-gray-800 block">
                                    ${p.name}
                                </span>

                                <span class="text-[10px] text-gray-400 font-medium">
                                    ${p.team || 'Free Agent'}
                                </span>
                            </div>
                        </div>

                        <span class="text-[10px] text-sky-600 font-bold uppercase tracking-wider bg-sky-50 px-2 py-0.5 rounded-md border border-sky-100">
                            ${p.role || 'Player'}
                        </span>
                    </a>
                `;
            });

            html += `
                    </div>
                </div>
            `;
        }

        dropdown.innerHTML = html;
        dropdown.classList.remove('hidden');
    }

    // Direct submit action
    searchForm.addEventListener('submit', (e) => {
        if (topTargetUrl) {
            e.preventDefault();
            window.location.href = topTargetUrl;
        }
    });

    // Hide dropdown when clicking outside
    document.addEventListener('click', (e) => {
        if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.classList.add('hidden');
        }
    });
</script>
