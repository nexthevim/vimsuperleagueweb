<%- include('partials/navbar') %>
<%
    const details = match.details || {};
    const goalsA = parseInt(details.goalsA) || 0;
    const goalsB = parseInt(details.goalsB) || 0;
    const leg1A = details.leg1GoalsA != null ? parseInt(details.leg1GoalsA) : (details.goalsA1 != null ? parseInt(details.goalsA1) : null);
    const leg1B = details.leg1GoalsB != null ? parseInt(details.leg1GoalsB) : (details.goalsB1 != null ? parseInt(details.goalsB1) : null);
    const leg2A = details.leg2GoalsA != null ? parseInt(details.leg2GoalsA) : (details.goalsA2 != null ? parseInt(details.goalsA2) : null);
    const leg2B = details.leg2GoalsB != null ? parseInt(details.leg2GoalsB) : (details.goalsB2 != null ? parseInt(details.goalsB2) : null);
    const hasLegs = leg1A != null || leg2A != null;
    const lineupA = details.lineupPlayersA || [];
    const lineupB = details.lineupPlayersB || [];

    // 7v7: GK, LB, RB, CM, LF, RF, CF
    const POS_SLOTS_A = [
        { key: 'GK', x: 50, y: 10 },
        { key: 'LB', x: 22, y: 24 },
        { key: 'RB', x: 78, y: 24 },
        { key: 'CM', x: 50, y: 36 },
        { key: 'LF', x: 22, y: 48 },
        { key: 'RF', x: 78, y: 48 },
        { key: 'CF', x: 50, y: 44 }
    ];
    const POS_SLOTS_B = [
        { key: 'GK', x: 50, y: 90 },
        { key: 'LB', x: 78, y: 76 },
        { key: 'RB', x: 22, y: 76 },
        { key: 'CM', x: 50, y: 64 },
        { key: 'LF', x: 78, y: 52 },
        { key: 'RF', x: 22, y: 52 },
        { key: 'CF', x: 50, y: 56 }
    ];

    function slotForPlayer(player, index, isTeamA) {
        const slots = isTeamA ? POS_SLOTS_A : POS_SLOTS_B;
        const pos = String(player.position || player.pos || player.slot || '').toUpperCase().trim();
        // map old def/mid/fwd slots
        const map = { DEF1: 'LB', DEF2: 'RB', MID1: 'CM', MID2: 'CM', FWD1: 'LF', FWD2: 'RF', DEF: 'LB', MID: 'CM', FWD: 'CF' };
        const key = map[pos] || pos;
        const byKey = slots.find(s => s.key === key || s.key === pos);
        if (byKey) return byKey;
        return slots[Math.min(index, slots.length - 1)];
    }

    function ratingPillClass(rating) {
        const n = parseFloat(rating);
        if (rating === null || rating === undefined || rating === '' || Number.isNaN(n)) return '';
        if (n >= 6.5) return 'rating-green';
        if (n >= 5.0) return 'rating-amber';
        return 'rating-red';
    }

    // Player contribution rows from admin (teamAPlayers / teamBPlayers)
    // plus optional leg-specific arrays.
    function normalizePlayers(list) {
        return (list || []).filter(p => p && p.name).map(p => ({
            name: p.name,
            type: (p.type || p.statType || '').toString(),
            value: p.value != null ? p.value : (p.goals != null ? p.goals : ''),
            assists: p.assists != null ? p.assists : '',
            saves: p.saves != null ? p.saves : '',
            rating: p.rating != null ? p.rating : '',
            position: p.position || p.pos || '',
            image: p.image || p.cardImage || '',
            number: p.number || ''
        }));
    }

    const leg1PlayersA = normalizePlayers(
        details.leg1TeamAPlayers || details.teamAPlayersLeg1 ||
        (hasLegs ? (details.teamAPlayers || []) : (details.teamAPlayers || []))
    );
    const leg1PlayersB = normalizePlayers(
        details.leg1TeamBPlayers || details.teamBPlayersLeg1 ||
        (hasLegs ? (details.teamBPlayers || []) : (details.teamBPlayers || []))
    );
    // Leg 2: prefer dedicated arrays; if only one list exists and legs not split, leave empty for leg2
    const leg2PlayersA = normalizePlayers(details.leg2TeamAPlayers || details.teamAPlayersLeg2 || []);
    const leg2PlayersB = normalizePlayers(details.leg2TeamBPlayers || details.teamBPlayersLeg2 || []);

    // If no leg split in admin data, show the single list under "Match stats" as leg1 only
    const legStatsObj = details.legStats || {};
    const legKeysExtra = Object.keys(legStatsObj).map(Number).filter(n => n >= 2).sort((a,b)=>a-b);
    const showLeg2Block = leg2A != null || leg2PlayersA.length > 0 || leg2PlayersB.length > 0 || legKeysExtra.length > 0;

    // Merge lineup ratings into a lookup for richer rows
    function lineupMap(arr) {
        const m = {};
        (arr || []).forEach(p => { if (p && p.name) m[p.name.toLowerCase()] = p; });
        return m;
    }
    const luA = lineupMap(lineupA);
    const luB = lineupMap(lineupB);

    function enrich(row, side) {
        const lu = side === 'A' ? luA : luB;
        const hit = lu[(row.name || '').toLowerCase()];
        if (!hit) return row;
        return {
            ...row,
            image: row.image || hit.image || hit.cardImage || '',
            rating: row.rating !== '' && row.rating != null ? row.rating : (hit.rating != null ? hit.rating : ''),
            position: row.position || hit.position || '',
            number: row.number || hit.number || ''
        };
    }

    const recentMeetings = details.recentMeetings || [];
    const matchDate = details.date || match.date || '';
    const competition = details.competition || match.competition || 'VIM SUPER LEAGUE';
    const status = details.status || match.status || 'FULL TIME';
    const videoUrl = details.videoUrl || details.highlights || '';
    const remarks =
        details.remarks ||
        details.narrative ||
        details.feedback ||
        `An intense battle between ${match.teamA} and ${match.teamB}.`;
    const mvpName = details.mvpName || 'N/A';
    const mvpCard = details.mvpCardUrl || '';
%>

<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --md-paper: #f4f1e9;
  --md-ink: #0f2f2f;
  --md-ink-deep: #073536;
  --md-teal: #07595a;
  --md-coral: #e87a64;
  --md-muted: #6d7f7a;
  --md-line: rgba(15,47,47,.1);
  --md-display: "DM Serif Display", Georgia, serif;
  --md-body: "Manrope", system-ui, sans-serif;
}
* { box-sizing: border-box; }
body { margin: 0; font-family: var(--md-body); }

.match-page {
  background:
    radial-gradient(ellipse 55% 35% at 0% 0%, rgba(232,122,100,.1), transparent 50%),
    radial-gradient(ellipse 45% 30% at 100% 5%, rgba(7,89,90,.08), transparent 48%),
    var(--md-paper);
  min-height: 100vh;
  color: var(--md-ink);
}
.match-shell { max-width: 1100px; margin: 0 auto; }

.match-card {
  background: #fffdf8;
  border: 1px solid var(--md-line);
  box-shadow: 0 16px 40px rgba(15,47,47,.06);
  animation: mdIn .5s cubic-bezier(.22,1,.36,1) both;
}
@keyframes mdIn {
  from { opacity: 0; transform: translateY(14px); }
  to { opacity: 1; transform: none; }
}

.score-hero {
  background: #fffdf8;
  color: var(--md-ink-deep);
  border-radius: 1.75rem;
  overflow: hidden;
  position: relative;
  border: 1px solid var(--md-line);
  box-shadow: 0 18px 44px rgba(15,47,47,.07);
}
.score-hero::after {
  content: ""; position: absolute; inset: 0;
  background:
    radial-gradient(circle at 12% 20%, rgba(7,89,90,.06), transparent 40%),
    radial-gradient(circle at 88% 30%, rgba(232,122,100,.07), transparent 38%);
  pointer-events: none;
}
.score-hero > * { position: relative; z-index: 1; }

.team-badge {
  width: 88px; height: 88px; border-radius: 1.35rem;
  background: #f4f1e9; border: 1px solid var(--md-line);
  display: flex; align-items: center; justify-content: center; padding: 14px;
  margin: 0 auto;
  box-shadow: 0 8px 20px rgba(15,47,47,.05);
}
.team-badge img { max-width: 100%; max-height: 100%; object-fit: contain; }

.leg-pills {
  display: flex; flex-wrap: wrap; justify-content: center; gap: .45rem; margin-top: .85rem;
}
.leg-pill {
  padding: .35rem .75rem; border-radius: 999px;
  background: rgba(7,89,90,.08); border: 1px solid rgba(7,89,90,.12);
  color: var(--md-teal);
  font-size: .62rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
}

.tab-btn { color: var(--md-muted); transition: .2s ease; }
.tab-btn:hover { color: var(--md-ink-deep); }
.tab-btn.active {
  background: var(--md-ink-deep); color: #fff;
  box-shadow: 0 8px 20px rgba(15,47,47,.15);
}

/* Pitch */
.pitch {
  position: relative; width: 100%; max-width: 820px;
  min-height: 780px; margin: 0 auto; overflow: hidden;
  border-radius: 1.75rem;
  background: repeating-linear-gradient(0deg, #1f9a4a 0px, #1f9a4a 70px, #1a8a42 70px, #1a8a42 140px);
  box-shadow: inset 0 0 0 2px rgba(255,255,255,.45), 0 28px 60px rgba(15,47,47,.18);
}
.pitch-lines {
  position: absolute; inset: 22px;
  border: 2px solid rgba(255,255,255,.6); border-radius: 1rem; pointer-events: none;
}
.pitch-halfway {
  position: absolute; left: 22px; right: 22px; top: 50%;
  border-top: 2px solid rgba(255,255,255,.6);
}
.pitch-circle {
  position: absolute; width: 140px; height: 140px;
  left: 50%; top: 50%; transform: translate(-50%,-50%);
  border: 2px solid rgba(255,255,255,.6); border-radius: 50%;
}
.pitch-center-dot {
  position: absolute; width: 8px; height: 8px;
  left: 50%; top: 50%; transform: translate(-50%,-50%);
  background: #fff; border-radius: 50%;
}
.penalty-box-top, .penalty-box-bottom {
  position: absolute; left: 50%; transform: translateX(-50%);
  width: 210px; height: 100px; border: 2px solid rgba(255,255,255,.6);
}
.penalty-box-top { top: 22px; border-top: none; }
.penalty-box-bottom { bottom: 22px; border-bottom: none; }
.goal-box-top, .goal-box-bottom {
  position: absolute; left: 50%; transform: translateX(-50%);
  width: 90px; height: 44px; border: 2px solid rgba(255,255,255,.6);
}
.goal-box-top { top: 22px; border-top: none; }
.goal-box-bottom { bottom: 22px; border-bottom: none; }

.player-marker {
  position: absolute; transform: translate(-50%,-50%);
  width: 96px; text-align: center; cursor: pointer; z-index: 20;
  transition: transform .2s ease;
  animation: mdPop .45s cubic-bezier(.22,1,.36,1) both;
}
@keyframes mdPop {
  from { opacity: 0; transform: translate(-50%,-50%) scale(.7); }
  to { opacity: 1; transform: translate(-50%,-50%) scale(1); }
}
.player-marker:hover { transform: translate(-50%,-50%) scale(1.1); z-index: 50; }
.player-avatar-frame { position: relative; width: 54px; height: 54px; margin: 0 auto 10px; }
.player-avatar {
  width: 100%; height: 100%; border-radius: 50%;
  background: #cbd5e1; border: 2px solid rgba(255,255,255,.95);
  box-shadow: 0 6px 16px rgba(0,0,0,.35);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden; font-size: 12px; font-weight: 900; color: #1e293b;
}
.player-avatar img { width: 100%; height: 100%; object-fit: cover; }
.player-icon {
  position: absolute; top: -2px; width: 17px; height: 17px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 9px; color: #fff; box-shadow: 0 2px 5px rgba(0,0,0,.4);
  border: 1.5px solid rgba(255,255,255,.9);
}
.player-icon.sub-off { left: -4px; background: #dc2626; }
.player-icon.goal { right: -4px; background: #fff; color: #111827; }
.player-pos-tag {
  position: absolute; left: 50%; top: -14px; transform: translateX(-50%);
  font-size: 8px; font-weight: 900; letter-spacing: .06em;
  padding: 1px 5px; border-radius: 4px;
  background: rgba(0,0,0,.55); color: #fff; white-space: nowrap;
}
.player-rating-pill {
  position: absolute; left: 50%; bottom: -9px; transform: translateX(-50%);
  min-width: 27px; text-align: center; padding: 2px 6px; border-radius: 999px;
  font-size: 10px; font-weight: 900; color: #fff; line-height: 1.3;
  box-shadow: 0 3px 8px rgba(0,0,0,.35); border: 1.5px solid rgba(255,255,255,.95);
}
.rating-green { background: linear-gradient(135deg, #22c55e, #15803d); }
.rating-amber { background: linear-gradient(135deg, #f7b733, #d97706); }
.rating-red { background: linear-gradient(135deg, #ef4444, #b91c1c); }
.player-label {
  color: #fff; font-size: 9.5px; font-weight: 800; text-transform: uppercase;
  letter-spacing: .01em; line-height: 1.25; white-space: nowrap;
  overflow: hidden; text-overflow: ellipsis;
  text-shadow: 0 1px 2px rgba(0,0,0,.95);
}

/* Player stats tables */
.leg-block {
  background: #fffdf8;
  border: 1px solid var(--md-line);
  border-radius: 1.5rem;
  overflow: hidden;
  box-shadow: 0 14px 36px rgba(15,47,47,.05);
  margin-bottom: 1.25rem;
}
.leg-head {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
  gap: .75rem; padding: 1rem 1.25rem;
  background: linear-gradient(135deg, rgba(7,89,90,.08), rgba(232,122,100,.06));
  border-bottom: 1px solid var(--md-line);
}
.leg-head h3 {
  margin: 0; font-family: var(--md-display); font-size: 1.35rem; color: var(--md-ink-deep);
}
.leg-score {
  font-size: .75rem; font-weight: 800; letter-spacing: .06em;
  text-transform: uppercase; color: var(--md-teal);
  padding: .4rem .8rem; border-radius: 999px;
  background: rgba(7,89,90,.1);
}
.leg-teams {
  display: grid; grid-template-columns: 1fr 1fr; gap: 0;
}
@media (max-width: 720px) {
  .leg-teams { grid-template-columns: 1fr; }
}
.leg-team-col { padding: 1rem 1.1rem 1.15rem; }
.leg-team-col + .leg-team-col { border-left: 1px solid var(--md-line); }
@media (max-width: 720px) {
  .leg-team-col + .leg-team-col { border-left: 0; border-top: 1px solid var(--md-line); }
}
.leg-team-name {
  display: flex; align-items: center; gap: .5rem;
  margin-bottom: .75rem;
  font-size: .68rem; font-weight: 800; letter-spacing: .08em;
  text-transform: uppercase; color: var(--md-ink-deep);
}
.leg-team-name img { width: 22px; height: 22px; object-fit: contain; }

.pstat-row {
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr) auto;
  gap: .55rem; align-items: center;
  padding: .55rem .35rem;
  border-radius: .85rem;
  transition: background .15s;
}
.pstat-row:hover { background: rgba(7,89,90,.04); }
.pstat-av {
  width: 28px; height: 28px; border-radius: 50%;
  background: #e2e8f0; overflow: hidden;
  display: grid; place-items: center;
  font-size: .65rem; font-weight: 900; color: #475569;
}
.pstat-av img { width: 100%; height: 100%; object-fit: cover; }
.pstat-name {
  font-size: .78rem; font-weight: 800; color: var(--md-ink-deep);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.pstat-sub {
  font-size: .58rem; font-weight: 700; color: var(--md-muted);
  text-transform: uppercase; letter-spacing: .04em;
}
.pstat-nums {
  display: flex; flex-wrap: wrap; gap: .3rem; justify-content: flex-end;
}
.pstat-chip {
  font-size: .55rem; font-weight: 800; letter-spacing: .04em;
  text-transform: uppercase; padding: .25rem .45rem; border-radius: .5rem;
  background: rgba(15,47,47,.06); color: var(--md-ink);
  white-space: nowrap;
}
.pstat-chip.g { background: rgba(5,150,105,.12); color: #047857; }
.pstat-chip.a { background: rgba(37,99,235,.1); color: #1d4ed8; }
.pstat-chip.s { background: rgba(217,119,6,.12); color: #b45309; }
.pstat-chip.r { background: rgba(7,89,90,.12); color: var(--md-teal); }
.pstat-empty {
  padding: 1.25rem .5rem; text-align: center;
  font-size: .72rem; font-weight: 700; color: var(--md-muted);
  text-transform: uppercase; letter-spacing: .06em;
}

.player-modal {
  display: none; position: fixed; inset: 0; z-index: 100;
  background: rgba(15,23,42,.55); backdrop-filter: blur(10px);
  align-items: center; justify-content: center; padding: 20px;
}
.player-modal.active { display: flex; }

@media (max-width: 768px) {
  .pitch { min-height: 640px; }
  .player-marker { width: 72px; }
  .player-avatar-frame { width: 42px; height: 42px; }
  .team-badge { width: 64px; height: 64px; }
}
</style>

<main class="match-page pt-24 pb-16 px-4 md:px-6">
  <div class="match-shell space-y-8">

    <section class="score-hero">
      <div class="px-6 md:px-10 py-4 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.25em] text-teal-700"><%= competition %></p>
          <% if (matchDate) { %>
            <p class="text-xs font-bold text-slate-400 mt-1"><%= matchDate %></p>
          <% } %>
        </div>
        <span class="px-4 py-2 rounded-full bg-slate-100 text-slate-600 text-[9px] font-black uppercase tracking-widest border border-slate-200">
          <%= status %>
        </span>
      </div>
      <div class="px-6 md:px-12 py-10 md:py-12">
        <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] items-center gap-6 md:gap-8">
          <div class="text-center">
            <div class="team-badge"><img src="<%= match.logoA %>" alt="<%= match.teamA %>"></div>
            <h1 class="mt-4 text-xl md:text-2xl font-black uppercase italic tracking-tight" style="font-family:var(--md-display)"><%= match.teamA %></h1>
          </div>
          <div class="text-center">
            <div class="flex items-center justify-center gap-3 md:gap-5">
              <span class="text-5xl md:text-7xl font-black tracking-tighter" style="font-family:var(--md-display)"><%= goalsA %></span>
              <span class="text-2xl font-black text-slate-300">–</span>
              <span class="text-5xl md:text-7xl font-black tracking-tighter" style="font-family:var(--md-display)"><%= goalsB %></span>
            </div>
            <p class="mt-2 text-[9px] font-black uppercase tracking-[0.25em] text-slate-400">Aggregate</p>
            <% if (hasLegs) { %>
              <div class="leg-pills">
                <% if (leg1A != null) { %><span class="leg-pill">Leg 1 · <%= leg1A %>–<%= leg1B %></span><% } %>
                <% if (leg2A != null) { %><span class="leg-pill">Leg 2 · <%= leg2A %>–<%= leg2B %></span><% } %>
              </div>
            <% } %>
          </div>
          <div class="text-center">
            <div class="team-badge"><img src="<%= match.logoB %>" alt="<%= match.teamB %>"></div>
            <h1 class="mt-4 text-xl md:text-2xl font-black uppercase italic tracking-tight" style="font-family:var(--md-display)"><%= match.teamB %></h1>
          </div>
        </div>
      </div>
    </section>

    <div class="flex justify-center">
      <div class="bg-white/90 border border-slate-200 shadow-sm rounded-2xl p-1.5 flex gap-1 w-full max-w-xl">
        <button id="btn-overview" onclick="switchTab('overview')" class="tab-btn active flex-1 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all">Overview</button>
        <button id="btn-lineups" onclick="switchTab('lineups')" class="tab-btn flex-1 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all">Lineups</button>
        <button id="btn-stats" onclick="switchTab('stats')" class="tab-btn flex-1 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all">Statistics</button>
      </div>
    </div>

    <!-- OVERVIEW -->
    <section id="tab-overview" class="tab-content space-y-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 match-card rounded-[28px] p-7 md:p-9">
          <div class="flex items-center justify-between mb-6">
            <div>
              <p class="text-[9px] font-black uppercase tracking-[0.25em] text-teal-700">Match report</p>
              <h2 class="text-2xl font-black italic uppercase tracking-tight mt-1" style="font-family:var(--md-display)">Feedback</h2>
            </div>
            <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center font-black">★</div>
          </div>
          <p class="text-base md:text-lg font-semibold leading-relaxed text-slate-600"><%= remarks %></p>
          <% if (hasLegs) { %>
            <div class="grid grid-cols-2 gap-3 mt-8 pt-6 border-t border-slate-100">
              <div class="bg-slate-50 rounded-2xl p-4 text-center">
                <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">Leg 1</p>
                <p class="text-2xl font-black text-slate-900 mt-1"><%= leg1A != null ? leg1A : '–' %> – <%= leg1B != null ? leg1B : '–' %></p>
              </div>
              <div class="bg-slate-50 rounded-2xl p-4 text-center">
                <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">Leg 2</p>
                <p class="text-2xl font-black text-slate-900 mt-1"><%= leg2A != null ? leg2A : '–' %> – <%= leg2B != null ? leg2B : '–' %></p>
              </div>
            </div>
          <% } %>
          <div class="grid grid-cols-2 gap-3 mt-4">
            <div class="bg-slate-50 rounded-2xl p-4 text-center">
              <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">Total goals</p>
              <p class="text-3xl font-black text-slate-900 mt-1"><%= goalsA + goalsB %></p>
            </div>
            <div class="bg-slate-50 rounded-2xl p-4 text-center">
              <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">MVP</p>
              <p class="text-lg font-black italic uppercase text-slate-900 mt-2 truncate"><%= mvpName %></p>
            </div>
          </div>
        </div>
        <div class="match-card rounded-[28px] p-6 text-center">
          <p class="text-[9px] font-black uppercase tracking-[0.25em] text-amber-600">Player of the match</p>
          <h2 class="text-xl font-black italic uppercase mt-1" style="font-family:var(--md-display)">MVP</h2>
          <div class="mt-5 rounded-2xl overflow-hidden bg-slate-100 aspect-[3/4]">
            <% if (mvpCard) { %>
              <img src="<%= mvpCard %>" class="w-full h-full object-cover" onerror="this.style.display='none'">
            <% } else { %>
              <div class="w-full h-full flex items-center justify-center text-slate-300 text-4xl font-black">MVP</div>
            <% } %>
          </div>
          <p class="mt-4 text-lg font-black italic uppercase"><%= mvpName %></p>
        </div>
      </div>

      <% if (videoUrl) { %>
        <section class="match-card rounded-[28px] p-6 md:p-8">
          <div class="mb-4">
            <p class="text-[9px] font-black uppercase tracking-[0.25em] text-rose-600">Match media</p>
            <h2 class="text-2xl font-black italic uppercase" style="font-family:var(--md-display)">Highlights</h2>
          </div>
          <div class="rounded-2xl overflow-hidden bg-black aspect-video">
            <iframe src="<%= videoUrl %>" class="w-full h-full" frameborder="0" allowfullscreen></iframe>
          </div>
        </section>
      <% } %>

      <section class="match-card rounded-[28px] p-7 md:p-9">
        <div class="mb-6">
          <p class="text-[9px] font-black uppercase tracking-[0.25em] text-teal-700">Head to head</p>
          <h2 class="text-2xl font-black italic uppercase" style="font-family:var(--md-display)">Recent meetings</h2>
        </div>
        <% if (recentMeetings.length > 0) { %>
          <div class="space-y-3">
            <% recentMeetings.forEach(previous => { %>
              <a href="/match/<%= previous._id || previous.id %>"
                 class="group flex items-center justify-between gap-4 p-4 rounded-2xl border border-slate-100 hover:border-teal-200 hover:bg-teal-50/40 transition-all">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center p-2">
                    <img src="<%= previous.logoA %>" class="w-full h-full object-contain">
                  </div>
                  <div class="min-w-0">
                    <p class="text-xs font-black uppercase truncate"><%= previous.teamA %></p>
                    <p class="text-[9px] font-bold text-slate-400">vs <%= previous.teamB %></p>
                  </div>
                </div>
                <div class="text-center shrink-0">
                  <p class="text-xl font-black"><%= previous.goalsA || 0 %> <span class="text-slate-300">–</span> <%= previous.goalsB || 0 %></p>
                </div>
                <span class="text-slate-300 group-hover:text-teal-700">→</span>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-12 bg-slate-50 rounded-2xl border border-slate-100">
            <p class="text-sm font-black uppercase tracking-widest text-slate-400">No previous meetings</p>
          </div>
        <% } %>
      </section>
    </section>

    <!-- LINEUPS -->
    <section id="tab-lineups" class="tab-content hidden space-y-6">
      <div class="text-center">
        <p class="text-[9px] font-black uppercase tracking-[0.25em] text-teal-700">7v7 formation</p>
        <h2 class="text-3xl font-black italic uppercase" style="font-family:var(--md-display)">Starting lineups</h2>
        <p class="text-sm text-slate-400 mt-2">CF · RF · LF · CM · RB · LB · GK — click a player</p>
      </div>
      <div class="pitch">
        <div class="pitch-lines"></div>
        <div class="pitch-halfway"></div>
        <div class="pitch-circle"></div>
        <div class="pitch-center-dot"></div>
        <div class="penalty-box-top"></div>
        <div class="penalty-box-bottom"></div>
        <div class="goal-box-top"></div>
        <div class="goal-box-bottom"></div>
        <div class="absolute top-6 left-1/2 -translate-x-1/2 z-30">
          <div class="bg-white/95 backdrop-blur rounded-full px-4 py-1.5 shadow-lg flex items-center gap-2">
            <img src="<%= match.logoA %>" class="w-4 h-4 object-contain">
            <span class="text-[9px] font-black uppercase tracking-widest"><%= match.teamA %></span>
          </div>
        </div>
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-30">
          <div class="bg-white/95 backdrop-blur rounded-full px-4 py-1.5 shadow-lg flex items-center gap-2">
            <img src="<%= match.logoB %>" class="w-4 h-4 object-contain">
            <span class="text-[9px] font-black uppercase tracking-widest"><%= match.teamB %></span>
          </div>
        </div>

        <% if (lineupA.length > 0) { %>
          <% lineupA.forEach((player, index) => {
            const slot = slotForPlayer(player, index, true);
            const px = player.x !== undefined ? player.x : slot.x;
            const py = player.y !== undefined ? player.y : slot.y;
            const posLabel = String(player.position || player.pos || slot.key).toUpperCase();
          %>
            <div class="player-marker" style="left:<%= px %>%; top:<%= py %>%; animation-delay:<%= index * 0.05 %>s"
                 onclick='openPlayerProfile(<%- JSON.stringify(player) %>)'>
              <div class="player-avatar-frame">
                <span class="player-pos-tag"><%= posLabel %></span>
                <div class="player-avatar">
                  <% if (player.image || player.cardImage) { %>
                    <img src="<%= player.image || player.cardImage %>" alt="">
                  <% } else { %>
                    <span><%= (player.name || '?').charAt(0) %></span>
                  <% } %>
                </div>
                <% if (player.subbedOff) { %><span class="player-icon sub-off">↓</span><% } %>
                <% if (player.goals) { %><span class="player-icon goal">⚽</span><% } %>
                <% if (player.rating || player.rating === 0) { %>
                  <span class="player-rating-pill <%= ratingPillClass(player.rating) %>"><%= player.rating %></span>
                <% } %>
              </div>
              <div class="player-label"><% if (player.number) { %><%= player.number %> <% } %><%= player.name || 'Player' %></div>
            </div>
          <% }) %>
        <% } %>

        <% if (lineupB.length > 0) { %>
          <% lineupB.forEach((player, index) => {
            const slot = slotForPlayer(player, index, false);
            const px = player.x !== undefined ? player.x : slot.x;
            const py = player.y !== undefined ? player.y : slot.y;
            const posLabel = String(player.position || player.pos || slot.key).toUpperCase();
          %>
            <div class="player-marker" style="left:<%= px %>%; top:<%= py %>%; animation-delay:<%= (index + 7) * 0.05 %>s"
                 onclick='openPlayerProfile(<%- JSON.stringify(player) %>)'>
              <div class="player-avatar-frame">
                <span class="player-pos-tag"><%= posLabel %></span>
                <div class="player-avatar">
                  <% if (player.image || player.cardImage) { %>
                    <img src="<%= player.image || player.cardImage %>" alt="">
                  <% } else { %>
                    <span><%= (player.name || '?').charAt(0) %></span>
                  <% } %>
                </div>
                <% if (player.subbedOff) { %><span class="player-icon sub-off">↓</span><% } %>
                <% if (player.goals) { %><span class="player-icon goal">⚽</span><% } %>
                <% if (player.rating || player.rating === 0) { %>
                  <span class="player-rating-pill <%= ratingPillClass(player.rating) %>"><%= player.rating %></span>
                <% } %>
              </div>
              <div class="player-label"><% if (player.number) { %><%= player.number %> <% } %><%= player.name || 'Player' %></div>
            </div>
          <% }) %>
        <% } %>

        <% if (lineupA.length === 0 && lineupB.length === 0) { %>
          <div class="absolute inset-0 flex items-center justify-center z-30">
            <div class="bg-white/95 rounded-3xl px-8 py-7 text-center shadow-2xl">
              <p class="text-xs font-black uppercase tracking-widest">Lineups not set</p>
              <p class="text-[10px] font-bold text-slate-400 mt-2">Admin can add GK · LB · RB · CM · LF · RF · CF</p>
            </div>
          </div>
        <% } %>
      </div>
    </section>

    <!-- STATISTICS — per player, Leg 1 / Leg 2 -->
    <section id="tab-stats" class="tab-content hidden space-y-6">
      <div class="text-center">
        <p class="text-[9px] font-black uppercase tracking-[0.25em] text-teal-700">Player performances</p>
        <h2 class="text-3xl font-black italic uppercase" style="font-family:var(--md-display)">Statistics</h2>
        <p class="text-sm text-slate-400 mt-2">Goals, assists & ratings from admin match entry</p>
      </div>

      <%
        function renderPlayerRows(rows, side) {
          if (!rows || !rows.length) {
            return '<div class="pstat-empty">No player stats logged</div>';
          }
          return rows.map(function(raw) {
            const p = enrich(raw, side);
            const type = String(p.type || '').toLowerCase();
            let chips = '';
            // type often goal/assist/save from admin
            if (p.goals !== '' && p.goals != null && Number(p.goals) > 0) {
              chips += '<span class="pstat-chip g">G ' + p.goals + '</span>';
            } else if (p.value !== '' && p.value != null && type.indexOf('goal') >= 0) {
              chips += '<span class="pstat-chip g">G ' + p.value + '</span>';
            } else if (p.value !== '' && p.value != null && !type) {
              chips += '<span class="pstat-chip">' + p.value + '</span>';
            }
            if (p.assists !== '' && p.assists != null && Number(p.assists) > 0) {
              chips += '<span class="pstat-chip a">A ' + p.assists + '</span>';
            }
            if (p.saves !== '' && p.saves != null && Number(p.saves) > 0) {
              chips += '<span class="pstat-chip s">S ' + p.saves + '</span>';
            }
            if (p.tackles !== '' && p.tackles != null && Number(p.tackles) > 0) {
              chips += '<span class="pstat-chip">T ' + p.tackles + '</span>';
            }
            if (p.rating !== '' && p.rating != null) {
              chips += '<span class="pstat-chip r">★ ' + p.rating + '</span>';
            }
            if (!chips) chips = '<span class="pstat-chip">—</span>';
            const img = p.image
              ? '<img src="' + p.image + '" alt="">'
              : (p.name || '?').charAt(0);
            const sub = [p.position, p.number ? '#' + p.number : ''].filter(Boolean).join(' · ') || 'Player';
            return '<div class="pstat-row">' +
              '<div class="pstat-av">' + img + '</div>' +
              '<div style="min-width:0">' +
                '<div class="pstat-name">' + (p.name || 'Unknown') + '</div>' +
                '<div class="pstat-sub">' + sub + '</div>' +
              '</div>' +
              '<div class="pstat-nums">' + chips + '</div>' +
            '</div>';
          }).join('');
        }
      %>

      <!-- LEG 1 -->
      <div class="leg-block">
        <div class="leg-head">
          <h3>Leg 1</h3>
          <span class="leg-score">
            <% if (leg1A != null) { %><%= leg1A %> – <%= leg1B %><% } else { %><%= goalsA %> – <%= goalsB %> agg<% } %>
          </span>
        </div>
        <div class="leg-teams">
          <div class="leg-team-col">
            <div class="leg-team-name">
              <% if (match.logoA) { %><img src="<%= match.logoA %>" alt=""><% } %>
              <%= match.teamA %>
            </div>
            <%- renderPlayerRows(leg1PlayersA, 'A') %>
          </div>
          <div class="leg-team-col">
            <div class="leg-team-name">
              <% if (match.logoB) { %><img src="<%= match.logoB %>" alt=""><% } %>
              <%= match.teamB %>
            </div>
            <%- renderPlayerRows(leg1PlayersB, 'B') %>
          </div>
        </div>
      </div>

      <!-- LEG 2 -->
      <% if (showLeg2Block) { %>
      <div class="leg-block">
        <div class="leg-head">
          <h3>Leg 2</h3>
          <span class="leg-score">
            <% if (leg2A != null) { %><%= leg2A %> – <%= leg2B %><% } else { %>—<% } %>
          </span>
        </div>
        <div class="leg-teams">
          <div class="leg-team-col">
            <div class="leg-team-name">
              <% if (match.logoA) { %><img src="<%= match.logoA %>" alt=""><% } %>
              <%= match.teamA %>
            </div>
            <%- renderPlayerRows(leg2PlayersA, 'A') %>
          </div>
          <div class="leg-team-col">
            <div class="leg-team-name">
              <% if (match.logoB) { %><img src="<%= match.logoB %>" alt=""><% } %>
              <%= match.teamB %>
            </div>
            <%- renderPlayerRows(leg2PlayersB, 'B') %>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Lineup ratings board (always useful) -->
      <% if (lineupA.length || lineupB.length) { %>
      <div class="leg-block">
        <div class="leg-head">
          <h3>Lineup ratings</h3>
          <span class="leg-score">Full squad</span>
        </div>
        <div class="leg-teams">
          <div class="leg-team-col">
            <div class="leg-team-name">
              <% if (match.logoA) { %><img src="<%= match.logoA %>" alt=""><% } %>
              <%= match.teamA %>
            </div>
            <% if (lineupA.length) { %>
              <% lineupA.forEach(p => { %>
                <div class="pstat-row">
                  <div class="pstat-av">
                    <% if (p.image || p.cardImage) { %><img src="<%= p.image || p.cardImage %>" alt=""><% } else { %><%= (p.name||'?').charAt(0) %><% } %>
                  </div>
                  <div style="min-width:0">
                    <div class="pstat-name"><%= p.name %></div>
                    <div class="pstat-sub"><%= (p.position || p.slot || 'Player') %><%= p.number ? ' · #' + p.number : '' %></div>
                  </div>
                  <div class="pstat-nums">
                    <% if (p.rating != null && p.rating !== '') { %><span class="pstat-chip r">★ <%= p.rating %></span><% } %>
                    <% if (p.goals) { %><span class="pstat-chip g">G <%= p.goals %></span><% } %>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="pstat-empty">No lineup</div>
            <% } %>
          </div>
          <div class="leg-team-col">
            <div class="leg-team-name">
              <% if (match.logoB) { %><img src="<%= match.logoB %>" alt=""><% } %>
              <%= match.teamB %>
            </div>
            <% if (lineupB.length) { %>
              <% lineupB.forEach(p => { %>
                <div class="pstat-row">
                  <div class="pstat-av">
                    <% if (p.image || p.cardImage) { %><img src="<%= p.image || p.cardImage %>" alt=""><% } else { %><%= (p.name||'?').charAt(0) %><% } %>
                  </div>
                  <div style="min-width:0">
                    <div class="pstat-name"><%= p.name %></div>
                    <div class="pstat-sub"><%= (p.position || p.slot || 'Player') %><%= p.number ? ' · #' + p.number : '' %></div>
                  </div>
                  <div class="pstat-nums">
                    <% if (p.rating != null && p.rating !== '') { %><span class="pstat-chip r">★ <%= p.rating %></span><% } %>
                    <% if (p.goals) { %><span class="pstat-chip g">G <%= p.goals %></span><% } %>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="pstat-empty">No lineup</div>
            <% } %>
          </div>
        </div>
      </div>
      <% } %>
    </section>
  </div>
</main>

<div id="playerProfileModal" class="player-modal" onclick="closePlayerProfile(event)">
  <div class="bg-white rounded-[28px] shadow-2xl max-w-md w-full overflow-hidden" onclick="event.stopPropagation()">
    <div class="relative">
      <button onclick="closePlayerProfile()" class="absolute top-4 right-4 z-20 w-9 h-9 rounded-full bg-black/10 hover:bg-black/20 text-slate-700 font-black transition">×</button>
      <div class="bg-slate-100 h-52 flex items-center justify-center">
        <img id="profileImage" class="max-h-full max-w-full object-contain" style="display:none">
        <div id="profilePlaceholder" class="text-6xl font-black text-slate-300">?</div>
      </div>
    </div>
    <div class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p id="profilePosition" class="text-[9px] font-black uppercase tracking-[0.25em] text-teal-700">PLAYER</p>
          <h2 id="profileName" class="text-2xl font-black italic uppercase tracking-tight mt-1" style="font-family:var(--md-display)">Player</h2>
          <p id="profileCountry" class="text-xs font-bold text-slate-400 mt-1">UNKNOWN</p>
        </div>
        <div class="bg-slate-900 text-white rounded-2xl px-4 py-3 text-center">
          <p class="text-[8px] uppercase tracking-widest opacity-50">Rating</p>
          <p id="profileRating" class="text-2xl font-black">—</p>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-3 mt-6">
        <div class="bg-slate-50 rounded-2xl p-3 text-center">
          <p class="text-[8px] font-black uppercase tracking-widest text-slate-400">Goals</p>
          <p id="profileGoals" class="text-xl font-black mt-1">0</p>
        </div>
        <div class="bg-slate-50 rounded-2xl p-3 text-center">
          <p class="text-[8px] font-black uppercase tracking-widest text-slate-400">Assists</p>
          <p id="profileAssists" class="text-xl font-black mt-1">0</p>
        </div>
        <div class="bg-slate-50 rounded-2xl p-3 text-center">
          <p class="text-[8px] font-black uppercase tracking-widest text-slate-400">Saves</p>
          <p id="profileSaves" class="text-xl font-black mt-1">0</p>
        </div>
      </div>
      <div id="profileBioWrapper" class="mt-5 pt-4 border-t border-slate-100" style="display:none">
        <p class="text-[9px] font-black uppercase tracking-widest text-slate-400 mb-2">About</p>
        <p id="profileBio" class="text-sm font-medium leading-relaxed text-slate-500"></p>
      </div>
    </div>
  </div>
</div>

<script>
function switchTab(tabId) {
  document.querySelectorAll('.tab-content').forEach(s => s.classList.add('hidden'));
  const selected = document.getElementById('tab-' + tabId);
  if (selected) selected.classList.remove('hidden');
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  const activeButton = document.getElementById('btn-' + tabId);
  if (activeButton) activeButton.classList.add('active');
}
function openPlayerProfile(player) {
  if (!player) return;
  document.getElementById('profileName').innerText = (player.number ? '#' + player.number + ' ' : '') + (player.name || 'Unknown');
  document.getElementById('profilePosition').innerText = player.position || player.pos || 'PLAYER';
  document.getElementById('profileCountry').innerText = player.country || 'UNKNOWN';
  document.getElementById('profileRating').innerText = player.rating != null ? player.rating : '—';
  document.getElementById('profileGoals').innerText = player.goals || 0;
  document.getElementById('profileAssists').innerText = player.assists || 0;
  document.getElementById('profileSaves').innerText = player.saves || 0;
  const image = player.image || player.cardImage || '';
  const profileImage = document.getElementById('profileImage');
  const placeholder = document.getElementById('profilePlaceholder');
  if (image) {
    profileImage.src = image;
    profileImage.style.display = 'block';
    placeholder.style.display = 'none';
  } else {
    profileImage.style.display = 'none';
    placeholder.style.display = 'block';
  }
  const bio = player.bio || player.experience || '';
  const bioWrapper = document.getElementById('profileBioWrapper');
  if (bio) {
    document.getElementById('profileBio').innerText = bio;
    bioWrapper.style.display = 'block';
  } else bioWrapper.style.display = 'none';
  document.getElementById('playerProfileModal').classList.add('active');
}
function closePlayerProfile(event) {
  if (event && event.target && event.target.id !== 'playerProfileModal') return;
  document.getElementById('playerProfileModal').classList.remove('active');
}
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') document.getElementById('playerProfileModal').classList.remove('active');
});
</script>
