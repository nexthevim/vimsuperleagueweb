        <!-- SECTION 3: FREQUENTLY ASKED QUESTIONS -->
        <section>
            <div class="flex items-center gap-2 mb-6">
                <span class="w-2.5 h-2.5 rounded-full bg-slate-900"></span>
                <h2 class="text-xs font-black uppercase tracking-widest text-slate-400">Frequently Asked Questions</h2>
            </div>

            <div class="space-y-4">
                
                <!-- FAQ Item 1 -->
                <div class="faq-item vim-glass-card rounded-3xl p-6 cursor-pointer" onclick="toggleFaq(this)">
                    <div class="flex items-center justify-between">
                        <h3 class="text-base font-black uppercase text-slate-900 tracking-tight">Are we scammers?</h3>
                        <i class="fa-solid fa-chevron-down faq-icon text-slate-400 text-xs transition-transform duration-300"></i>
                    </div>
                    <div class="faq-answer mt-3 pt-3 border-t border-slate-100">
                        <p class="text-xs text-slate-600 font-medium leading-relaxed">
                            We have paid out all prize pools for our past seasons. The only exception was Season 3, which we truly regret and have publicly addressed. All payout receipts, payment logs, and proof of transactions are fully transparent and accessible inside our official Discord server under the proof channels.
                        </p>
                    </div>
                </div>

                <!-- FAQ Item 2 -->
                <div class="faq-item vim-glass-card rounded-3xl p-6 cursor-pointer" onclick="toggleFaq(this)">
                    <div class="flex items-center justify-between">
                        <h3 class="text-base font-black uppercase text-slate-900 tracking-tight">How to get staff?</h3>
                        <i class="fa-solid fa-chevron-down faq-icon text-slate-400 text-xs transition-transform duration-300"></i>
                    </div>
                    <div class="faq-answer mt-3 pt-3 border-t border-slate-100">
                        <p class="text-xs text-slate-600 font-medium leading-relaxed">
                            You can check the "Join the Team" section above to fill out our official Google Forms for Editorial, Moderation, or Management roles. Once submitted, our Executive Board reviews all applications. If selected, an official administrator will DM you directly on Discord.
                        </p>
                    </div>
                </div>

                <!-- FAQ Item 3 -->
                <div class="faq-item vim-glass-card rounded-3xl p-6 cursor-pointer" onclick="toggleFaq(this)">
                    <div class="flex items-center justify-between">
                        <h3 class="text-base font-black uppercase text-slate-900 tracking-tight">How do I register my team for the league?</h3>
                        <i class="fa-solid fa-chevron-down faq-icon text-slate-400 text-xs transition-transform duration-300"></i>
                    </div>
                    <div class="faq-answer mt-3 pt-3 border-t border-slate-100">
                        <p class="text-xs text-slate-600 font-medium leading-relaxed">
                            Team registrations open prior to every official Gameweek or new Season launch. Announcement links and registration forms are posted inside the Discord announcements channel. Make sure your team roster fulfills the minimum player criteria before applying.
                        </p>
                    </div>
                </div>

                <!-- FAQ Item 4 -->
                <div class="faq-item vim-glass-card rounded-3xl p-6 cursor-pointer" onclick="toggleFaq(this)">
                    <div class="flex items-center justify-between">
                        <h3 class="text-base font-black uppercase text-slate-900 tracking-tight">How are match disputes or stat errors handled?</h3>
                        <i class="fa-solid fa-chevron-down faq-icon text-slate-400 text-xs transition-transform duration-300"></i>
                    </div>
                    <div class="faq-answer mt-3 pt-3 border-t border-slate-100">
                        <p class="text-xs text-slate-600 font-medium leading-relaxed">
                            If you spot an error in goal stats, yellow cards, or match results, open a support ticket in our Discord server within 24 hours of match completion. Our Match Review Officers will verify the match recording and update the live metrics database accordingly.
                        </p>
                    </div>
                </div>

                <!-- FAQ Item 5 -->
                <div class="faq-item vim-glass-card rounded-3xl p-6 cursor-pointer" onclick="toggleFaq(this)">
                    <div class="flex items-center justify-between">
                        <h3 class="text-base font-black uppercase text-slate-900 tracking-tight">Where can I check live fixtures and match times?</h3>
                        <i class="fa-solid fa-chevron-down faq-icon text-slate-400 text-xs transition-transform duration-300"></i>
                    </div>
                    <div class="faq-answer mt-3 pt-3 border-t border-slate-100">
                        <p class="text-xs text-slate-600 font-medium leading-relaxed">
                            Head over to the Matches tab in the main navigation. You can view Live Games, Today's Spotlights, Upcoming Gameweek schedules, and past match results categorized cleanly.
                        </p>
                    </div>
                </div>

