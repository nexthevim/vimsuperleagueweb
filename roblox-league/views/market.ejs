<%- include('partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --mk-bg: #ece7dc;
  --mk-surface: #fffdf8;
  --mk-ink: #0f2f2f;
  --mk-ink-2: #1a4544;
  --mk-muted: #6d7f7a;
  --mk-teal: #0a6b68;
  --mk-teal-d: #064e4c;
  --mk-coral: #e87a64;
  --mk-gold: #c9a227;
  --mk-line: rgba(15,47,47,.1);
  --mk-serif: "DM Serif Display", Georgia, serif;
  --mk-sans: "Manrope", system-ui, sans-serif;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; font-family: var(--mk-sans); }

main.mk-market {
  min-height: 100vh;
  color: var(--mk-ink);
  background:
    radial-gradient(ellipse 70% 40% at 0% 0%, rgba(232,122,100,.14), transparent 50%),
    radial-gradient(ellipse 50% 35% at 100% 5%, rgba(10,107,104,.1), transparent 48%),
    radial-gradient(ellipse 60% 30% at 50% 100%, rgba(201,162,39,.08), transparent 50%),
    var(--mk-bg);
  padding: 5.25rem 0 4rem;
  overflow-x: hidden;
}

.mk-wrap { width: min(1220px, calc(100% - 1.75rem)); margin: 0 auto; }

/* ===== HERO ===== */
.mk-hero {
  position: relative;
  display: grid;
  grid-template-columns: 1.3fr .7fr;
  gap: 1.5rem;
  align-items: end;
  margin-bottom: 1.75rem;
  padding: 0 .15rem 1.5rem;
}
@media (max-width: 900px) {
  .mk-hero { grid-template-columns: 1fr; }
}
.mk-hero-copy .eyebrow {
  display: inline-flex; align-items: center; gap: .5rem;
  font-size: .62rem; font-weight: 800; letter-spacing: .18em;
  text-transform: uppercase; color: var(--mk-coral);
}
.mk-hero-copy .eyebrow::before {
  content: ""; width: 18px; height: 2px; background: currentColor; border-radius: 2px;
}
.mk-hero-copy h1 {
  margin: .45rem 0 .4rem;
  font-family: var(--mk-serif);
  font-size: clamp(2.8rem, 6vw, 4.2rem);
  line-height: .9; letter-spacing: -.03em; color: var(--mk-ink);
}
.mk-hero-copy h1 em { font-style: italic; color: var(--mk-teal); }
.mk-hero-copy p {
  margin: 0; max-width: 34rem; color: var(--mk-muted); font-size: .92rem; line-height: 1.5;
}

.mk-hero-stats {
  display: grid; grid-template-columns: 1fr 1fr; gap: .55rem;
}
.mk-stat {
  background: var(--mk-surface);
  border: 1px solid var(--mk-line);
  border-radius: 1.25rem;
  padding: 1rem 1.05rem;
  box-shadow: 0 10px 28px rgba(15,47,47,.05);
  transition: transform .25s cubic-bezier(.22,1,.36,1);
}
.mk-stat:hover { transform: translateY(-3px); }
.mk-stat span {
  display: block; font-size: .55rem; font-weight: 800;
  letter-spacing: .12em; text-transform: uppercase; color: var(--mk-muted);
}
.mk-stat strong {
  font-family: var(--mk-serif); font-style: italic;
  font-size: 1.55rem; color: var(--mk-ink);
}

/* curved divider */
.mk-curve {
  height: 28px; margin: 0 0 1.25rem;
  background: var(--mk-surface);
  border-radius: 0 0 50% 50% / 0 0 100% 100%;
  border: 1px solid var(--mk-line);
  border-top: 0;
  opacity: .7;
}

/* ===== CONTROLS ===== */
.mk-toolbar {
  display: flex; flex-wrap: wrap; align-items: center; gap: .6rem;
  background: var(--mk-surface);
  border: 1px solid var(--mk-line);
  border-radius: 1.5rem;
  padding: .75rem .9rem;
  margin-bottom: 1.5rem;
  box-shadow: 0 12px 32px rgba(15,47,47,.05);
}
.mk-mode {
  display: flex; background: rgba(15,47,47,.06); padding: 3px; border-radius: 999px;
}
.mk-mode button {
  border: 0; border-radius: 999px; padding: .5rem 1.05rem;
  font-family: inherit; font-size: .62rem; font-weight: 800;
  letter-spacing: .08em; text-transform: uppercase; cursor: pointer;
  background: transparent; color: var(--mk-muted);
  transition: .2s ease;
}
.mk-mode button.is-on {
  background: var(--mk-ink); color: #fff;
  box-shadow: 0 6px 16px rgba(15,47,47,.18);
}
.mk-search { position: relative; flex: 1; min-width: 160px; max-width: 260px; }
.mk-search input {
  width: 100%; border: 1.5px solid var(--mk-line); border-radius: 999px;
  padding: .65rem 1rem .65rem 2.3rem; background: #f7f4ec;
  font-family: inherit; font-size: .8rem; font-weight: 600; color: var(--mk-ink); outline: none;
  transition: border-color .2s, box-shadow .2s;
}
.mk-search input:focus {
  border-color: var(--mk-teal); box-shadow: 0 0 0 4px rgba(10,107,104,.12); background: #fff;
}
.mk-search svg {
  position: absolute; left: .8rem; top: 50%; transform: translateY(-50%);
  width: 14px; height: 14px; color: var(--mk-muted); pointer-events: none;
}
.mk-chips {
  display: flex; flex-wrap: wrap; gap: .25rem;
  background: rgba(15,47,47,.04); padding: 3px; border-radius: 999px;
}
.mk-chips .filter-btn {
  border: 0; border-radius: 999px; padding: .4rem .7rem;
  font-family: inherit; font-size: .58rem; font-weight: 800;
  letter-spacing: .06em; text-transform: uppercase; cursor: pointer;
  background: transparent; color: var(--mk-muted); transition: .18s ease;
}
.mk-chips .filter-btn:hover { color: var(--mk-ink); }
.mk-chips .filter-btn.active {
  background: var(--mk-teal); color: #fff;
}
.mk-pill {
  border: 0; border-radius: 999px; padding: .45rem .85rem;
  font-family: inherit; font-size: .58rem; font-weight: 800;
  letter-spacing: .06em; text-transform: uppercase; cursor: pointer;
  background: #e8f3f1; color: var(--mk-teal); transition: .2s;
}
.mk-pill.on { background: var(--mk-teal); color: #fff; }
.mk-count {
  margin-left: auto; padding: .45rem .85rem; border-radius: 999px;
  background: #f3ebe0; color: var(--mk-ink-2);
  font-size: .58rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
}

/* ===== LEADERBOARD / SPOTLIGHT ===== */
.mk-lb {
  margin-bottom: 2rem;
  background: var(--mk-surface);
  border: 1px solid var(--mk-line);
  border-radius: 2rem 2rem 1.5rem 1.5rem;
  overflow: hidden;
  box-shadow: 0 18px 48px rgba(15,47,47,.07);
}
.mk-lb-top {
  display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between;
  gap: 1rem; padding: 1.35rem 1.4rem 1.1rem;
  background:
    radial-gradient(circle at 90% 0%, rgba(201,162,39,.15), transparent 40%),
    linear-gradient(180deg, #faf6ee, var(--mk-surface));
  border-bottom: 1px solid var(--mk-line);
}
.mk-lb-top h2 {
  margin: .2rem 0 0; font-family: var(--mk-serif);
  font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1; color: var(--mk-ink);
}
.mk-lb-top p { margin: .35rem 0 0; color: var(--mk-muted); font-size: .78rem; }
.mk-lb-btn {
  border: 0; border-radius: 999px; padding: .6rem 1.1rem;
  font-family: inherit; font-size: .62rem; font-weight: 800;
  letter-spacing: .08em; text-transform: uppercase; cursor: pointer;
  background: var(--mk-ink); color: #fff;
  box-shadow: 0 8px 20px rgba(15,47,47,.15);
  transition: transform .2s, background .2s;
}
.mk-lb-btn:hover { transform: translateY(-2px); background: var(--mk-teal); }

.mk-lb-body { padding: 1.25rem 1.25rem 1.5rem; }

.mk-lb-section { margin-bottom: 1.5rem; }
.mk-lb-section:last-child { margin-bottom: 0; }
.mk-lb-section h3 {
  display: flex; align-items: center; gap: .5rem;
  margin: 0 0 1rem; font-size: .62rem; font-weight: 800;
  letter-spacing: .14em; text-transform: uppercase; color: var(--mk-muted);
}
.mk-lb-section h3 i {
  font-style: normal; width: 8px; height: 8px; border-radius: 50%;
  background: var(--mk-coral); display: inline-block;
}

.mk-podium {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  align-items: end;
  perspective: 1200px;
}
@media (max-width: 800px) {
  .mk-podium { grid-template-columns: 1fr; }
}
.mk-podium-item { position: relative; display: flex; flex-direction: column; align-items: center; }
.mk-podium-item.mk-1 { order: 2; }
.mk-podium-item.mk-2 { order: 1; }
.mk-podium-item.mk-3 { order: 3; }
@media (max-width: 800px) {
  .mk-podium-item.mk-1, .mk-podium-item.mk-2, .mk-podium-item.mk-3 { order: 0; }
}
.mk-medal {
  position: absolute; top: -12px; z-index: 30;
  font-size: 1.5rem; filter: drop-shadow(0 4px 8px rgba(0,0,0,.2));
}
.mk-podium-item.mk-1 .player-card { width: 230px !important; height: 320px !important; }
.mk-podium-item.mk-2 .player-card,
.mk-podium-item.mk-3 .player-card { width: 200px !important; height: 280px !important; opacity: .96; }

.mk-rank-list {
  display: none; margin-top: .85rem;
  border: 1px solid var(--mk-line); border-radius: 1.15rem; overflow: hidden;
  background: #faf7f0;
}
.mk-rank-list.open { display: block; animation: mkSlide .35s cubic-bezier(.22,1,.36,1); }
@keyframes mkSlide {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: none; }
}
.mk-rank-row {
  display: flex; align-items: center; justify-content: space-between; gap: .75rem;
  padding: .7rem 1rem; border-bottom: 1px solid var(--mk-line);
  transition: background .15s;
}
.mk-rank-row:last-child { border-bottom: 0; }
.mk-rank-row:hover { background: #fff; }
.mk-rank-row .n {
  width: 1.5rem; height: 1.5rem; border-radius: 50%;
  display: grid; place-items: center;
  font-size: .65rem; font-weight: 800; background: rgba(15,47,47,.08); color: var(--mk-ink);
  flex-shrink: 0;
}
.mk-rank-row .name { font-weight: 800; font-size: .85rem; color: var(--mk-ink); }
.mk-rank-row .meta { font-size: .65rem; color: var(--mk-muted); font-weight: 600; }
.mk-rank-row .bid { font-weight: 800; color: var(--mk-teal); font-size: .9rem; }

/* ===== LANES / CONVEYOR ===== */
.mk-lanes { display: flex; flex-direction: column; gap: 1.25rem; }
.mk-lane {
  position: relative;
  background: var(--mk-surface);
  border: 1px solid var(--mk-line);
  border-radius: 1.75rem;
  padding: 2.4rem 0 1.4rem;
  overflow: hidden;
  box-shadow: 0 14px 36px rgba(15,47,47,.05);
}
.mk-lane-label {
  position: absolute; top: .75rem; left: 1.1rem; z-index: 5;
}
.mk-lane-label span {
  display: inline-block; padding: .35rem .75rem; border-radius: 999px;
  background: rgba(15,47,47,.06); color: var(--mk-ink-2);
  font-size: .58rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
}

@keyframes scrollLeft { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
@keyframes scrollRight { 0% { transform: translateX(-50%); } 100% { transform: translateX(0); } }
.animate-conveyor-1 { display: flex; animation: scrollLeft 36s linear infinite; width: max-content; }
.animate-conveyor-2 { display: flex; animation: scrollRight 42s linear infinite; width: max-content; }
.animate-conveyor-1:hover, .animate-conveyor-2:hover { animation-play-state: paused; }

/* ===== PLAYER CARDS ===== */
.glass-light {
  background: #fffdf8;
  border: 1px solid rgba(15,47,47,.1);
  box-shadow: 0 16px 36px -10px rgba(15,47,47,.12);
}
.player-card, .mk-card {
  transition: transform .22s cubic-bezier(.2,0,0,1), box-shadow .3s ease, border-color .3s ease;
  cursor: pointer; position: relative; overflow: hidden;
  transform-style: preserve-3d; perspective: 1000px;
  border-radius: 1.35rem !important;
  background: #0d1615;
}
.player-card:hover {
  z-index: 20;
  border-color: rgba(10,107,104,.5) !important;
  box-shadow: 0 0 40px rgba(10,107,104,.22), 0 24px 48px -12px rgba(15,47,47,.25);
}
.card-sheen {
  position: absolute; inset: 0;
  background: linear-gradient(115deg, transparent 20%, rgba(255,255,255,.55) 45%, rgba(255,255,255,.85) 50%, rgba(255,255,255,.55) 55%, transparent 80%);
  pointer-events: none; z-index: 12; opacity: 0; transform: translateX(-100%);
}
.player-card:hover .card-sheen {
  opacity: 1; transform: translateX(100%);
  transition: transform .75s ease-in-out, opacity .25s ease;
}
.card-img {
  filter: grayscale(85%) contrast(1.05);
  transition: filter .45s ease, transform .5s ease;
}
.player-card:hover .card-img {
  filter: grayscale(0%) contrast(1.02);
  transform: scale(1.07);
}
.card-active-anim {
  animation: sleekClick .4s cubic-bezier(.4,0,.2,1) forwards;
  pointer-events: none;
}
@keyframes sleekClick {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); box-shadow: 0 0 30px rgba(10,107,104,.4); }
  100% { transform: scale(1.02); opacity: .9; }
}

.pos-fwd { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; }
.pos-mid { background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: #fff; }
.pos-def { background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; }
.pos-gk  { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; }
.pos-pro { background: linear-gradient(135deg, #64748b, #475569); color: #fff; }
.rank-ss { background: linear-gradient(135deg, #ec4899, #a855f7, #f59e0b); background-size: 200% 200%; animation: rankShimmer 3s ease infinite; color: #fff; }
.rank-s { background: linear-gradient(135deg, #f59e0b, #ef4444); color: #fff; }
.rank-a { background: linear-gradient(135deg, #8b5cf6, #3b82f6); color: #fff; }
.rank-b { background: linear-gradient(135deg, #10b981, #059669); color: #fff; }
.rank-c { background: linear-gradient(135deg, #64748b, #475569); color: #fff; }
@keyframes rankShimmer {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* modal keep functional */
.modal {
  display: none; position: fixed; inset: 0; background: rgba(8,16,16,0);
  z-index: 100; align-items: center; justify-content: center; padding: 20px;
  backdrop-filter: blur(0); transition: all .4s ease;
}
.modal.active { background: rgba(8,16,16,.6); backdrop-filter: blur(16px); }
#modalContainer {
  transition: transform .5s cubic-bezier(.16,1,.3,1), opacity .4s ease;
  transform: translateY(30px) scale(.96); opacity: 0;
}
#modalContainer.show { transform: translateY(0) scale(1); opacity: 1; }
.stat-badge {
  background: rgba(241,245,249,.85); border: 1px solid #e2e8f0; backdrop-filter: blur(8px);
}
.form-label {
  display: block; font-size: .62rem; font-weight: 800; text-transform: uppercase;
  letter-spacing: .1em; color: var(--mk-muted); margin-bottom: .35rem;
}
.form-input {
  width: 100%; background: #fffdf8; border: 1.5px solid var(--mk-line);
  padding: .75rem 1rem; border-radius: .9rem; outline: none;
  transition: .25s ease; color: var(--mk-ink); font-weight: 700; font-size: .85rem;
  font-family: inherit;
}
.form-input:focus {
  border-color: var(--mk-teal); background: #fff;
  box-shadow: 0 0 0 4px rgba(10,107,104,.1);
}
.position-radio:checked + label {
  border-color: var(--mk-teal); background: #e8f3f1; color: var(--mk-teal);
  box-shadow: 0 0 0 2px var(--mk-teal);
}
.hidden-form { display: none !important; }
.custom-scroll::-webkit-scrollbar { width: 4px; }
.custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
.team-tile {
  transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  border-radius: 1.25rem !important;
}
.team-tile.active {
  border-color: transparent;
  box-shadow: 0 0 0 3px hsl(var(--team-hue) 75% 52%), 0 20px 35px -15px rgba(15,23,42,.2);
  transform: translateY(-3px);
}

/* auction section polish */
#auctionSection {
  width: min(1220px, calc(100% - 1.75rem)) !important;
  margin-left: auto !important; margin-right: auto !important;
  padding-left: 0 !important; padding-right: 0 !important;
}

.mk-alert {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
  gap: .75rem; padding: 1rem 1.15rem; margin-bottom: 1.25rem;
  border-radius: 1.25rem; background: linear-gradient(135deg, #e87a64, #d96756);
  color: #fff; box-shadow: 0 12px 28px rgba(232,122,100,.25);
}
.mk-alert button {
  border: 0; border-radius: 999px; padding: .55rem 1rem;
  font-family: inherit; font-size: .62rem; font-weight: 800;
  letter-spacing: .08em; text-transform: uppercase; cursor: pointer;
  background: #fff; color: #c45a48;
}

@keyframes mkIn {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: none; }
}
.mk-in { animation: mkIn .55s cubic-bezier(.22,1,.36,1) both; }
</style>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="fixed top-24 left-1/2 -translate-x-1/2 z-[100] bg-red-600 text-white px-8 py-4 rounded-full font-black uppercase italic shadow-lg border border-white/20 text-xs tracking-wider">
        ⚠️ <%= error %>
    </div>
<% } %>

<main class="mk-market">
<div class="mk-wrap">

    <header class="mk-hero mk-in">
        <div class="mk-hero-copy">
            <div class="eyebrow">Official transfer board</div>
            <h1>Player <em>Market</em></h1>
            <p>Scout every card, track the money, and move when the price is right. Filters and auction tools sit right under the boards.</p>
        </div>
        <div class="mk-hero-stats">
            <div class="mk-stat"><span>Players</span><strong><%= typeof players !== 'undefined' ? players.length : 0 %></strong></div>
            <div class="mk-stat"><span>Mode</span><strong style="font-size:1.15rem">Live</strong></div>
            <div class="mk-stat"><span>Classes</span><strong style="font-size:1.15rem">SS–C</strong></div>
            <div class="mk-stat"><span>Hub</span><strong style="font-size:1.15rem">Auction</strong></div>
        </div>
    </header>

    <div class="mk-toolbar mk-in">
        <div class="mk-mode">
            <button type="button" id="viewMarketBtn" class="is-on" onclick="switchMode('market')">Market</button>
            <button type="button" id="viewAuctionBtn" onclick="switchMode('auction')">Auction Hub</button>
        </div>
        <div class="mk-search" id="searchWrapper">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input type="text" id="searchInput" onkeyup="filterCards()" placeholder="Search name, Discord, country…">
        </div>
        <div class="mk-chips" id="filterWrapper">
            <button data-pos-filter="ALL" onclick="setFilter('ALL')" class="filter-btn active">ALL</button>
            <button data-pos-filter="FWD" onclick="setFilter('FWD')" class="filter-btn">FWD</button>
            <button data-pos-filter="MID" onclick="setFilter('MID')" class="filter-btn">MID</button>
            <button data-pos-filter="DEF" onclick="setFilter('DEF')" class="filter-btn">DEF</button>
            <button data-pos-filter="GK" onclick="setFilter('GK')" class="filter-btn">GK</button>
        </div>
        <div class="mk-chips" id="classFilterWrapper">
            <button data-class-filter="ALL" onclick="setClassFilter('ALL')" class="filter-btn active">ALL CLASS</button>
            <button data-class-filter="SS" onclick="setClassFilter('SS')" class="filter-btn">SS</button>
            <button data-class-filter="S" onclick="setClassFilter('S')" class="filter-btn">S</button>
            <button data-class-filter="A" onclick="setClassFilter('A')" class="filter-btn">A</button>
            <button data-class-filter="B" onclick="setClassFilter('B')" class="filter-btn">B</button>
            <button data-class-filter="C" onclick="setClassFilter('C')" class="filter-btn">C</button>
        </div>
        <% if (typeof isManager !== 'undefined' && isManager) { %>
        <button type="button" id="eligibleFilterBtn" class="mk-pill" onclick="toggleEligibleFilter()">I can bid</button>
        <% } %>
        <div class="mk-count" id="countWrapper">● <%= typeof players !== 'undefined' ? players.length : 0 %> players</div>
    </div>

    <% if (typeof isManager !== 'undefined' && isManager && typeof myOutbidPlayers !== 'undefined' && myOutbidPlayers && myOutbidPlayers.length > 0) { %>
    <div class="mk-alert">
        <div>
            <strong style="display:block;font-size:.7rem;letter-spacing:.1em;text-transform:uppercase">You've been outbid</strong>
            <span style="font-size:.8rem;opacity:.95"><%= myOutbidPlayers.length %> player(s) — check your bids in the hub.</span>
        </div>
        <button type="button" onclick="switchMode('auction')">Review bids</button>
    </div>
    <% } %>

    <div id="marketSection" class="mk-in">

    <% if (typeof marketSpotlight !== 'undefined' && marketSpotlight) { %>
    <%
        function spotPosClass(pos) {
            const u = (pos || 'PRO').toUpperCase();
            if (u === 'FWD' || u === 'FORWARD') return 'pos-fwd';
            if (u === 'MID' || u === 'MIDFIELD') return 'pos-mid';
            if (u === 'DEF' || u === 'DEFENSE') return 'pos-def';
            if (u === 'GK' || u === 'GOALKEEPER') return 'pos-gk';
            return 'pos-pro';
        }
        function spotRankClass(rank) {
            const u = (rank || 'C').toUpperCase();
            if (u === 'SS') return 'rank-ss';
            if (u === 'S') return 'rank-s';
            if (u === 'A') return 'rank-a';
            if (u === 'B') return 'rank-b';
            return 'rank-c';
        }
        function renderPodiumCard(p, medal) {
            // returns nothing - we inline below
        }
