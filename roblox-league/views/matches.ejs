<%- include('partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --ms-paper: #f4f1e9;
  --ms-ink: #0f2f2f;
  --ms-ink-deep: #073536;
  --ms-teal: #07595a;
  --ms-coral: #e87a64;
  --ms-muted: #6d7f7a;
  --ms-line: rgba(15,47,47,.1);
  --ms-display: "DM Serif Display", Georgia, serif;
  --ms-body: "Manrope", system-ui, sans-serif;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; font-family: var(--ms-body); }

.ms-page {
  min-height: 100vh;
  color: var(--ms-ink);
  background:
    radial-gradient(ellipse 60% 40% at 10% 0%, rgba(232,122,100,.12), transparent 50%),
    radial-gradient(ellipse 50% 35% at 90% 10%, rgba(7,89,90,.1), transparent 48%),
    var(--ms-paper);
  padding: 5.5rem 0 4rem;
}
.ms-wrap { width: min(1100px, calc(100% - 1.75rem)); margin: 0 auto; }

.ms-hero {
  text-align: center;
  margin-bottom: 2rem;
  animation: msIn .55s cubic-bezier(.22,1,.36,1) both;
}
.ms-hero .eyebrow {
  display: inline-flex; align-items: center; gap: .5rem;
  font-size: .62rem; font-weight: 800; letter-spacing: .18em;
  text-transform: uppercase; color: var(--ms-coral);
}
.ms-hero .eyebrow::before {
  content: ""; width: 16px; height: 2px; background: currentColor;
}
.ms-hero h1 {
  margin: .4rem 0 .3rem;
  font-family: var(--ms-display);
  font-size: clamp(2.8rem, 6vw, 4rem);
  line-height: .92; color: var(--ms-ink-deep);
}
.ms-hero h1 em { font-style: italic; color: var(--ms-teal); }
.ms-hero p {
  margin: 0; color: var(--ms-muted); font-size: .85rem;
}

.ms-tabs {
  display: flex; flex-wrap: wrap; gap: .35rem;
  padding: .4rem; margin-bottom: 1.75rem;
  background: rgba(255,253,248,.9);
  border: 1px solid var(--ms-line);
  border-radius: 999px;
  box-shadow: 0 10px 30px rgba(15,47,47,.05);
  animation: msIn .55s .08s cubic-bezier(.22,1,.36,1) both;
}
.ms-tabs button {
  flex: 1; min-width: 100px; border: 0; border-radius: 999px;
  padding: .7rem 1rem; cursor: pointer;
  font-family: inherit; font-size: .62rem; font-weight: 800;
  letter-spacing: .08em; text-transform: uppercase;
  background: transparent; color: var(--ms-muted);
  transition: .2s ease;
}
.ms-tabs button:hover { color: var(--ms-ink); }
.ms-tabs button.active {
  background: var(--ms-ink-deep); color: #fff;
  box-shadow: 0 6px 16px rgba(15,47,47,.18);
}
.ms-tabs button .dot {
  display: inline-block; width: 6px; height: 6px;
  border-radius: 50%; background: #ef4444; margin-left: .35rem;
  animation: msPulse 1.2s ease infinite;
}
@keyframes msPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: .5; transform: scale(.85); }
}

.ms-section { margin-bottom: 2rem; }
.ms-section-title {
  display: flex; align-items: center; gap: .5rem;
  margin: 0 0 1rem;
  font-size: .62rem; font-weight: 800; letter-spacing: .14em;
  text-transform: uppercase; color: var(--ms-muted);
}
.ms-section-title .live-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: #ef4444; animation: msPulse 1.2s ease infinite;
}

.ms-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  gap: 1rem;
}

/* Match card */
.ms-card {
  display: block; text-decoration: none; color: inherit;
  background: #fffdf8;
  border: 1px solid var(--ms-line);
  border-radius: 1.5rem;
  padding: 1.15rem 1.2rem 1.25rem;
  box-shadow: 0 12px 32px rgba(15,47,47,.05);
  transition: transform .25s cubic-bezier(.22,1,.36,1), box-shadow .25s ease, border-color .2s;
  animation: msIn .5s cubic-bezier(.22,1,.36,1) both;
}
.ms-card:hover {
  transform: translateY(-4px);
  border-color: rgba(7,89,90,.25);
  box-shadow: 0 20px 44px rgba(15,47,47,.1);
}
.ms-card-top {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: .9rem; padding-bottom: .7rem;
  border-bottom: 1px solid var(--ms-line);
}
.ms-badge {
  font-size: .55rem; font-weight: 800; letter-spacing: .1em;
  text-transform: uppercase; padding: .3rem .65rem; border-radius: 999px;
}
.ms-badge.live { background: #fef2f2; color: #dc2626; }
.ms-badge.up { background: #ecfdf5; color: #059669; }
.ms-badge.done { background: rgba(15,47,47,.06); color: var(--ms-muted); }

.ms-teams {
  display: grid; grid-template-columns: 1fr auto 1fr;
  gap: .75rem; align-items: center;
}
.ms-team {
  text-align: center; min-width: 0;
}
.ms-team img {
  width: 52px; height: 52px; object-fit: contain; margin: 0 auto .4rem;
  display: block; filter: drop-shadow(0 4px 8px rgba(0,0,0,.08));
  transition: transform .25s ease;
}
.ms-card:hover .ms-team img { transform: scale(1.06); }
.ms-team h3 {
  margin: 0; font-size: .78rem; font-weight: 800;
  text-transform: uppercase; letter-spacing: -.01em;
  color: var(--ms-ink-deep); line-height: 1.2;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.ms-scorebox {
  text-align: center; min-width: 4.5rem;
}
.ms-score {
  display: flex; align-items: center; justify-content: center; gap: .35rem;
  font-family: var(--ms-display); font-size: 1.75rem; font-weight: 400;
  color: var(--ms-ink-deep); line-height: 1;
}
.ms-score span.sep { color: #cbd5e1; font-size: 1.1rem; }
.ms-legs {
  display: flex; flex-direction: column; gap: .2rem; margin-top: .35rem;
}
.ms-leg {
  font-size: .55rem; font-weight: 800; letter-spacing: .06em;
  text-transform: uppercase; color: var(--ms-muted);
}
.ms-time {
  margin-top: .35rem; font-size: .65rem; font-weight: 800;
  letter-spacing: .06em; text-transform: uppercase; color: var(--ms-teal);
}

/* Spotlight */
.ms-spot {
  margin-bottom: 1.75rem;
  animation: msIn .55s .12s cubic-bezier(.22,1,.36,1) both;
}
.ms-spot a {
  display: block; text-decoration: none; color: inherit;
  background: linear-gradient(135deg, #0f2f2f 0%, #07595a 55%, #0a6b68 100%);
  border-radius: 1.75rem; padding: 1.5rem 1.35rem;
  box-shadow: 0 20px 50px rgba(7,89,90,.25);
  transition: transform .25s cubic-bezier(.22,1,.36,1);
  position: relative; overflow: hidden;
}
.ms-spot a::before {
  content: ""; position: absolute; inset: 0;
  background: radial-gradient(circle at 80% 20%, rgba(232,122,100,.2), transparent 40%);
  pointer-events: none;
}
.ms-spot a:hover { transform: translateY(-3px); }
.ms-spot-inner {
  position: relative; z-index: 1;
  display: grid; grid-template-columns: 1fr auto 1fr;
  gap: 1rem; align-items: center;
}
@media (max-width: 640px) {
  .ms-spot-inner { grid-template-columns: 1fr; text-align: center; }
}
.ms-spot .ms-team h3 { color: #fff; font-size: 1rem; }
.ms-spot .ms-team span { color: rgba(255,255,255,.55); font-size: .6rem; font-weight: 700; text-transform: uppercase; }
.ms-spot .ms-score { color: #fff; font-size: 2.5rem; }
.ms-spot .ms-score .sep { color: rgba(255,255,255,.35); }
.ms-spot-live {
  display: inline-flex; align-items: center; gap: .4rem;
  padding: .35rem .75rem; border-radius: 999px;
  background: #ef4444; color: #fff;
  font-size: .55rem; font-weight: 800; letter-spacing: .1em;
  text-transform: uppercase; margin-bottom: .5rem;
}
.ms-spot-live i {
  width: 6px; height: 6px; border-radius: 50%; background: #fff;
  animation: msPulse 1s ease infinite;
}

.ms-empty {
  padding: 2rem; text-align: center;
  color: var(--ms-muted); font-size: .8rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .08em;
}

@keyframes msIn {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: none; }
}
</style>

<div class="ms-page">
  <div class="ms-wrap">

    <header class="ms-hero">
      <div class="eyebrow">VIM Super League</div>
      <h1>Match <em>Centre</em></h1>
      <p>Fixtures, live scores & full-time results</p>
    </header>

    <div class="ms-tabs" role="tablist">
      <button type="button" id="tab-all" class="active" onclick="filterCategory('all')">All</button>
      <button type="button" id="tab-live" onclick="filterCategory('live')">Live <span class="dot"></span></button>
      <button type="button" id="tab-upcoming" onclick="filterCategory('upcoming')">Upcoming</button>
      <button type="button" id="tab-completed" onclick="filterCategory('completed')">Results</button>
    </div>

    <%
      let spotlightMatch = matches ? matches.find(m => m.isToday || m.status === 'live') : null;
      let liveMatches = matches ? matches.filter(m => m.status === 'live') : [];
      let upcomingMatches = matches ? matches.filter(m => m.status !== 'completed' && m.status !== 'live') : [];
      let completedMatches = matches ? matches.filter(m => m.status === 'completed') : [];

      function legScores(m) {
        const d = m.details || {};
        const l1a = d.leg1GoalsA != null ? d.leg1GoalsA : (d.goalsA1 != null ? d.goalsA1 : null);
        const l1b = d.leg1GoalsB != null ? d.leg1GoalsB : (d.goalsB1 != null ? d.goalsB1 : null);
        const l2a = d.leg2GoalsA != null ? d.leg2GoalsA : (d.goalsA2 != null ? d.goalsA2 : null);
        const l2b = d.leg2GoalsB != null ? d.leg2GoalsB : (d.goalsB2 != null ? d.goalsB2 : null);
        const aggA = parseInt(d.goalsA) || ((l1a != null ? +l1a : 0) + (l2a != null ? +l2a : 0));
        const aggB = parseInt(d.goalsB) || ((l1b != null ? +l1b : 0) + (l2b != null ? +l2b : 0));
        return { l1a, l1b, l2a, l2b, aggA, aggB, hasLegs: l1a != null || l2a != null };
      }
    %>

    <% if (spotlightMatch) {
      const sp = legScores(spotlightMatch);
    %>
    <div class="ms-spot match-section-spotlight">
      <a href="/match/<%= spotlightMatch.id %>">
        <div class="ms-spot-inner">
          <div class="ms-team">
            <img src="<%= spotlightMatch.logoA %>" onerror="this.onerror=null;this.src='https://via.placeholder.com/120/07595a/ffffff?text=A'" alt="">
            <h3><%= spotlightMatch.teamA %></h3>
            <span>Home</span>
          </div>
          <div class="ms-scorebox">
            <% if (spotlightMatch.status === 'live') { %>
              <div class="ms-spot-live"><i></i> Live</div>
            <% } %>
            <% if (spotlightMatch.status === 'completed' || spotlightMatch.status === 'live') { %>
              <div class="ms-score">
                <span><%= sp.aggA %></span>
                <span class="sep">–</span>
                <span><%= sp.aggB %></span>
              </div>
              <% if (sp.hasLegs) { %>
                <div class="ms-legs" style="color:rgba(255,255,255,.7)">
                  <% if (sp.l1a != null) { %><div class="ms-leg">L1 <%= sp.l1a %>–<%= sp.l1b %></div><% } %>
                  <% if (sp.l2a != null) { %><div class="ms-leg">L2 <%= sp.l2a %>–<%= sp.l2b %></div><% } %>
                </div>
              <% } %>
            <% } else { %>
              <div class="ms-score" style="font-size:1.25rem"><%= spotlightMatch.time || 'TBD' %></div>
              <div class="ms-leg" style="color:rgba(255,255,255,.6);margin-top:.35rem">Today</div>
            <% } %>
          </div>
          <div class="ms-team">
            <img src="<%= spotlightMatch.logoB %>" onerror="this.onerror=null;this.src='https://via.placeholder.com/120/e87a64/ffffff?text=B'" alt="">
            <h3><%= spotlightMatch.teamB %></h3>
            <span>Away</span>
          </div>
        </div>
      </a>
    </div>
    <% } %>

    <!-- LIVE -->
    <div id="section-live" class="ms-section match-category-block">
      <% if (liveMatches.length > 0) { %>
        <h2 class="ms-section-title"><span class="live-dot"></span> Live matches</h2>
        <div class="ms-grid">
          <% liveMatches.forEach((m, idx) => {
            const sc = legScores(m);
          %>
            <a href="/match/<%= m.id %>" class="ms-card" style="animation-delay:<%= idx * 0.05 %>s">
              <div class="ms-card-top">
                <span class="ms-badge live">Live</span>
                <span style="font-size:.55rem;font-weight:800;color:var(--ms-muted);letter-spacing:.08em;text-transform:uppercase"><%= m.time || 'In play' %></span>
              </div>
              <div class="ms-teams">
                <div class="ms-team">
                  <img src="<%= m.logoA %>" onerror="this.onerror=null;this.src='https://via.placeholder.com/100/f1f5f9/475569?text=A'" alt="">
                  <h3><%= m.teamA %></h3>
                </div>
                <div class="ms-scorebox">
                  <div class="ms-score">
                    <span><%= sc.aggA %></span>
                    <span class="sep">–</span>
                    <span><%= sc.aggB %></span>
                  </div>
                  <% if (sc.hasLegs) { %>
                    <div class="ms-legs">
                      <% if (sc.l1a != null) { %><div class="ms-leg">L1 <%= sc.l1a %>–<%= sc.l1b %></div><% } %>
                      <% if (sc.l2a != null) { %><div class="ms-leg">L2 <%= sc.l2a %>–<%= sc.l2b %></div><% } %>
                    </div>
                  <% } %>
                </div>
                <div class="ms-team">
                  <img src="<%= m.logoB %>" onerror="this.onerror=null;this.src='https://via.placeholder.com/100/f1f5f9/475569?text=B'" alt="">
                  <h3><%= m.teamB %></h3>
                </div>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- UPCOMING -->
    <div id="section-upcoming" class="ms-section match-category-block">
      <h2 class="ms-section-title">Upcoming fixtures</h2>
      <% if (upcomingMatches.length > 0) { %>
        <div class="ms-grid">
          <% upcomingMatches.forEach((m, idx) => { %>
            <a href="/match/<%= m.id %>" class="ms-card" style="animation-delay:<%= idx * 0.04 %>s">
              <div class="ms-card-top">
                <span class="ms-badge up">Scheduled</span>
                <span style="font-size:.55rem;font-weight:800;color:var(--ms-muted);letter-spacing:.06em">#<%= String(m.id).substring(0,6) %></span>
              </div>
              <div class="ms-teams">
                <div class="ms-team">
                  <img src="<%= m.logoA %>" onerror="this.onerror=null;this.src='https://via.placeholder.com/100/f1f5f9/475569?text=A'" alt="">
                  <h3><%= m.teamA %></h3>
                </div>
                <div class="ms-scorebox">
                  <div class="ms-time"><%= m.time || 'TBD' %></div>
                </div>
                <div class="ms-team">
                  <img src="<%= m.logoB %>" onerror="this.onerror=null;this.src='https://via.placeholder.com/100/f1f5f9/475569?text=B'" alt="">
                  <h3><%= m.teamB %></h3>
                </div>
              </div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <p class="ms-empty">No upcoming fixtures</p>
      <% } %>
    </div>

    <!-- RESULTS -->
    <div id="section-completed" class="ms-section match-category-block">
      <h2 class="ms-section-title">Results</h2>
      <% if (completedMatches.length > 0) { %>
        <div class="ms-grid">
          <% completedMatches.forEach((m, idx) => {
            const sc = legScores(m);
          %>
            <a href="/match/<%= m.id %>" class="ms-card" style="animation-delay:<%= idx * 0.04 %>s">
              <div class="ms-card-top">
                <span class="ms-badge done">Full time</span>
                <span style="font-size:.55rem;font-weight:800;color:var(--ms-muted);letter-spacing:.08em;text-transform:uppercase">Final</span>
              </div>
              <div class="ms-teams">
                <div class="ms-team">
                  <img src="<%= m.logoA %>" onerror="this.onerror=null;this.src='https://via.placeholder.com/100/f1f5f9/475569?text=A'" alt="">
                  <h3><%= m.teamA %></h3>
                </div>
                <div class="ms-scorebox">
                  <div class="ms-score">
                    <span><%= sc.aggA %></span>
                    <span class="sep">–</span>
                    <span><%= sc.aggB %></span>
                  </div>
                  <% if (sc.hasLegs) { %>
                    <div class="ms-legs">
                      <% if (sc.l1a != null) { %><div class="ms-leg">Leg 1 · <%= sc.l1a %>–<%= sc.l1b %></div><% } %>
                      <% if (sc.l2a != null) { %><div class="ms-leg">Leg 2 · <%= sc.l2a %>–<%= sc.l2b %></div><% } %>
                    </div>
                  <% } %>
                </div>
                <div class="ms-team">
                  <img src="<%= m.logoB %>" onerror="this.onerror=null;this.src='https://via.placeholder.com/100/f1f5f9/475569?text=B'" alt="">
                  <h3><%= m.teamB %></h3>
                </div>
              </div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <p class="ms-empty">No results yet</p>
      <% } %>
    </div>

  </div>
</div>

<script>
function filterCategory(cat) {
  document.querySelectorAll('.ms-tabs button').forEach(btn => btn.classList.remove('active'));
  const active = document.getElementById('tab-' + cat);
  if (active) active.classList.add('active');
  const liveSec = document.getElementById('section-live');
  const upcomingSec = document.getElementById('section-upcoming');
  const completedSec = document.getElementById('section-completed');
  if (cat === 'all') {
    if (liveSec) liveSec.style.display = '';
    if (upcomingSec) upcomingSec.style.display = '';
    if (completedSec) completedSec.style.display = '';
  } else {
    if (liveSec) liveSec.style.display = cat === 'live' ? '' : 'none';
    if (upcomingSec) upcomingSec.style.display = cat === 'upcoming' ? '' : 'none';
    if (completedSec) completedSec.style.display = cat === 'completed' ? '' : 'none';
  }
}
</script>
