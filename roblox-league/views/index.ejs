<%- include('partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
/* =========================================================
   VIM SUPER LEAGUE — HOMEPAGE
   Editorial football / tactile 3D / anti-template styling
   ========================================================= */

:root {
    --ink: #07111f;
    --navy: #091827;
    --navy-2: #0d2238;
    --blue: #2377ff;
    --blue-2: #52a8ff;
    --ice: #dff2ff;
    --lime: #d8ff43;
    --paper: #f3f5f0;
    --white: #ffffff;
    --muted: #7b8795;
    --line: rgba(7,17,31,.10);
    --shadow: 0 24px 70px rgba(5,18,35,.16);
    --soft-shadow: 0 14px 35px rgba(5,18,35,.10);
    --display: "Bebas Neue", Impact, sans-serif;
    --serif: "DM Serif Display", Georgia, serif;
    --body: "Manrope", system-ui, sans-serif;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
    margin: 0;
    background:
        radial-gradient(circle at 10% 5%, rgba(35,119,255,.10), transparent 26rem),
        radial-gradient(circle at 92% 35%, rgba(216,255,67,.09), transparent 24rem),
        var(--paper);
    color: var(--ink);
    font-family: var(--body);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
}

a { -webkit-tap-highlight-color: transparent; }

.vsl-page {
    position: relative;
    overflow: hidden;
}

.vsl-wrap {
    width: min(1180px, calc(100% - 36px));
    margin: 0 auto;
}

.vsl-kicker {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    color: var(--blue);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .18em;
    text-transform: uppercase;
}

.vsl-kicker::before {
    content: "";
    width: 22px;
    height: 3px;
    border-radius: 99px;
    background: var(--lime);
    box-shadow: 5px 0 0 var(--blue);
}

.vsl-display {
    font-family: var(--display);
    font-weight: 400;
    letter-spacing: .005em;
    line-height: .86;
}

/* ---------- decorative background ---------- */

.vsl-orb {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(.2px);
    opacity: .65;
}

.vsl-orb.one {
    width: 360px; height: 360px;
    right: -160px; top: 180px;
    background: rgba(35,119,255,.12);
}

.vsl-orb.two {
    width: 260px; height: 260px;
    left: -150px; top: 850px;
    background: rgba(216,255,67,.10);
}

/* ---------- HERO ---------- */

.vsl-hero {
    padding: 18px 0 0;
    position: relative;
}

.vsl-hero-shell {
    min-height: 720px;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 34px 34px 70px 34px;
    background:
        linear-gradient(100deg, rgba(3,11,22,.98) 0%, rgba(5,20,37,.86) 45%, rgba(5,17,30,.36) 100%),
        url('/images/vimgfx.png') center / cover no-repeat;
    box-shadow: 0 38px 100px rgba(4,18,35,.25);
}

.vsl-hero-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at 80% 35%, rgba(82,168,255,.32), transparent 23rem),
        linear-gradient(135deg, transparent 58%, rgba(216,255,67,.12));
    z-index: -1;
}

.vsl-hero-shell::after {
    content: "VSL";
    position: absolute;
    right: -20px;
    bottom: -72px;
    font-family: var(--display);
    font-size: clamp(13rem, 30vw, 25rem);
    line-height: .7;
    color: rgba(255,255,255,.035);
    letter-spacing: -.04em;
    pointer-events: none;
}

.vsl-hero-content {
    position: relative;
    z-index: 3;
    width: min(720px, 100%);
    min-height: 720px;
    padding: 92px 58px 58px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.vsl-hero-kicker {
    color: var(--lime);
    margin-bottom: 22px;
}

.vsl-hero-kicker::before {
    background: var(--lime);
    box-shadow: 5px 0 0 rgba(255,255,255,.7);
}

.vsl-hero h1 {
    margin: 0;
    color: #fff;
    font-family: var(--display);
    font-size: clamp(5.2rem, 11vw, 9.5rem);
    line-height: .77;
    letter-spacing: -.015em;
    text-transform: uppercase;
    text-shadow: 0 8px 35px rgba(0,0,0,.20);
}

.vsl-hero h1 span {
    display: block;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255,255,255,.78);
    transform: translateX(22px);
}

.vsl-hero-copy {
    margin: 30px 0 0;
    max-width: 490px;
    color: rgba(255,255,255,.72);
    font-size: 1rem;
    line-height: 1.75;
}

.vsl-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
}

.vsl-btn {
    min-height: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 0 22px;
    border: 0;
    border-radius: 16px;
    font-family: var(--body);
    font-size: .73rem;
    font-weight: 800;
    letter-spacing: .10em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    position: relative;
    transform: translateY(0);
    transition: transform .16s ease, box-shadow .16s ease, background .16s ease;
}

.vsl-btn::after {
    content: "↗";
    font-size: 1rem;
    line-height: 1;
    transition: transform .16s ease;
}

.vsl-btn:hover {
    transform: translateY(-4px);
}

.vsl-btn:hover::after { transform: translate(2px,-2px); }

.vsl-btn:active {
    transform: translateY(2px);
}

.vsl-btn-primary {
    background: var(--lime);
    color: var(--ink);
    box-shadow:
        0 8px 0 #a5c91d,
        0 18px 34px rgba(216,255,67,.18);
}

.vsl-btn-primary:hover {
    box-shadow:
        0 5px 0 #a5c91d,
        0 18px 40px rgba(216,255,67,.26);
}

.vsl-btn-ghost {
    color: #fff;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.20);
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 0 rgba(0,0,0,.18);
}

.vsl-btn-ghost:hover { background: rgba(255,255,255,.14); }

/* floating hero objects */

.vsl-float-card {
    position: absolute;
    z-index: 4;
    border: 1px solid rgba(255,255,255,.16);
    background: rgba(8,25,43,.72);
    backdrop-filter: blur(18px);
    color: #fff;
    box-shadow: 0 24px 55px rgba(0,0,0,.22);
    animation: vslFloat 5s ease-in-out infinite;
}

.vsl-float-card.match {
    right: 42px;
    top: 82px;
    width: 265px;
    padding: 18px;
    border-radius: 22px 22px 22px 7px;
    transform: rotate(2deg);
}

.vsl-float-card.market {
    right: 72px;
    bottom: 88px;
    width: 225px;
    padding: 17px;
    border-radius: 8px 22px 22px 22px;
    transform: rotate(-2deg);
    animation-delay: -2.1s;
}

.vsl-float-label {
    color: var(--lime);
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
    margin-bottom: 12px;
}

.vsl-score {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 9px;
}

.vsl-mini-team {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
}

.vsl-mini-team:last-child { justify-content: flex-end; }

.vsl-mini-team img {
    width: 32px;
    height: 32px;
    object-fit: contain;
}

.vsl-mini-team span {
    font-size: .67rem;
    font-weight: 800;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.vsl-vs {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1rem;
    color: rgba(255,255,255,.6);
}

.vsl-market-row {
    display: flex;
    align-items: center;
    gap: 11px;
}

.vsl-market-orb {
    width: 43px;
    height: 43px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, #4ea7ff, #1457db);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.3), 0 10px 22px rgba(35,119,255,.28);
    font-family: var(--display);
    font-size: 1.5rem;
}

.vsl-market-row strong {
    display: block;
    font-size: .8rem;
    line-height: 1.2;
}

.vsl-market-row small {
    color: rgba(255,255,255,.48);
    font-size: .62rem;
}

@keyframes vslFloat {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -9px; }
}

/* ---------- SEARCH ---------- */

.vsl-search-wrap {
    position: absolute;
    z-index: 7;
    left: 58px;
    bottom: 45px;
    width: min(500px, calc(100% - 116px));
}

.vsl-search {
    position: relative;
    display: flex;
    align-items: center;
    padding: 6px;
    border-radius: 19px;
    background: #fff;
    box-shadow: 0 18px 45px rgba(0,0,0,.25);
}

.vsl-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    padding: 13px 15px;
    background: transparent;
    color: var(--ink);
    font-family: var(--body);
    font-size: .84rem;
    font-weight: 600;
}

.vsl-search input::placeholder { color: #9aa3ad; }

.vsl-search button {
    border: 0;
    min-height: 43px;
    padding: 0 17px;
    border-radius: 13px;
    background: var(--ink);
    color: #fff;
    font-family: var(--body);
    font-size: .64rem;
    font-weight: 800;
    letter-spacing: .09em;
    text-transform: uppercase;
    cursor: pointer;
}

#search-results-dropdown {
    position: absolute;
    left: 0; right: 0;
    top: calc(100% + 9px);
    max-height: 350px;
    overflow-y: auto;
    padding: 12px;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 25px 55px rgba(0,0,0,.25);
    color: var(--ink);
    text-align: left;
    z-index: 30;
}

.hidden { display: none !important; }

/* ---------- CURVED TICKER ---------- */

.vsl-ticker {
    position: relative;
    margin-top: -1px;
    padding: 19px 0 23px;
    overflow: hidden;
    background: var(--lime);
    color: var(--ink);
    transform: rotate(-1.2deg) scale(1.03);
    box-shadow: 0 12px 30px rgba(120,150,10,.12);
}

.vsl-ticker-track {
    width: max-content;
    display: flex;
    align-items: center;
    gap: 30px;
    animation: ticker 24s linear infinite;
}

.vsl-ticker-item {
    display: flex;
    align-items: center;
    gap: 30px;
    font-family: var(--display);
    font-size: 1.35rem;
    letter-spacing: .04em;
    white-space: nowrap;
}

.vsl-ticker-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--blue);
}

@keyframes ticker {
    to { transform: translateX(-50%); }
}

/* ---------- INTRO ---------- */

.vsl-intro {
    padding: 105px 0 70px;
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: 80px;
    align-items: end;
}

.vsl-intro h2 {
    margin: 15px 0 0;
    max-width: 8ch;
    font-family: var(--display);
    font-size: clamp(3.8rem, 7vw, 6.8rem);
    line-height: .82;
    text-transform: uppercase;
}

.vsl-intro h2 em {
    font-family: var(--serif);
    text-transform: none;
    font-size: .72em;
    font-weight: 400;
}

.vsl-intro-copy {
    max-width: 530px;
    color: #5f6c79;
    font-size: 1.03rem;
    line-height: 1.85;
}

.vsl-intro-copy strong {
    color: var(--ink);
    font-weight: 800;
}

/* ---------- SECTION HEAD ---------- */

.vsl-section {
    padding: 48px 0;
}

.vsl-section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
}

.vsl-section-head h3 {
    margin: 8px 0 0;
    font-family: var(--display);
    font-size: clamp(2.7rem, 5vw, 4.2rem);
    line-height: .85;
    text-transform: uppercase;
}

.vsl-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .10em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 2px solid var(--lime);
    padding-bottom: 5px;
}

.vsl-link::after { content: "↗"; font-size: 1rem; }

/* ---------- NEXT MATCH ---------- */

.vsl-match-card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 180px 1fr;
    align-items: center;
    gap: 20px;
    padding: 36px;
    border-radius: 30px 30px 30px 8px;
    background: var(--navy);
    color: #fff;
    box-shadow: var(--shadow);
}

.vsl-match-card::before {
    content: "";
    position: absolute;
    width: 270px;
    height: 270px;
    right: 18%;
    top: -190px;
    border: 70px solid rgba(35,119,255,.16);
    border-radius: 50%;
}

.vsl-match-card::after {
    content: "";
    position: absolute;
    width: 130px;
    height: 130px;
    left: -50px;
    bottom: -70px;
    border: 28px solid rgba(216,255,67,.12);
    border-radius: 50%;
}

.vsl-team {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 17px;
}

.vsl-team.right {
    flex-direction: row-reverse;
    text-align: right;
}

.vsl-team img {
    width: 78px;
    height: 78px;
    object-fit: contain;
    filter: drop-shadow(0 12px 15px rgba(0,0,0,.25));
}

.vsl-team span {
    font-family: var(--display);
    font-size: 2.35rem;
    line-height: .9;
    text-transform: uppercase;
}

.vsl-match-mid {
    position: relative;
    z-index: 2;
    text-align: center;
}

.vsl-match-mid strong {
    display: block;
    font-family: var(--serif);
    font-size: 2.3rem;
    font-style: italic;
    font-weight: 400;
}

.vsl-match-mid small {
    display: inline-block;
    margin-top: 10px;
    padding: 7px 10px;
    border-radius: 99px;
    background: rgba(255,255,255,.09);
    color: rgba(255,255,255,.60);
    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
}

.vsl-empty {
    padding: 32px;
    border: 2px dashed rgba(7,17,31,.12);
    border-radius: 24px;
    text-align: center;
    color: var(--muted);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
}

/* ---------- STREAM ---------- */

.vsl-stream {
    margin-top: 18px;
    overflow: hidden;
    min-height: 300px;
    border-radius: 28px 28px 8px 28px;
    background: #030a12;
    box-shadow: var(--soft-shadow);
}

.vsl-stream iframe {
    width: 100%;
    min-height: 430px;
    display: block;
    border: 0;
}

.vsl-stream-empty {
    min-height: 300px;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 40px;
    color: rgba(255,255,255,.42);
}

.vsl-stream-empty strong {
    display: block;
    margin-bottom: 5px;
    color: #fff;
    font-family: var(--display);
    font-size: 2.5rem;
    letter-spacing: .02em;
}

/* ---------- 3 STEPS ---------- */

.vsl-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
}

.vsl-step {
    position: relative;
    min-height: 235px;
    padding: 28px;
    overflow: hidden;
    border-radius: 24px 24px 24px 6px;
    background: #fff;
    border: 1px solid rgba(7,17,31,.07);
    box-shadow: 0 14px 34px rgba(7,17,31,.06);
    transition: transform .2s ease, box-shadow .2s ease;
}

.vsl-step:nth-child(2) { transform: translateY(18px); background: #eaf5ff; }
.vsl-step:nth-child(3) { background: var(--navy); color: #fff; }

.vsl-step:hover {
    transform: translateY(-5px) !important;
    box-shadow: 0 22px 45px rgba(7,17,31,.13);
}

.vsl-step::after {
    content: attr(data-num);
    position: absolute;
    right: -15px;
    bottom: -45px;
    font-family: var(--display);
    font-size: 10rem;
    line-height: 1;
    color: rgba(7,17,31,.045);
}

.vsl-step:nth-child(3)::after { color: rgba(255,255,255,.045); }

.vsl-step-num {
    position: relative;
    z-index: 2;
    color: var(--blue);
    font-family: var(--display);
    font-size: 2.7rem;
    line-height: .8;
}

.vsl-step h4 {
    position: relative;
    z-index: 2;
    margin: 25px 0 9px;
    font-size: 1rem;
    font-weight: 800;
}

.vsl-step p {
    position: relative;
    z-index: 2;
    max-width: 270px;
    margin: 0;
    color: #73808d;
    font-size: .83rem;
    line-height: 1.7;
}

.vsl-step:nth-child(3) p { color: rgba(255,255,255,.55); }

/* ---------- RESULTS ---------- */

.vsl-results {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}

.vsl-result {
    display: block;
    padding: 17px 18px;
    border-radius: 17px;
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid rgba(7,17,31,.07);
    box-shadow: 0 8px 22px rgba(7,17,31,.045);
    transition: transform .18s ease, box-shadow .18s ease;
}

.vsl-result:hover {
    color: var(--ink);
    transform: translateY(-4px) rotate(-.3deg);
    box-shadow: 0 18px 32px rgba(7,17,31,.10);
}

.vsl-result-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.vsl-result-row + .vsl-result-row { margin-top: 11px; }

.vsl-result-team {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
}

.vsl-result-team img {
    width: 29px;
    height: 29px;
    object-fit: contain;
}

.vsl-result-team span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: .76rem;
    font-weight: 800;
    text-transform: uppercase;
}

.vsl-result-score {
    min-width: 30px;
    text-align: right;
    font-family: var(--display);
    font-size: 1.65rem;
    line-height: 1;
}

.vsl-result-score.dim { color: #9aa4ae; }

/* ---------- STORIES ---------- */

.vsl-stories {
    display: grid;
    grid-template-columns: 1.45fr .8fr .8fr;
    grid-auto-rows: 220px;
    gap: 13px;
}

.vsl-story {
    position: relative;
    overflow: hidden;
    display: block;
    border-radius: 25px;
    color: #fff;
    text-decoration: none;
    background: var(--navy);
}

.vsl-story:first-child {
    grid-row: span 2;
    border-radius: 34px 8px 34px 34px;
}

.vsl-story img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .55s cubic-bezier(.2,.8,.2,1);
}

.vsl-story:hover img { transform: scale(1.08) rotate(1deg); }

.vsl-story::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(3,10,18,0) 30%, rgba(3,10,18,.88) 100%);
}

.vsl-story-text {
    position: absolute;
    z-index: 2;
    left: 20px;
    right: 20px;
    bottom: 19px;
}

.vsl-story-text small {
    display: block;
    margin-bottom: 7px;
    color: var(--lime);
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
}

.vsl-story-text strong {
    display: block;
    font-family: var(--display);
    font-size: 1.65rem;
    line-height: .9;
    letter-spacing: .02em;
    text-transform: uppercase;
}

.vsl-story:first-child .vsl-story-text strong {
    font-size: 2.7rem;
}

/* ---------- CTA ---------- */

.vsl-cta {
    position: relative;
    margin: 90px 0 80px;
    padding: 72px 45px;
    overflow: hidden;
    text-align: center;
    border-radius: 42px 42px 8px 42px;
    background: var(--blue);
    color: #fff;
    box-shadow: 0 30px 70px rgba(35,119,255,.24);
}

.vsl-cta::before,
.vsl-cta::after {
    content: "";
    position: absolute;
    border: 2px solid rgba(255,255,255,.13);
    border-radius: 50%;
    pointer-events: none;
}

.vsl-cta::before {
    width: 440px;
    height: 440px;
    left: -190px;
    top: -260px;
}

.vsl-cta::after {
    width: 320px;
    height: 320px;
    right: -110px;
    bottom: -240px;
}

.vsl-cta .vsl-kicker {
    color: var(--lime);
    justify-content: center;
}

.vsl-cta h3 {
    position: relative;
    z-index: 2;
    margin: 14px 0 14px;
    font-family: var(--display);
    font-size: clamp(3.7rem, 8vw, 7rem);
    line-height: .78;
    text-transform: uppercase;
}

.vsl-cta p {
    position: relative;
    z-index: 2;
    max-width: 500px;
    margin: 0 auto 28px;
    color: rgba(255,255,255,.72);
    line-height: 1.7;
    font-size: .92rem;
}

.vsl-cta .vsl-btn {
    position: relative;
    z-index: 2;
}

/* ---------- TOUR ---------- */

#vim-tour-overlay {
    position: fixed;
    inset: 0;
    z-index: 50000;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity .25s ease, visibility .25s ease;
}

#vim-tour-overlay.active { opacity: 1; visibility: visible; }

#vim-tour-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(3,10,18,.78);
    pointer-events: auto;
}

#vim-tour-spotlight {
    position: absolute;
    width: 100px;
    height: 100px;
    border-radius: 20px;
    border: 2px solid var(--lime);
    box-shadow: 0 0 0 5px rgba(216,255,67,.13), 0 0 45px rgba(216,255,67,.20);
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: left .45s cubic-bezier(.16,1,.3,1), top .45s cubic-bezier(.16,1,.3,1), width .35s ease, height .35s ease;
}

#vim-tour-card {
    position: fixed;
    width: min(360px, calc(100vw - 32px));
    background: #fff;
    color: var(--ink);
    border: 0;
    border-radius: 20px;
    padding: 1.35rem;
    box-shadow: 0 24px 60px rgba(0,0,0,.25);
    z-index: 50002;
    pointer-events: auto;
}

#vim-tour-card.centered::before { display: none; }

.vim-tour-eyebrow {
    color: var(--blue);
    font-size: .65rem;
    font-weight: 800;
    letter-spacing: .18em;
    text-transform: uppercase;
    margin-bottom: .4rem;
}

.vim-tour-title {
    font-family: var(--display);
    font-size: 2rem;
    line-height: .9;
    text-transform: uppercase;
    margin-bottom: .55rem;
}

.vim-tour-description {
    color: var(--muted);
    font-size: .84rem;
    line-height: 1.6;
    margin-bottom: 1rem;
}

.vim-tour-progress { display: flex; gap: 5px; margin-bottom: 1rem; }

.vim-tour-progress span {
    height: 4px;
    width: 18px;
    border-radius: 99px;
    background: #e5e9ed;
}

.vim-tour-progress span.active {
    width: 28px;
    background: var(--blue);
}

.vim-tour-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.vim-tour-skip {
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: .5rem;
    cursor: pointer;
}

.vim-tour-next {
    border: 0;
    background: var(--ink);
    color: #fff;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: .75rem 1rem;
    border-radius: 12px;
    cursor: pointer;
}

#vim-tour-launcher {
    position: fixed;
    right: 1.15rem;
    bottom: 1.15rem;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 14px;
    background: var(--ink);
    color: var(--lime);
    border: 0;
    z-index: 40000;
    font-family: var(--display);
    font-size: 1.2rem;
    cursor: pointer;
    box-shadow: 0 10px 24px rgba(0,0,0,.18);
}

/* ---------- RESPONSIVE ---------- */

@media (max-width: 1000px) {
    .vsl-float-card.match { right: 25px; }
    .vsl-float-card.market { right: 25px; }
    .vsl-intro { gap: 40px; }
}

@media (max-width: 820px) {
    .vsl-hero-shell { min-height: 680px; border-radius: 26px 26px 45px 26px; }
    .vsl-hero-content { min-height: 680px; padding: 75px 30px 155px; }
    .vsl-hero h1 { font-size: clamp(4.6rem, 17vw, 7rem); }
    .vsl-float-card.match { top: 25px; right: 20px; transform: scale(.86) rotate(2deg); transform-origin: top right; }
    .vsl-float-card.market { display: none; }
    .vsl-search-wrap { left: 30px; bottom: 32px; width: calc(100% - 60px); }
    .vsl-intro { grid-template-columns: 1fr; padding-top: 80px; }
    .vsl-intro h2 { max-width: 9ch; }
    .vsl-steps { grid-template-columns: 1fr; }
    .vsl-step:nth-child(2) { transform: none; }
    .vsl-step:hover { transform: translateY(-4px) !important; }
    .vsl-match-card { grid-template-columns: 1fr; padding: 28px; }
    .vsl-team, .vsl-team.right { justify-content: center; flex-direction: row; text-align: center; }
    .vsl-match-mid { order: 2; }
    .vsl-team.right { order: 3; }
    .vsl-team { order: 1; }
    .vsl-results { grid-template-columns: 1fr; }
    .vsl-stories { grid-template-columns: 1fr 1fr; grid-auto-rows: 230px; }
    .vsl-story:first-child { grid-column: 1 / -1; grid-row: auto; }
}

@media (max-width: 560px) {
    .vsl-wrap { width: min(100% - 22px, 1180px); }
    .vsl-hero { padding-top: 10px; }
    .vsl-hero-shell { min-height: 650px; }
    .vsl-hero-content { min-height: 650px; padding: 62px 22px 140px; }
    .vsl-hero h1 { font-size: clamp(4.1rem, 19vw, 6rem); }
    .vsl-hero h1 span { transform: translateX(11px); }
    .vsl-hero-copy { font-size: .88rem; line-height: 1.65; }
    .vsl-hero-actions { gap: 10px; }
    .vsl-btn { min-height: 52px; padding: 0 17px; }
    .vsl-float-card.match { display: none; }
    .vsl-search-wrap { left: 16px; bottom: 19px; width: calc(100% - 32px); }
    .vsl-search { flex-direction: column; align-items: stretch; border-radius: 17px; }
    .vsl-search button { width: 100%; }
    .vsl-intro { padding: 70px 0 35px; }
    .vsl-intro h2 { font-size: 4.5rem; }
    .vsl-section { padding: 34px 0; }
    .vsl-section-head { align-items: start; flex-direction: column; }
    .vsl-section-head h3 { font-size: 3.2rem; }
    .vsl-team span { font-size: 1.8rem; }
    .vsl-team img { width: 62px; height: 62px; }
    .vsl-stories { grid-template-columns: 1fr; grid-auto-rows: 220px; }
    .vsl-story:first-child { min-height: 320px; }
    .vsl-cta { margin: 65px 0 55px; padding: 55px 24px; border-radius: 30px 30px 7px 30px; }
    #vim-tour-card { bottom: 1.15rem !important; top: auto !important; left: 1rem !important; width: calc(100vw - 2rem); }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
    }
}
</style>

<div class="vsl-page">
    <div class="vsl-orb one"></div>
    <div class="vsl-orb two"></div>

    <!-- TOUR -->
    <div id="vim-tour-overlay" aria-hidden="true">
        <div id="vim-tour-backdrop"></div>
        <div id="vim-tour-spotlight"></div>
        <div id="vim-tour-card">
            <div class="vim-tour-eyebrow" id="vim-tour-eyebrow">VIM SUPER LEAGUE</div>
            <div class="vim-tour-title" id="vim-tour-title">Welcome</div>
            <div class="vim-tour-description" id="vim-tour-description">A quick look around the league.</div>
            <div class="vim-tour-progress" id="vim-tour-progress"></div>
            <div class="vim-tour-actions">
                <button type="button" id="vim-tour-skip" class="vim-tour-skip">Skip</button>
                <button type="button" id="vim-tour-next" class="vim-tour-next">Next</button>
            </div>
        </div>
    </div>
    <button id="vim-tour-launcher" type="button" aria-label="Replay tutorial" title="Replay tutorial">?</button>

    <!-- HERO -->
    <section class="vsl-hero">
        <div class="vsl-wrap">
            <div class="vsl-hero-shell">
                <div class="vsl-hero-content">
                    <div class="vsl-kicker vsl-hero-kicker">VIM Super League · Season live</div>

                    <h1 class="vsl-display">
                        Play<br>
                        <span>above</span>
                        the rest.
                    </h1>

                    <p class="vsl-hero-copy">
                        A competitive Roblox football league built around managers, players,
                        transfers, matchdays and the tiny details that make a season feel real.
                    </p>

                    <div class="vsl-hero-actions">
                        <a href="/market" class="vsl-btn vsl-btn-primary">Enter market</a>
                        <a href="/matches" class="vsl-btn vsl-btn-ghost">View fixtures</a>
                    </div>
                </div>

                <!-- floating "physical" UI pieces -->
                <div class="vsl-float-card match" aria-hidden="true">
                    <div class="vsl-float-label">Next on the pitch</div>
                    <% const heroMatchList = (typeof matches !== 'undefined' && matches) ? matches : []; %>
                    <% const heroNext = heroMatchList.find(m => m.status === 'upcoming'); %>
                    <% if (heroNext) { %>
                        <div class="vsl-score">
                            <div class="vsl-mini-team">
                                <img src="<%= heroNext.logoA %>" alt="">
                                <span><%= heroNext.teamA %></span>
                            </div>
                            <div class="vsl-vs">vs</div>
                            <div class="vsl-mini-team">
                                <img src="<%= heroNext.logoB %>" alt="">
                                <span><%= heroNext.teamB %></span>
                            </div>
                        </div>
                    <% } else { %>
                        <div style="font-size:.75rem;color:rgba(255,255,255,.65)">No fixture locked yet.</div>
                    <% } %>
                </div>

                <div class="vsl-float-card market" aria-hidden="true">
                    <div class="vsl-float-label">Market pulse</div>
                    <div class="vsl-market-row">
                        <div class="vsl-market-orb">↑</div>
                        <div>
                            <strong>Transfers are moving.</strong>
                            <small>Scout. Bid. Build.</small>
                        </div>
                    </div>
                </div>

                <div class="vsl-search-wrap">
                    <form id="search-form" action="/matches" method="GET" class="vsl-search">
                        <input id="live-search-input" name="q" type="text"
                               placeholder="Search teams, players, matches…" autocomplete="off">
                        <button type="submit" id="search-btn">Search</button>
                        <div id="search-results-dropdown" class="hidden"></div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- moving identity strip -->
    <div class="vsl-ticker" aria-hidden="true">
        <div class="vsl-ticker-track">
            <div class="vsl-ticker-item">
                <span>VIM SUPER LEAGUE</span><i class="vsl-ticker-dot"></i>
                <span>MATCHDAY</span><i class="vsl-ticker-dot"></i>
                <span>PLAYER MARKET</span><i class="vsl-ticker-dot"></i>
                <span>MANAGER FOOTBALL</span><i class="vsl-ticker-dot"></i>
                <span>VIM SUPER LEAGUE</span><i class="vsl-ticker-dot"></i>
                <span>MATCHDAY</span><i class="vsl-ticker-dot"></i>
                <span>PLAYER MARKET</span><i class="vsl-ticker-dot"></i>
                <span>MANAGER FOOTBALL</span><i class="vsl-ticker-dot"></i>
            </div>
        </div>
    </div>

    <!-- INTRO -->
    <section class="vsl-wrap vsl-intro">
        <div>
            <div class="vsl-kicker">The league</div>
            <h2 class="vsl-display">Built for <em>the ones</em> who care.</h2>
        </div>
        <p class="vsl-intro-copy">
            <strong>VIM is not just a fixture list.</strong> Track upcoming games, browse the
            player market, follow results and stay close to the league without digging through
            twelve channels and a suspiciously large pile of Discord messages.
        </p>
    </section>

    <!-- MATCHDAY -->
    <section class="vsl-wrap vsl-section">
        <div class="vsl-section-head">
            <div>
                <div class="vsl-kicker">Matchday</div>
                <h3 class="vsl-display" id="tour-featured-match">Next fixture</h3>
            </div>
            <a href="/matches" class="vsl-link">All fixtures</a>
        </div>

        <% const matchList = (typeof matches !== 'undefined' && matches) ? matches : []; %>
        <% let nextMatch = matchList.find(m => m.status === 'upcoming'); %>

        <% if (nextMatch) { %>
            <div class="vsl-match-card">
                <div class="vsl-team">
                    <img src="<%= nextMatch.logoA %>" alt="">
                    <span><%= nextMatch.teamA %></span>
                </div>

                <div class="vsl-match-mid">
                    <strong>vs</strong>
                    <small><%= nextMatch.time || 'Time TBC' %></small>
                </div>

                <div class="vsl-team right">
                    <img src="<%= nextMatch.logoB %>" alt="">
                    <span><%= nextMatch.teamB %></span>
                </div>
            </div>
        <% } else { %>
            <div class="vsl-empty">No upcoming match scheduled</div>
        <% } %>

        <div class="vsl-stream">
            <% if (typeof liveLink !== 'undefined' && liveLink && String(liveLink).trim() !== '') { %>
                <%
                    let embedLink = liveLink;
                    if (liveLink.includes('watch?v=')) embedLink = liveLink.replace('watch?v=', 'embed/').split('&')[0];
                    else if (liveLink.includes('youtu.be/')) embedLink = liveLink.replace('youtu.be/', 'youtube.com/embed/').split('?')[0];
                %>
                <iframe src="<%= embedLink %>" allowfullscreen title="Live stream"></iframe>
            <% } else { %>
                <div class="vsl-stream-empty">
                    <div>
                        <strong>Stream offline</strong>
                        <span>Broadcast appears here when a match is live.</span>
                    </div>
                </div>
            <% } %>
        </div>
    </section>

    <!-- PLAYER JOURNEY -->
    <section class="vsl-wrap vsl-section">
        <div class="vsl-section-head">
            <div>
                <div class="vsl-kicker">The route in</div>
                <h3 class="vsl-display">Get in. Get signed.</h3>
            </div>
        </div>

        <div class="vsl-steps">
            <div class="vsl-step" data-num="01">
                <div class="vsl-step-num">01</div>
                <h4>Join the room</h4>
                <p>Start in Discord. Meet managers, learn the league and get yourself on the radar.</p>
            </div>
            <div class="vsl-step" data-num="02">
                <div class="vsl-step-num">02</div>
                <h4>Build your card</h4>
                <p>Create a clean player profile with the identity, role and information teams actually need.</p>
            </div>
            <div class="vsl-step" data-num="03">
                <div class="vsl-step-num">03</div>
                <h4>Get signed & play</h4>
                <p>Auction or signings put you on a roster. Then the fixtures, pressure and glory begin.</p>
            </div>
        </div>
    </section>

    <!-- RESULTS -->
    <section class="vsl-wrap vsl-section" id="tour-results">
        <div class="vsl-section-head">
            <div>
                <div class="vsl-kicker">Scoreboard</div>
                <h3 class="vsl-display">Recent results</h3>
            </div>
            <a href="/matches" class="vsl-link">Full list</a>
        </div>

        <div class="vsl-results">
            <%
                const recent = matchList
                    .filter(m => m.status === 'completed' || m.status === 'complete' || (m.details && (m.details.goalsA != null || m.details.goalsB != null)))
                    .slice(-8)
                    .reverse();
            %>

            <% if (recent.length) { %>
                <% recent.forEach(r => { %>
                    <a class="vsl-result" href="/match/<%= r._id || r.id || '' %>">
                        <div class="vsl-result-row">
                            <div class="vsl-result-team">
                                <img src="<%= r.logoA %>" alt="">
                                <span><%= r.teamA %></span>
                            </div>
                            <span class="vsl-result-score"><%= (r.details && r.details.goalsA != null) ? r.details.goalsA : 0 %></span>
                        </div>
                        <div class="vsl-result-row">
                            <div class="vsl-result-team">
                                <img src="<%= r.logoB %>" alt="">
                                <span style="color:#8b96a2"><%= r.teamB %></span>
                            </div>
                            <span class="vsl-result-score dim"><%= (r.details && r.details.goalsB != null) ? r.details.goalsB : 0 %></span>
                        </div>
                    </a>
                <% }) %>
            <% } else { %>
                <div class="vsl-empty" style="grid-column:1/-1">No results posted yet</div>
            <% } %>
        </div>
    </section>

    <!-- STORIES -->
    <section class="vsl-wrap vsl-section">
        <div class="vsl-section-head">
            <div>
                <div class="vsl-kicker">League journal</div>
                <h3 class="vsl-display">Stories from VIM</h3>
            </div>
        </div>

        <div class="vsl-stories">
            <% if (typeof stories !== 'undefined' && stories && stories.length) { %>
                <% stories.slice().reverse().slice(0, 5).forEach((story, i) => { %>
                    <div class="vsl-story">
                        <% if (story.image) { %>
                            <img src="<%= story.image %>" alt="">
                        <% } %>
                        <div class="vsl-story-text">
                            <small><%= story.date || 'Article' %></small>
                            <strong><%= story.title %></strong>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="vsl-empty" style="grid-column:1/-1">Stories will appear here</div>
            <% } %>
        </div>
    </section>

    <!-- CTA -->
    <section class="vsl-wrap">
        <div class="vsl-cta">
            <div class="vsl-kicker">Player market</div>
            <h3 class="vsl-display">Your next move<br>starts here.</h3>
            <p>Open the market, set up your player card or scout who is available for the next window.</p>
            <a href="/market" class="vsl-btn vsl-btn-primary">Go to market</a>
        </div>
    </section>
</div>

<script>
(function () {
    const overlay = document.getElementById('vim-tour-overlay');
    const backdrop = document.getElementById('vim-tour-backdrop');
    const spotlight = document.getElementById('vim-tour-spotlight');
    const card = document.getElementById('vim-tour-card');
    const eyebrow = document.getElementById('vim-tour-eyebrow');
    const title = document.getElementById('vim-tour-title');
    const description = document.getElementById('vim-tour-description');
    const progress = document.getElementById('vim-tour-progress');
    const nextButton = document.getElementById('vim-tour-next');
    const skipButton = document.getElementById('vim-tour-skip');
    const launcher = document.getElementById('vim-tour-launcher');
    if (!overlay || !spotlight || !card) return;

    const tourSteps = [
        { selector: '[data-tour="market"]', mobileSelector: '[data-tour="market-mobile"]', eyebrow: 'MARKET', title: 'Player market', description: 'Browse cards, stats and registration.' },
        { selector: '[data-tour="matches"]', mobileSelector: '[data-tour="matches-mobile"]', eyebrow: 'MATCHES', title: 'Fixtures', description: 'Upcoming and completed games.' },
        { selector: '#live-search-input', eyebrow: 'SEARCH', title: 'Find anything', description: 'Teams, players or matches from here.' },
        { selector: '#tour-featured-match', eyebrow: 'SCHEDULE', title: 'Next match', description: 'The featured upcoming fixture.' },
        { selector: '#tour-results', eyebrow: 'RESULTS', title: 'Recent scores', description: 'Latest completed matches.' }
    ];
    let currentStep = 0;
    function isMobileLayout() { return window.innerWidth < 1280; }
    function getTarget(step) {
        let t = null;
        if (isMobileLayout() && step.mobileSelector) t = document.querySelector(step.mobileSelector);
        if (!t && step.selector) t = document.querySelector(step.selector);
        return t;
    }
    function createProgress() {
        progress.innerHTML = '';
        tourSteps.forEach((_, i) => {
            const d = document.createElement('span');
            if (i === currentStep) d.classList.add('active');
            progress.appendChild(d);
        });
    }
    function positionTourCard(target) {
        const margin = 16, cardWidth = Math.min(360, window.innerWidth - 32);
        card.style.width = cardWidth + 'px';
        if (window.innerWidth <= 640) {
            card.classList.add('centered');
            card.style.left = '16px'; card.style.top = 'auto'; card.style.bottom = '20px';
            return;
        }
        card.classList.remove('centered');
        const rect = target.getBoundingClientRect();
        let left = rect.left, top = rect.bottom + 22;
        if (left + cardWidth > window.innerWidth - margin) left = window.innerWidth - cardWidth - margin;
        if (left < margin) left = margin;
        if (top + 200 > window.innerHeight - margin) {
            top = Math.max(margin, rect.top - 200 - 22);
            card.classList.add('centered');
        }
        card.style.left = left + 'px'; card.style.top = top + 'px'; card.style.bottom = 'auto';
    }
    function moveSpotlight(target) {
        const rect = target.getBoundingClientRect();
        const pad = window.innerWidth <= 640 ? 10 : 9;
        spotlight.style.left = (rect.left + rect.width / 2) + 'px';
        spotlight.style.top = (rect.top + rect.height / 2) + 'px';
        spotlight.style.width = (Math.max(rect.width, 55) + pad * 2) + 'px';
        spotlight.style.height = (Math.max(rect.height, 45) + pad * 2) + 'px';
    }
    function showStep(index) {
        currentStep = index;
        const step = tourSteps[currentStep];
        const target = getTarget(step);
        if (!target) {
            if (currentStep < tourSteps.length - 1) showStep(currentStep + 1);
            else finishTour();
            return;
        }
        if (isMobileLayout() && step.mobileSelector) {
            const m = document.getElementById('mobile-menu');
            if (m && !m.classList.contains('active')) m.classList.add('active');
        }
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => { moveSpotlight(target); positionTourCard(target); }, 120);
        eyebrow.textContent = step.eyebrow;
        title.textContent = step.title;
        description.textContent = step.description;
        createProgress();
        nextButton.textContent = currentStep === tourSteps.length - 1 ? 'Done' : 'Next';
    }
    function startTour() {
        overlay.classList.add('active');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        showStep(0);
    }
    function finishTour() {
        overlay.classList.remove('active');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        localStorage.setItem('vim_home_tour_seen', 'true');
        const m = document.getElementById('mobile-menu');
        if (m) m.classList.remove('active');
    }
    nextButton.addEventListener('click', () => {
        if (currentStep >= tourSteps.length - 1) finishTour();
        else showStep(currentStep + 1);
    });
    skipButton.addEventListener('click', finishTour);
    backdrop.addEventListener('click', finishTour);
    launcher.addEventListener('click', startTour);
    document.addEventListener('keydown', (e) => {
        if (!overlay.classList.contains('active')) return;
        if (e.key === 'Escape') finishTour();
        if (e.key === 'ArrowRight' && currentStep < tourSteps.length - 1) showStep(currentStep + 1);
        if (e.key === 'ArrowLeft' && currentStep > 0) showStep(currentStep - 1);
    });
    if (!localStorage.getItem('vim_home_tour_seen')) setTimeout(startTour, 900);
})();
</script>

<script>
    const localMatches = <%- JSON.stringify(typeof matches !== 'undefined' ? matches : []) %>;
    const localPlayers = <%- typeof players !== 'undefined' ? JSON.stringify(players) : '[]' %>;
    const searchInput = document.getElementById('live-search-input');
    const dropdown = document.getElementById('search-results-dropdown');
    const searchForm = document.getElementById('search-form');
    let debounceTimer, topTargetUrl = '';

    searchInput.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        const query = e.target.value.trim().toLowerCase();
        if (query.length < 1) { dropdown.classList.add('hidden'); dropdown.innerHTML = ''; topTargetUrl = ''; return; }
        debounceTimer = setTimeout(() => {
            fetch(`/api/search?q=${encodeURIComponent(query)}`)
                .then(res => res.ok ? res.json() : Promise.reject())
                .then(data => renderSearchResults(data, query))
                .catch(() => {
                    renderSearchResults({
                        matches: localMatches.filter(m => (m.teamA && m.teamA.toLowerCase().includes(query)) || (m.teamB && m.teamB.toLowerCase().includes(query))),
                        players: localPlayers.filter(p => (p.name && p.name.toLowerCase().includes(query)) || (p.role && p.role.toLowerCase().includes(query)))
                    }, query);
                });
        }, 150);
    });

    function renderSearchResults(data, query) {
        const { players, matches } = data;
        let html = '';
        topTargetUrl = '';
        if ((!matches || !matches.length) && (!players || !players.length)) {
            dropdown.innerHTML = '<div style="padding:1rem;text-align:center;color:#6b6560;font-size:0.8rem;">No results</div>';
            dropdown.classList.remove('hidden');
            return;
        }
        if (matches && matches.length) {
            if (!topTargetUrl) topTargetUrl = `/match/${matches[0]._id || matches[0].id || ''}`;
            html += '<div style="font-size:0.65rem;letter-spacing:0.12em;text-transform:uppercase;color:#6b6560;margin-bottom:0.4rem;">Matches</div>';
            matches.forEach(m => {
                const url = (m._id || m.id) ? `/match/${m._id || m.id}` : `/matches?q=${encodeURIComponent(query)}`;
                html += `<a href="${url}" style="display:block;padding:0.5rem 0.25rem;text-decoration:none;color:#1a1a1a;font-size:0.85rem;font-weight:500;">${m.teamA} vs ${m.teamB}</a>`;
            });
        }
        if (players && players.length) {
            if (!topTargetUrl) topTargetUrl = (players[0]._id || players[0].id) ? `/player/${players[0]._id || players[0].id}` : '/market';
            html += '<div style="font-size:0.65rem;letter-spacing:0.12em;text-transform:uppercase;color:#6b6560;margin:0.6rem 0 0.4rem;">Players</div>';
            players.forEach(p => {
                const url = (p._id || p.id) ? `/player/${p._id || p.id}` : `/market?search=${encodeURIComponent(p.name)}`;
                html += `<a href="${url}" style="display:block;padding:0.5rem 0.25rem;text-decoration:none;color:#1a1a1a;font-size:0.85rem;font-weight:500;">${p.name}</a>`;
            });
        }
        dropdown.innerHTML = html;
        dropdown.classList.remove('hidden');
    }

    searchForm.addEventListener('submit', (e) => {
        if (topTargetUrl) { e.preventDefault(); window.location.href = topTargetUrl; }
    });
    document.addEventListener('click', (e) => {
        if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) dropdown.classList.add('hidden');
    });
</script>
