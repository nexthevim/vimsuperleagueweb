<%- include('partials/navbar') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --info-paper: #f4f1e9;
  --info-ink: #0f2f2f;
  --info-ink-deep: #073536;
  --info-teal: #07595a;
  --info-coral: #e87a64;
  --info-muted: #6d7f7a;
  --info-line: rgba(15,47,47,.1);
  --info-display: "DM Serif Display", Georgia, serif;
  --info-body: "Manrope", system-ui, sans-serif;
}
* { box-sizing: border-box; }
body { margin: 0; font-family: var(--info-body); }

.info-page {
  min-height: 100vh;
  color: var(--info-ink);
  background:
    radial-gradient(ellipse 55% 40% at 8% 0%, rgba(232,122,100,.12), transparent 50%),
    radial-gradient(ellipse 45% 35% at 95% 8%, rgba(7,89,90,.1), transparent 48%),
    var(--info-paper);
  padding: 5.5rem 0 0;
}
.info-wrap { width: min(1000px, calc(100% - 1.75rem)); margin: 0 auto; }

.info-hero {
  text-align: center;
  margin-bottom: 2.25rem;
  animation: infoIn .55s cubic-bezier(.22,1,.36,1) both;
}
.info-hero .eyebrow {
  display: inline-flex; align-items: center; gap: .5rem;
  font-size: .62rem; font-weight: 800; letter-spacing: .18em;
  text-transform: uppercase; color: var(--info-coral);
}
.info-hero .eyebrow::before {
  content: ""; width: 16px; height: 2px; background: currentColor;
}
.info-hero h1 {
  margin: .4rem 0 .35rem;
  font-family: var(--info-display);
  font-size: clamp(2.6rem, 5.5vw, 3.8rem);
  line-height: .92; color: var(--info-ink-deep);
}
.info-hero h1 em { font-style: italic; color: var(--info-teal); }
.info-hero p { margin: 0; color: var(--info-muted); font-size: .85rem; }

.info-section { margin-bottom: 2.25rem; animation: infoIn .55s cubic-bezier(.22,1,.36,1) both; }
.info-section-title {
  display: flex; align-items: center; gap: .55rem;
  margin: 0 0 1rem;
  font-size: .62rem; font-weight: 800; letter-spacing: .14em;
  text-transform: uppercase; color: var(--info-muted);
}
.info-section-title i {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--info-teal); display: inline-block;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
  gap: .85rem;
}

.info-card {
  display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  padding: 1.15rem 1.2rem;
  background: #fffdf8;
  border: 1px solid var(--info-line);
  border-radius: 1.35rem;
  text-decoration: none; color: inherit;
  box-shadow: 0 12px 30px rgba(15,47,47,.05);
  transition: transform .25s cubic-bezier(.22,1,.36,1), box-shadow .25s, border-color .2s;
}
.info-card:hover {
  transform: translateY(-4px);
  border-color: rgba(7,89,90,.25);
  box-shadow: 0 18px 40px rgba(15,47,47,.1);
}
.info-card .meta span {
  display: block; font-size: .55rem; font-weight: 800;
  letter-spacing: .1em; text-transform: uppercase; color: var(--info-muted);
}
.info-card .meta strong {
  display: block; margin-top: .25rem;
  font-size: 1rem; font-weight: 800; text-transform: uppercase;
  color: var(--info-ink-deep); letter-spacing: -.01em;
}
.info-icon {
  width: 3rem; height: 3rem; border-radius: 1rem;
  display: grid; place-items: center; flex-shrink: 0;
  font-size: 1.25rem;
  transition: transform .25s ease;
}
.info-card:hover .info-icon { transform: scale(1.08); }
.info-icon.discord { background: #eef0ff; color: #5865F2; border: 1px solid #dce0ff; }
.info-icon.youtube { background: #fff1f1; color: #FF0000; border: 1px solid #ffd6d6; }
.info-icon.book { background: #eef7fb; color: #0284c7; border: 1px solid #d0ebf7; }
.info-icon.edit { background: rgba(15,47,47,.05); color: var(--info-ink-deep); border: 1px solid var(--info-line); }
.info-icon.shield { background: rgba(7,89,90,.08); color: var(--info-teal); border: 1px solid rgba(7,89,90,.12); }
.info-icon.tie { background: rgba(232,122,100,.12); color: #c45a48; border: 1px solid rgba(232,122,100,.2); }

/* FAQ */
.faq-item {
  background: #fffdf8;
  border: 1px solid var(--info-line);
  border-radius: 1.25rem;
  padding: 1.1rem 1.2rem;
  cursor: pointer;
  box-shadow: 0 10px 28px rgba(15,47,47,.04);
  transition: border-color .2s, box-shadow .2s;
  margin-bottom: .65rem;
}
.faq-item:hover { border-color: rgba(7,89,90,.2); }
.faq-item.active {
  border-color: rgba(7,89,90,.3);
  box-shadow: 0 14px 32px rgba(15,47,47,.08);
}
.faq-q {
  display: flex; align-items: center; justify-content: space-between; gap: 1rem;
}
.faq-q h3 {
  margin: 0; font-size: .95rem; font-weight: 800;
  text-transform: uppercase; letter-spacing: -.01em; color: var(--info-ink-deep);
}
.faq-icon {
  color: var(--info-muted); font-size: .7rem;
  transition: transform .28s cubic-bezier(.22,1,.36,1);
  flex-shrink: 0;
}
.faq-item.active .faq-icon {
  transform: rotate(180deg); color: var(--info-teal);
}
.faq-answer {
  max-height: 0; overflow: hidden; opacity: 0;
  transition: max-height .35s ease, opacity .3s ease, margin .3s ease;
}
.faq-item.active .faq-answer {
  max-height: 280px; opacity: 1; margin-top: .85rem;
  padding-top: .85rem; border-top: 1px solid var(--info-line);
}
.faq-answer p {
  margin: 0; font-size: .82rem; font-weight: 600;
  line-height: 1.55; color: var(--info-muted);
}

.info-foot {
  margin-top: 3rem; padding: 2rem 0;
  border-top: 1px solid var(--info-line);
  text-align: center;
}
.info-foot p {
  margin: 0; font-size: .58rem; font-weight: 800;
  letter-spacing: .16em; text-transform: uppercase; color: var(--info-muted);
}

@keyframes infoIn {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: none; }
}
</style>

<div class="info-page">
  <div class="info-wrap">

    <header class="info-hero">
      <div class="eyebrow">Official directory</div>
      <h1>Info <em>Hub</em></h1>
      <p>Resources, staff applications & FAQ</p>
    </header>

    <!-- RESOURCES -->
    <section class="info-section">
      <h2 class="info-section-title"><i></i> Platforms & resources</h2>
      <div class="info-grid">
        <a href="" target="_blank" class="info-card">
          <div class="meta">
            <span>Community hub</span>
            <strong>Discord Server</strong>
          </div>
          <div class="info-icon discord"><i class="fa-brands fa-discord"></i></div>
        </a>
        <a href="https://youtube.com/@vimleague?si=YzHmcioUvJoCghTH" target="_blank" class="info-card">
          <div class="meta">
            <span>Video broadcasts</span>
            <strong>YouTube Channel</strong>
          </div>
          <div class="info-icon youtube"><i class="fa-brands fa-youtube"></i></div>
        </a>
        <a href="https://vimsuperleague-rulebook.base44.app/" target="_blank" class="info-card">
          <div class="meta">
            <span>Official rules</span>
            <strong>League Rulebook</strong>
          </div>
          <div class="info-icon book"><i class="fa-solid fa-book"></i></div>
        </a>
      </div>
    </section>

    <!-- STAFF -->
    <section class="info-section" style="animation-delay:.06s">
      <h2 class="info-section-title"><i></i> Staff & management recruitment</h2>
      <div class="info-grid">
        <a href="https://forms.gle/dQTwe3DbtFgrB7qFA" target="_blank" class="info-card">
          <div class="meta">
            <span>Google form</span>
            <strong>Editorial Team</strong>
          </div>
          <div class="info-icon edit"><i class="fa-solid fa-pen-nib"></i></div>
        </a>
        <a href="https://docs.google.com/forms/d/e/1FAIpQLSfofj8qvOPyTMHvXn69VJCWPupnz0Bfm7inl5bmxJ54dtlt7Q/viewform" target="_blank" class="info-card">
          <div class="meta">
            <span>Google form</span>
            <strong>Moderation Team</strong>
          </div>
          <div class="info-icon shield"><i class="fa-solid fa-shield-halved"></i></div>
        </a>
        <a href="https://docs.google.com/forms/d/e/1FAIpQLSeRBPSTQQqUyHhkzA2FYeUkgLdXhRiBea-P2LjDHMTPU86f7w/viewform" target="_blank" class="info-card">
          <div class="meta">
            <span>Google form</span>
            <strong>Management Team</strong>
          </div>
          <div class="info-icon tie"><i class="fa-solid fa-user-tie"></i></div>
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="info-section" style="animation-delay:.1s">
      <h2 class="info-section-title"><i></i> Frequently asked questions</h2>

      <div class="faq-item" onclick="toggleFaq(this)">
        <div class="faq-q">
          <h3>Are we scammers?</h3>
          <i class="fa-solid fa-chevron-down faq-icon"></i>
        </div>
        <div class="faq-answer">
          <p>We have paid out all prize pools for our past seasons. The only exception was Season 3, which we truly regret and have publicly addressed. All payout receipts, payment logs, and proof of transactions are fully transparent and accessible inside our official Discord server under the proof channels.</p>
        </div>
      </div>

      <div class="faq-item" onclick="toggleFaq(this)">
        <div class="faq-q">
          <h3>How to get staff?</h3>
          <i class="fa-solid fa-chevron-down faq-icon"></i>
        </div>
        <div class="faq-answer">
          <p>You can check the staff section above to fill out our official Google Forms for Editorial, Moderation, or Management roles. Once submitted, our Executive Board reviews all applications. If selected, an official administrator will DM you directly on Discord.</p>
        </div>
      </div>

      <div class="faq-item" onclick="toggleFaq(this)">
        <div class="faq-q">
          <h3>How do I register my team for the league?</h3>
          <i class="fa-solid fa-chevron-down faq-icon"></i>
        </div>
        <div class="faq-answer">
          <p>Team registrations open prior to every official Gameweek or new Season launch. Announcement links and registration forms are posted inside the Discord announcements channel. Make sure your team roster fulfills the minimum player criteria before applying.</p>
        </div>
      </div>

      <div class="faq-item" onclick="toggleFaq(this)">
        <div class="faq-q">
          <h3>How are match disputes or stat errors handled?</h3>
          <i class="fa-solid fa-chevron-down faq-icon"></i>
        </div>
        <div class="faq-answer">
          <p>If you spot an error in goal stats, yellow cards, or match results, open a support ticket in our Discord server within 24 hours of match completion. Our Match Review Officers will verify the match recording and update the live metrics database accordingly.</p>
        </div>
      </div>

      <div class="faq-item" onclick="toggleFaq(this)">
        <div class="faq-q">
          <h3>Where can I check live fixtures and match times?</h3>
          <i class="fa-solid fa-chevron-down faq-icon"></i>
        </div>
        <div class="faq-answer">
          <p>Head over to the Matches tab in the main navigation. You can view live games, upcoming fixtures, and past results — including dual-leg scores when available.</p>
        </div>
      </div>
    </section>

    <footer class="info-foot">
      <p>© 2026 VIM Super League · Built for the community</p>
    </footer>
  </div>
</div>

<script>
function toggleFaq(el) {
  el.classList.toggle('active');
}
</script>
