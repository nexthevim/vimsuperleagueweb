<%- include('partials/navbar') %>

<main class="min-h-[85vh] flex items-center justify-center bg-slate-50 px-6 py-16">

    <div class="w-full max-w-sm">

        <div class="text-center mb-8">
            <span class="text-[11px] text-blue-600 font-black uppercase tracking-[0.25em]">VIM Super League</span>
            <h1 class="text-4xl font-black italic uppercase tracking-tighter text-slate-900 mt-1">Staff Login</h1>
            <p class="text-xs text-slate-400 font-bold uppercase tracking-wide mt-2">
                Enter the admin password to continue
            </p>
        </div>

        <div class="bg-white border border-slate-200 rounded-[28px] shadow-sm p-8">

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-red-50 border border-red-200 text-red-600 text-xs font-bold uppercase tracking-wide rounded-2xl px-4 py-3 mb-6 flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86l-8.18 14.17A1 1 0 003 19.5h18a1 1 0 00.89-1.47L13.71 3.86a1 1 0 00-1.72 0z"/>
                    </svg>
                    <%= error %>
                </div>
            <% } %>

            <form action="/admin-login" method="POST" class="space-y-5">
                <div>
                    <label class="text-[10px] font-black uppercase text-slate-500 tracking-widest block mb-1.5">
                        Password
                    </label>
                    <input
                        type="password"
                        name="password"
                        required
                        autofocus
                        placeholder="••••••••"
                        class="w-full bg-slate-50 border border-slate-200 px-4 py-3 rounded-2xl text-slate-900 text-sm font-bold outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-500/10 transition-all">
                </div>

                <button type="submit"
                        class="w-full bg-slate-900 hover:bg-slate-800 text-white py-3.5 rounded-2xl font-black uppercase text-xs tracking-widest transition-all shadow-sm">
                    Log In
                </button>
            </form>

        </div>

        <p class="text-center text-[10px] text-slate-400 font-bold uppercase tracking-widest mt-6">
            Staff access only &middot; VIM Super League
        </p>

    </div>

</main>
