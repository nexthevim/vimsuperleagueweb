                        <path d="M8 13h16v11a2 2 0 01-2 2H10a2 2 0 01-2-2V13z" fill="#dbeafe"/>
                        <circle cx="16" cy="20" r="3.2" fill="#1e40af"/>
                        <path d="M14.8 20.2l.9.7-.25 1.05.95-.5.95.5-.25-1.05.9-.7-1.1-.1-.5-1-.5 1z" fill="#93c5fd"/>
                    </svg>
